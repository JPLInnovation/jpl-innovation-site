---
import Logo from "./Logo.astro";
// Words and links: src/text/site.ts (`footer`).
import { footer, site } from "@/text/site";

const year = new Date().getFullYear();
const linkClass = "press inline-flex min-h-11 items-center underline-offset-4 hover:text-foreground hover:underline";
---

<footer class="border-t">
	<div class="wrapper grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
		<div class="flex max-w-xs flex-col gap-4">
			<a href="/" class="press w-fit" aria-label="JPL Innovation home"><Logo class="h-12" /></a>
			<p class="text-sm text-muted-foreground">
				{footer.blurb}
			</p>
		</div>
		<nav aria-label="Footer">
			<h2 class="mb-1 text-sm font-semibold">{footer.pagesHeading}</h2>
			<ul class="flex flex-col text-sm text-muted-foreground">
				{footer.pages.map((l) => <li><a class={linkClass} href={l.href}>{l.label}</a></li>)}
			</ul>
		</nav>
		<div>
			<h2 class="mb-1 text-sm font-semibold">{footer.contactHeading}</h2>
			<ul class="flex flex-col text-sm text-muted-foreground">
				<li><a class={linkClass} href={`mailto:${site.email}`}>{site.email}</a></li>
			</ul>
		</div>
	</div>
	<div class="wrapper border-t py-5 text-sm text-muted-foreground">
		&copy; {year} {footer.copyright}
	</div>
</footer>
