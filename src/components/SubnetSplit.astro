		transform-origin: left center;
	}
	.subnet__seg--1 {
		background: var(--s1);
	}
	.subnet__seg--2 {
		background: var(--s2);
	}
	.subnet__seg--3 {
		background: var(--s3);
	}
	.subnet__seg--4 {
		background: var(--s4);
	}
	.subnet__table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.875rem;
