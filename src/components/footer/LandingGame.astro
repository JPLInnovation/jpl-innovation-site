---
/**
 * "Land the drone" (spec §11, the footer game; src/scripts/landing-game.ts plays it, src/lib/look/landing.ts is its
 * physics). The F450 in line, from the side, over its H pad in Saigon (Bitexco with its helipad, Landmark 81), the
 * altitude drawn as a dimension ruler. Without script it is a still drawing and a link to the real drone; the controls
 * and the readouts only show when the game runs.
 *
 * The stage is a size container: wide on a wide column, 4:3 in a narrow one. Its pieces are placed in CSS from three
 * numbers on the stage: --g (the ground above the stage's bottom), --dw (the drone's width) and --ppm (pixels a metre,
 * worked out from the stage's height). The script only sets --alt (metres) on the drone layer.
 */
import { CEILING } from "@/lib/look/landing";
import { landing as text } from "@/text/site";

const labels = [5, 10, 15].filter((m) => m <= CEILING);
---

<section class="lander" data-lander aria-labelledby="lander-heading" data-phase="ready">
	<div class="lander__row">
		<h2 id="lander-heading">{text.heading}</h2>
		<p class="lander__best" data-js hidden>{text.best}: <span data-best>{text.bestNone}</span></p>
	</div>
	<div class="lander__frame">
		<div class="lander__stage" data-stage>
			<!-- Saigon on the horizon: low blocks, Bitexco Financial Tower and its helipad, Landmark 81 -->
			<svg class="lander__city" viewBox="0 0 480 80" preserveAspectRatio="xMidYMax meet" aria-hidden="true" focusable="false">
				<g class="ln-soft">
					<rect x="338" y="58" width="22" height="22" />
					<path d="M373 80C371 64 370 55 374 47L378 36L382 47C386 55 385 64 383 80" />
					<path d="M384 50h6" />
					<ellipse cx="394" cy="50" rx="6" ry="1.5" />
					<rect x="398" y="64" width="24" height="16" />
					<path d="M430 80V40H433V28H436V16H439V8L441.5 1L444 8V16H447V28H450V40H453V80" />
					<rect x="458" y="54" width="20" height="26" />
				</g>
			</svg>
			<!-- the ground, cut in section -->
			<svg class="lander__ground" aria-hidden="true" focusable="false">
				<defs>
					<pattern id="lander-hatch" width="10" height="20" patternUnits="userSpaceOnUse">
						<path class="ln-soft" d="M0 12L10 2" />
					</pattern>
				</defs>
				<rect y="2" width="100%" height="100%" fill="url(#lander-hatch)" />
				<line class="ln" x1="0" y1="0.75" x2="100%" y2="0.75" />
			</svg>
			<!-- the pad lying on it -->
			<svg class="lander__pad" viewBox="-70 -12 140 24" aria-hidden="true" focusable="false">
				<ellipse class="ln lander__pad-top" rx="66" ry="10" />
				<ellipse class="ln-soft" rx="50" ry="7.4" />
				<path class="lander__h" d="M-10 -3.6v7.2 M10 -3.6v7.2 M-10 0h20" />
			</svg>
			<div class="lander__shadow" data-shadow></div>
			<!-- the altitude ruler: a tick a metre, a long one every 5 m -->
			<div class="lander__ruler" aria-hidden="true">
				<svg viewBox={`0 0 12 ${CEILING * 10}`} preserveAspectRatio="none" focusable="false">
					{
						Array.from({ length: CEILING + 1 }, (_, m) => (
							<line class="ln-soft" x1={m % 5 === 0 ? 0 : 6} y1={m * 10} x2="12" y2={m * 10} />
						))
					}
					<line class="ln-soft" x1="12" y1="0" x2="12" y2={CEILING * 10} />
				</svg>
				{labels.map((m) => <span style={`--m: ${m}`}>{m === CEILING ? `${m} m` : m}</span>)}
			</div>
			<!-- the drone layer: a line at the skids' height, moved up by the altitude -->
			<div class="lander__drone" data-drone>
				<span class="lander__mark"></span>
				<span class="lander__leader"></span>
				<!-- the F450 from the side (after public/assets/f450-drone.svg): skids and legs, the two plates and the stack
				     between them, arms, motors, props, the GPS mast, the camera, the 4G link -->
				<svg class="lander__craft-svg" viewBox="-72 -48 144 49" aria-hidden="true" focusable="false">
					<g class="lander__craft">
						<path class="ln" d="M-27 0h12 M15 0h12 M-21 0l9 -14 M21 0l-9 -14" />
						<rect class="ln" x="-25" y="-17.5" width="50" height="3.5" rx="1" />
						<rect class="ln" x="-16" y="-24" width="32" height="6.5" rx="1.5" />
						<rect class="ln" x="-21" y="-27.5" width="42" height="3.5" rx="1" />
						<path class="ln lander__arm" d="M-21 -21.5L-47 -24 M21 -21.5L47 -24" />
						<rect class="ln" x="-51" y="-31" width="8" height="7" rx="1.5" />
						<rect class="ln" x="43" y="-31" width="8" height="7" rx="1.5" />
						<path class="ln" d="M-47 -31v-3 M47 -31v-3 M0 -27.5v-8" />
						<rect class="ln" x="-6" y="-39" width="12" height="3.5" rx="1.5" />
						<rect class="ln" x="25" y="-14" width="8" height="6" rx="1.5" />
						<path class="ln-soft" d="M8 -41a9 9 0 0 1 7 7 M10 -46a15 15 0 0 1 10 10" />
						<path class="ln lander__blade" d="M-71 -34.5h48 M23 -34.5h48" />
						<ellipse class="lander__disc" cx="-47" cy="-34.5" rx="25" ry="2.6" />
						<ellipse class="lander__disc" cx="47" cy="-34.5" rx="25" ry="2.6" />
						<path class="lander__wash" d="M-56 -27v14 M-47 -27v18 M-38 -27v14 M38 -27v14 M47 -27v18 M56 -27v14" />
					</g>
				</svg>
			</div>
		</div>
		<dl class="lander__hud" data-js hidden>
			<div><dt>{text.altitude}</dt><dd><span data-alt>{CEILING.toFixed(1)}</span> m</dd></div>
			<div><dt>{text.speed}</dt><dd><span data-speed>0.0</span> m/s</dd></div>
			<div><dt>{text.fuel}</dt><dd class="lander__fuel"><span data-fuel></span></dd></div>
		</dl>
	</div>
	<div class="lander__row">
		<p class="lander__status" id="lander-status" data-js hidden data-status>{text.howTo}</p>
		<a class="lander__link" href={text.href}>{text.link}&nbsp;<span aria-hidden="true">→</span></a>
	</div>
	<p class="sr-only" aria-live="polite" data-said></p>
</section>

<script>
	import "@/scripts/landing-game";
</script>

<style define:vars={{ ceiling: CEILING }}>
	.lander {
		container-type: inline-size;
		display: grid;
		gap: 0.9rem;
		align-content: start;
	}
	.lander__row {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1.5rem;
	}
	h2 {
		font-size: var(--step-lead);
		font-stretch: 125%;
		font-weight: 760;
		letter-spacing: -0.02em;
	}
	.lander__best,
	.lander__status {
		font-size: var(--step-small);
		color: var(--ink-soft);
		font-variant-numeric: tabular-nums;
	}
	.lander__status {
		flex: 1 1 18rem;
	}
	.lander__best span {
		color: var(--ink);
		font-weight: 650;
	}
	/* The frame: 8 px of the sheet's edge colour around the drawing, radii concentric (24 = 16 + 8). */
	.lander__frame {
		position: relative;
		padding: 0.5rem;
		border-radius: 1.5rem;
		background: rgb(242 238 223 / 0.05);
		box-shadow: inset 0 0 0 1px var(--sheet-edge);
	}
	.lander__stage {
		/* resolved where they are used, inside the stage, so cqw / cqh are the stage's */
		--g: 18px;
		--cx: 52%;
		--dw: clamp(104px, 30cqw, 210px);
		--dh: calc(var(--dw) * 49 / 144);
		--ppm: calc((100cqh - var(--g) - var(--dh) - 10px) / var(--ceiling));
		container-type: size;
		position: relative;
		aspect-ratio: 2.4;
		overflow: hidden;
		border-radius: 1rem;
		background: var(--field);
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
		-webkit-touch-callout: none;
		-webkit-tap-highlight-color: transparent;
	}
	@container (max-width: 30rem) {
		.lander__stage {
			aspect-ratio: 4 / 3;
			--cx: 40%;
		}
	}
	.lander[data-on] .lander__stage {
		cursor: pointer;
	}
	.lander__stage:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 4px;
	}
	.lander__stage > * {
		position: absolute;
	}

	/* line weights: one pen for the drawing, a finer one for the ruler, the hatch and the city */
	.ln,
	.ln-soft,
	.lander__h,
	.lander__wash {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}
	.ln {
		stroke: var(--ink);
		stroke-width: 1.5;
	}
	.ln-soft {
		stroke: rgb(242 238 223 / 0.4);
		stroke-width: 1;
	}

	.lander__city {
		left: 0;
		bottom: var(--g);
		width: 100%;
		height: auto;
	}
	.lander__ground {
		left: 0;
		bottom: 0;
		width: 100%;
		height: calc(var(--g) + 1px);
	}
	.lander__pad {
		left: var(--cx);
		bottom: calc(var(--g) - var(--dw) * 0.95 * 12 / 140);
		width: calc(var(--dw) * 0.95);
		translate: -50% 0;
		overflow: visible;
	}
	.lander__pad-top {
		fill: rgb(242 238 223 / 0.06);
	}
	.lander__h {
		stroke: var(--mark);
		stroke-width: 2.5;
	}
	/* the drone's shadow on the pad: darker and tighter as it comes down */
	.lander__shadow {
		left: var(--cx);
		bottom: var(--g);
		width: calc(var(--dw) * 0.42);
		aspect-ratio: 6 / 1;
		translate: -50% 50%;
		border-radius: 50%;
		background: rgb(0 0 0 / 0.55);
		opacity: 0.12;
		scale: 0.4;
	}

	.lander__ruler {
		left: 0.6rem;
		bottom: var(--g);
		width: 3rem;
		height: calc(var(--ceiling) * var(--ppm));
	}
	.lander__ruler svg {
		position: absolute;
		right: 0;
		top: 0;
		width: 12px;
		height: 100%;
		overflow: visible;
	}
	.lander__ruler span {
		position: absolute;
		right: 17px;
		bottom: calc(var(--m) / var(--ceiling) * 100%);
		translate: 0 50%;
		font-size: 0.75rem;
		line-height: 1;
		white-space: nowrap;
		color: var(--ink-soft);
		font-variant-numeric: tabular-nums;
	}

	/* The drone layer sits on the ground line; --alt (metres, set by the script) lifts it. */
	.lander__drone {
		--alt: var(--ceiling);
		left: 0;
		right: 0;
		bottom: var(--g);
		height: 0;
		transform: translateY(calc(var(--alt) * var(--ppm) * -1));
		will-change: transform;
	}
	.lander__mark {
		position: absolute;
		left: calc(0.6rem + 3rem + 3px);
		top: 0;
		width: 8px;
		height: 9px;
		translate: 0 -50%;
		background: var(--mark);
		clip-path: polygon(0 50%, 100% 0, 100% 100%);
	}
	.lander__leader {
		position: absolute;
		left: calc(0.6rem + 3rem + 16px);
		width: calc(var(--cx) - var(--dw) * 0.4 - 0.6rem - 3rem - 22px);
		top: 0;
		border-top: 1px dashed rgb(242 238 223 / 0.35);
	}
	.lander__craft-svg {
		position: absolute;
		left: var(--cx);
		bottom: 0;
		width: var(--dw);
		translate: -50% 0;
		overflow: visible;
	}
	.lander__arm {
		stroke-width: 2.5;
	}
	/* props: still blades at rest; spinning discs while it flies */
	.lander__disc {
		fill: rgb(242 238 223 / 0.14);
		stroke: rgb(242 238 223 / 0.6);
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
		opacity: 0;
	}
	.lander[data-on]:is([data-phase="flying"], [data-phase="ready"]) .lander__disc {
		opacity: 1;
	}
	.lander[data-on]:is([data-phase="flying"], [data-phase="ready"]) .lander__blade {
		opacity: 0;
	}
	/* the thrust: the props' downwash, only while the throttle is held */
	.lander__wash {
		stroke: var(--mark);
		stroke-width: 1.5;
		stroke-dasharray: 3 5;
		opacity: 0;
	}
	.lander[data-throttle] .lander__wash {
		opacity: 1;
	}
	/* a hard landing tips it over its right skid */
	.lander__craft {
		transform-box: fill-box;
		transform-origin: 69% 100%;
	}
	.lander[data-phase="hard"] .lander__craft {
		transform: rotate(9deg);
		transition: transform 0.35s cubic-bezier(0.3, 1.4, 0.5, 1);
	}

	/* Motion, only when allowed and on screen: the rotors spin, and the hover bobs before the first flight. */
	@media (prefers-reduced-motion: no-preference) {
		:global(html:not(.reduce-motion)) .lander[data-visible][data-phase="ready"][data-on] .lander__craft-svg {
			animation: lander-hover 2.4s ease-in-out infinite alternate;
		}
		:global(html:not(.reduce-motion)) .lander[data-visible][data-on]:is([data-phase="flying"], [data-phase="ready"]) .lander__disc {
			animation: lander-spin 0.11s linear infinite;
			transform-box: fill-box;
			transform-origin: center;
		}
		:global(html:not(.reduce-motion)) .lander[data-visible][data-throttle] .lander__wash {
			animation: lander-wash 0.25s linear infinite;
		}
	}
	@keyframes lander-hover {
		to {
			transform: translateY(-4px);
		}
	}
	@keyframes lander-spin {
		50% {
			transform: scaleX(0.82);
		}
	}
	@keyframes lander-wash {
		to {
			stroke-dashoffset: -8;
		}
	}

	/* The readouts, top right of the drawing, where the drone never flies. */
	.lander__hud {
		position: absolute;
		top: 1.15rem;
		right: 1.3rem;
		display: grid;
		gap: 0.1rem;
		margin: 0;
		pointer-events: none;
		font-size: var(--step-small);
		font-variant-numeric: tabular-nums;
	}
	.lander__hud > div {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
	}
	.lander__hud dt {
		color: var(--ink-soft);
	}
	.lander__hud dd {
		margin: 0;
		font-weight: 650;
		min-width: 4.6em;
		text-align: right;
	}
	.lander__fuel {
		display: flex;
		align-items: center;
	}
	.lander__fuel span {
		display: block;
		width: 100%;
		height: 0.4rem;
		border-radius: 999px;
		background: var(--mark);
		transform-origin: left center;
		box-shadow: 0 0 0 1px rgb(242 238 223 / 0.2);
	}
	@container (max-width: 30rem) {
		.lander__hud {
			top: 0.9rem;
			right: 1rem;
		}
	}
	.lander__link {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-weight: 650;
		text-decoration: underline;
		text-decoration-color: var(--accent-brand);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}
</style>
