---
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
// Menu labels and links: src/text/site.ts (`menu`).
import { menu as links } from "@/text/site";

/** The most specific link that matches the current path (so /work/frc/ lights up "Work"). */
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const current = links
	.filter((l) => path.startsWith(l.href))
	.sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<!-- Auto-hides once the page scrolls; comes back when the mouse reaches the top edge, on keyboard focus, or (touch) on scroll up. -->
<header
	data-site-header
	class="site-header sticky top-0 z-50 border-b border-transparent bg-background/70 backdrop-blur-xl backdrop-saturate-150 data-[menu-open]:border-border/70 data-[menu-open]:bg-background/95 data-[scrolled]:border-border/70 data-[scrolled]:bg-background/80"
>
	<div class="wrapper flex h-18 items-center justify-between gap-3">
		<a href="/" class="press flex items-center rounded-md" aria-label="JPL Innovation home">
			<Logo class="h-11 sm:h-14" />
		</a>
		<div class="flex items-center gap-1 sm:gap-2">
			<!-- Tablet and up: links inline -->
			<nav aria-label="Main" class="hidden md:block">
				<ul class="flex items-center">
					{
						links.map((l) => (
							<li>
								<a
									href={l.href}
									aria-current={l.href === current ? "page" : undefined}
									class="press relative inline-flex h-11 items-center px-3.5 text-[15px] font-medium text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:text-foreground after:absolute after:inset-x-3.5 after:bottom-2 after:h-[3px] after:rounded-full after:bg-primary dark:after:bg-accent after:opacity-0 aria-[current=page]:after:opacity-100"
								>
									{l.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
			<ThemeToggle />
			<!-- Phones and small tablets: menu button -->
			<button
				type="button"
				data-menu-button
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label="Open menu"
				class="menu-button inline-flex size-11 items-center justify-center rounded-md text-foreground transition-colors hover:bg-secondary md:hidden"
			>
				<span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
			</button>
		</div>
	</div>

	<!-- Phone menu panel. Closes on scroll, link tap, tap outside, Escape, or widening to desktop (script below). -->
	<nav
		id="mobile-menu"
		aria-label="Main"
		data-menu-panel
		inert
		class="menu-panel absolute inset-x-0 top-full border-b bg-background/95 backdrop-blur-xl md:hidden"
	>
		<ul class="wrapper flex flex-col py-2">
			{
				links.map((l, i) => (
					<li class="menu-item border-t first:border-t-0" style={`--i: ${i}`}>
						<a
							href={l.href}
							aria-current={l.href === current ? "page" : undefined}
							class="flex min-h-14 items-center justify-between text-lg font-semibold text-muted-foreground aria-[current=page]:text-foreground"
						>
							{l.label}
							{l.href === current && <span class="size-2 rounded-full bg-accent" aria-hidden="true" />}
						</a>
					</li>
				))
			}
		</ul>
	</nav>

	<!-- Pull-tab that hangs below the header while it is hidden. Hover it (or tap it on touch) to bring the header back. -->
	<div data-header-tab class="header-tab absolute top-full left-1/2 flex h-6 w-16 -translate-x-1/2 items-center justify-center rounded-b-xl border border-t-0 border-foreground/15 bg-background/90 shadow-[var(--shadow-soft)] backdrop-blur-xl" aria-hidden="true">
		<span class="h-1 w-7 rounded-full bg-foreground/55"></span>
	</div>
</header>

<style>
	/* Hide by sliding up; the tab below the header stays in view. */
	.site-header {
		transition:
			transform 0.4s cubic-bezier(0.32, 0.72, 0, 1),
			border-color 0.3s,
			background-color 0.3s;
	}
	.site-header[data-hidden] {
		transform: translateY(-100%);
	}
	.header-tab {
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s;
	}
	[data-hidden] .header-tab {
		opacity: 1;
		pointer-events: auto;
		cursor: pointer;
	}

	/* Two bars that fold into an X when the menu is open. */
	.menu-icon {
		position: relative;
		display: block;
		width: 1.25rem;
		height: 0.75rem;
	}
	.menu-icon > span {
		position: absolute;
		left: 0;
		width: 100%;
		height: 2px;
		border-radius: 999px;
		background: currentColor;
		transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1), top 0.35s cubic-bezier(0.32, 0.72, 0, 1);
	}
	.menu-icon > span:first-child {
		top: 0;
	}
	.menu-icon > span:last-child {
		top: calc(100% - 2px);
	}
	[data-menu-open] .menu-icon > span {
		top: calc(50% - 1px);
	}
	[data-menu-open] .menu-icon > span:first-child {
		transform: rotate(45deg);
	}
	[data-menu-open] .menu-icon > span:last-child {
		transform: rotate(-45deg);
	}

	/* Panel slides down; links follow one after another. */
	.menu-panel {
		visibility: hidden;
		opacity: 0;
		transform: translateY(-0.5rem);
		transition:
			opacity 0.3s cubic-bezier(0.32, 0.72, 0, 1),
			transform 0.3s cubic-bezier(0.32, 0.72, 0, 1),
			visibility 0s linear 0.3s;
	}
	[data-menu-open] .menu-panel {
		visibility: visible;
		opacity: 1;
		transform: none;
		transition-delay: 0s;
	}
	.menu-item {
		opacity: 0;
		transform: translateY(0.5rem);
		transition:
			opacity 0.35s cubic-bezier(0.32, 0.72, 0, 1),
			transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
	}
	[data-menu-open] .menu-item {
		opacity: 1;
		transform: none;
		transition-delay: calc(0.05s + var(--i) * 0.05s);
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.header-tab,
		.menu-icon > span,
		.menu-panel,
		.menu-item {
			transition: none;
		}
	}
</style>

<script>
	let cleanup: (() => void) | undefined;

	function init() {
		cleanup?.();
		const header = document.querySelector<HTMLElement>("[data-site-header]");
		if (!header) return;

		// Scroll edge: the header's bottom border only appears once content is scrolling underneath it.
		const edge = () => header.toggleAttribute("data-scrolled", scrollY > 4);
		edge();

		// Auto-hide: the header is always shown near the top of the page, while it is hovered or holds focus, and
		// while the phone menu is open. Mouse users bring it back by moving to the top edge; touch users by scrolling up.
		const TOP = 80;
		const EDGE = 28;
		const hoverMode = matchMedia("(hover: hover) and (pointer: fine)");
		const tab = header.querySelector<HTMLElement>("[data-header-tab]")!;
		let hideTimer = 0;
		let lastY = scrollY;
		const show = () => {
			clearTimeout(hideTimer);
			header.removeAttribute("data-hidden");
		};
		const canHide = () =>
			scrollY > TOP &&
			!isOpen() &&
			// Touch screens keep :hover and focus on whatever was tapped, so only count real hover and keyboard focus.
			!(hoverMode.matches && header.matches(":hover")) &&
			!header.querySelector(":focus-visible");
		const hideSoon = (delay = 0) => {
			clearTimeout(hideTimer);
			hideTimer = window.setTimeout(() => canHide() && header.setAttribute("data-hidden", ""), delay);
		};

		const button = header.querySelector<HTMLButtonElement>("[data-menu-button]")!;
		const panel = header.querySelector<HTMLElement>("[data-menu-panel]")!;
		const desktop = matchMedia("(min-width: 48rem)");
		let openedAt = 0;

		const isOpen = () => header.hasAttribute("data-menu-open");
		const setOpen = (open: boolean, returnFocus = false) => {
			header.toggleAttribute("data-menu-open", open);
			button.setAttribute("aria-expanded", String(open));
			button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
			panel.inert = !open;
			if (open) openedAt = scrollY;
			else if (returnFocus) button.focus();
			if (!open) hideSoon(600);
		};

		const onScroll = () => {
			edge();
			// Close as soon as the page actually scrolls (a little slack for touch jitter).
			if (isOpen() && Math.abs(scrollY - openedAt) > 8) setOpen(false);
			const y = scrollY;
			if (y <= TOP) show();
			else if (hoverMode.matches) hideSoon();
			else if (y < lastY - 6) show(); // touch: scrolling up
			else if (y > lastY + 6) hideSoon();
			if (Math.abs(y - lastY) > 6 || y <= TOP) lastY = y;
		};
		const onPointerMove = (event: PointerEvent) => {
			if (event.pointerType === "mouse" && event.clientY <= EDGE) show();
		};
		const onPointerDown = (event: PointerEvent) => {
			if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
		};
		const onKey = (event: KeyboardEvent) => {
			if (event.key === "Escape" && isOpen()) setOpen(false, true);
		};
		const onBreakpoint = () => desktop.matches && setOpen(false);

		button.addEventListener("click", () => setOpen(!isOpen()));
		panel.addEventListener("click", (event) => {
			if ((event.target as Element).closest("a")) setOpen(false);
		});
		header.addEventListener("pointerleave", () => hideSoon(400));
		header.addEventListener("focusin", () => header.querySelector(":focus-visible") && show());
		header.addEventListener("focusout", () => hideSoon(100));
		tab.addEventListener("click", show);
		document.addEventListener("pointermove", onPointerMove, { passive: true });
		addEventListener("scroll", onScroll, { passive: true });
		// Arriving mid-page (reload, #contact link): start hidden.
		if (scrollY > TOP) hideSoon(800);
		document.addEventListener("pointerdown", onPointerDown);
		document.addEventListener("keydown", onKey);
		desktop.addEventListener("change", onBreakpoint);

		cleanup = () => {
			removeEventListener("scroll", onScroll);
			document.removeEventListener("pointerdown", onPointerDown);
			document.removeEventListener("pointermove", onPointerMove);
			clearTimeout(hideTimer);
			document.removeEventListener("keydown", onKey);
			desktop.removeEventListener("change", onBreakpoint);
		};
	}

	// The header is re-rendered on every client-side navigation, so wire it up after each one.
	document.addEventListener("astro:page-load", init);
</script>
