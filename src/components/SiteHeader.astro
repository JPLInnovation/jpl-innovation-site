---
import Logo from "./Logo.astro";
import SettingsPanel from "./SettingsPanel.astro";
import EmailButton from "./EmailButton.astro";
// Menu labels and links, and the "Let's talk" button: src/text/site.ts (`menu`, `talk`).
import { menu as links, talk } from "@/text/site";

/** The most specific link that matches the current path (so /work/frc/ lights up "Work"). */
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const current = links
	.filter((l) => path.startsWith(l.href))
	.sort((a, b) => b.href.length - a.href.length)[0]?.href;
---

<!--
	Always on screen. Logo at the left (once the page scrolls it rolls into just its badge, Logo.astro), the menu in the
	middle, Settings and the glass "Let's talk" button at the right. Theme lives in Settings now.
-->
<header
	data-site-header
	class="site-header sticky top-0 z-50 border-b border-transparent bg-background/70 backdrop-blur-xl backdrop-saturate-150 data-[menu-open]:border-border/70 data-[menu-open]:bg-background/95 data-[scrolled]:border-border/70 data-[scrolled]:bg-background/92"
>
	<div class="wrapper grid h-18 grid-cols-[1fr_auto] items-center gap-3 md:grid-cols-[1fr_auto_1fr]">
		<a href="/" class="press flex w-fit items-center rounded-md" aria-label="JPL Innovation home">
			<Logo animated class="[--logo-h:2.75rem] sm:[--logo-h:3.5rem]" />
		</a>
		<!-- Tablet and up: links in the middle -->
		<nav aria-label="Main" class="hidden md:block">
			<ul class="flex items-center">
				{
					links.map((l) => (
						<li>
							<a
								href={l.href}
								aria-current={l.href === current ? "page" : undefined}
								class="press relative inline-flex h-11 items-center px-3.5 text-[15px] font-medium text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:text-foreground after:absolute after:inset-x-3.5 after:bottom-2 after:h-[3px] after:rounded-full after:bg-primary dark:after:bg-accent after:opacity-0 aria-[current=page]:after:opacity-100"
							>
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="flex items-center justify-end gap-1 sm:gap-2">
			<SettingsPanel />
			<EmailButton look="glass" label={talk.label} subject={talk.subject} class="hidden sm:inline-flex" />
			<!-- Phones and small tablets: menu button -->
			<button
				type="button"
				data-menu-button
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label="Open menu"
				class="menu-button inline-flex size-11 items-center justify-center rounded-md text-foreground transition-colors hover:bg-secondary md:hidden"
			>
				<span class="menu-icon" aria-hidden="true"><span></span><span></span></span>
			</button>
		</div>
	</div>

	<!-- Phone menu panel. Closes on scroll, link tap, tap outside, Escape, or widening to desktop (script below). -->
	<nav
		id="mobile-menu"
		aria-label="Main"
		data-menu-panel
		inert
		class="menu-panel absolute inset-x-0 top-full border-b bg-background/95 backdrop-blur-xl md:hidden"
	>
		<ul class="wrapper flex flex-col py-2">
			{
				links.map((l, i) => (
					<li class="menu-item border-t first:border-t-0" style={`--i: ${i}`}>
						<a
							href={l.href}
							aria-current={l.href === current ? "page" : undefined}
							class="flex min-h-14 items-center justify-between text-lg font-semibold text-muted-foreground aria-[current=page]:text-foreground"
						>
							{l.label}
							{l.href === current && <span class="size-2 rounded-full bg-accent" aria-hidden="true" />}
						</a>
					</li>
				))
			}
			<li class="menu-item border-t py-4 sm:hidden" style={`--i: ${links.length}`}>
				<EmailButton look="glass" label={talk.label} subject={talk.subject} />
			</li>
		</ul>
	</nav>
</header>

<style>
	.site-header {
		transition:
			border-color 0.3s,
			background-color 0.3s;
	}

	/* Two bars that fold into an X when the menu is open. */
	.menu-icon {
		position: relative;
		display: block;
		width: 1.25rem;
		height: 0.75rem;
	}
	.menu-icon > span {
		position: absolute;
		left: 0;
		width: 100%;
		height: 2px;
		border-radius: 999px;
		background: currentColor;
		transition: transform 0.35s cubic-bezier(0.32, 0.72, 0, 1), top 0.35s cubic-bezier(0.32, 0.72, 0, 1);
	}
	.menu-icon > span:first-child {
		top: 0;
	}
	.menu-icon > span:last-child {
		top: calc(100% - 2px);
	}
	[data-menu-open] .menu-icon > span {
		top: calc(50% - 1px);
	}
	[data-menu-open] .menu-icon > span:first-child {
		transform: rotate(45deg);
	}
	[data-menu-open] .menu-icon > span:last-child {
		transform: rotate(-45deg);
	}

	/* Panel slides down; links follow one after another. */
	.menu-panel {
		visibility: hidden;
		opacity: 0;
		transform: translateY(-0.5rem);
		transition:
			opacity 0.3s cubic-bezier(0.32, 0.72, 0, 1),
			transform 0.3s cubic-bezier(0.32, 0.72, 0, 1),
			visibility 0s linear 0.3s;
	}
	[data-menu-open] .menu-panel {
		visibility: visible;
		opacity: 1;
		transform: none;
		transition-delay: 0s;
	}
	.menu-item {
		opacity: 0;
		transform: translateY(0.5rem);
		transition:
			opacity 0.35s cubic-bezier(0.32, 0.72, 0, 1),
			transform 0.35s cubic-bezier(0.32, 0.72, 0, 1);
	}
	[data-menu-open] .menu-item {
		opacity: 1;
		transform: none;
		transition-delay: calc(0.05s + var(--i) * 0.05s);
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.menu-icon > span,
		.menu-panel,
		.menu-item {
			transition: none;
		}
	}
</style>

<script>
	let cleanup: (() => void) | undefined;

	function init() {
		cleanup?.();
		const header = document.querySelector<HTMLElement>("[data-site-header]");
		if (!header) return;

		// Scroll edge: the header's bottom border only appears once content is scrolling underneath it.
		const edge = () => header.toggleAttribute("data-scrolled", scrollY > 4);
		edge();

		// Compact logo: the wordmark rolls away into the badge once the page has scrolled a little, and back at the top.
		const COMPACT = 48;
		const compact = () => header.toggleAttribute("data-compact", scrollY > COMPACT);
		compact();

		const button = header.querySelector<HTMLButtonElement>("[data-menu-button]")!;
		const panel = header.querySelector<HTMLElement>("[data-menu-panel]")!;
		const desktop = matchMedia("(min-width: 48rem)");
		let openedAt = 0;

		const isOpen = () => header.hasAttribute("data-menu-open");
		const setOpen = (open: boolean, returnFocus = false) => {
			header.toggleAttribute("data-menu-open", open);
			button.setAttribute("aria-expanded", String(open));
			button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
			panel.inert = !open;
			if (open) openedAt = scrollY;
			else if (returnFocus) button.focus();
		};

		const onScroll = () => {
			edge();
			compact();
			// Close as soon as the page actually scrolls (a little slack for touch jitter).
			if (isOpen() && Math.abs(scrollY - openedAt) > 8) setOpen(false);
		};
		const onPointerDown = (event: PointerEvent) => {
			if (isOpen() && !header.contains(event.target as Node)) setOpen(false);
		};
		const onKey = (event: KeyboardEvent) => {
			if (event.key === "Escape" && isOpen()) setOpen(false, true);
		};
		const onBreakpoint = () => desktop.matches && setOpen(false);

		button.addEventListener("click", () => setOpen(!isOpen()));
		panel.addEventListener("click", (event) => {
			if ((event.target as Element).closest("a")) setOpen(false);
		});
		addEventListener("scroll", onScroll, { passive: true });
		document.addEventListener("pointerdown", onPointerDown);
		document.addEventListener("keydown", onKey);
		desktop.addEventListener("change", onBreakpoint);

		cleanup = () => {
			removeEventListener("scroll", onScroll);
			document.removeEventListener("pointerdown", onPointerDown);
			document.removeEventListener("keydown", onKey);
			desktop.removeEventListener("change", onBreakpoint);
		};
	}

	// The header is re-rendered on every client-side navigation, so wire it up after each one.
	document.addEventListener("astro:page-load", init);
</script>
