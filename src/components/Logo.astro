---
/**
 * The JPL Innovation logo. The light theme uses a copy with navy "JPL" letters (scripts/make-logo-assets.mjs);
 * both are 480 px WebP copies (scripts/resize-images.mjs), 3x the largest size shown.
 * `loading="lazy"` means only the theme's visible logo downloads: the hidden one is display:none.
 */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={["inline-flex", className]} data-site-logo>
	<img src="/assets/jpl-logo-light-480.webp" alt="JPL Innovation" width="480" height="173" loading="lazy" decoding="async" class="h-full w-auto dark:hidden" />
	<img src="/assets/jpl-logo-dark-480.webp" alt="JPL Innovation" width="480" height="173" loading="lazy" decoding="async" class="hidden h-full w-auto dark:block" />
</span>
