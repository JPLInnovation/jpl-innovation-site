---
/**
 * JPL logo intro and opening page. The logo builds ("build, then boot"), the slogan comes in under it, and then:
 *   - a first visit on a computer that could run the 3D is asked 3D or Classic here (the buttons below);
 *   - later visits pause on the logo and slogan for a moment.
 * Then the logo flies into the header (Classic) or onto the logo on the 3D studio's wall (3D, home page).
 * Plays on every full page load or refresh of every page except the FRC and drone pages, which get their own intros
 * (src/lib/splash.ts decides). Not on in-site navigation.
 *
 *   Turn it off: remove the IntroSplash line in src/layouts/BaseLayout.astro.
 *   Logo:        src/assets/intro/jpl-logo.svg (generated by scripts/build-intro-svg.mjs from the traced logo)
 *   Animation:   src/scripts/intro-splash.ts; shared overlay/engine: SplashShell.astro, src/scripts/splash-core.ts
 */
import { BookOpen, Box, TriangleAlert } from "lucide-react";
import SplashShell from "./SplashShell.astro";
import logo from "@/assets/intro/jpl-logo.svg?raw";
import { experience, site } from "@/text/site";
---

<SplashShell kind="jpl">
	<div class="intro-gate">
		<div class="intro-logo" data-intro-logo>
			<div class="intro-parallax" data-intro-parallax set:html={logo} />
		</div>
		<p class="intro-slogan" data-intro-slogan id="intro-slogan">{site.slogan}</p>
		<!-- The question, on a first visit only (src/scripts/intro-splash.ts shows it). Words: src/text/site.ts (`experience`). -->
		<div class="intro-choice" data-intro-choice hidden>
			<p class="intro-choice-title" id="intro-choice-title">{experience.title}</p>
			<div class="intro-choice-cards">
				<button type="button" class="intro-card" data-intro-pick="3d">
					<span class="intro-card-icon" aria-hidden="true"><Box className="size-5" strokeWidth={1.75} /></span>
					<span class="intro-card-name">{experience.threeD.title}</span>
					<span class="intro-card-text">{experience.threeD.text}</span>
					<span class="intro-card-tag intro-card-warn"><TriangleAlert className="size-3.5" aria-hidden="true" /> {experience.threeD.warning}</span>
				</button>
				<button type="button" class="intro-card" data-intro-pick="classic">
					<span class="intro-card-icon" aria-hidden="true"><BookOpen className="size-5" strokeWidth={1.75} /></span>
					<span class="intro-card-name">{experience.classic.title}</span>
					<span class="intro-card-text">{experience.classic.text}</span>
					<span class="intro-card-tag intro-card-good">{experience.classic.note}</span>
				</button>
			</div>
		</div>
	</div>
</SplashShell>

<script>
	import "@/scripts/intro-splash";
</script>

<style is:global>
	/* The navbar logo waits for the splash logo to land on it. */
	html.splash-jpl:not(.splash-reduced) [data-site-header] [data-site-logo] {
		opacity: 0;
		animation: splash-reveal-failsafe 0.3s ease-out 5s forwards;
	}
	html.splash-live [data-site-header] [data-site-logo] {
		animation: none;
	}

	/* The opening page: the logo, the slogan under it and (first visit) the question, centred together. */
	.intro-gate {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: clamp(0.75rem, 2.2vh, 1.5rem);
		padding: 0 1rem;
	}
	.intro-slogan {
		margin: 0;
		color: rgb(255 255 255 / 0.88);
		font: 700 clamp(1.05rem, 2.4vw, 1.6rem) / 1.2 "Archivo Variable", ui-sans-serif, system-ui, sans-serif;
		font-stretch: 112%;
		letter-spacing: 0.01em;
		text-align: center;
	}
	html.splash:not(.splash-reduced) .intro-slogan {
		opacity: 0; /* brought in by the script */
	}
	.intro-choice {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		width: min(44rem, 100%);
		margin-top: 0.5rem;
		opacity: 0;
		transform: translateY(12px);
		transition:
			opacity 0.45s cubic-bezier(0.65, 0, 0.35, 1),
			transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
	}
	.intro-choice[hidden] {
		display: none;
	}
	.splash-overlay[data-asking] .intro-choice {
		opacity: 1;
		transform: none;
	}
	.splash-overlay[data-asking] {
		cursor: default;
	}
	.splash-overlay[data-asking] .splash-skip {
		display: none;
	}
	.intro-choice-title {
		margin: 0;
		color: rgb(255 255 255 / 0.7);
		font: 600 14px/1.3 "Archivo Variable", ui-sans-serif, system-ui, sans-serif;
	}
	.intro-choice-cards {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
		width: 100%;
	}
	.intro-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.45rem;
		padding: 1rem 1.1rem;
		border: 1px solid rgb(255 255 255 / 0.16);
		border-radius: 1rem;
		background: rgb(255 255 255 / 0.06);
		color: #fff;
		text-align: left;
		cursor: pointer;
		font-family: inherit;
		transition:
			border-color 0.2s,
			background-color 0.2s,
			transform 0.2s;
	}
	.intro-card:hover,
	.intro-card:focus-visible {
		border-color: #22d3ee;
		background: rgb(34 211 238 / 0.12);
		transform: translateY(-2px);
	}
	.intro-card:focus-visible {
		outline: 2px solid #22d3ee;
		outline-offset: 2px;
	}
	.intro-card-icon {
		display: inline-flex;
		width: 2.4rem;
		height: 2.4rem;
		align-items: center;
		justify-content: center;
		border-radius: 0.7rem;
		background: rgb(34 211 238 / 0.18);
	}
	.intro-card-name {
		font-weight: 800;
		font-stretch: 112%;
		font-size: 1.2rem;
		line-height: 1.1;
	}
	.intro-card-text {
		font-size: 0.9rem;
		line-height: 1.45;
		color: rgb(255 255 255 / 0.75);
	}
	.intro-card-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border-radius: 999px;
		padding: 0.2rem 0.6rem;
		font: 600 12px/1.4 ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
	}
	.intro-card-warn {
		background: rgb(251 191 36 / 0.18);
		color: #fcd34d;
	}
	.intro-card-good {
		background: rgb(74 222 128 / 0.16);
		color: #86efac;
	}
	@media (max-width: 560px) {
		.intro-choice-cards {
			grid-template-columns: 1fr;
		}
	}

	.intro-logo {
		width: min(760px, 86vw);
		transform-origin: 0 0;
		will-change: transform, opacity;
	}
	.intro-parallax {
		position: relative;
		will-change: transform;
	}
	/* The wrench's own layers (built by the script), stacked exactly over the logo. */
	.jl-wlayer {
		position: absolute;
		inset: 0;
		will-change: transform;
	}
	.intro-logo svg.jl-wrench-svg {
		position: absolute;
		inset: 0;
		height: 100%;
	}
	.intro-logo svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible; /* the wrench flies in from well outside the logo */
	}
	/* Parts start hidden and are brought in by the script. Reduced motion shows the finished logo at once. */
	html.splash:not(.splash-reduced) .jl-part {
		opacity: 0;
	}
	.jl-line,
	.jl-metal,
	#jl-screen-glow,
	#jl-jpl-ink,
	#jl-cursor,
	#jl-sweep {
		opacity: 0;
	}
	.jl-ring,
	.jl-line {
		stroke-dasharray: 1;
	}
	/* Transform origins, in the logo's own pixel coordinates (view-box) or per shape (fill-box). */
	.jl-logo #jl-badge-fill {
		transform-box: view-box;
		transform-origin: 610.9px 163.9px;
	}
	.jl-logo .jl-wave {
		transform-box: view-box;
		transform-origin: 610.5px 147.5px; /* wrench head centre */
	}
	.jl-logo .jl-letter,
	.jl-logo .jl-stand {
		transform-box: fill-box;
		transform-origin: 50% 100%;
	}
	.jl-logo #jl-sweep {
		transform-box: fill-box;
		transform-origin: 50% 50%;
		transform: skewX(-18deg);
	}
	@media (forced-colors: active) {
		html.splash [data-site-header] [data-site-logo] {
			opacity: 1;
		}
	}
</style>
