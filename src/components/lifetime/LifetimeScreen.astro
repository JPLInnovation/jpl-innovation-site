---
/**
 * Lifetime, on the 3D studio's software monitor (the "software" device, src/pages/index.astro): a slim tab bar across
 * the top switches between its pages (the app's own screens carry its sidebar, so the window has none of its own). Overview and Activity are the app's real screens (screenshots, and
 * said so); Server is the lab demo from the Lifetime page (LifetimeDay, in hand mode: the slider, the desks, the filters,
 * and "Play the day"). Words: src/text/studio.ts (`devices.software`).
 */
import { Activity, LayoutGrid, Server } from "lucide-react";
import LifetimeDay from "@/components/lifetime/LifetimeDay.astro";
import { devices } from "@/text/studio";

const t = devices.software;
const tabs = [
	{ id: "overview", label: t.tabs.overview, Icon: LayoutGrid },
	{ id: "activity", label: t.tabs.activity, Icon: Activity },
	{ id: "server", label: t.tabs.server, Icon: Server },
] as const;
---

<div class="lts" data-lts>
	<nav class="lts-bar" aria-label={t.tabsLabel}>
		<p class="lts-brand"><img src="/assets/lifetime.svg" alt="" width="28" height="21" /> Lifetime</p>
		<div class="lts-tabs" role="tablist">
			{
				tabs.map(({ id, label, Icon }, i) => (
					<button type="button" role="tab" id={`lts-tab-${id}`} aria-controls={`lts-${id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? "0" : "-1"} data-lts-tab={id}>
						<Icon className="size-4" strokeWidth={1.75} aria-hidden="true" />
						{label}
					</button>
				))
			}
		</div>
		<a href="/work/lifetime/" class="lts-page">{t.page}</a>
	</nav>
	<div class="lts-main">
		<section id="lts-overview" role="tabpanel" aria-labelledby="lts-tab-overview" class="lts-panel">
			<figure>
				<img src="/assets/lifetime/overview.webp" alt={t.overviewAlt} width="1280" height="800" loading="lazy" decoding="async" />
				<figcaption>{t.shotNote}</figcaption>
			</figure>
		</section>
		<section id="lts-activity" role="tabpanel" aria-labelledby="lts-tab-activity" class="lts-panel" hidden>
			<figure>
				<img src="/assets/lifetime/activity.webp" alt={t.activityAlt} width="1280" height="800" loading="lazy" decoding="async" />
				<figcaption>{t.shotNote}</figcaption>
			</figure>
		</section>
		<section id="lts-server" role="tabpanel" aria-labelledby="lts-tab-server" class="lts-panel lts-panel--demo" hidden>
			<LifetimeDay hand />
		</section>
	</div>
</div>

<style>
	.lts {
		display: grid;
		grid-template-rows: auto minmax(0, 1fr);
		min-height: 100%;
		background: #0b1530;
		color: #f2eedf;
	}
	.lts-bar {
		position: sticky;
		top: 0;
		z-index: 2;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
		padding: 0.6rem clamp(1rem, 2vw, 2rem);
		background: #0e1a3a;
		border-bottom: 1px solid rgb(242 238 223 / 0.1);
	}
	.lts-brand {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-weight: 750;
	}
	.lts-tabs {
		display: flex;
		gap: 0.25rem;
		padding: 0.25rem;
		border-radius: 999px;
		background: rgb(242 238 223 / 0.06);
	}
	.lts-tabs button {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.5rem;
		padding: 0 1rem;
		border-radius: 999px;
		color: rgb(242 238 223 / 0.78);
		font-weight: 600;
		transition:
			background-color 0.2s,
			color 0.2s;
	}
	.lts-tabs button:hover {
		color: #f2eedf;
	}
	.lts-tabs button[aria-selected="true"] {
		background: #f2eedf;
		color: #0a174e;
	}
	.lts-tabs button:focus-visible,
	.lts-page:focus-visible {
		outline: 2px solid #f5d042;
		outline-offset: 2px;
	}
	.lts-page {
		margin-left: auto;
		font-size: 0.875rem;
		color: rgb(242 238 223 / 0.78);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.lts-main {
		min-width: 0;
	}
	.lts-panel figure {
		margin: 0;
		padding: clamp(1rem, 2vw, 2rem);
	}
	.lts-panel img {
		display: block;
		width: 100%;
		max-width: 80rem;
		height: auto;
		margin-inline: auto;
		border-radius: 0.75rem;
	}
	.lts-panel figcaption {
		max-width: 80rem;
		margin: 0.6rem auto 0;
		font-size: 0.8125rem;
		color: rgb(242 238 223 / 0.7);
	}
	/* The demo brings its own page colours; it sits on the site's field. */
	.lts-panel--demo {
		background: var(--field);
		color: var(--ink);
		min-height: 100%;
	}
</style>

<script>
	// The tab bar: a click or the arrow keys pick a page (the ARIA tabs pattern).
	function init() {
		const root = document.querySelector<HTMLElement>("[data-lts]");
		if (!root) return;
		const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-lts-tab]")];
		const select = (tab: HTMLButtonElement, focus = false) => {
			for (const t of tabs) {
				const on = t === tab;
				t.setAttribute("aria-selected", String(on));
				t.tabIndex = on ? 0 : -1;
				root.querySelector<HTMLElement>(`#${t.getAttribute("aria-controls")}`)!.hidden = !on;
			}
			if (focus) tab.focus();
		};
		root.addEventListener("click", (event) => {
			const tab = (event.target as Element).closest<HTMLButtonElement>("[data-lts-tab]");
			if (tab) select(tab);
		});
		root.addEventListener("keydown", (event) => {
			const at = tabs.indexOf(event.target as HTMLButtonElement);
			if (at < 0) return;
			const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
			const to = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : step ? (at + step + tabs.length) % tabs.length : -1;
			if (to < 0) return;
			event.preventDefault();
			select(tabs[to], true);
		});
	}
	document.addEventListener("astro:page-load", init);
</script>
