		}
	}

	/* Tablets and phones: the story on top (clock and words beside the plan), the window under it. */
	@media (max-width: 1023px) {
		.ltd-fit {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			grid-template-rows: auto;
			gap: 0.6rem 1.25rem;
			grid-template-areas:
				"clock plan"
				"beats plan"
				"app app"
				"controls controls"
				"caption caption";
		}
		.ltd-plan-wrap {
			margin-top: 0;
		}
		.ltd-compare {
			display: none;
		}
		.ltd-controls {
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: end;
			margin-top: 0;
		}
	}
	@media (max-width: 639px) {
		.ltd-fit {
			grid-template-columns: minmax(0, 1fr) 46%;
			gap: 0.5rem 0.75rem;
		}
		.ltd-clock {
			font-size: clamp(2.4rem, 11vw, 3.4rem);
		}
		.ltd-beat,
		.ltd-queued {
			font-size: 0.875rem;
			line-height: 1.35;
		}
		.ltd-label {
			display: none;
		}
		.ltd-controls {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}
		.ltd-time {
			grid-template-columns: auto 1fr;
			align-items: center;
			gap: 0.75rem;
		}
		.ltd-time input {
			min-height: 2.25rem;
		}
		.ltd-switches {
			justify-content: space-between;
		}
		.ltd-seg button {
			min-height: 2.25rem;
			padding: 0 0.8rem;
		}
		.ltd-caption {
			font-size: 0.75rem;
			max-width: none;
		}
	}

	/* ---------- the window: Lifetime Server, in the product's own palette ---------- */
	.lt-app {
		--r: 12px;
		position: relative;
		color: var(--lt-text);
		font-size: clamp(11px, 0.55rem + 0.42cqi, 13.5px);
		line-height: 1.3;
		border-radius: 20px;
		overflow: hidden;
		box-shadow: 0 0 0 1px var(--lt-edge);
		background: var(--lt-bg);
		font-variant-numeric: tabular-nums;
	}
	.lt-app[data-theme="dark"] {
		--lt-bg: #0b1426;
		--lt-card: #12203a;
		--lt-card-a: rgb(18 32 58 / 0.72);
		--lt-text: #fff;
		--lt-muted: #9fb0cc;
		--lt-border: #22345a;
		--lt-pill: #223959;
		--lt-accent: #ffc93c;
		--lt-on-accent: #0b1426;
		--lt-track: #1b2a46;
		--lt-bar: #3a5688;
		--lt-good: #4cc38a;
		--lt-info: #7db4ff;
		--lt-danger: #ff8a8a;
		--lt-field: #0f1a30;
		--lt-edge: rgb(255 255 255 / 0.1);
		--lt-wash: rgb(255 255 255 / 0.11);
		--lt-wash-mid: rgb(255 255 255 / 0.03);
		--lt-amber: rgb(255 201 60 / 0.09);
		--lt-sky: #2353a0;
		--lt-sky-mid: #15306a;
		--lt-ember-mid: #3a3220;
		--lt-ember: #8a6516;
	}
	.lt-app[data-theme="light"] {
		--lt-bg: #f3f4f1;
		--lt-card: #fcfcfa;
		--lt-card-a: rgb(252 252 250 / 0.6);
		--lt-text: #252d2d;
		--lt-muted: #5f6b69;
		--lt-border: #d3d9d5;
		--lt-pill: #dde3eb;
		--lt-accent: #9a5b00;
		--lt-on-accent: #fff;
		--lt-track: #e1e6e1;
		--lt-bar: #b8c4d6;
		--lt-good: #2e8b57;
		--lt-info: #2b5da8;
		--lt-danger: #b3261e;
		--lt-field: #ecefea;
		--lt-edge: rgb(20 33 61 / 0.12);
		--lt-wash: rgb(255 255 255 / 0.7);
		--lt-wash-mid: rgb(255 255 255 / 0.22);
		--lt-amber: rgb(154 91 0 / 0.06);
		--lt-sky: #bfd3f2;
		--lt-sky-mid: #dde6f3;
		--lt-ember-mid: #f2ebda;
		--lt-ember: #f1d58c;
	}
	/* Glass: the product's blue-to-gold depth behind everything (its window_gradient). */
	.lt-app[data-style="glass"] {
		background: linear-gradient(
			in oklab 135deg,
			var(--lt-sky) 0%,
			var(--lt-sky-mid) 28%,
			var(--lt-bg) 55%,
			var(--lt-ember-mid) 80%,
			var(--lt-ember) 100%
		);
	}
	.lt-top {
		display: flex;
		align-items: center;
		gap: 0.9em;
		padding: 1.1em 1.4em 0.6em;
	}
	.lt-logo svg {
		width: 2.6em;
		height: 2.6em;
		display: block;
	}
	.lt-name {
		display: grid;
		min-width: 0;
	}
	.lt-appname {
		font-size: 1.35em;
		font-weight: 650;
		white-space: nowrap;
	}
	.lt-sub {
		color: var(--lt-muted);
		font-size: 0.9em;
	}
	.lt-name .lt-sub {
		white-space: nowrap;
	}
	.lt-nav {
		position: relative;
		margin-inline: auto;
		display: flex;
		padding: 0.25em;
		border-radius: 999px;
		background: rgb(0 0 0 / 0.22);
		box-shadow: inset 0 0 0 1px var(--lt-edge);
	}
	.lt-app[data-theme="light"] .lt-nav {
		background: rgb(20 33 61 / 0.06);
	}
	.lt-nav-item {
		padding: 0.55em 1.25em;
		border-radius: 999px;
		color: var(--lt-muted);
		white-space: nowrap;
	}
	.lt-nav-item.is-on {
		color: var(--lt-text);
		background: var(--lt-pill);
	}
	.lt-app[data-theme="dark"] .lt-nav-item.is-on {
		color: #fff0bf;
	}
	.lt-app[data-style="glass"] .lt-nav-item.is-on {
		background: linear-gradient(in oklab, rgb(255 255 255 / 0.24), rgb(160 190 240 / 0.09)), rgb(58 86 136 / 0.5);
		box-shadow:
			inset 0 0 0 1px rgb(255 255 255 / 0.22),
			inset 0 -2px 0 rgb(255 201 60 / 0.35);
	}
	.lt-app[data-style="glass"][data-theme="light"] .lt-nav-item.is-on {
		background: #fff;
		color: #6b3f00;
		box-shadow:
			inset 0 0 0 1px rgb(20 33 61 / 0.12),
			inset 0 -2px 0 rgb(154 91 0 / 0.3);
	}
	.lt-tools {
		display: flex;
		align-items: center;
		gap: 0.6em;
	}
	.lt-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4em;
		min-height: 2.6em;
		padding: 0 1.1em;
		border-radius: 9px;
		color: var(--lt-text);
		background: var(--lt-pill);
		box-shadow: inset 0 0 0 1px var(--lt-edge);
		white-space: nowrap;
		font-weight: 500;
	}
	.lt-app[data-style="glass"] .lt-btn {
		background: linear-gradient(in oklab, var(--lt-wash), var(--lt-wash-mid)), color-mix(in oklab, var(--lt-pill) 70%, transparent);
	}
	button.lt-btn:disabled {
		opacity: 0.45;
	}
	button.lt-btn:focus-visible,
	.lt-chip-btn:focus-visible,
	.lt-row-btn:focus-visible {
		outline: 2px solid var(--lt-accent);
		outline-offset: 2px;
	}
	.lt-round {
		min-width: 2.6em;
		padding: 0;
		border-radius: 999px;
		font-weight: 650;
		position: relative;
	}
	.lt-themebtn {
		color: var(--lt-accent);
	}
	.lt-ti {
		position: absolute;
		width: 1.25em;
		height: 1.25em;
		transition:
			opacity 0.25s,
			filter 0.25s,
			transform 0.25s;
	}
	.lt-app[data-theme="dark"] .lt-ti-sun,
	.lt-app[data-theme="light"] .lt-ti-moon {
		opacity: 0;
		filter: blur(4px);
		transform: scale(0.6);
	}
	.lt-status {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
	}
	.lt-status-words {
		display: grid;
		min-width: 9.5em;
	}
	.lt-run {
		color: var(--lt-good);
	}
	.lt-app.is-stopped .lt-run {
		color: var(--lt-danger);
	}
	.lt-dot {
		display: inline-block;
		width: 0.62em;
		height: 0.62em;
		border-radius: 50%;
		flex: none;
		background: var(--lt-muted);
	}
	.lt-dot.is-online {
		background: var(--lt-good);
	}
	.lt-dot.is-offline {
		background: var(--lt-accent);
	}
	.lt-dot.is-pending {
		background: var(--lt-info);
	}
	.lt-dot.is-down {
		background: var(--lt-danger);
	}
	.lt-body {
		padding: 0.6em 1.4em 1.4em;
		transition: opacity 0.4s;
	}
	.lt-app.is-stopped .lt-body {
		opacity: 0.55;
	}
	.lt-titlerow {
		display: flex;
		align-items: center;
		gap: 1em;
		margin-bottom: 0.9em;
	}
	.lt-title {
		font-size: 1.75em;
		font-weight: 650;
		display: flex;
		align-items: baseline;
		gap: 0.6em;
		white-space: nowrap;
	}
	.lt-title small {
		font-size: 0.5em;
		font-weight: 400;
		color: var(--lt-muted);
	}
	.lt-actions {
		margin-left: auto;
		display: flex;
		gap: 0.6em;
	}
	.lt-app[data-style] .lt-btn.lt-primary {
		background: var(--lt-accent);
		color: var(--lt-on-accent);
		font-weight: 650;
		box-shadow: none;
	}
	.lt-grid {
		display: grid;
		gap: 0.9em;
		grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(17.5em, 1.35fr);
		grid-template-areas:
			"strip strip strip strip gauge"
			"k1 k2 k3 k4 gauge"
			"chart chart chart chart details"
			"devices devices devices devices events";
		align-items: start;
	}
	/* Cards: Classic is a solid card with a hairline; Glass is the product's translucent panel (lit cap, amber lower
	   edge, a light rim). Neither throws a shadow. */
	.lt-card {
		position: relative;
		border-radius: var(--r);
		padding: 1.05em 1.15em;
		background: var(--lt-card);
		box-shadow: inset 0 0 0 1px var(--lt-border);
		min-width: 0;
	}
	.lt-app[data-style="glass"] .lt-card {
		background:
			linear-gradient(in oklab, transparent calc(100% - 1.8em), var(--lt-amber)),
			linear-gradient(in oklab, var(--lt-wash), var(--lt-wash-mid) 50%, transparent),
			var(--lt-card-a);
		box-shadow:
			inset 0 0 0 1px var(--lt-border),
			inset 1px 1px 0 1px rgb(255 255 255 / 0.07);
	}
	.lt-app[data-style="glass"][data-theme="light"] .lt-card {
		box-shadow:
			inset 0 0 0 1px rgb(20 33 61 / 0.1),
			inset 1px 1px 0 1px rgb(255 255 255 / 0.8);
	}
	.lt-card-title {
		font-size: 1.22em;
		font-weight: 650;
	}
	.lt-card-head {
		display: flex;
		align-items: center;
		gap: 0.8em;
		margin-bottom: 0.6em;
	}
	.lt-select,
	.lt-search {
		margin-left: auto;
		min-height: 2.4em;
		display: inline-flex;
		align-items: center;
		padding: 0 2.2em 0 0.8em;
		border-radius: 7px;
		background: var(--lt-field);
		box-shadow: inset 0 0 0 1px var(--lt-border);
		position: relative;
		white-space: nowrap;
	}
	.lt-select::after {
		content: "";
		position: absolute;
		right: 0.8em;
		top: 50%;
		border: 0.3em solid transparent;
		border-top-color: var(--lt-muted);
		margin-top: -0.1em;
	}
	.lt-search {
		color: var(--lt-muted);
		padding-right: 6em;
	}
	.lt-search + .lt-select {
		margin-left: 0;
	}
	/* the state strip: one bar of the four states, then a chip per state (click: which computers) */
	.lt-strip {
		grid-area: strip;
		display: grid;
		gap: 0.55em;
	}
	.lt-strip-bar {
		position: relative;
		height: 0.55em;
		border-radius: 999px;
		overflow: hidden;
		background: var(--lt-track);
	}
	.lt-strip-bar i {
		position: absolute;
		inset: 0;
		transform-origin: 0 50%;
		transform: scaleX(0);
		transition: transform 0.3s;
	}
	.lt-strip-bar .is-online {
		background: var(--lt-good);
	}
	.lt-strip-bar .is-offline {
		background: var(--lt-accent);
	}
	.lt-strip-bar .is-noreport {
		background: var(--lt-muted);
	}
	.lt-strip-bar .is-pending {
		background: var(--lt-info);
	}
	.lt-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}
	.lt-chip {
		--tone: var(--lt-muted);
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		min-height: 2em;
		padding: 0 0.75em 0 0.5em;
		border-radius: 999px;
		background: color-mix(in oklab, var(--tone) 15%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--tone) 60%, transparent);
		color: var(--lt-text);
		white-space: nowrap;
	}
	.lt-chip.is-online {
		--tone: var(--lt-good);
	}
	.lt-chip.is-offline {
		--tone: var(--lt-accent);
	}
	.lt-chip.is-pending {
		--tone: var(--lt-info);
	}
	.lt-chip-btn {
		min-height: 2.4em;
		cursor: pointer;
		transition: opacity 0.2s;
	}
	.lt-chip-btn.is-empty:not([aria-pressed="true"]) {
		opacity: 0.45;
	}
	.lt-chip-btn[aria-pressed="true"] {
		background: color-mix(in oklab, var(--tone) 34%, transparent);
	}
	.lt-glyph {
		width: 1em;
		height: 1em;
		fill: none;
		stroke: var(--tone);
		stroke-width: 2.4;
		stroke-linecap: round;
		stroke-linejoin: round;
		flex: none;
	}
	/* KPI cards */
	.lt-kpi {
		display: grid;
		align-content: start;
		gap: 0.15em;
		min-height: 9.2em;
	}
	.lt-kpi-icon {
		width: 1.9em;
		height: 1.9em;
		margin-bottom: 0.7em;
	}
	.lt-review {
		position: absolute;
		top: 1.2em;
		right: 1.15em;
		color: var(--lt-accent);
		font-weight: 650;
	}
	.lt-kpi-value {
		font-size: 1.95em;
		font-weight: 650;
		line-height: 1.1;
		white-space: nowrap;
	}
	.lt-kpi.is-alert .lt-kpi-value {
		color: var(--lt-accent);
	}
	.lt-kpi-label {
		font-size: 1.08em;
	}
	.lt-kpi-note {
		color: var(--lt-muted);
		font-size: 0.9em;
	}
	/* the gauge: 31 ticks in a half ring */
	.lt-gauge {
		grid-area: gauge;
		align-self: stretch;
		display: grid;
		align-content: space-between;
		text-align: center;
	}
	.lt-gauge .lt-card-title {
		text-align: left;
	}
	.lt-gauge-svg {
		width: 100%;
		max-width: 17em;
		margin: 0.4em auto 0;
		display: block;
	}
	.lt-gauge-svg line {
		stroke: var(--lt-border);
		stroke-width: 6;
		stroke-linecap: round;
		transition: stroke 0.25s;
	}
	.lt-gauge-svg line.is-lit {
		stroke: var(--lt-accent);
	}
	.lt-gauge-num {
		fill: var(--lt-text);
		font-size: 42px;
		font-weight: 300;
	}
	.lt-gauge-note {
		color: var(--lt-muted);
		font-size: 0.9em;
	}
	/* the daily chart */
	.lt-chart {
		grid-area: chart;
	}
	.lt-plot {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.6em;
		height: 11em;
		margin: 0.2em 0 0.4em;
	}
	.lt-axis {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		color: var(--lt-muted);
		font-size: 0.9em;
		text-align: right;
		padding-bottom: 1.7em;
		margin-top: -0.5em;
	}
	.lt-bars {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		background: repeating-linear-gradient(to bottom, var(--lt-border) 0 1px, transparent 1px 25%) top / 100% calc(100% - 1.7em) no-repeat;
		border-bottom: 0;
	}
	.lt-col {
		display: grid;
		grid-template-rows: 1fr 1.7em;
		justify-items: center;
		min-width: 0;
	}
	.lt-barbox {
		position: relative;
		width: min(3.2em, 52%);
		height: 100%;
		border-bottom: 1px solid var(--lt-border);
	}
	.lt-bar {
		position: absolute;
		inset: 0;
		border-radius: 6px 6px 0 0;
		background: var(--lt-bar);
		transform-origin: 50% 100%;
	}
	.lt-bar.is-today {
		background: var(--lt-accent);
	}
	.lt-missing {
		position: absolute;
		left: 50%;
		bottom: 0.3em;
		width: 0.7em;
		height: 2px;
		margin-left: -0.35em;
		background: var(--lt-muted);
		border-radius: 1px;
	}
	.lt-day {
		color: var(--lt-muted);
		font-size: 0.92em;
		align-self: end;
		white-space: nowrap;
	}
	.lt-note {
		color: var(--lt-muted);
		font-size: 0.88em;
	}
	/* device details */
	.lt-details {
		grid-area: details;
		display: grid;
		gap: 0.15em;
		align-self: stretch;
		align-content: start;
	}
	.lt-det-name {
		margin-top: 0.5em;
		font-weight: 650;
		font-size: 1.1em;
	}
	.lt-det-value {
		font-size: 1.9em;
		font-weight: 650;
		margin-top: 0.3em;
	}
	.lt-open {
		margin-top: 0.7em;
		justify-self: end;
		color: var(--lt-muted);
	}
	/* the device list */
	.lt-devices {
		grid-area: devices;
	}
	.lt-rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.lt-row {
		margin: 0;
	}
	.lt-row-btn,
	.lt-head {
		width: 100%;
		display: grid;
		grid-template-columns: 7.6em 5.4em 10.5em 6.4em minmax(0, 1fr);
		align-items: center;
		gap: 0.6em;
		text-align: left;
		padding: 0.45em 0.6em;
		border-radius: 8px;
		min-height: 2.75em;
	}
	.lt-head {
		color: var(--lt-muted);
		font-size: 0.86em;
		min-height: 0;
		padding-bottom: 0.35em;
		border-bottom: 1px solid var(--lt-border);
		border-radius: 0;
	}
	.lt-row + .lt-row .lt-row-btn {
		box-shadow: 0 -1px 0 var(--lt-border);
	}
	.lt-row-btn {
		cursor: pointer;
		color: var(--lt-text);
	}
	.lt-row-btn:hover {
		background: color-mix(in oklab, var(--lt-text) 5%, transparent);
	}
	.lt-row.is-selected .lt-row-btn {
		background: color-mix(in oklab, var(--lt-accent) 14%, transparent);
		box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--lt-accent) 55%, transparent);
	}
	.lt-cell {
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.lt-awake {
		text-align: right;
	}
	.lt-tl {
		position: relative;
		display: block;
		height: 0.9em;
		border-radius: 3px;
		background: var(--lt-track);
		overflow: hidden;
	}
	.lt-seg {
		position: absolute;
		top: 0;
		bottom: 0;
	}
	.lt-tl .is-online {
		background: var(--lt-good);
	}
	.lt-tl .is-offline {
		background: color-mix(in oklab, var(--lt-accent) 32%, transparent);
	}
	.lt-tl .is-unknown {
		background: var(--lt-bg);
		box-shadow: inset 0 0 0 1px var(--lt-muted);
		border-radius: 2px;
	}
	.lt-tl-cover {
		position: absolute;
		inset: 0;
		background: var(--lt-track);
		transform-origin: 100% 50%;
	}
	.lt-pager {
