<script>
	import { afterIntro } from "@/lib/splash";

	const LIVE_GATE = 300; // ms: the loading gate shows only if the 3D isn't up by then
	let cleanup: (() => void) | undefined;

	function initChapter() {
		cleanup?.();
		cleanup = undefined;
		const root = document.querySelector<HTMLElement>("[data-dch]");
		if (!root) return;
		const cleanups: Array<() => void> = [];
		cleanup = () => cleanups.forEach((c) => c());

		// The live local time in Ho Chi Minh City, in both modes.
		const clocks = [...root.querySelectorAll<HTMLTimeElement>("[data-dch-clock]")];
		const formats = clocks.map(
			(c) => new Intl.DateTimeFormat("en-GB", { timeZone: c.dataset.dchClock, hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false }),
		);
		const tick = () => {
			const now = new Date();
			clocks.forEach((c, i) => {
				c.textContent = formats[i].format(now);
				c.dateTime = now.toISOString();
			});
		};
		tick();
		const clock = window.setInterval(tick, 1000);
		cleanups.push(() => clearInterval(clock));
		if (root.hasAttribute("data-read")) return;

		const stops = JSON.parse(root.dataset.stops!) as string[];
		const titles = JSON.parse(root.dataset.titles!) as string[];
		const last = stops.length - 1;
		const track = root.querySelector<HTMLElement>(".dch-track")!;
		const pin = root.querySelector<HTMLElement>(".dch-pin")!;
		const stage = root.querySelector<HTMLElement>("[data-dch-stage]")!;
		const canvas = stage.querySelector("canvas")!;
		const panels = [...root.querySelectorAll<HTMLElement>(".dch-panel")];
		const beatLinks = [...root.querySelectorAll<HTMLAnchorElement>("[data-beat]")];
		const tickLinks = [...root.querySelectorAll<HTMLAnchorElement>(".dch-ticks a")];
		const count = root.querySelector<HTMLElement>("[data-dch-count]")!;
		const live = root.querySelector<HTMLElement>("[data-dch-live]")!;
		const gate = root.querySelector<HTMLElement>("[data-dch-gate]")!;
		const capture = root.hasAttribute("data-capture");

		// Offsets, measured on resize only: each stop is one screen of scroll from the top of the track.
		let screenH = 1;
		let top = 0;
		const measure = () => {
			screenH = pin.offsetHeight || innerHeight;
			top = track.getBoundingClientRect().top + scrollY;
		};
		measure();
		const resize = new ResizeObserver(measure);
		resize.observe(document.documentElement);
		cleanups.push(() => resize.disconnect());
		const position = () => (scrollY - top) / screenH;
		const goTo = (stop: number, smooth = true) =>
			scrollTo({ top: top + Math.max(0, Math.min(last, stop)) * screenH, behavior: smooth ? "smooth" : "instant" });

		// Keyboard: arrows and Page Up/Down move one stop while the chapter is on screen; past either end the page scrolls on.
		const onKey = (event: KeyboardEvent) => {
			if (root.hasAttribute("data-read") || event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) return;
			const target = event.target as HTMLElement;
			if (target.closest?.("input, textarea, select, [contenteditable], dialog")) return;
			const forward = ["ArrowDown", "ArrowRight", "PageDown"].includes(event.key);
			const back = ["ArrowUp", "ArrowLeft", "PageUp"].includes(event.key);
			if (!forward && !back) return;
			const p = position();
			if (p < -0.5 || p > last + 0.25) return;
			const next = Math.round(p) + (forward ? 1 : -1);
			if (next < 0 || next > last) return;
			event.preventDefault();
			goTo(next);
		};
		addEventListener("keydown", onKey);
		cleanups.push(() => removeEventListener("keydown", onKey));
		// The map's links (and the skip link, which the browser handles itself).
		const onClick = (event: MouseEvent) => {
			const el = (event.target as Element).closest<HTMLElement>("[data-goto]");
			if (!el || root.hasAttribute("data-read")) return;
			event.preventDefault();
			goTo(Number(el.dataset.goto));
		};
		root.addEventListener("click", onClick);
		cleanups.push(() => root.removeEventListener("click", onClick));
		// A link inside a stop's words gets focus (Tab): bring the camera to that stop.
		const onFocus = (event: FocusEvent) => {
			const panel = (event.target as Element).closest<HTMLElement>(".dch-panel");
			if (!panel || root.hasAttribute("data-read")) return;
			const stop = Number(panel.dataset.stop);
			if (Math.abs(position() - stop) > 0.3) goTo(stop, false);
		};
		root.addEventListener("focusin", onFocus);
		cleanups.push(() => root.removeEventListener("focusin", onFocus));

		// The backdrop follows the camera too: how much of each beat's layer shows, the dusk's swing, the scrim.
		const clamp01 = (x: number) => Math.max(0, Math.min(1, x));
		const round = (x: number) => Math.round(x * 100) / 100;
		const layers = {
			city: root.querySelector<HTMLElement>(".dch-bd-city")!,
			dusk: root.querySelector<HTMLElement>(".dch-bd-dusk")!,
			video: root.querySelector<HTMLElement>(".dch-bd-skyline")!,
			streaks: root.querySelector<HTMLElement>(".dch-bd-streaks")!,
		};
		const shown: Record<string, number> = {};
		let scrims = { base: 0.7, prologue: 0, stakes: 0, reveal: 0, video: 0 };
		const set = (name: string, value: number) => {
			const v = round(value);
			if (shown[name] === v) return;
			shown[name] = v;
			pin.style.setProperty(`--bd-${name}`, String(v));
		};
		const backdrop = (at: number) => {
			const city = clamp01(1 - at * 0.8);
			const streaks = clamp01(1 - Math.abs(at - 1) * 1.6);
			const dusk = clamp01(1 - Math.abs(at - 2) * 1.05);
			const video = clamp01(1 - Math.abs(at - (stops.length - 1)) * 1.6);
			set("city", city);
			set("streaks", streaks);
			set("push", clamp01(at));
			set("dusk", dusk);
			set("swing", Math.max(-1, Math.min(1, at - 2)));
			set("video", video);
			set("scrim", scrims.base + scrims.prologue * city + scrims.stakes * streaks + scrims.reveal * dusk + scrims.video * video);
			for (const [name, value] of [["city", city], ["dusk", dusk], ["video", video], ["streaks", streaks]] as const) layers[name].toggleAttribute("data-off", value <= 0.005);
			pin.toggleAttribute("data-city-on", city > 0.005);
		};
		backdrop(0);

		// The words, the HUD's counter, the map and the announcement follow the camera.
		const levels = new Float32Array(panels.length).fill(-1);
		let shownStop = -1;
		let announceTimer: number | undefined;
		const beatNames = beatLinks.map((a) => `${a.querySelector(".dch-map-n")!.textContent} / ${String(beatLinks.length).padStart(2, "0")}: ${a.querySelector(".dch-map-title")!.textContent}`);
		const onFrame = (at: number) => {
			panels.forEach((panel, i) => {
				const d = Math.abs(at - i);
				const on = Math.round(Math.max(0, Math.min(1, (0.42 - d) / 0.22)) * 100) / 100;
				if (on === levels[i]) return;
				levels[i] = on;
				panel.style.setProperty("--on", String(on));
				panel.toggleAttribute("data-shown", on > 0.5);
			});
			root.style.setProperty("--w-stakes", String(Math.round(Math.max(0, 1 - Math.abs(at - 1) * 2.2) * 100) / 100));
			backdrop(at);
			root.style.setProperty("--past", String(Math.round(Math.min(1, Math.max(0, at * 2)) * 100) / 100));
			const current = Math.max(0, Math.min(last, Math.round(at)));
			if (current === shownStop) return;
			shownStop = current;
			const beat = Math.min(current, 3);
			count.textContent = String(beat + 1).padStart(2, "0");
			beatLinks.forEach((a, b) => (b === beat ? a.setAttribute("aria-current", "step") : a.removeAttribute("aria-current")));
			tickLinks.forEach((a, k) => (k === current - 3 ? a.setAttribute("aria-current", "step") : a.removeAttribute("aria-current")));
			// Told to screen readers once the camera has settled, not for every stop it passes on a long move.
			window.clearTimeout(announceTimer);
			announceTimer = window.setTimeout(() => {
				live.textContent = current >= 3 && titles[current] ? `${beatNames[beat]}, ${titles[current]}` : beatNames[beat];
			}, 600);
		};
		cleanups.push(() => window.clearTimeout(announceTimer));

		// The loading gate: a real percentage of the model's bytes, only if it takes a moment.
		const total = Number(root.dataset.cadBytes) || 0;
		let stopProgress: (() => void) | undefined;
		const gateTimer = window.setTimeout(() => {
			if (root.hasAttribute("data-live") || root.hasAttribute("data-read") || capture) return;
			gate.hidden = false;
			const bar = gate.querySelector<HTMLElement>("[data-dch-bar]")!;
			const percent = gate.querySelector<HTMLElement>("[data-dch-percent]")!;
			import("@/lib/three/models/drone").then(({ onCadProgress }) => {
				stopProgress = onCadProgress((received) => {
					const p = total ? Math.min(100, Math.round((received / total) * 100)) : 0;
					percent.textContent = String(p);
					bar.setAttribute("aria-valuenow", String(p));
					bar.style.setProperty("--p", String(p));
				});
			});
		}, LIVE_GATE);
		const closeGate = () => {
			window.clearTimeout(gateTimer);
			stopProgress?.();
			if (gate.hidden) return;
			gate.setAttribute("data-leaving", "");
			window.setTimeout(() => {
				gate.hidden = true;
				gate.removeAttribute("data-leaving");
			}, 600);
		};
		cleanups.push(closeGate);

		let cancelled = false;
		let dispose: (() => void) | undefined;
		/** The plain page, for any reason the 3D cannot carry on (no WebGL, too slow, the GPU lost, an error). */
		const toRead = (why: string) => {
			if (cancelled || root.hasAttribute("data-read")) return;
			console.warn(`Drone chapter: switching to the plain page (${why}).`);
			closeGate();
			root.setAttribute("data-read", "");
			root.removeAttribute("data-live");
			root.classList.remove("dark");
			dispose?.();
			dispose = undefined;
			scrollTo({ top: 0, behavior: "instant" }); // the tall track is gone; start the ordinary page at its top
		};
		cleanups.push(() => {
			cancelled = true;
			dispose?.();
			dispose = undefined;
		});

		type Hook = { go(n: number | null): void; capture(): string };
		const w = window as unknown as { __showcase?: Hook };
		let hook: Hook | undefined;
		Promise.all([import("@/lib/three/stage"), import("@/lib/three/models/drone-chapter"), afterIntro()])
			.then(async ([stageModule, chapterModule]) => {
				if (cancelled || root.hasAttribute("data-read")) return;
				if (chapterModule.STOPS.join() !== stops.join()) console.warn("Drone chapter: the page's stops and the camera's differ.", stops, chapterModule.STOPS);
				// The look's CSS intensities, from the same config as the 3D's.
				const look = chapterModule.LOOK;
				pin.style.setProperty("--look-glow", String(look.glow));
				pin.style.setProperty("--look-vignette", String(look.vignette));
				pin.style.setProperty("--look-grain", String(look.grain));
				const b = look.backdrop;
				const values = {
					city: b.prologue.cityOpacity,
					"far-drift": `${b.prologue.farDrift}s`,
					"near-drift": `${b.prologue.nearDrift}s`,
					streaks: b.stakes.streaksOpacity,
					grow: b.stakes.streaksGrow,
					dusk: b.reveal.duskOpacity,
					parallax: b.reveal.parallax,
					skyline: b["video-link"].skylineOpacity,
				};
				for (const [name, value] of Object.entries(values)) pin.style.setProperty(`--look-${name}`, String(value));
				scrims = { base: look.scrim, prologue: b.prologue.scrim, stakes: b.stakes.scrim, reveal: b.reveal.scrim, video: b["video-link"].scrim };
				delete shown.scrim;
				backdrop(position());
				dispose = await stageModule.mountStage(
					stage,
					canvas,
					async (ctx) => {
						const model = await chapterModule.default(ctx, {
							position,
							onStop: () => undefined,
							onFrame,
							titles,
							measureLabel: root.dataset.measure ?? "",
							capture,
						});
						// ?showcase=capture: held back until the stage is up, then offered per part (below).
						if (capture) {
							hook = w.__showcase;
							delete w.__showcase;
						}
						return model;
					},
					{ camera: [-0.6, 0.1, -0.9], target: [0, 0, 0], fov: 36, near: 0.02, orbit: false, effects: capture, pixelRatio: 1.5, onFallback: (reason) => toRead(reason) },
				);
				if (cancelled || root.hasAttribute("data-read")) {
					dispose();
					dispose = undefined;
					return;
				}
				root.setAttribute("data-live", "");
				closeGate();
				// The backdrop's images: beat 1's now, the rest a moment later.
				pin.setAttribute("data-images", "first");
				const more = window.setTimeout(() => pin.setAttribute("data-images", "all"), 1200);
				cleanups.push(() => clearTimeout(more));
				// A link to a stop (/work/drone/#motors) lands on it, on arrival and when the address changes to one.
				const toHash = () => {
					const hashed = stops.indexOf(decodeURIComponent(location.hash.slice(1)));
					if (hashed > 0) goTo(hashed, false);
				};
				toHash();
				addEventListener("hashchange", toHash);
				cleanups.push(() => removeEventListener("hashchange", toHash));
				// ?showcase=capture: part n is stop 3 + n (scripts/showcase-stills.py counts the parts only).
				const held = hook;
				if (capture && held) w.__showcase = { ...held, go: (n) => held.go(n === null ? null : n + 3) };
			})
			.catch((error) => {
				console.warn("Drone chapter: the 3D could not start.", error);
				toRead("error");
			});
	}

	document.addEventListener("astro:page-load", initChapter);
	document.addEventListener("astro:before-swap", () => {
		cleanup?.();
		cleanup = undefined;
	});
</script>
