---
/**
 * The drone chapter, beats 1 to 4: one pinned, full-window 3D stage that the page's own scroll moves the camera through
 * (src/lib/three/models/drone-chapter.ts), with each beat's words as real HTML over it. Nothing scrolls past: the stage
 * stays put for about nine and a half screens of scroll, then lets go into the rest of the page.
 *
 *   01 Prologue   the drone in the dark, a silhouette against the rim light; the HUD and the problem
 *   02 Stakes     the camera pushes in to the lens: 720p at 60 fps (or 1080p at 30 fps), the camera's
 *   03 Reveal     the lights come up: the name, the status, the credits
 *   04 Anatomy    the part-by-part stops (450 mm, then the parts), the rest of the drone fading back
 *
 * Every stop is one screen of native scroll (nothing is hijacked); the camera follows through the showcase's damped
 * spring. Keyboard: arrows and Page Up/Down move one stop while the chapter is on screen; "Skip the chapter" goes past
 * it. The chapter map at the side has a dot per beat and a tick per part-by-part stop.
 *
 * Classic (data-read, decided before the first paint): the same words as one ordinary page in the same order, the
 * first three beats on a still dark gradient, the parts as cards with pictures of the real model
 * (public/showcase/drone/, scripts/showcase-stills.py). Used on phones (under 768 px), with reduced motion, without
 * WebGL, when Classic is chosen, and when the 3D gives up (too slow, a lost GPU, an error, or not up within 30 s).
 *
 * All the words: src/text/projects/drone.ts (droneChapter, drone, dronePage, roadmap) and src/text/showcase/drone.ts.
 * Dev: ?showcase=capture shows the drone alone for scripts/showcase-stills.py (window.__showcase.go(n) = part n).
 */
// @ts-ignore: the project has no Node type definitions; this only runs at build time, in Node.
import { existsSync, statSync } from "node:fs";
import { getEntry } from "astro:content";
import BackLink from "@/components/BackLink.astro";
import BeatLabel from "@/components/BeatLabel.astro";
import StatusTag from "@/components/StatusTag.astro";
import { buttonVariants } from "@/components/ui/button";
import { DataIcon } from "@/lib/icons";
import { drone, droneChapter as chapter, dronePage as text, roadmap } from "@/text/projects/drone";
import { droneShowcase as parts } from "@/text/showcase/drone";
import { backToWork } from "@/text/work";

const team = await Promise.all(
	drone.team.map(async (t) => ({ role: t.role, member: "member" in t ? await getEntry("members", t.member) : null })),
);
const beats = chapter.beats;
const [first, ...rest] = parts.features;
/** The stops in order (the camera's, src/lib/three/models/drone-chapter.ts STOPS): beats 1 to 3, then the parts. */
const stops = ["prologue", "stakes", "reveal", ...parts.features.map((f) => f.id)];
/** The small label in the 3D view on each stop: none on beats 1 to 3. */
const titles = ["", "", "", ...parts.features.map((f) => f.title)];
const beatList = [beats.prologue, beats.stakes, beats.reveal, beats.anatomy];
const now = roadmap.findIndex((s) => s.state === "current");
const step = now >= 0 ? `${chapter.hud.stepLabel} ${now + 1} ${chapter.hud.ofLabel} ${roadmap.length} · ${roadmap[now].title}` : "";
// The model's size, for the loading gate's real percentage (the bytes as served).
const cadBytes = statSync("src/lib/three/models/f450-cad.bin").size;
/** Classic's picture of a stop, from the real model (scripts/showcase-stills.py), when there is one. */
const still = (id: string) =>
	existsSync(`public/showcase/drone/${id}-800.webp`)
		? { src: `/showcase/drone/${id}-800.webp`, srcset: `/showcase/drone/${id}-800.webp 800w, /showcase/drone/${id}.webp 1600w` }
		: undefined;
const overviewStill = still("overview");
---

<div class="dch showcase" data-dch data-read data-cad-bytes={cadBytes} data-stops={JSON.stringify(stops)} data-titles={JSON.stringify(titles)} data-measure={chapter.anatomy.measure} style={`--stops: ${stops.length}`}>
	<script is:inline data-astro-rerun>
		// Before the first paint: the 3D chapter unless Classic was chosen, the window is under 768 px, motion is reduced
		// or there is no WebGL. In 3D the whole chapter has the dark theme's colours, in both themes.
		(() => {
			const el = document.currentScript.parentElement;
			const root = document.documentElement;
			const capture = new URLSearchParams(location.search).get("showcase") === "capture";
			const read =
				!capture &&
				(root.classList.contains("read-mode") ||
					root.classList.contains("reduce-motion") ||
					matchMedia("(max-width: 767px), (prefers-reduced-motion: reduce)").matches);
			if (read) return;
			const gl = document.createElement("canvas").getContext("webgl2") || document.createElement("canvas").getContext("webgl");
			if (!gl) return;
			gl.getExtension("WEBGL_lose_context")?.loseContext();
			el.removeAttribute("data-read");
			el.classList.add("dark");
			if (capture) el.setAttribute("data-capture", "");
			// Failsafe: if the 3D is not up within 30 s (scripts blocked, a very slow device), the plain page instead.
			setTimeout(() => {
				if (el.isConnected && !el.hasAttribute("data-live") && !el.hasAttribute("data-read")) {
					el.setAttribute("data-read", "");
					el.classList.remove("dark");
					console.warn("Drone chapter: the 3D did not start in time, showing the plain page.");
				}
			}, 30000);
		})();
	</script>
	<a class="dch-skip" href="#after-chapter">{chapter.skip}</a>

	<div class="dch-track">
		<div class="dch-pin">
			<!-- The backdrop, a layer per beat (public/chapter/drone/, scripts/drone-backdrops.mjs); the script fades each in
			     with the camera. -->
			<div class="dch-bg" aria-hidden="true">
				<div class="dch-bd dch-bd-city"><div class="dch-drift dch-drift-far"></div><div class="dch-drift dch-drift-near"></div></div>
				<div class="dch-bd dch-bd-dusk"><span style="--depth: 0"></span><span style="--depth: 0.6"></span><span style="--depth: 1.2"></span><span style="--depth: 2"></span><span style="--depth: 3"></span></div>
				<div class="dch-bd dch-bd-skyline"></div>
				<div class="dch-bd dch-bd-streaks"></div>
			</div>
			<div class="dch-stage" data-dch-stage>
				<canvas role="img" aria-label={parts.modelLabel}></canvas>
			</div>
			<div class="dch-veil" aria-hidden="true"></div>
			<div class="dch-frame" aria-hidden="true">
				<span class="dch-corner dch-tl"></span><span class="dch-corner dch-tr"></span><span class="dch-corner dch-bl"></span><span class="dch-corner dch-br"></span>
			</div>
			<div class="dch-frame dch-aim" aria-hidden="true">
				<svg class="dch-cross" viewBox="-20 -20 40 40"><path d="M0-20v12M0 8v12M-20 0h12M8 0h12" fill="none" stroke="currentColor" stroke-width="1.6"></path><circle r="11" fill="none" stroke="currentColor" stroke-width="1" opacity="0.6"></circle></svg>
			</div>

			<!-- The HUD: the drone's real state only (from src/text/projects/drone.ts). -->
			<div class="dch-hud" aria-hidden="true">
				<p class="dch-hud-left">
					<span class="dch-hud-state"><span class="dch-hud-dot"></span>{chapter.hud.state}</span>
					{step && <span class="dch-hud-step">{step}</span>}
				</p>
				<p class="dch-hud-right">
					<span>{chapter.hud.city} <time class="dch-hud-time" data-dch-clock={chapter.hud.timeZone}>--:--:--</time></span>
					<span class="dch-hud-count"><span data-dch-count>01</span> / {beatList.length.toString().padStart(2, "0")}</span>
				</p>
			</div>

			<nav class="dch-map" aria-label={chapter.mapLabel}>
				<ol>
					{
						beatList.map((beat, b) => (
							<li>
								<a href={`#${stops[b]}`} data-goto={b} data-beat={b}>
									<span class="dch-map-dot" aria-hidden="true" />
									<span class="dch-map-n">{beat.number}</span>
									<span class="dch-map-title">{beat.title}</span>
								</a>
								{b === 3 && (
									<ol class="dch-ticks">
										{parts.features.map((f, i) => (
											<li>
												<a href={`#${f.id}`} data-goto={3 + i} aria-label={`${beat.number} ${beat.title}: ${f.title}`}>
													<span class="dch-map-title" aria-hidden="true">{f.title}</span>
												</a>
											</li>
										))}
									</ol>
								)}
							</li>
						))
					}
				</ol>
			</nav>

			<div class="dch-gate" data-dch-gate hidden>
				<p class="dch-gate-label">{chapter.loading}</p>
				<div class="dch-gate-bar" role="progressbar" aria-label={chapter.loading} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-dch-bar>
					<span></span>
				</div>
				<p class="dch-gate-n" aria-hidden="true"><span data-dch-percent>0</span>%</p>
			</div>

			<div class="dch-panels">
				<!-- Beats 1 to 3: dark in both modes (Classic: a still gradient). -->
				<div class="dch-band dark">
					<div class="dch-back wrapper"><BackLink href="/work/">{backToWork}</BackLink></div>

					<!-- 01 Prologue -->
					<section id="prologue" class="dch-panel" data-stop="0" aria-labelledby="prologue-label">
						<BeatLabel id="prologue-label" beat={beats.prologue} />
						<p class="dch-classic-hud">
							<span class="dch-hud-state"><span class="dch-hud-dot" aria-hidden="true"></span>{chapter.hud.state}</span>
							{step && <span>{step}</span>}
							<span>
								<span aria-hidden="true">{chapter.hud.city}</span>
								<span class="sr-only">{chapter.hud.timeLabel} {chapter.hud.city}:</span>
								<time class="dch-hud-time" data-dch-clock={chapter.hud.timeZone}>--:--:--</time>
							</span>
						</p>
						<p class="dch-statement font-wide">{chapter.prologue.problem}</p>
					</section>

					<!-- 02 The stakes: the camera's modes, and the 4G link said on its own (no frame rate for the stream) -->
					<section id="stakes" class="dch-panel" data-stop="1" aria-labelledby="stakes-label">
						<BeatLabel id="stakes-label" beat={beats.stakes} />
						<p class="dch-stat-label">{chapter.stakes.label}</p>
						<p class="dch-stat font-wide"><span>{chapter.stakes.value}</span> <span class="dch-stat-unit">{chapter.stakes.unit}</span></p>
						<p class="dch-stat-secondary font-wide">{chapter.stakes.secondary}</p>
						<p class="dch-stat-source">{chapter.stakes.source}</p>
						<p class="dch-aside">{chapter.stakes.link}</p>
					</section>

					<!-- 03 The reveal: the name, status and credits -->
					<header id="reveal" class="dch-panel dch-reveal" data-stop="2" aria-labelledby="reveal-label">
						<BeatLabel id="reveal-label" beat={beats.reveal} />
						<div><StatusTag>{drone.status}</StatusTag></div>
						<h1 class="font-wide"><span class="dch-kicker">{chapter.reveal.kicker}</span> {drone.name}</h1>
						<p class="dch-intro">{drone.intro}</p>
						<dl class="dch-facts">
							{
								drone.facts.map((f) => (
									<div>
										<dt>
											<DataIcon name={f.icon} className="size-4" />
											{f.label}
										</dt>
										<dd>{f.value}</dd>
									</div>
								))
							}
						</dl>
						<ul class="dch-team">
							{
								team.map((t) => (
									<li>
										{t.role}
										{t.member && (
											<>
												{" — "}
												<a href={`/members/${t.member.id}/`}>{t.member.data.title}</a>
											</>
										)}
									</li>
								))
							}
						</ul>
						<!-- data-astro-reload: the guide, the 3D layout and Camera POV are standalone pages. -->
						<div class="dch-actions">
							<a href={text.buildGuide.href} data-astro-reload class={buttonVariants({ variant: "signal", size: "lg" })}>{text.buildGuide.label}</a>
							<a href={text.layout3d.href} data-astro-reload class={buttonVariants({ variant: "outline", size: "lg" })}>{text.layout3d.label}</a>
							<a href={text.cameraPov.href} data-astro-reload class={buttonVariants({ variant: "outline", size: "lg" })}>{text.cameraPov.label}</a>
						</div>
						<p class="dch-note">{text.buildGuide.note}</p>
						<p class="dch-legend">
							<span><span class="dch-swatch bg-alliance-red" aria-hidden="true"></span>{text.model3d.frontArms}</span>
							<span><span class="dch-swatch bg-muted-foreground" aria-hidden="true"></span>{text.model3d.rearArms}</span>
							<span>{text.model3d.layoutNote}</span>
						</p>
						{
							overviewStill && (
								<img class="dch-still" transition:name="project-drone" src={overviewStill.src} srcset={overviewStill.srcset} sizes="(min-width: 48rem) 40rem, 100vw" alt={text.model3d.description} width="1600" height="1200" loading="lazy" />
							)
						}
					</header>
				</div>

				<!-- 04 Anatomy: 450 mm, then the parts (Classic: cards with pictures of the real model) -->
				<div class="dch-parts">
					<section id={first.id} class="dch-panel showcase-feature" data-stop="3" aria-labelledby="anatomy-label">
						<BeatLabel id="anatomy-label" beat={beats.anatomy} />
						<p class="dch-stat dch-stat-small font-wide"><span>{chapter.anatomy.value}</span> <span class="dch-stat-unit">{chapter.anatomy.label}</span></p>
						<h2 class="dch-parts-heading font-wide">{parts.heading}</h2>
						<p class="dch-parts-intro">{parts.intro}</p>
						<h3 class="dch-part-title font-semiwide">{first.title}</h3>
						<p>{first.text}</p>
						<dl class="dch-part-facts">
							{first.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
						</dl>
						{(() => { const s = still(first.id); return s && <img class="dch-still" src={s.src} srcset={s.srcset} sizes="(min-width: 48rem) 36rem, 100vw" alt={parts.modelLabel} width="1600" height="1200" loading="lazy" />; })()}
					</section>
					{
						rest.map((f, i) => {
							const s = still(f.id);
							return (
								<section id={f.id} class="dch-panel showcase-feature" data-stop={4 + i} aria-labelledby={`part-${f.id}`}>
									<h3 id={`part-${f.id}`} class="dch-part-title font-semiwide">{f.title}</h3>
									<p>{f.text}</p>
									<dl class="dch-part-facts">
										{f.facts.map((x) => <div><dt>{x.label}</dt><dd>{x.value}</dd></div>)}
									</dl>
									{s && <img class="dch-still" src={s.src} srcset={s.srcset} sizes="(min-width: 48rem) 36rem, 100vw" alt={parts.modelLabel} width="1600" height="1200" loading="lazy" />}
								</section>
							);
						})
					}
				</div>
			</div>
		</div>
	</div>
	<p class="sr-only" aria-live="polite" data-dch-live></p>
</div>
<div id="after-chapter" class="dch-after" tabindex="-1"></div>

<style is:global>
	/* ---------- Both modes ---------- */
	.dch .chapter-label {
		font: 600 0.8rem/1.3 ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.dch .chapter-label-n {
		color: var(--foreground);
		margin-right: 0.6em;
	}
	.dch-panel {
		color: var(--foreground);
		scroll-margin-top: 5rem;
	}
	.dch-hud-state {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
	}
	.dch-hud-dot {
		width: 0.55em;
		height: 0.55em;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 8px color-mix(in oklab, var(--accent) 80%, transparent);
	}
	.dch-hud-time {
		display: inline-block;
		min-width: 8ch;
		color: var(--foreground);
		font-variant-numeric: tabular-nums;
	}
	.dch-statement {
		max-width: 16ch;
		font-weight: 860;
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 1.02;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}
	.dch-stat-label {
		font: 600 0.85rem/1.3 ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.dch-stat {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 0.3em;
		font-weight: 900;
		font-size: clamp(4rem, 15vw, 9rem);
		line-height: 0.86;
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
	}
	.dch-stat > span:first-child {
		white-space: nowrap;
	}
	.dch-stat-small {
		font-size: clamp(2.75rem, 8vw, 5rem);
	}
	.dch-stat-unit {
		font-size: 0.32em;
		font-weight: 760;
		letter-spacing: 0;
		color: var(--muted-foreground);
	}
	.dch-stat-secondary {
		font-size: clamp(1.4rem, 3vw, 2.25rem);
		font-weight: 780;
		color: var(--muted-foreground);
	}
	.dch-stat-source,
	.dch-aside {
		max-width: 46ch;
		font-size: 1.125rem;
	}
	.dch-stat-source {
		color: var(--muted-foreground);
	}
	.dch-reveal h1 {
		font-size: clamp(2.8rem, 8vw, 6.25rem);
		font-weight: 900;
		line-height: 0.94;
	}
	.dch-kicker {
		display: block;
		margin-bottom: 0.15em;
		font-size: 0.36em;
		font-weight: 720;
		color: var(--muted-foreground);
	}
	.dch-intro {
		max-width: 56ch;
		font-size: 1.125rem;
	}
	.dch-facts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem 1.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}
	@media (min-width: 40rem) {
		.dch-facts {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.dch-facts dt {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		font-size: 0.875rem;
		color: var(--muted-foreground);
	}
	.dch-facts dd {
		font-weight: 600;
	}
	.dch-team {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		font-size: 0.875rem;
		color: var(--muted-foreground);
	}
	.dch-team a {
		font-weight: 500;
		color: var(--foreground);
	}
	.dch-team a:hover {
		text-decoration: underline;
	}
	.dch-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
	}
	.dch-note,
	.dch-legend {
		max-width: 48ch;
		font-size: 0.875rem;
		color: var(--muted-foreground);
	}
	.dch-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
	}
	.dch-legend > span {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.dch-swatch {
		width: 1.25rem;
		height: 0.375rem;
		border-radius: 999px;
	}
	.dch-parts-heading {
		font-size: clamp(2rem, 4.5vw, 3.25rem);
		font-weight: 850;
	}
	.dch-parts-intro {
		max-width: 56ch;
		font-size: 1.125rem;
		color: var(--muted-foreground);
	}
	.dch-part-title {
		font-size: 1.5rem;
		font-weight: 780;
	}
	.dch-part-facts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem 1.5rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--border);
	}
	.dch-part-facts dt {
		font-size: 0.8rem;
		color: var(--muted-foreground);
	}
	.dch-part-facts dd {
		font-weight: 600;
	}
	.dch-skip {
		position: absolute;
		left: 1rem;
		z-index: 60;
		translate: 0 -200%;
		padding: 0.6rem 1rem;
		border-radius: 999px;
		background: var(--primary);
		color: var(--primary-foreground);
		font-weight: 600;
	}
	.dch-skip:focus-visible {
		translate: 0 0.5rem;
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}

	/* ---------- Classic: an ordinary page, in the same order ---------- */
	.dch[data-read] :is(.dch-bg, .dch-stage, .dch-veil, .dch-frame, .dch-hud, .dch-map, .dch-gate) {
		display: none;
	}
	.dch[data-read] .dch-band {
		padding-bottom: 10rem;
		/* The still gradient: the 3D's colours, fading into the page. */
		background:
			linear-gradient(to bottom, rgb(3 10 16 / 0.35), rgb(3 10 16 / 0.6) 60%, #030a10 calc(100% - 10rem), transparent),
			url("/chapter/drone/classic.webp") center 35% / cover no-repeat,
			#071822;
	}
	.dch[data-read] .dch-back {
		padding-top: 1.5rem;
	}
	.dch[data-read] .dch-panel {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		width: 100%;
		max-width: 76rem;
		margin-inline: auto;
		padding: 2.5rem clamp(1rem, 4vw, 2.5rem);
	}
	.dch-classic-hud {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		padding-block: 0.75rem;
		border-block: 1px solid var(--border);
		font: 500 0.85rem/1.4 ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
