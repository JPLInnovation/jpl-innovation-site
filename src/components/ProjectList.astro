---
import type { CollectionEntry } from "astro:content";
import { ArrowRight } from "lucide-react";
import StatusTag from "./StatusTag.astro";
import { srcset } from "@/lib/images";
import { projectCard } from "@/text/work";

interface Props {
	projects: CollectionEntry<"work">[];
	/** h2 when the list is the page's main content, h3 under a section heading. */
	headingLevel?: "h2" | "h3";
}

const { projects, headingLevel: Heading = "h3" } = Astro.props;
---

<ul class="flex flex-col">
	{
		projects.map((p, i) => {
			const href = `/work/${p.id}/`;
			return (
				<li data-reveal class="grid gap-5 border-t py-8 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-10 md:py-10">
					<a
						href={href}
						tabindex="-1"
						aria-hidden="true"
						data-parallax
						class="press group block overflow-hidden rounded-xl bg-muted"
					>
						<img
							src={p.data.img}
							srcset={srcset(p.data.img)}
							sizes="(min-width: 1216px) 475px, (min-width: 768px) 40vw, 100vw"
							alt=""
							transition:name={p.id === "frc" ? undefined : `project-${p.id}`}
							loading={i === 0 ? "eager" : "lazy"}
							class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
						/>
					</a>
					<div class="flex flex-col items-start gap-3 md:pt-2">
						{p.data.badge && <StatusTag>{p.data.badge}</StatusTag>}
						<Heading class="font-semiwide text-2xl font-[780] md:text-[2rem]">
							<a href={href} class="hover:underline decoration-primary dark:decoration-accent decoration-[3px] underline-offset-[6px]">
								{p.data.title}
							</a>
						</Heading>
						<p class="max-w-[58ch] text-muted-foreground">{p.data.description}</p>
						<a
							href={href}
							class="press mt-1 inline-flex min-h-11 items-center gap-2 font-semibold transition-[gap,transform] hover:gap-3"
						>
							{projectCard.readMore} {p.data.title}
							<ArrowRight className="size-4" aria-hidden="true" />
						</a>
					</div>
				</li>
			);
		})
	}
</ul>
