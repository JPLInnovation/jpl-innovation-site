---
/**
 * The projects as a ruled list of sheets: each one's picture, name, words and status, one link each. Used where the
 * projects are listed outside the Work page's register (the classic home).
 *
 *   <ProjectList projects={await getProjects()} />                 names as h3 (under a section heading)
 *   <ProjectList projects={…} headingLevel="h2" />                 names as h2 (the list is the page's main content)
 */
import type { CollectionEntry } from "astro:content";
import { ArrowRight } from "lucide-react";
import StatusTag from "./StatusTag.astro";
import { srcset } from "@/lib/images";
import { projectCard, register } from "@/text/work";

interface Props {
	projects: CollectionEntry<"work">[];
	/** h2 when the list is the page's main content, h3 under a section heading. */
	headingLevel?: "h2" | "h3";
}

const { projects, headingLevel: Heading = "h3" } = Astro.props;
---

<ul class="project-list">
	{
		projects.map((p, i) => {
			const href = `/work/${p.id}/`;
			const picture = register.rows[p.id]?.picture ?? { src: p.data.img, fit: "cover" };
			return (
				<li class="project-list__row">
					<a href={href} tabindex="-1" aria-hidden="true" class="project-list__plate" data-fit={picture.fit}>
						<img
							src={picture.src}
							srcset={srcset(picture.src)}
							sizes="(min-width: 1216px) 475px, (min-width: 768px) 40vw, 100vw"
							alt=""
							transition:name={p.id === "frc" ? undefined : `project-${p.id}`}
							loading={i === 0 ? "eager" : "lazy"}
							decoding="async"
						/>
					</a>
					<div class="project-list__words">
						<Heading class="project-list__name">
							<a href={href} data-astro-prefetch="viewport">
								{p.data.title}
							</a>
						</Heading>
						<p class="project-list__text">{p.data.description}</p>
						<p class="project-list__meta">
							{p.data.badge && <StatusTag>{p.data.badge}</StatusTag>}
							<a href={href} class="project-list__go">
								{projectCard.readMore} {p.data.title}
								<ArrowRight className="project-list__arrow" strokeWidth={2} aria-hidden="true" />
							</a>
						</p>
					</div>
				</li>
			);
		})
	}
</ul>

<style>
	.project-list__row {
		display: grid;
		gap: 1.25rem;
		padding-block: 2rem;
		border-top: 1px solid var(--sheet-edge);
	}
	@media (min-width: 768px) {
		.project-list__row {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: 2.5rem;
			padding-block: 2.5rem;
		}
	}
	.project-list__plate {
		display: block;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		border-radius: 1rem;
		background: var(--sheet);
	}
	.project-list__plate img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.project-list__plate[data-fit="contain"] img {
		object-fit: contain;
		padding: 5%;
	}
	.project-list__row:hover .project-list__plate img {
		transform: scale(1.04);
	}
	.project-list__words {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.8rem;
	}
	.project-list__name {
		font-size: clamp(1.6rem, 1.1rem + 1.8vw, 2.5rem);
		font-stretch: 125%;
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.03em;
	}
	.project-list__name a:hover {
		text-decoration: underline;
		text-decoration-color: var(--accent-brand);
		text-decoration-thickness: 3px;
		text-underline-offset: 6px;
	}
	.project-list__text {
		max-width: 58ch;
		color: var(--ink-soft);
		text-wrap: pretty;
	}
	.project-list__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.75rem;
	}
	.project-list__go {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		gap: 0.5rem;
		font-weight: 650;
	}
	.project-list__go :global(.project-list__arrow) {
		width: 1.1em;
		height: 1.1em;
		transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.project-list__go:hover :global(.project-list__arrow) {
		transform: translateX(0.3rem);
	}
</style>
