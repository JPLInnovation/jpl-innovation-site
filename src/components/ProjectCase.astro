---
/**
 * The case at the top of a project page (the spec: "every project page opens with its case"), laid out as a drawing's
 * notes: the problem, its headline decoding into place; the obvious alternatives, struck out by a pen line like
 * rejected options; our answer on the page's one glass sheet, in living colour, with what it gets you as a ruled
 * list; and the partner who takes it to people, when there is one. Each part's name sits in the sheet's margin, beside
 * its words, not above them. The words: src/text/projects/hooks.ts. Renders nothing for a project without a case.
 *
 *   <ProjectCase project="cybersecurity" />
 */
import { ArrowUpRight } from "lucide-react";
import DecodeHeading from "./work/DecodeHeading.astro";
import { caseLabels, hooks } from "@/text/projects/hooks";

interface Props {
	/** The project's id (the file name in src/text/projects/). */
	project: string;
}
const story = hooks[Astro.props.project];
const id = `case-${Astro.props.project}`;
---

{
	story && (
		<section class="case wrapper" aria-labelledby={`${id}-problem`}>
			<div class="case__zone">
				<p class="case__margin">{caseLabels.problem}</p>
				<div class="case__body">
					<DecodeHeading id={`${id}-problem`} class="case__headline" text={story.problem.title} />
					<p class="case__text">{story.problem.text}</p>
				</div>
			</div>

			<div class="case__zone">
				<p class="case__margin">{caseLabels.alternatives}</p>
				<ul class="case__body case__options">
					{story.alternatives.map((a) => (
						<li>
							<span class="case-struck">{a.option}</span>
							<span class="case__catch">{a.catch}</span>
						</li>
					))}
				</ul>
			</div>

			<div class="case__answer sheet lens" aria-labelledby={`${id}-answer`}>
				<div class="case__zone">
					<p class="case__margin">{caseLabels.answer}</p>
					<div class="case__body">
						<h2 id={`${id}-answer`} class="case__headline living">
							{story.answer.title}
						</h2>
						<p class="case__text">{story.answer.text}</p>
					</div>
				</div>
				<div class="case__zone">
					<p class="case__margin">{caseLabels.pros}</p>
					<ul class="case__body case__pros">
						{story.pros.map((p) => (
							<li class="case-pro">
								<h3>{p.title}</h3>
								<p>{p.text}</p>
							</li>
						))}
					</ul>
				</div>
				{story.partner && (
					<div class="case__zone case__partner">
						<p class="case__margin">
							{caseLabels.partner}
							<br />
							<span>{story.partner.role}</span>
						</p>
						<div class="case__body">
							<p class="case__partner-name">{story.partner.name}</p>
							<p class="case__text">{story.partner.text}</p>
							<a href={story.partner.href} target="_blank" rel="noopener" class="case__partner-link">
								{story.partner.link} <ArrowUpRight className="size-[1.1em]" strokeWidth={2} aria-hidden="true" />
							</a>
						</div>
					</div>
				)}
			</div>
		</section>
	)
}

<style>
	.case {
		display: flex;
		flex-direction: column;
		gap: clamp(3.5rem, 2rem + 5vw, 7rem);
		padding-block: clamp(4rem, 2rem + 6vw, 8rem);
	}
	/* A zone of the sheet: its name in the margin, its words beside it. */
	.case__zone {
		display: grid;
		gap: 1rem;
	}
	@media (min-width: 900px) {
		.case__zone {
			grid-template-columns: 12rem minmax(0, 1fr);
			gap: 2.5rem;
		}
	}
	.case__margin {
		font-size: var(--step-small);
		font-weight: 650;
		line-height: 1.35;
		color: var(--ink-soft);
		padding-top: 0.9rem;
		border-top: 1px solid var(--sheet-edge);
	}
	.case__margin span {
		font-weight: 500;
	}
	.case__body {
		min-width: 0;
	}
	.case :global(.case__headline) {
		max-width: 18ch;
		font-size: var(--step-head);
		font-stretch: 125%;
		font-weight: 800;
		line-height: 0.98;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}
	.case__text {
		max-width: 56ch;
		margin-top: 1.25rem;
		font-size: var(--step-lead);
		line-height: 1.4;
		text-wrap: pretty;
	}

	/* The rejected options: big, struck through by a pen line that draws across as it comes into view. */
	.case__options li {
		display: grid;
		gap: 0.4rem;
		padding-block: 1.1rem 1.4rem;
		border-top: 1px solid var(--sheet-edge);
	}
	.case__options li:first-child {
		border-top: 0;
		padding-top: 0.5rem;
	}
	@media (min-width: 900px) {
		.case__options li {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
			gap: 2.5rem;
			align-items: baseline;
		}
	}
	/* struck through on every line it wraps to, in the accent, like a rejected option on a drawing */
	.case-struck {
		width: fit-content;
		text-decoration: line-through;
		text-decoration-color: var(--accent-brand);
		text-decoration-thickness: 0.1em;
		font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.85rem);
		font-stretch: 112%;
		font-weight: 700;
		line-height: 1.15;
		color: var(--ink-soft);
		text-wrap: balance;
	}
	.case__catch {
		max-width: 48ch;
		color: var(--ink);
		text-wrap: pretty;
	}

	/* Our answer: the page's one glass sheet. Concentric corners: 2rem outside, its contents square. */
	.case__answer {
		display: flex;
		flex-direction: column;
		gap: clamp(3rem, 2rem + 3vw, 5rem);
		padding: clamp(1.5rem, 0.5rem + 4vw, 4rem);
		border-radius: 2rem;
	}
	.case__answer .case__margin {
		color: var(--ink);
	}
	/* What it gets you: a ruled list, like the notes column of a drawing. */
	.case__pros {
		display: grid;
	}
	@media (min-width: 640px) {
		.case__pros {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: 2.5rem;
		}
	}
	.case-pro {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding-block: 1rem 1.35rem;
		border-top: 1px solid var(--sheet-edge);
	}
	.case-pro h3 {
		font-size: 1.15rem;
		font-stretch: 112%;
		font-weight: 720;
		line-height: 1.2;
	}
	.case-pro p {
		color: var(--ink-soft);
		text-wrap: pretty;
	}
	.case__partner-name {
		font-size: clamp(2.2rem, 1.2rem + 4vw, 4.5rem);
		font-stretch: 125%;
		font-weight: 850;
		line-height: 0.9;
		letter-spacing: -0.03em;
	}
	.case__partner-link {
		display: inline-flex;
		min-height: 48px;
		align-items: center;
		gap: 0.45rem;
		margin-top: 1.5rem;
		padding-inline: 1.4rem;
		border-radius: 999px;
		font-weight: 650;
		background: var(--ink);
		color: var(--field);
		transition: transform 0.2s;
	}
	.case__partner-link:hover {
		transform: translateY(-2px);
	}
</style>
