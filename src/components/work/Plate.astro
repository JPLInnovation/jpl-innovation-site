---
/**
 * A plate (the spec's section 5): a big picture that opens from its frame to the whole width as it scrolls into view,
 * and lights up from darkness as if the studio lights came on. Transform and opacity only. Chrome and Safari 26 let
 * the scroll drive it (CSS scroll-driven animation, nothing on the main thread); elsewhere a tiny script plays it once
 * when it comes into view. Without script, or with reduced motion, it is simply open and lit.
 *
 * Put it outside .wrapper: it spans its container, and starts framed to about the wrapper's width.
 *
 *   <Plate src="/showcase/drone/overview.webp" alt="…" />                            a picture (cover, 21:9)
 *   <Plate src=… alt=… srcset=… sizes=… ratio="16/9" fit="contain" caption="…" />    the options
 *   <Plate ratio="16/9" label="…"><ModelViewer client:visible … /></Plate>           anything: a 3D view, an SVG
 */
interface Props {
	src?: string;
	alt?: string;
	srcset?: string;
	sizes?: string;
	/** The frame's shape, as a CSS aspect-ratio ("21/9", "16/9", "4/3"). */
	ratio?: string;
	/** cover (crop to fill) or contain (the whole picture, on the plate's ground). */
	fit?: "cover" | "contain";
	caption?: string;
	loading?: "lazy" | "eager";
	/** Astro's view-transition name for the picture (a project's picture flying from the Work page). */
	transitionName?: string;
	class?: string;
}
const { src, alt = "", srcset, sizes = "100vw", ratio = "21/9", fit = "cover", caption, loading = "lazy", transitionName, class: className } = Astro.props;
---

<figure class:list={["plate", className]} data-plate style={`--plate-ratio: ${ratio}; --plate-fit: ${fit}`}>
	<div class="plate__frame">
		{src ? <img src={src} srcset={srcset} sizes={sizes} alt={alt} loading={loading} decoding="async" transition:name={transitionName} /> : <slot />}
		<div class="plate__dark" aria-hidden="true"></div>
	</div>
	{caption && <figcaption class="plate__caption wrapper">{caption}</figcaption>}
</figure>

<style is:global>
	.plate {
		--plate-from: 0.94;
		margin: 0;
	}
	@media (min-width: 768px) {
		.plate {
			--plate-from: 0.9;
		}
	}
	@media (min-width: 1280px) {
		.plate {
			--plate-from: 0.82;
		}
	}
	.plate__frame {
		position: relative;
		overflow: hidden;
		aspect-ratio: var(--plate-ratio);
		border-radius: 1.25rem;
		background: var(--sheet);
		transform-origin: 50% 40%;
	}
	.plate__frame > img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: var(--plate-fit);
	}
	.plate__dark {
		position: absolute;
		inset: 0;
		background: #030820;
		opacity: 0;
		pointer-events: none;
	}
	.plate__caption {
		padding-top: 1rem;
		font-size: var(--step-small);
		color: var(--ink-soft);
		text-wrap: pretty;
	}

	/* Framed and dark until it opens: only when motion is on (html.motion, set before paint by BaseLayout). */
	html.motion:not(.reduce-motion) .plate__frame {
		transform: scale(var(--plate-from));
	}
	html.motion:not(.reduce-motion) .plate__dark {
		opacity: 0.92;
	}
	html.motion:not(.reduce-motion) .plate[data-open] .plate__frame {
		transform: none;
		transition: transform 1.3s cubic-bezier(0.65, 0, 0.35, 1);
	}
	html.motion:not(.reduce-motion) .plate[data-open] .plate__dark {
		opacity: 0;
		transition: opacity 1.6s cubic-bezier(0.3, 0, 0.2, 1) 0.15s;
	}
	@supports (animation-timeline: view()) {
		html.motion:not(.reduce-motion) .plate .plate__frame {
			animation: plate-open linear both;
			animation-timeline: view();
			animation-range: entry 0% cover 48%;
		}
		html.motion:not(.reduce-motion) .plate .plate__dark {
			animation: plate-light linear both;
			animation-timeline: view();
			animation-range: entry 25% cover 50%;
		}
	}
	@keyframes plate-open {
		from {
			transform: scale(var(--plate-from));
		}
		to {
			transform: none;
		}
	}
	@keyframes plate-light {
		from {
			opacity: 0.92;
		}
		to {
			opacity: 0;
		}
	}
</style>

<script>
	// Only where the scroll can't drive it: open each plate once, when a quarter of it is in view.
	let observer: IntersectionObserver | undefined;
	function init() {
		observer?.disconnect();
		if (CSS.supports("animation-timeline: view()")) return;
		observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.setAttribute("data-open", "");
					observer!.unobserve(entry.target);
				}
			},
			{ threshold: 0.25 },
		);
		document.querySelectorAll("[data-plate]:not([data-open])").forEach((el) => observer!.observe(el));
	}
	document.addEventListener("astro:page-load", init);
</script>
