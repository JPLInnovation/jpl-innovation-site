---
/**
 * Contact section at the bottom of every page (id="contact", linked from the nav).
 * Words: src/text/site.ts (`contact`). The band uses fixed blues (not theme variables) so its
 * white text keeps AA contrast (≥ 6.7:1) in both light and dark mode.
 */
import ContactDialog from "./contact-dialog";
import { contact, site } from "@/text/site";
---

<section id="contact" class="contact-band relative isolate overflow-hidden text-white" aria-labelledby="contact-heading">
	<div class="wrapper flex flex-col gap-8 py-16 md:flex-row md:items-end md:justify-between md:py-24">
		<div class="flex max-w-2xl flex-col gap-3" data-reveal>
			<h2 id="contact-heading" class="font-wide text-[clamp(1.9rem,4vw,3rem)] font-[850]">{contact.heading}</h2>
			<p class="text-lg text-white/90">
				{contact.before}
				<a
					href={`mailto:${site.email}`}
					class="font-semibold text-white underline decoration-white/60 decoration-2 underline-offset-4 transition-[text-decoration-color] hover:decoration-white"
					>{site.email}</a
				>{contact.after}
			</p>
		</div>
		<ContactDialog
			client:visible
			label={contact.button}
			look="inverse"
			subject={contact.subject}
			className="shrink-0"
		/>
	</div>
</section>

<style>
	.contact-band {
		background: linear-gradient(120deg, #0b3fb8 0%, #1d4ed8 45%, #6d28d9 100%);
	}
	/* A slow sheen across the band; off for reduced motion. */
	.contact-band::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(60% 120% at 85% 0%, rgb(34 211 238 / 0.28), transparent 60%);
		animation: contact-sheen 14s ease-in-out infinite alternate;
	}
	@keyframes contact-sheen {
		to {
			transform: translateX(-18%);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.contact-band::before {
			animation: none;
		}
	}
</style>
