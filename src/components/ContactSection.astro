---
/**
 * Contact section at the bottom of every page (id="contact", linked from the nav).
 * Words: src/text/site.ts (`contact`). The band is always graphite (--hero-field, the same on both themes), so its
 * white text keeps 18:1 and the cyan button 9:1 in light and dark mode. A drafting grid runs behind it, and a cyan
 * rule draws across the top as it comes into view.
 */
import ContactDialog from "./contact-dialog";
import { contact, site } from "@/text/site";
---

<section id="contact" class="contact-band relative isolate overflow-hidden bg-hero-field text-white" aria-labelledby="contact-heading">
	<span aria-hidden="true" data-draw data-draw-duration="1.2" class="absolute inset-x-0 top-0 h-[3px] bg-accent"></span>
	<div class="wrapper grid gap-10 py-20 md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:py-28">
		<div class="flex max-w-3xl flex-col gap-5" data-reveal>
			<h2 id="contact-heading" class="font-wide text-[clamp(2.2rem,5vw,4rem)] font-[850] leading-[0.98]">{contact.heading}</h2>
			<p class="max-w-[52ch] text-lg text-white/80">
				{contact.before}
				<a
					href={`mailto:${site.email}`}
					class="spec font-medium text-white underline decoration-accent decoration-2 underline-offset-4 transition-[text-decoration-color] hover:decoration-white"
					>{site.email}</a
				>{contact.after}
			</p>
		</div>
		<ContactDialog
			client:visible
			label={contact.button}
			look="inverse"
			subject={contact.subject}
			className="shrink-0"
		/>
	</div>
</section>

<style>
	.contact-band::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image:
			linear-gradient(rgb(255 255 255 / 0.045) 1px, transparent 1px),
			linear-gradient(90deg, rgb(255 255 255 / 0.045) 1px, transparent 1px);
		background-size: 32px 32px;
		-webkit-mask-image: linear-gradient(100deg, transparent 20%, #000 75%);
		mask-image: linear-gradient(100deg, transparent 20%, #000 75%);
	}
</style>
