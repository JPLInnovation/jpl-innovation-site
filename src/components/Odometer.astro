---
/**
 * A number whose digits roll up into place on page load, like a mechanical counter.
 * Screen readers get the plain number; without motion the digits simply sit in place.
 */
interface Props {
	value: string;
	class?: string;
}
const { value, class: className } = Astro.props;
const digits = [...value];
---

<span class:list={["odometer", className]}>
	<span class="sr-only">{value}</span>
	{
		digits.map((d, i) =>
			/\d/.test(d) ? (
				<span class="odo-window" aria-hidden="true">
					<span class="odo-strip" style={`--digit: ${d}; --i: ${i}`} />
				</span>
			) : (
				<span aria-hidden="true">{d}</span>
			),
		)
	}
</span>

<style>
	.odometer {
		display: inline-flex;
		font-variant-numeric: tabular-nums;
	}
	.odo-window {
		display: inline-block;
		height: 1em;
		/* A little room so descending strokes aren't clipped. */
		line-height: 1;
		overflow: hidden;
	}
	.odo-strip {
		display: block;
		transform: translateY(calc((var(--digit) + 10) * -1em));
	}
	/* Two turns of the wheel (0–9 twice, one per line), so every digit spins a full turn before landing.
	   Generated content keeps these 20 digits out of the page's text (search engines, copy-paste);
	   the space after each \A ends the escape, so "\A 1" is a line break then 1. */
	.odo-strip::before {
		content: "0\A 1\A 2\A 3\A 4\A 5\A 6\A 7\A 8\A 9\A 0\A 1\A 2\A 3\A 4\A 5\A 6\A 7\A 8\A 9";
		white-space: pre;
	}
	/* Only rolls when motion is allowed (the `motion` class is set in BaseLayout). */
	:global(.motion) .odo-strip {
		animation: roll 1.6s cubic-bezier(0.16, 1, 0.3, 1) both;
		animation-delay: calc(var(--i) * 90ms + 150ms);
	}
	@keyframes roll {
		from {
			transform: translateY(0);
		}
	}
</style>
