---
/**
 * A number whose digits roll up into place, like a mechanical counter: on page load, or (wait) each time an ancestor
 * gets the class `is-on` (the FRC page's pinned season chapters). Screen readers get the plain number; without motion
 * the digits simply sit in place. Set --odo-lh on it to change the height of a digit (default 1em).
 */
interface Props {
	value: string;
	class?: string;
	/** Roll when an ancestor has `is-on`, instead of on page load. */
	wait?: boolean;
}
const { value, class: className, wait = false } = Astro.props;
const digits = [...value];
---

<span class:list={["odometer", wait && "odometer--wait", className]}>
	<span class="sr-only">{value}</span>
	{
		digits.map((d, i) =>
			/\d/.test(d) ? (
				<span class="odo-window" aria-hidden="true">
					<span class="odo-strip" style={`--digit: ${d}; --i: ${i}`} />
				</span>
			) : (
				<span class="odo-char" aria-hidden="true">{d === " " ? " " : d}</span>
			),
		)
	}
</span>

<style>
	.odometer {
		display: inline-flex;
		font-variant-numeric: tabular-nums;
	}
	.odo-window {
		display: inline-block;
		height: var(--odo-lh, 1em);
		line-height: var(--odo-lh, 1em);
		overflow: hidden;
	}
	.odo-char {
		line-height: var(--odo-lh, 1em);
	}
	.odo-strip {
		display: block;
		transform: translateY(calc((var(--digit) + 10) * -1 * var(--odo-lh, 1em)));
	}
	/* Two turns of the wheel (0–9 twice, one per line), so every digit spins a full turn before landing.
	   Generated content keeps these 20 digits out of the page's text (search engines, copy-paste);
	   the space after each \A ends the escape, so "\A 1" is a line break then 1. */
	.odo-strip::before {
		content: "0\A 1\A 2\A 3\A 4\A 5\A 6\A 7\A 8\A 9\A 0\A 1\A 2\A 3\A 4\A 5\A 6\A 7\A 8\A 9";
		white-space: pre;
	}
	/* Only rolls when motion is allowed (the `motion` class is set in BaseLayout). */
	:global(.motion) .odometer:not(.odometer--wait) .odo-strip {
		animation: roll 1.6s cubic-bezier(0.16, 1, 0.3, 1) both;
		animation-delay: calc(var(--i) * 90ms + 150ms);
	}
	@keyframes roll {
		from {
			transform: translateY(0);
		}
	}
	/* Waiting: at zero until an ancestor is on, then a roll; back to zero (at once) when it goes off. */
	:global(.motion) .odometer--wait .odo-strip {
		transform: translateY(0);
	}
	:global(.motion .is-on) .odometer--wait .odo-strip {
		transform: translateY(calc((var(--digit) + 10) * -1 * var(--odo-lh, 1em)));
		transition: transform 1.4s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i) * 70ms + 120ms);
	}
</style>
