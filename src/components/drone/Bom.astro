---
/**
 * The parts list, as on a drawing: the number of parts as the heading, the receipt beside it (each group's sum, the
 * lines adding up to the total, the total counting up), then the list itself, numbered down the whole set, one table
 * per group with its subtotal. The sums: src/lib/look/tally.ts (tested). A group with no prices has no Price column; a list with
 * no prices at all counts parts instead of money.
 */
import { formatVnd } from "@/lib/format";
import { tally } from "@/lib/look/tally";

interface Part {
	name: string;
	why: string;
	price?: number;
}
interface Props {
	groups: Array<{ id: string; title: string; color: string; parts: Part[] }>;
	/** After the number of parts: "parts, one budget". */
	suffix: string;
	labels: { item: string; part: string; why: string; price: string; notPriced: string; subtotal: string };
	/** After each group's name in its table's caption (read aloud): "parts and prices". */
	captionSuffix: string;
	/** A priced list: the total's label and the note under it. */
	total?: { label: string; note: string };
	/** A list without prices: "parts" after each count, and the total's label ("In all"). */
	count?: { unit: string; label: string };
}
const { groups, suffix, labels, captionSuffix, total, count } = Astro.props;
const t = tally(groups);
let item = 0;
const numbered = t.groups.map((g) => ({ ...g, rows: g.parts.map((p) => ({ ...p, n: ++item })) }));
const money = t.priced && total;
---

<section id="parts" class="bom wrapper" aria-labelledby="parts-heading">
	<div class="bom-top">
		<div class="bom-lead">
			<h2 id="parts-heading" class="bom-heading">{t.count} {suffix}</h2>
			{money && <p class="bom-note">{total.note}</p>}
		</div>
		<div class="receipt">
			{
				money && (
					<div class="receipt-bar" aria-hidden="true">
						{t.groups.map((g) => (
							<span style={`flex-grow: ${g.subtotal}; background: ${g.color}`} />
						))}
					</div>
				)
			}
			<ul class="receipt-lines">
				{
					t.groups.map((g) => (
						<li>
							<span class="bom-swatch" style={`background: ${g.color}`} aria-hidden="true" />
							<span class="receipt-name">{g.title}</span>
							<span class="receipt-leader" aria-hidden="true" />
							<span class="receipt-sum">{money ? formatVnd(g.subtotal) : `${g.count} ${count?.unit ?? ""}`}</span>
							{money && <span class="receipt-share">{g.share}%</span>}
						</li>
					))
				}
			</ul>
			<p class="receipt-total">
				<span class="receipt-total-label">{money ? total.label : count?.label}</span>
				{
					money ? (
						<span class="receipt-total-n" data-count={t.total} data-count-format="vnd">
							{formatVnd(t.total)}
						</span>
					) : (
						<span class="receipt-total-n">
							<span data-count={t.count}>{t.count}</span> {count?.unit}
						</span>
					)
				}
			</p>
		</div>
	</div>

	<div class="bom-groups">
		{
			numbered.map((g) => {
				const priced = g.parts.some((p) => p.price !== undefined);
				return (
					<section class="bom-group" aria-labelledby={`group-${g.id}`}>
						<h3 id={`group-${g.id}`} class="bom-group-title">
							<span class="bom-swatch" style={`background: ${g.color}`} aria-hidden="true" />
							{g.title}
						</h3>
						<table class="bom-table">
							<caption class="sr-only">
								{g.title} {captionSuffix}
							</caption>
							<thead>
								<tr>
									<th scope="col" class="c-item">{labels.item}</th>
									<th scope="col">{labels.part}</th>
									<th scope="col" class="c-why">{labels.why}</th>
									{priced && <th scope="col" class="c-price">{labels.price}</th>}
								</tr>
							</thead>
							<tbody>
								{g.rows.map((p) => (
									<tr>
										<td class="c-item">{p.n}</td>
										<th scope="row" class="c-part">
											{p.name}
											<span class="c-why-inline">{p.why}</span>
										</th>
										<td class="c-why">{p.why}</td>
										{priced && <td class="c-price">{p.price === undefined ? <span class="c-unpriced">{labels.notPriced}</span> : formatVnd(p.price)}</td>}
									</tr>
								))}
							</tbody>
							{priced && (
								<tfoot>
									<tr>
										<th scope="row" colspan="2">
											{labels.subtotal}
										</th>
										<td class="c-why" />
										<td class="c-price">{formatVnd(g.subtotal)}</td>
									</tr>
								</tfoot>
							)}
						</table>
					</section>
				);
			})
		}
	</div>
</section>

<style>
	/* The groups' colours (src/text/projects/*.ts names them --bom-1 to --bom-4): the brand's navy, blue, gold, slate. */
	.bom {
		--bom-1: #0a174e;
		--bom-2: #2f7ce6;
		--bom-3: #b88a14;
		--bom-4: oklch(0.58 0.05 270);
		--rule: rgb(10 23 78 / 0.14);
		display: flex;
		flex-direction: column;
		gap: clamp(3rem, 6vw, 5rem);
		padding-block: clamp(4.5rem, 10vw, 8rem);
	}
	:global(.dark) .bom {
		--bom-1: #f2eedf;
		--bom-2: #8fb8f5;
		--bom-3: #f5d042;
		--bom-4: oklch(0.62 0.07 270);
		--rule: rgb(242 238 223 / 0.14);
	}
	.bom-top {
		display: grid;
		gap: 2.5rem;
		align-items: end;
	}
	@media (min-width: 60rem) {
		.bom-top {
			grid-template-columns: 1fr min(34rem, 48%);
			gap: 4rem;
		}
	}
	.bom-lead {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}
	.bom-heading {
		font-size: var(--step-head);
		font-stretch: 125%;
		font-weight: 800;
		line-height: 0.95;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}
	.bom-note {
		max-width: 44ch;
		color: var(--ink-soft);
		text-wrap: pretty;
	}
	/* The receipt: solid paper (navy in the dark), the lines with leaders, a double rule, the total. */
	.receipt {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		padding: clamp(1.25rem, 3vw, 2rem);
		border-radius: 1.5rem;
		background: var(--sheet);
		box-shadow: inset 0 0 0 1px var(--sheet-edge);
	}
	.receipt-bar {
		display: flex;
		gap: 3px;
		height: 0.75rem;
		border-radius: 0.375rem;
		overflow: hidden;
	}
	.receipt-lines {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}
	.receipt-lines li {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
	}
	.bom-swatch {
		flex: none;
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 0.2rem;
	}
	.receipt-name {
		min-width: 0;
		font-weight: 600;
		line-height: 1.25;
	}
	.receipt-leader {
		flex: 1;
		min-width: 0.75rem;
		translate: 0 -0.3em;
		border-bottom: 2px dotted var(--rule);
	}
	.receipt-sum,
	.receipt-share {
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.receipt-share {
		min-width: 3ch;
		text-align: right;
		color: var(--ink-soft);
	}
	.receipt-total {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding-top: 1.1rem;
		border-top: 4px double var(--rule);
	}
	.receipt-total-label {
		color: var(--ink-soft);
	}
	.receipt-total-n {
		font-size: var(--step-head);
		font-stretch: 125%;
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	@media (max-width: 26rem) {
		.receipt-total-n {
			font-size: 2rem;
		}
	}

	/* The list itself */
	.bom-groups {
		display: flex;
		flex-direction: column;
		gap: clamp(2.5rem, 5vw, 3.5rem);
	}
	.bom-group {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.bom-group-title {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		font-size: var(--step-lead);
		font-stretch: 112%;
		font-weight: 760;
	}
	.bom-table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--step-body);
	}
	.bom-table thead th {
		padding: 0 0.75rem 0.6rem 0;
		text-align: left;
		font-size: var(--step-small);
		font-weight: 600;
		color: var(--ink-soft);
		border-bottom: 1.5px solid var(--ink);
	}
	.bom-table td,
	.bom-table tbody th {
		padding: 0.9rem 0.75rem 0.9rem 0;
		vertical-align: top;
		text-align: left;
		border-bottom: 1px solid var(--rule);
	}
	.bom-table tbody th {
		font-weight: 650;
		text-wrap: pretty;
	}
	.c-item {
		width: 3.25rem;
		color: var(--ink-soft);
		font-variant-numeric: tabular-nums;
	}
	.bom-table thead .c-item,
	.bom-table tbody .c-item {
		color: var(--ink-soft);
	}
	.c-why {
		display: none;
		color: var(--ink-soft);
		text-wrap: pretty;
	}
	.c-why-inline {
		display: block;
		margin-top: 0.3rem;
		font-weight: 400;
		font-size: var(--step-small);
		color: var(--ink-soft);
	}
	.c-price {
		text-align: right !important;
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
		padding-right: 0 !important;
	}
	.c-unpriced {
		color: var(--ink-soft);
		white-space: normal;
	}
	.bom-table tfoot th,
	.bom-table tfoot td {
		padding: 0.9rem 0 0;
		font-weight: 750;
		text-align: left;
		border-bottom: 0;
	}
	@media (min-width: 48rem) {
		.c-why {
			display: table-cell;
			width: 46%;
		}
		.c-why-inline {
			display: none;
		}
		.bom-table tbody th {
			width: 30%;
		}
	}
</style>
