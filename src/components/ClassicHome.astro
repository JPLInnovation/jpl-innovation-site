---
/**
 * Classic mode's home page: the title sheet of JPL's drawing set (docs/superpowers/specs/2026-11-15-classic-redesign-design.md
 * §7). Shown when the studio isn't running (Classic chosen, Read mode, phones, reduced motion, no JavaScript);
 * src/pages/index.astro swaps it with the studio.
 *
 * From the top: the name across the sheet in living colour, the slogan and the one button beside the live thing (the F450
 * from sketch to built drone, home/Scrubber.astro), the title block; then "Ideas in", the three plates of "What we do"
 * (one per word of the slogan, the theme turned over on two of them), why we exist, the projects with their own figures,
 * the mission on the brand yellow, the journey as the set's revision table, the team, and the contact band.
 *
 * Every word: src/text/home.ts (and site.ts for the slogan); the projects: src/text/projects/*.md; the people:
 * src/text/members/*.md.
 */
import { ArrowDown, ArrowRight, ArrowUpRight, Check } from "lucide-react";
import ProofCounts from "@/components/ProofCounts.astro";
import TitleBlock from "@/components/TitleBlock.astro";
import Network from "@/components/home/Network.astro";
import Scrubber from "@/components/home/Scrubber.astro";
import { getMembers, getProjects, roleLine } from "@/lib/content";
import { srcset } from "@/lib/images";
import {
	hero,
	hook,
	journey,
	mission,
	pageHeading,
	proof,
	services,
	servicesSection,
	teamSection,
	titleBlock,
	verbs,
	workSection,
} from "@/text/home";
import { projectCard } from "@/text/work";
import { site } from "@/text/site";

const projects = await getProjects();
const members = await getMembers();

// The name shown huge (before the colon), the rest of the page heading for screen readers.
const [name, rest = ""] = pageHeading.split(/:(.*)/s);
const [first, ...others] = name.trim().split(" ");

const blockRows = [
	{ label: titleBlock.who, value: hero.kicker },
	{ label: titleBlock.drawnBy, value: members.map((m) => m.data.title).join(", ") },
	{ label: titleBlock.founded, value: titleBlock.foundedValue },
	{ label: titleBlock.inSet, value: `${projects.length} ${proof.projects}` },
];

const plate = Object.fromEntries(verbs.map((v) => [v.id, { ...v, services: services.filter((s) => s.verb === v.id) }]));
const external = (href: string) => (href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {});
---

<!-- ============ The title sheet ============ -->
<section class="hero" aria-labelledby="home-title">
	<h1 id="home-title" class="hero-name">
		<span class="living hero-name__a">{first}</span>
		<span class="living hero-name__b">{others.join(" ")}</span><span class="sr-only">:{rest}</span>
	</h1>
	<div class="wrapper hero-grid">
		<div class="hero-lead">
			<p class="hero-slogan">{site.slogan.split(/(?<=\.)\s+/).map((s) => <span>{s} </span>)}</p>
			<p class="hero-support">{hero.support}</p>
			<a href="#services" class="cta press">{hero.enterButton} <ArrowDown className="size-5" strokeWidth={2} aria-hidden="true" /></a>
			<p class="hero-scroll">{hero.scrollHint}</p>
		</div>
		<Scrubber class="hero-scrub" />
		<TitleBlock rows={blockRows} label={titleBlock.label} wide class="hero-block" />
	</div>
</section>

<!-- ============ Ideas in ============ -->
<section class="wrapper ideas" aria-labelledby="ideas-heading">
	<h2 id="ideas-heading" class="head">{hero.heading}</h2>
	<div class="ideas-text">
		<p class="lead">{hero.text}</p>
		<p class="links">
			<a href="/#services" class="text-link press">{hero.servicesButton} <ArrowRight className="size-4" strokeWidth={2} aria-hidden="true" /></a>
			<a href="/work/" class="text-link press">{hero.workButton} <ArrowRight className="size-4" strokeWidth={2} aria-hidden="true" /></a>
		</p>
	</div>
</section>

<!-- ============ What we do: one plate per word of the slogan ============ -->
<section id="services" class="services" aria-labelledby="services-heading">
	<div class="wrapper services-head">
		<h2 id="services-heading" class="head">{servicesSection.heading}</h2>
		<p class="lead">{servicesSection.intro}</p>
	</div>

	{
		[plate.sketch, plate.build, plate.secure].map((v) => (
			<article class:list={["plate", `plate--${v.id}`, v.id !== "build" && "turned"]} aria-labelledby={`verb-${v.id}`} data-plate>
				<div class="plate-stage">
				{v.id === "build" && (
					<div class="plate-photo">
						<img src="/assets/FRCnew.jpg" srcset={srcset("/assets/FRCnew.jpg")} sizes="100vw" alt={v.alt} loading="lazy" width="1920" height="1280" />
					</div>
				)}
				<div class="wrapper plate-grid">
					<h3 id={`verb-${v.id}`} class="verb living" data-wipe>{v.verb}</h3>
					{v.id === "sketch" && (
						<div class="plate-picture">
							<img
								src="/showcase/drone/power.webp"
								srcset="/showcase/drone/power-800.webp 800w, /showcase/drone/power.webp 1600w"
								sizes="(min-width: 64rem) 52rem, 100vw"
								alt={v.alt}
								loading="lazy"
								width="1600"
								height="1200"
							/>
							<img
								class="plate-assembled"
								src="/showcase/drone/overview.webp"
								srcset="/showcase/drone/overview-800.webp 800w, /showcase/drone/overview.webp 1600w"
								sizes="(min-width: 64rem) 52rem, 100vw"
								alt=""
								loading="lazy"
								width="1600"
								height="1200"
							/>
						</div>
					)}
					{v.id === "secure" && (
						<div class="plate-picture">
							<Network />
						</div>
					)}
					<ul class="plate-services">
						{v.services.map((s, k) => (
							<li style={`--k:${k}`}>
								<h4>{s.title}</h4>
								<p>{s.desc}</p>
								{s.proof && (
									<a href={s.proof.href} class="text-link press" {...external(s.proof.href)}>
										{servicesSection.linkPrefix} {s.proof.label}
										<ArrowUpRight className="size-4" strokeWidth={2} aria-hidden="true" />
									</a>
								)}
							</li>
						))}
					</ul>
					{v.id === "build" && <p class="plate-caption">{hero.photoCaption}</p>}
				</div>
				</div>
			</article>
		))
	}
</section>

<!-- ============ Why we exist (the same words the 3D studio opens on) ============ -->
<section class="wrapper why" aria-labelledby="hook-heading">
	<h2 id="hook-heading" class="head">{hook.heading}</h2>
	<p class="lead why-text">
		{hook.lines.map((line, i) => (i === hook.lampLine ? <><mark data-wipe="mark">{line}</mark> </> : `${line} `))}
	</p>
</section>

<!-- ============ Selected work: the projects, each with its own figures ============ -->
<section id="work" class="wrapper work" aria-labelledby="work-heading">
	<div class="work-head">
		<h2 id="work-heading" class="head">{workSection.heading}</h2>
		<p class="lead">{workSection.intro}</p>
	</div>
	<ol class="register">
		{
			projects.map((p, i) => {
				const href = `/work/${p.id}/`;
				return (
					<li class="reg-row" data-project={p.id}>
						<a href={href} class="reg-pic press" tabindex="-1" aria-hidden="true" data-wipe>
							<img
								src={p.data.img}
								srcset={srcset(p.data.img)}
								sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 40vw, 100vw"
								alt=""
								loading={i === 0 ? "eager" : "lazy"}
								transition:name={p.id === "frc" ? undefined : `project-${p.id}`}
							/>
						</a>
						<div class="reg-title">
							<h3>
								<a href={href} data-astro-prefetch="viewport">{p.data.title}</a>
							</h3>
							{p.data.badge && <p class="reg-status">{p.data.badge}</p>}
						</div>
						<div class="reg-body">
							<p>{p.data.description}</p>
							<ProofCounts about={p.id} look="line" class="reg-proof" />
							<a href={href} class="text-link press">
								{projectCard.readMore} {p.data.title}
								<ArrowRight className="size-4" strokeWidth={2} aria-hidden="true" />
							</a>
						</div>
					</li>
				);
			})
		}
	</ol>
	<p class="work-all">
		<a href="/work/" class="text-link press">{workSection.allWorkLink} <ArrowRight className="size-4" strokeWidth={2} aria-hidden="true" /></a>
	</p>
</section>

<!-- ============ Mission, on the brand yellow ============ -->
<section class="mission" aria-labelledby="mission-heading">
	<div class="wrapper">
		<h2 id="mission-heading" class="mission-label">{mission.label}</h2>
		<p data-words class="mission-statement">{mission.statement}</p>
		<div class="mission-grid">
			<div>
				<h3 class="mission-sub">{mission.standardsHeading}</h3>
				<ul class="standards">
					{
						mission.standards.map((s) => (
							<li>
								<Check className="size-5" strokeWidth={2.25} aria-hidden="true" />
								<span>{s}</span>
							</li>
						))
					}
				</ul>
			</div>
			<div>
				<h3 class="mission-sub">{mission.processHeading}</h3>
				<ol class="flow">
					{
						mission.process.map(({ title, desc }, i) => (
							<li>
								<h4>
									<span class="sr-only">
										{mission.stepLabel} {i + 1}:{" "}
									</span>
									{title}
								</h4>
								<p>{desc}</p>
							</li>
						))
					}
				</ol>
			</div>
		</div>
	</div>
</section>

<!-- ============ The journey: the set's revision table ============ -->
<section class="wrapper journey" aria-labelledby="journey-heading">
	<h2 id="journey-heading" class="head">{journey.heading}</h2>
	<ol class="revs">
		{
			journey.milestones.map((m, i) => (
				<li class="rev" data-state={m.state}>
					{m.state !== "future" && <span class="rev-track" data-draw="y" data-draw-duration="0.5" data-draw-ease="linear" data-reveal-delay={i * 450} aria-hidden="true" />}
					<span class="rev-dot" aria-hidden="true" />
					<p class="rev-year">{m.year}</p>
					<div class="rev-text">
						<h3>{m.title}</h3>
						<p>{m.desc}</p>
					</div>
					<p class="rev-tag">{m.state === "now" ? journey.nowTag : m.before ? journey.beforeTag : ""}</p>
				</li>
			))
		}
	</ol>
</section>

<!-- ============ The team ============ -->
<section id="team" class="wrapper team" aria-labelledby="team-heading">
	<div class="team-head">
		<h2 id="team-heading" class="head">{teamSection.heading}</h2>
		<p class="lead">{teamSection.intro}</p>
		<a href="/members/" class="text-link press">{teamSection.allMembersLink} <ArrowRight className="size-4" strokeWidth={2} aria-hidden="true" /></a>
	</div>
	<ul class="crew">
		{
			members.map((m) => (
				<li class="person">
					<img
						src={m.data.img}
						srcset={srcset(m.data.img)}
						sizes="(min-width: 64rem) 30rem, (min-width: 40rem) 45vw, 100vw"
						alt={m.data.img_alt ?? ""}
						loading="lazy"
						transition:name={`member-${m.id}`}
					/>
					<h3>
						<a href={`/members/${m.id}/`}>{m.data.title}</a>
					</h3>
					{m.data.leadership && <p class="person-role">{roleLine(m)}</p>}
					<p class="person-tags">{m.data.tags.join(", ")}</p>
				</li>
			))
		}
	</ul>
</section>


<style>
	/* ---------- Shared ---------- */
	.head {
		font-size: var(--step-head);
		font-stretch: 125%;
		font-weight: 800;
		line-height: 0.98;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}
	.lead {
		font-size: var(--step-lead);
		line-height: 1.4;
		text-wrap: pretty;
	}
	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.75rem;
		font-weight: 650;
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--accent-brand);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
		transition: gap 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.text-link:hover {
		gap: 0.65rem;
	}
	section {
		color: var(--ink);
	}

	/* ---------- The title sheet ---------- */
	.hero {
		container-type: inline-size;
		padding-top: clamp(1.25rem, 3vw, 2.5rem);
	}
	/* The name across the whole sheet: one line wide, two on a phone (JPL huge, then Innovation the full width). The
	   sizes are the widths of the words in Archivo at 125% and 850 (measured), so each line meets both gutters. */
	.hero-name {
		margin: 0 clamp(1rem, 4vw, 2.5rem);
		font-stretch: 125%;
		font-weight: 850;
		line-height: 0.82;
		letter-spacing: -0.045em;
		white-space: nowrap;
		font-size: calc((100cqi - 2 * clamp(1rem, 4vw, 2.5rem)) / 8.78);
	}
	.hero-name > span {
		display: inline-block;
		padding-bottom: 0.08em;
	}
	@media (max-width: 40rem) {
		.hero-name__a,
		.hero-name__b {
			display: block !important;
		}
		.hero-name__a {
			font-size: 3.86em;
		}
		.hero-name__b {
			font-size: 1.4em;
		}
	}
	:global(.motion) .hero-name__a,
	:global(.motion) .hero-name__b {
		animation: rise 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
	}
	:global(.motion) .hero-name__b {
		animation-delay: 0.08s;
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(0.35em);
		}
	}
	.hero-grid {
		display: grid;
		grid-template-areas: "lead" "scrub" "block";
		gap: 2rem;
		margin-top: clamp(1.25rem, 2.5vw, 2.25rem);
	}
	.hero-lead {
		grid-area: lead;
	}
	.hero-grid > :global(.hero-scrub) {
		grid-area: scrub;
	}
	.hero-grid > :global(.hero-block) {
		grid-area: block;
	}
	@media (min-width: 64rem) {
		.hero-grid {
			grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
			grid-template-rows: auto 1fr;
			grid-template-areas: "lead scrub" "block scrub";
			gap: 2rem 3rem;
		}
		.hero-grid > :global(.hero-block) {
			align-self: end;
		}
	}
	.hero-slogan span {
		display: block;
	}
	/* the title block: what this is across the top, then two by two, the count across the foot */
	.hero-grid > :global(.hero-block .title-block__cell:first-child) {
		grid-column: 1 / -1;
	}
	.hero-lead {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
		padding-top: 0.5rem;
	}
	.hero-slogan {
		font-size: var(--step-lead);
		font-stretch: 125%;
		font-weight: 800;
		line-height: 1.1;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}
	.hero-support {
		font-size: var(--step-body);
		max-width: 34ch;
		text-wrap: pretty;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 3.25rem;
		margin-top: 0.5rem;
		padding: 0 1.5rem;
		border-radius: 999px;
		background: var(--primary);
		color: var(--primary-foreground);
		font-weight: 650;
		transition:
			transform 120ms ease-out,
			background-color 0.2s;
	}
	.cta:hover {
		background: color-mix(in oklab, var(--primary) 88%, var(--ink));
	}
	.cta:focus-visible {
		outline-offset: 4px;
	}
	.hero-scroll {
		font-size: var(--step-small);
		color: var(--ink-soft);
	}

	/* ---------- Ideas in ---------- */
	/* The page's one centred moment: what we are, in one line, between the title sheet and the plates. */
	.ideas {
		display: grid;
		justify-items: center;
		gap: 2rem;
		padding-block: clamp(7rem, 13vw, 12rem);
		text-align: center;
	}
	.ideas .head {
		max-width: 18ch;
	}
	.ideas-text {
		display: grid;
		justify-items: center;
		gap: 1rem;
		max-width: 40rem;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25rem 1.75rem;
	}

	/* ---------- What we do: the plates ---------- */
	.services-head {
		display: grid;
		gap: 1rem 4rem;
		padding-bottom: clamp(3rem, 6vw, 5rem);
	}
	@media (min-width: 64rem) {
		.services-head {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			align-items: end;
		}
	}
	.plate {
		position: relative;
		min-height: 100svh;
		display: grid;
		align-items: center;
		overflow: clip; /* (clip, not hidden: the scroll scene's sticky stage needs the page to scroll it) */
		padding-block: clamp(4.5rem, 9vw, 8rem);
		background: var(--field);
		color: var(--ink);
	}
	/* The theme turned over: paper plates on the dark theme, navy plates on the light one (the hard section switch). */
	:global(html.dark) .turned {
		--field: #f2eedf;
		--field-2: #e8e2cc;
		--sheet: #ffffff;
		--sheet-edge: rgb(10 23 78 / 0.12);
		--ink: #0a174e;
		--ink-soft: #3d4770;
		--accent-brand: #2f7ce6;
		--ring: #1f5fc4;
	}
	:global(html:not(.dark)) .turned {
		--field: #0a174e;
		--field-2: #071038;
		--sheet: #13235f;
		--sheet-edge: rgb(242 238 223 / 0.14);
		--ink: #f2eedf;
		--ink-soft: #bcc1d6;
		--accent-brand: #f5d042;
		--ring: #f5d042;
	}
	.verb {
		font-size: clamp(3.75rem, 12.2vw, 15rem);
		font-stretch: 125%;
		font-weight: 850;
		line-height: 0.84;
		letter-spacing: -0.05em;
		white-space: nowrap;
	}
	.plate-grid {
		position: relative;
		display: grid;
		gap: 2.5rem;
	}
	.plate-services {
		display: grid;
		gap: 2rem 3rem;
		align-content: start;
	}
	.plate-services h4 {
		font-size: var(--step-lead);
		font-stretch: 112%;
		font-weight: 760;
		line-height: 1.15;
	}
	.plate-services p {
		margin: 0.5rem 0 0.35rem;
		max-width: 44ch;
		text-wrap: pretty;
	}
	.plate-picture img {
		width: 100%;
		height: auto;
	}

	/* Sketch it.: the word across the top, the F450 pulled apart under it, the services beside it. */
	@media (min-width: 64rem) {
		.plate--sketch .plate-grid {
			grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
			grid-template-rows: auto 1fr;
		}
		.plate--sketch .verb {
			grid-column: 1 / -1;
		}
		.plate--sketch .plate-services {
			grid-row: 2;
			grid-column: 1;
			align-self: end;
			padding-bottom: 2rem;
		}
		.plate--sketch .plate-picture {
			grid-row: 2;
			grid-column: 2;
			margin: -4rem -2rem -3rem 0;
		}
	}

	/* Build it.: the robot photograph, the word over its floor, the services on the navy under it. */
	.plate--build {
		--ink: #f2eedf;
		--ink-soft: #bcc1d6;
		--accent-brand: #f5d042;
		--ring: #f5d042;
		align-items: end;
		padding-top: 0;
		background: #071038;
	}
	.plate-photo {
		position: absolute;
		inset: 0 0 auto;
		height: 62svh;
	}
	.plate-photo img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 40% 62%;
	}
	.plate-photo::after {
		/* one flat navy veil, so the word reads on the floor of the photograph */
		content: "";
		position: absolute;
		inset: 0;
		background: rgb(7 16 56 / 0.28);
	}
	/* the word stands on the photograph's floor, right of the robot, its foot on the navy */
	.plate--build .verb {
		margin-top: 50svh;
		margin-bottom: 1rem;
		justify-self: end;
	}
	@media (min-width: 64rem) {
		.plate--build .plate-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(0, 0.8fr);
			align-items: start;
		}
		.plate--build .verb {
			grid-column: 1 / -1;
		}
		.plate--build .plate-services {
			grid-column: 1 / 3;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.plate--build .plate-caption {
			grid-column: 3;
			justify-self: end;
			text-align: right;
		}
	}
	.plate-caption {
		max-width: 30ch;
		font-size: var(--step-small);
		color: var(--ink-soft);
	}

	/* Secure it.: the word at the right, the network drawn across under it, the service under the internet's end. */
	@media (min-width: 64rem) {
		.plate--secure .plate-grid {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: 1rem 3rem;
		}
		.plate--secure .verb {
			grid-column: 1 / -1;
			justify-self: end;
		}
		.plate--secure .plate-picture {
			grid-column: 1 / -1;
			padding-inline: 1rem;
		}
		.plate--secure .plate-services {
			grid-column: 1;
			margin-top: -9rem;
		}
	}

	/* ---------- The plates as scroll scenes (wide screens with motion; the script below sets data-scrolly and --p) ----------
	   Each plate holds still while you scroll through it (--p runs 0 to 1): its word is written on with the colour moving
	   through its letters, its picture comes together (the F450's parts into the drone, the robot's photo into colour, the
	   network drawn link by link), and its services arrive one after another. Without it (phones, reduced motion, no
	   script) the plates are plain, as before. */
	.plate-picture {
		position: relative;
	}
	.plate-assembled {
		display: none;
	}
	.plate--build {
		--live-1: #8fb8f5;
		--live-2: #f5d042;
	}
	:global(html.dark) .turned {
		--live-1: #2f7ce6;
		--live-2: #94700c;
	}
	:global(html:not(.dark)) .turned {
		--live-1: #8fb8f5;
		--live-2: #f5d042;
	}
	.plate[data-scrolly] {
		display: block;
		min-height: 230svh;
		padding-block: 0;
	}
	.plate[data-scrolly] > .plate-stage {
		position: sticky;
		top: 0;
		height: 100svh;
		display: grid;
		align-items: center;
		overflow: hidden;
		padding-block: clamp(5rem, 9vw, 7rem) clamp(2rem, 4vw, 3rem);
	}
	.plate--build[data-scrolly] > .plate-stage {
		align-items: end;
		padding-top: 0;
	}
	/* a hairline along the foot of the stage: how far through the plate you are */
	.plate[data-scrolly] > .plate-stage::after {
		content: "";
		position: absolute;
		inset: auto 0 0;
		height: 3px;
		background: var(--accent-brand);
		transform-origin: left center;
		transform: scaleX(var(--p, 0));
	}
	.plate[data-scrolly] .verb {
		animation: none;
		transition: none;
		--live-x: calc(6% + var(--p, 0) * 88%);
		--live-y: calc(18% + var(--p, 0) * 64%);
		clip-path: inset(0 calc((1 - min(1, var(--p, 0) * 3.2)) * 100%) 0 0);
		transform: translateX(calc((0.4 - var(--p, 0)) * 4vw));
	}
	.plate[data-scrolly] .plate-services > li {
		--in: clamp(0, (var(--p, 0) - 0.4 - var(--k, 0) * 0.1) * 6, 1);
		opacity: var(--in);
		transform: translateY(calc((1 - var(--in)) * 2.5rem));
	}
	/* Sketch it.: the parts pulled apart come together into the drone. */
	.plate--sketch[data-scrolly] .plate-picture img {
		--joined: clamp(0, (var(--p, 0) - 0.3) * 2.6, 1);
		transform-origin: 55% 45%;
	}
	.plate--sketch[data-scrolly] .plate-picture img:first-child {
		opacity: calc(1 - var(--joined));
		transform: scale(calc(1.08 - var(--joined) * 0.14)) rotate(calc((0.5 - var(--p, 0)) * 5deg));
	}
	.plate--sketch[data-scrolly] .plate-assembled {
		display: block;
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		opacity: var(--joined);
		transform: scale(calc(0.86 + var(--joined) * 0.1));
	}
	/* Build it., held on one screen: its three services in one row, the photo's caption on the photo's floor. */
	.plate--build[data-scrolly] .plate-services {
		grid-column: 1 / -1;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.plate--build[data-scrolly] .plate-photo {
		height: 54svh;
	}
	.plate--build[data-scrolly] .verb {
		margin-top: 42svh;
		margin-bottom: 0.25rem;
	}
	/* the caption as a label in the photo's corner (the stage, not the grid, places it) */
	.plate--build[data-scrolly] .plate-grid {
		position: static;
	}
	.plate--build[data-scrolly] .plate-caption {
		position: absolute;
		top: 5.5rem;
		right: clamp(1rem, 4vw, 2.5rem);
		padding: 0.35rem 0.65rem;
		border-radius: 0.5rem;
		background: rgb(7 16 56 / 0.7);
		color: #f2eedf;
		text-align: right;
	}
	/* Build it.: the photograph pushes in and its colour comes up. */
	.plate--build[data-scrolly] .plate-photo img {
		transform: scale(calc(1.24 - var(--p, 0) * 0.24));
		filter: grayscale(calc(1 - min(1, var(--p, 0) * 1.7)));
	}
	/* Secure it., held on one screen: the drawing no taller than half of it, so the service and its link fit under. */
	.plate--secure[data-scrolly] :global(.net) {
		max-height: 52svh;
	}
	/* Secure it.: the network drawn link by link (each link's --n is its order, Network.astro). */
	.plate--secure[data-scrolly] :global(.net .net-link) {
		transition: none;
		transform: scaleX(clamp(0, (var(--p, 0) - 0.12 - var(--n, 0) * 0.07) * 7, 1));
	}
	.plate--secure[data-scrolly] :global(.net .net-link[data-dir="y"]) {
		transform: scaleY(clamp(0, (var(--p, 0) - 0.12 - var(--n, 0) * 0.07) * 7, 1));
	}

