</style>

<script>
	// The plates as scroll scenes: on wide screens with motion allowed, each plate holds still while you scroll through
	// it, and --p (0 to 1) says how far through it you are; the styles above turn that into the scene. Off screen, nothing.
	let stop: (() => void) | undefined;
	function init() {
		stop?.();
		const plates = [...document.querySelectorAll<HTMLElement>("[data-plate]")];
		if (!plates.length) return;
		const html = document.documentElement;
		const wide = matchMedia("(min-width: 64rem)");
		const allowed = () => wide.matches && html.classList.contains("motion") && !html.classList.contains("reduce-motion");
		let frame = 0;
		const update = () => {
			frame = 0;
			const vh = innerHeight;
			for (const plate of plates) {
				const r = plate.getBoundingClientRect();
				if (r.bottom < -vh || r.top > 2 * vh) continue;
				const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - vh)));
				plate.style.setProperty("--p", p.toFixed(4));
			}
		};
		const onScroll = () => {
			if (!frame && plates[0].hasAttribute("data-scrolly")) frame = requestAnimationFrame(update);
		};
		let was: boolean | undefined;
		const apply = () => {
			const on = allowed();
			if (on === was) return;
			was = on;
			for (const plate of plates) plate.toggleAttribute("data-scrolly", on);
			if (on) update();
		};
		apply();
		addEventListener("scroll", onScroll, { passive: true });
		addEventListener("resize", onScroll);
		wide.addEventListener("change", apply);
		const watch = new MutationObserver(apply); // the motion setting can change in Settings
		watch.observe(html, { attributes: true, attributeFilter: ["class"] });
		stop = () => {
			cancelAnimationFrame(frame);
			removeEventListener("scroll", onScroll);
			removeEventListener("resize", onScroll);
			wide.removeEventListener("change", apply);
			watch.disconnect();
			stop = undefined;
		};
	}
	document.addEventListener("astro:page-load", init);
	document.addEventListener("astro:before-swap", () => stop?.());
</script>
