---
/**
 * The members as a list of portraits (the classic home). Each photograph rests in the brand's two inks and comes up in
 * colour when you point at or tab to the person, as on the crew sheet (/members/). The whole card is the link.
 */
import type { CollectionEntry } from "astro:content";
import Portrait from "@/components/members/Portrait.astro";
import { roleLine } from "@/lib/content";

interface Props {
	members: CollectionEntry<"members">[];
	headingLevel?: "h2" | "h3";
}

const { members, headingLevel: Heading = "h3" } = Astro.props;
---

<ul class="crew-list" role="list">
	{
		members.map((m) => (
			<li class="press crew-list__item">
				<div class="crew-list__plate">
					<Portrait
						src={m.data.img}
						alt={m.data.img_alt ?? ""}
						sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 100vw"
						name={`member-${m.id}`}
					/>
				</div>
				<div class="crew-list__text">
					<Heading class="crew-list__name">
						{/* The whole card is clickable through this link's ::after. */}
						<a href={`/members/${m.id}/`}>{m.data.title}</a>
					</Heading>
					{m.data.leadership && <p class="crew-list__roles">{roleLine(m)}</p>}
					<p class="crew-list__tags">{m.data.tags.join(", ")}</p>
				</div>
			</li>
		))
	}
</ul>

<style>
	.crew-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
		gap: 3rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.crew-list__item {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.crew-list__plate {
		aspect-ratio: 4 / 5;
		overflow: hidden;
		border-radius: 1.25rem;
		box-shadow: inset 0 0 0 1px var(--sheet-edge);
	}
	.crew-list__item:is(:hover, :focus-within) {
		--portrait-lit: 1;
	}
	.crew-list__text {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}
	.crew-list__name {
		font-size: var(--step-lead);
		font-weight: 760;
		font-stretch: 112%;
	}
	.crew-list__name a {
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 3px;
		text-underline-offset: 5px;
		transition: text-decoration-color 0.3s;
	}
	.crew-list__item:hover .crew-list__name a {
		text-decoration-color: var(--accent-brand);
	}
	.crew-list__name a::after {
		content: "";
		position: absolute;
		inset: 0;
	}
	.crew-list__roles {
		font-size: var(--step-small);
		font-weight: 650;
	}
	.crew-list__tags {
		font-size: var(--step-small);
		color: var(--ink-soft);
	}
</style>
