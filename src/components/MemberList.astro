---
import type { CollectionEntry } from "astro:content";
import { roleLine } from "@/lib/content";
import { srcset } from "@/lib/images";

interface Props {
	members: CollectionEntry<"members">[];
	headingLevel?: "h2" | "h3";
}

const { members, headingLevel: Heading = "h3" } = Astro.props;
---

<ul class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
	{
		members.map((m) => (
			<li class="press group relative flex flex-col gap-4">
				<div class="overflow-hidden rounded-xl bg-muted">
					<img
						src={m.data.img}
						srcset={srcset(m.data.img)}
						sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, 100vw"
						transition:name={`member-${m.id}`}
						alt={m.data.img_alt ?? ""}
						loading="lazy"
						class="aspect-[4/5] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
					/>
				</div>
				<div class="flex flex-col gap-1.5">
					<Heading class="font-semiwide text-xl font-[760]">
						{/* The whole card is clickable through this link's ::after. */}
						<a href={`/members/${m.id}/`} class="after:absolute after:inset-0 group-hover:underline decoration-primary dark:decoration-accent decoration-[3px] underline-offset-[5px]">
							{m.data.title}
						</a>
					</Heading>
					{m.data.leadership && (
						<p class="text-sm font-semibold">{roleLine(m)}</p>
					)}
					<p class="text-sm text-muted-foreground">{m.data.tags.join(", ")}</p>
				</div>
			</li>
		))
	}
</ul>
