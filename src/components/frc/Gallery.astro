---
/**
 * From the pits: the two regionals' photos as a strip that slides sideways (drag it, swipe it, use the arrows or the
 * arrow keys), its edges fading out; each photo is in black and white until it is the one in front or under the
 * pointer, and opens full size in the page's photo viewer (frc.astro, [data-zoom]). The heading runs huge and hollow
 * behind it. Script: src/components/frc/edition.ts. Words: src/text/projects/frc.ts (rookieText.pits*, edition.gallery).
 */
import { edition, frcPhotos, lightboxText, rookieText, type FrcPhoto } from "@/text/projects/frc";

const photos = rookieText.pits.map((id) => frcPhotos[id] as FrcPhoto);
const g = edition.gallery;
// The cards are 4:3 and crop each photo to fill, so a wide photo needs a file as wide as the crop (see .fgal-track).
const sizes = (p: FrcPhoto) => {
	const k = Math.max(1, p.w / p.h / (4 / 3)).toFixed(2);
	return `(max-width: 640px) calc(78vw * ${k}), calc(min(29vw, 26rem) * ${k})`;
};
---

<section class="fgal frc-paper" aria-labelledby="pits-heading" data-frc-gallery>
	<p class="fgal-ghost" aria-hidden="true">{rookieText.pitsHeading}</p>
	<div class="wrapper fgal-head">
		<div class="fgal-title">
			<h2 id="pits-heading" class="fgal-h">{rookieText.pitsHeading}</h2>
			<p class="fgal-intro">{rookieText.pitsIntro}</p>
		</div>
		<div class="fgal-nav">
			<span class="fgal-count" aria-hidden="true"><span data-gal-n>1</span> / {photos.length}</span>
			<button type="button" class="fgal-arrow press" data-gal-prev aria-label={g.prev}><span aria-hidden="true">«</span></button>
			<button type="button" class="fgal-arrow press" data-gal-next aria-label={g.next}><span aria-hidden="true">»</span></button>
		</div>
	</div>
	<ul class="fgal-track" data-gal-track aria-label={rookieText.pitsHeading}>
		{
			photos.map((p, i) => (
				<li class:list={["fgal-card", i === 0 && "is-on"]}>
					<button
						type="button"
						class="fgal-im"
						data-zoom={`/assets/frc/${p.id}.webp`}
						data-zoom-alt={p.alt}
						data-zoom-caption={`${p.caption}${p.meta ? ` · ${p.meta}` : ""}`}
						aria-label={`${lightboxText.open} ${p.caption}`}
					>
						<img src={`/assets/frc/${p.id}-640.webp`} srcset={`/assets/frc/${p.id}-640.webp 640w, /assets/frc/${p.id}.webp ${p.w}w`} sizes={sizes(p)} alt={p.alt} width={p.w} height={p.h} loading="lazy" decoding="async" draggable="false" />
						<span class="frc-mono" />
					</button>
					<p class="fgal-cap">
						<span>{p.caption}</span>
						{p.meta && <span class="fgal-meta"> · {p.meta}</span>}
					</p>
				</li>
			))
		}
	</ul>
	<div class="wrapper fgal-foot">
		<span class="fgal-bar" aria-hidden="true"><i data-gal-bar></i></span>
		<p class="fgal-hint">{g.hint}</p>
	</div>
</section>

<style>
	.fgal {
		position: relative;
		overflow: clip;
		padding-block: clamp(5rem, 14svh, 9rem);
	}
	/* The heading again, huge and hollow, behind the strip. */
	.fgal-ghost {
		position: absolute;
		left: 0;
		top: clamp(1rem, 5svh, 3rem);
		font-family: var(--frc-disp);
		font-size: clamp(6rem, 19vw, 20rem);
		line-height: 0.8;
		text-transform: uppercase;
		white-space: nowrap;
		color: transparent;
		-webkit-text-stroke: 1px rgb(20 28 42 / 0.12);
		pointer-events: none;
		user-select: none;
		will-change: transform;
	}
	.fgal-head {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.25rem 2rem;
		margin-bottom: 2rem;
	}
	.fgal-h {
		font-family: var(--frc-disp);
		font-weight: 400;
		text-transform: uppercase;
		font-size: clamp(2.6rem, 5vw, 4.5rem);
		line-height: 0.95;
		letter-spacing: 0;
	}
	.fgal-intro {
		margin-top: 0.6rem;
		color: var(--muted-foreground);
	}
	.fgal-nav {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.fgal-count {
		margin-right: 0.75rem;
		font-family: var(--frc-disp);
		font-size: 1.15rem;
		color: var(--muted-foreground);
		font-variant-numeric: tabular-nums;
	}
	.fgal-arrow {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 2.75rem;
		background: rgb(20 28 42 / 0.08);
		font-family: var(--frc-disp);
		font-size: 1.25rem;
		transition:
			background-color 0.25s,
			color 0.25s;
	}
	.fgal-arrow:hover {
		background: var(--frc-k);
		color: var(--frc-y);
	}
	.fgal-arrow:disabled {
		opacity: 0.35;
		pointer-events: none;
	}
	/* The strip: native sideways scroll with snap points, the edges fading out. */
	.fgal-track {
		--gutter: max(clamp(1rem, 4vw, 2.5rem), calc((100% - 76rem) / 2 + clamp(1rem, 4vw, 2.5rem)));
		position: relative;
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: clamp(16rem, 29vw, 26rem);
		gap: 1rem;
		overflow-x: auto;
		overscroll-behavior-x: contain;
		scroll-snap-type: x mandatory;
		scroll-padding-inline: var(--gutter);
		padding-inline: var(--gutter);
		scrollbar-width: none;
		cursor: grab;
		-webkit-mask-image: linear-gradient(in oklch to right, transparent, #000 var(--gutter), #000 calc(100% - var(--gutter)), transparent);
		mask-image: linear-gradient(in oklch to right, transparent, #000 var(--gutter), #000 calc(100% - var(--gutter)), transparent);
	}
	.fgal-track::-webkit-scrollbar {
		display: none;
	}
	.fgal-track.is-drag {
		cursor: grabbing;
		scroll-snap-type: none;
	}
	.fgal-card {
		scroll-snap-align: start;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}
	.fgal-im {
		position: relative;
		display: block;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		cursor: zoom-in;
	}
	.fgal-track.is-drag .fgal-im {
		cursor: grabbing;
	}
	.fgal-im img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
		transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.fgal-im:hover img,
	.fgal-im:focus-visible img {
		transform: scale(1.04);
	}
	.fgal-card:is(.is-on, :hover, :focus-within) .frc-mono {
		opacity: 0;
	}
	.fgal-cap {
		font-size: var(--step-small);
		text-wrap: pretty;
	}
	.fgal-meta {
		color: var(--muted-foreground);
	}
	.fgal-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 2rem;
		margin-top: 1.75rem;
	}
	.fgal-bar {
		position: relative;
		flex: 1 1 12rem;
		height: 2px;
		background: rgb(20 28 42 / 0.12);
	}
	.fgal-bar i {
		position: absolute;
		inset: 0;
		background: var(--frc-g);
		transform-origin: 0 50%;
		transform: scaleX(var(--p, 0.1));
	}
	.fgal-hint {
		font-size: var(--step-small);
		color: var(--muted-foreground);
	}
	@media (max-width: 640px) {
		.fgal-track {
			grid-auto-columns: 78%;
		}
	}
</style>
