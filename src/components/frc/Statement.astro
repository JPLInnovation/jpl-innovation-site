---
/**
 * The statement: the team's line set huge on paper, its words lighting up as it scrolls past, its key words on a
 * yellow mark; small photographs of the team drift around it at their own speeds and come into colour as they pass
 * the middle of the screen (src/components/frc/edition.ts). Without motion the words and photos simply show.
 * Words: src/text/projects/frc.ts (frcDeck.heading and text, edition.statementMarks / statementPhotos).
 */
import { markWords } from "@/lib/look/frc-race";
import { edition, frcDeck, frcPhotos, type FrcPhoto } from "@/text/projects/frc";

const photos = edition.statementPhotos.map((id) => frcPhotos[id] as FrcPhoto);
/** Pieces of the heading, each split into words (a marked piece keeps its words together on one mark). */
let i = 0;
const pieces = markWords(frcDeck.heading, edition.statementMarks).map((p) => ({
	mark: p.mark,
	words: p.text.split(/(\s+)/).map((w) => (w.trim() ? { w, i: i++ } : { w, i: -1 })),
}));
/** Where each photo floats and how fast it drifts against the scroll. */
const spots = [
	{ style: "left:5%;top:16%", speed: -0.12 },
	{ style: "right:6%;top:10%", speed: 0.1 },
	{ style: "left:11%;bottom:12%", speed: 0.16 },
	{ style: "right:10%;bottom:16%", speed: -0.1 },
];
---

<section class="fs frc-paper" aria-labelledby="statement-heading" data-frc-statement>
	{
		photos.map((p, k) => (
			<figure class="fs-ph" style={spots[k].style} data-speed={spots[k].speed} aria-hidden="true">
				<img src={`/assets/frc/${p.id}-640.webp`} alt="" width={p.w} height={p.h} loading="lazy" decoding="async" />
				<span class="frc-mono" />
			</figure>
		))
	}
	<div class="fs-in">
		<h2 id="statement-heading" class="fs-h" style={`--n:${i}`}>
			{pieces.map((p) => {
				const words = p.words.map((x) => (x.i < 0 ? x.w : <span class="fs-w" style={`--i:${x.i}`}>{x.w}</span>));
				return p.mark ? <mark>{words}</mark> : words;
			})}
		</h2>
		<p class="fs-p">{frcDeck.text}</p>
	</div>
</section>

<style>
	.fs {
		position: relative;
		overflow: clip;
		display: grid;
		place-items: center;
		min-height: 100svh;
		padding: 16svh clamp(1rem, 4vw, 2.5rem);
	}
	.fs-in {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
		text-align: center;
	}
	.fs-h {
		--k: 1;
		max-width: 13ch;
		font-family: var(--frc-disp);
		font-weight: 400;
		font-size: clamp(3rem, 8.4vw, 8.5rem);
		line-height: 0.92;
		letter-spacing: 0;
		text-transform: uppercase;
		text-wrap: balance;
	}
	/* Lit word by word as the heading scrolls through (edition.ts sets --k from 0 to 1); never under half, so it reads. */
	:global(.motion) .fs-h {
		--k: 0;
	}
	.fs-w {
		opacity: clamp(0.5, calc(var(--k) * (var(--n) + 2) - var(--i)), 1);
	}
	/* The mark is a band the height of the capitals (a plain background would cover the line above: Anton's box is
	   taller than its tight line height). */
	.fs-h mark {
		background: linear-gradient(var(--frc-y), var(--frc-y)) 0 52% / 100% 0.86em no-repeat;
		color: var(--frc-g);
		padding: 0 0.08em;
		box-decoration-break: clone;
		-webkit-box-decoration-break: clone;
	}
	.fs-p {
		max-width: 46ch;
		font-size: var(--step-lead);
		line-height: 1.4;
		text-wrap: pretty;
		color: var(--muted-foreground);
	}
	.fs-ph {
		position: absolute;
		margin: 0;
		width: clamp(7rem, 13vw, 12rem);
		aspect-ratio: 3 / 2;
		overflow: hidden;
		will-change: transform;
	}
	.fs-ph img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	@media (max-width: 699px) {
		.fs-ph {
			width: 6.5rem;
		}
		.fs-ph:nth-of-type(2n) {
			display: none;
		}
	}
</style>
