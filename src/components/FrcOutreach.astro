---
/**
 * Outreach on the FRC page: a dark band in both themes (the `dark` class switches the colour tokens inside it). A huge
 * heading over a faint photo of the workshop, the programs as a large index (native <details>: one open at a time, opening when pointed at with a mouse; keyboard
 * and screen readers included, works without JavaScript), then the RoboKids photos as a mosaic (Filmstrip, with its
 * photo viewer). Words: src/text/projects/frc.ts (`outreach`).
 */
import { Filmstrip } from "@/components/frc-views";
import { frcPhotos, outreach, type FrcPhoto } from "@/text/projects/frc";

const backdrop = frcPhotos[outreach.backdrop] as FrcPhoto;
---

<section id="outreach" class="out dark scroll-mt-24" aria-labelledby="outreach-heading">
	<div class="out-backdrop" data-parallax aria-hidden="true">
		<img src={`/assets/frc/${backdrop.id}.webp`} alt="" width={backdrop.w} height={backdrop.h} loading="lazy" decoding="async" />
	</div>

	<div class="wrapper out-inner">
		<header class="out-head">
			<p class="out-tag" data-reveal><span aria-hidden="true"></span>{outreach.tag}</p>
			<h2 id="outreach-heading" class="out-title font-wide" data-words>{outreach.heading}</h2>
			<p class="out-intro" data-reveal>{outreach.intro}</p>
		</header>

		<div class="out-index" data-reveal-group>
			{outreach.programs.map((o, i) => (
				<details class="out-row" name="frc-outreach" open={i === 0}>
					<summary>
						<span class="out-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
						<h3 class="out-name font-wide">{o.name}</h3>
						<span class="out-status" data-live={o.tag.startsWith("Running") ? "" : undefined}>{o.tag}</span>
						<span class="out-plus" aria-hidden="true"></span>
					</summary>
					<div class="out-panel">
						<p class="out-text">{o.text}</p>
						{o.detail && <p class="out-detail">{o.detail}</p>}
						{o.more && (
							<dl class="out-more">
								{o.more.map((m) => (
									<div>
										<dt>{m.k}</dt>
										<dd>{m.v}</dd>
									</div>
								))}
							</dl>
						)}
					</div>
				</details>
			))}
		</div>

		<div class="out-photos">
			<Filmstrip client:visible ids={outreach.photos} label={outreach.photosLabel} mosaic />
			<p class="out-privacy">{outreach.privacy}</p>
		</div>
	</div>
</section>

<script>
	// With a mouse, a row opens when pointed at (touch and keyboard use the row's own click). The short wait lets the
	// pointer pass over rows on its way elsewhere; while the row above closes, the page follows so that this row stays
	// under the pointer, or it would slide away and open the next one.
	const WAIT = 120;
	const SETTLE = 600; // ms: a little over the opening's transition
	let timer: number | undefined;
	const rowOf = (target: EventTarget | null) => (target as Element | null)?.closest?.<HTMLElement>(".out-row summary");
	const open = (row: HTMLDetailsElement) => {
		if (row.open) return;
		const top = row.getBoundingClientRect().top;
		row.open = true;
		const end = performance.now() + SETTLE;
		const hold = () => {
			const moved = row.getBoundingClientRect().top - top;
			if (moved) scrollBy({ top: moved, behavior: "instant" });
			if (performance.now() < end) requestAnimationFrame(hold);
		};
		requestAnimationFrame(hold);
	};
	document.addEventListener("pointerover", (event) => {
		if (event.pointerType !== "mouse") return;
		const summary = rowOf(event.target);
		if (!summary || summary === rowOf(event.relatedTarget)) return;
		clearTimeout(timer);
		timer = window.setTimeout(() => open(summary.parentElement as HTMLDetailsElement), WAIT);
	});
	document.addEventListener("click", (event) => {
		if (rowOf(event.target)) clearTimeout(timer); // a click decides for itself
	});
	document.addEventListener("pointerout", (event) => {
		const summary = rowOf(event.target);
		if (summary && summary !== rowOf(event.relatedTarget)) clearTimeout(timer);
	});
</script>

<style is:global>
	.out {
		position: relative;
		overflow: clip;
		color: var(--foreground);
		background: var(--hero-field);
	}
	/* The workshop, fading into the band behind the heading. */
	.out-backdrop {
		position: absolute;
		inset: 0 0 auto;
		height: min(72svh, 50rem);
		overflow: hidden;
		-webkit-mask-image: linear-gradient(to bottom, #000 15%, transparent 92%);
		mask-image: linear-gradient(to bottom, #000 15%, transparent 92%);
	}
	.out-backdrop img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.24;
	}
	.out-inner {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: clamp(3.5rem, 8vw, 7rem);
		padding-block: clamp(6rem, 14vw, 12rem) clamp(4rem, 8vw, 7rem);
	}
	.out-head {
		display: grid;
		gap: 1.75rem;
	}
	.out-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font: 600 14px/1 ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.out-tag span {
		width: 2.5rem;
		height: 1px;
		background: currentColor;
	}
	.out-title {
		max-width: 11ch;
		font-size: clamp(2.1rem, 8.6vw, 8rem);
		font-weight: 880;
		line-height: 0.96;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}
	.out-intro {
		max-width: 44ch;
		justify-self: end;
		font-size: clamp(1.1rem, 1.6vw, 1.4rem);
		line-height: 1.45;
		color: color-mix(in oklab, var(--foreground) 82%, transparent);
	}

	/* ---------- The programs: one big row each ---------- */
	.out-index {
		border-bottom: 1px solid color-mix(in oklab, var(--foreground) 18%, transparent);
	}
	.out-row {
		border-top: 1px solid color-mix(in oklab, var(--foreground) 18%, transparent);
		interpolate-size: allow-keywords;
	}
	.out-row summary {
		display: grid;
		grid-template-columns: 2.75rem minmax(0, 1fr) auto 2rem;
		align-items: center;
		gap: 1rem;
		min-height: 44px;
		padding-block: clamp(1.1rem, 2.4vw, 2rem);
		cursor: pointer;
		list-style: none;
	}
	.out-row summary::-webkit-details-marker {
		display: none;
	}
	.out-row summary:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 4px;
		border-radius: 0.25rem;
	}
	.out-num {
		font: 500 13px/1 ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
		color: color-mix(in oklab, var(--foreground) 62%, transparent);
	}
	.out-name {
		font-size: clamp(1.5rem, 4.4vw, 4rem);
		font-weight: 850;
		line-height: 1.02;
		letter-spacing: -0.02em;
		transition:
			color 0.3s,
			translate 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.out-row summary:hover .out-name {
		translate: 0.6rem 0;
	}
	.out-row[open] .out-name {
		color: var(--accent);
	}
	.out-status {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.9rem;
		color: color-mix(in oklab, var(--foreground) 78%, transparent);
	}
	.out-status[data-live]::before {
		content: "";
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: #4ade80;
		animation: out-live 2.2s ease-out infinite;
	}
	@keyframes out-live {
		from {
			box-shadow: 0 0 0 0 rgb(74 222 128 / 0.6);
		}
		to {
			box-shadow: 0 0 0 0.6rem rgb(74 222 128 / 0);
		}
	}
	.out-plus {
		position: relative;
		justify-self: end;
		width: 1.1rem;
		height: 1.1rem;
		transition: rotate 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.out-plus::before,
	.out-plus::after {
		content: "";
		position: absolute;
		inset: 50% 0 auto;
		height: 2px;
		margin-top: -1px;
		background: currentColor;
	}
	.out-plus::after {
		rotate: 90deg;
	}
	.out-row[open] .out-plus {
		rotate: 135deg;
	}
	/* Opens smoothly where the browser can animate <details>; elsewhere it simply opens. */
	.out-row::details-content {
		block-size: 0;
		overflow: clip;
		transition:
			block-size 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
			content-visibility 0.5s allow-discrete;
	}
	.out-row[open]::details-content {
		block-size: auto;
	}
	.out-panel {
		display: grid;
		gap: 1.5rem clamp(2rem, 6vw, 6rem);
		padding: 0 0 clamp(1.75rem, 3.5vw, 3rem) 3.75rem;
	}
	.out-text {
		max-width: 48ch;
		font-size: clamp(1.05rem, 1.5vw, 1.3rem);
		line-height: 1.5;
	}
	.out-detail {
		max-width: 44ch;
		align-self: start;
		padding-left: 1rem;
		border-left: 2px solid var(--accent);
		color: color-mix(in oklab, var(--foreground) 82%, transparent);
	}
	.out-more {
		display: grid;
		gap: 0.9rem;
	}
	.out-more dt {
		font-weight: 650;
	}
	.out-more dd {
		color: color-mix(in oklab, var(--foreground) 78%, transparent);
	}
	@media (min-width: 900px) {
		.out-panel {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}
	@media (max-width: 639px) {
		.out-row summary {
			grid-template-columns: minmax(0, 1fr) 1.5rem;
			gap: 0.35rem 0.75rem;
		}
		.out-num {
			display: none;
		}
		.out-status {
			grid-row: 2;
		}
		.out-plus {
			grid-row: 1 / span 2;
			grid-column: 2;
		}
		.out-panel {
			padding-left: 0;
		}
		.out-intro {
			justify-self: start;
		}
	}

	/* ---------- RoboKids: the photos as a mosaic ---------- */
	.out-photos {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.out-privacy {
		font-size: 0.875rem;
		color: color-mix(in oklab, var(--foreground) 72%, transparent);
	}
	.frc-mosaic {
		display: grid;
		gap: 0.75rem;
		grid-auto-rows: 14rem;
	}
	.frc-mosaic li:nth-child(2) {
		grid-row: span 2;
	}
	.frc-mosaic figure {
		position: relative;
	}
	.frc-mosaic button {
		height: 100%;
	}
	/* The caption sits on the photo, on its own gradient, so it stays readable on any of them. */
	.frc-mosaic figcaption {
		position: absolute;
		inset: auto 0 0;
		padding: 2.5rem 1rem 0.8rem;
		border-radius: 0 0 0.75rem 0.75rem;
		color: #fff;
		background: linear-gradient(to top, rgb(5 12 40 / 0.9), transparent);
		pointer-events: none;
	}
	@media (min-width: 640px) {
		.frc-mosaic {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.frc-mosaic li:first-child {
			grid-column: span 2;
		}
	}
	@media (min-width: 1024px) {
		.frc-mosaic {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			grid-auto-rows: clamp(15rem, 21vw, 21rem);
		}
		.frc-mosaic li:nth-child(1) {
			grid-column: span 8;
		}
		.frc-mosaic li:nth-child(2) {
			grid-column: span 4;
		}
		.frc-mosaic li:nth-child(3),
		.frc-mosaic li:nth-child(4) {
			grid-column: span 4;
		}
		.frc-mosaic li:nth-child(5),
		.frc-mosaic li:nth-child(6) {
			grid-column: span 6;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.out-status[data-live]::before {
			animation: none;
		}
		.out-name,
		.out-plus,
		.out-row::details-content {
			transition: none;
		}
	}
	html.reduce-motion .out-status[data-live]::before {
		animation: none;
	}
	html.reduce-motion .out-name,
	html.reduce-motion .out-plus,
	html.reduce-motion .out-row::details-content {
		transition: none;
	}
</style>
