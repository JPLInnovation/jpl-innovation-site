---
/**
 * A project's current status, set as part of the text (a short yellow rule, then the words), never as a pill or badge:
 * the drawing's status note. Inline, so it sits in a sentence, a title block or a table cell as well as on its own.
 *
 *   <StatusTag>Bench tested</StatusTag>
 */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={["status-tag", className]}><slot /></span>

<style>
	.status-tag {
		display: inline-flex;
		align-items: baseline;
		gap: 0.55em;
		font-size: var(--step-small);
		font-weight: 600;
		color: var(--ink);
	}
	/* the yellow mark of the spec: one short rule, like a revision note's leader */
	.status-tag::before {
		content: "";
		flex: none;
		width: 1.1em;
		height: 0.2em;
		border-radius: 1px;
		background: var(--mark);
		transform: translateY(-0.28em);
	}
	@media (forced-colors: active) {
		.status-tag::before {
			background: CanvasText;
		}
	}
</style>
