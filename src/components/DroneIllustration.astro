---
/**
 * A quad drawn from above, as on a general arrangement drawing (quad-X, front up, the front arms in the accent), with
 * its one stated size as a real dimension: the line from motor to motor across the frame, its number counting up
 * (data-count, src/scripts/motion.ts) as the line draws out (./drone/Lit's data-lights moment).
 * Drawn to scale in millimetres from the page's own figures; nothing else is measured or labelled.
 *
 *   <DroneIllustration label="…" wheelbase={450} prop={254} dimension="450 mm frame" />
 */
interface Props {
	/** Read aloud by screen readers. */
	label: string;
	/** Motor to motor across the frame (diagonal), in mm. */
	wheelbase: number;
	/** Propeller diameter, in mm. */
	prop: number;
	/** The dimension's words; a leading number counts up ("450 mm frame"). */
	dimension: string;
	/** Motor and centre plate size as a share of the wheelbase (the drawing's proportions only). */
	motor?: number;
	plate?: number;
	class?: string;
}
const { label, wheelbase, prop, dimension, motor = 0.032, plate = 0.3, class: className } = Astro.props;

const d = wheelbase / (2 * Math.SQRT2); // motor centre, from the middle, on each axis
const r = prop / 2;
const m = wheelbase * motor;
const p = (wheelbase * plate) / 2;
const u = wheelbase / 100; // one drawing unit: line widths and text scale with the drone
const motors = [
	{ x: -d, y: -d, front: true, a: 25 },
	{ x: d, y: -d, front: true, a: -40 },
	{ x: -d, y: d, front: false, a: 70 },
	{ x: d, y: d, front: false, a: -10 },
];
// The dimension: parallel to the front-left to rear-right diagonal, out past the rear-left prop.
const off = wheelbase / 2 + r + 10 * u;
const k = off / Math.SQRT2;
const a = { x: -d - k, y: -d + k };
const b = { x: d - k, y: d + k };
const mid = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
const half = wheelbase / 2;
/** An extension line: from just off a motor's centre, out past the dimension line (along the dimension's normal). */
const ext = (x: number, y: number, to: { x: number; y: number }) => {
	const n = Math.SQRT1_2;
	const s = m + 2 * u;
	return `M${x - s * n} ${y + s * n}L${to.x - 3 * u * n} ${to.y + 3 * u * n}`;
};
const [, num, rest] = dimension.match(/^(\d+)(.*)$/) ?? [null, null, dimension];
const pad = 8 * u;
const minX = a.x - pad * 2;
const minY = -d - r - pad;
const maxX = d + r + pad;
const maxY = b.y + pad * 2;
---

<svg class:list={["plan", className]} viewBox={`${minX} ${minY} ${maxX - minX} ${maxY - minY}`} role="img" aria-label={label} data-lights>
	<g class="plan-body" stroke-linecap="round" fill="none">
		{motors.map((o) => <circle class="plan-disc" cx={o.x} cy={o.y} r={r} stroke-width={0.5 * u} stroke-dasharray={`${2 * u} ${2 * u}`} />)}
		{motors.map((o) => <line class:list={["plan-arm", { front: o.front }]} x1={Math.sign(o.x) * p * 0.7} y1={Math.sign(o.y) * p * 0.7} x2={o.x} y2={o.y} stroke-width={(o.front ? 2.6 : 1.8) * u} />)}
		<rect class="plan-plate" x={-p} y={-p} width={2 * p} height={2 * p} rx={p * 0.25} stroke-width={0.9 * u} />
		<rect class="plan-plate" x={-p * 0.42} y={-p * 0.42} width={p * 0.84} height={p * 0.84} rx={p * 0.08} stroke-width={0.7 * u} />
		{
			motors.map((o) => (
				<g transform={`translate(${o.x} ${o.y})`}>
					<line class="plan-blade" x1={-r * 0.92} x2={r * 0.92} y1="0" y2="0" transform={`rotate(${o.a})`} stroke-width={1.6 * u} />
					<circle class="plan-motor" r={m} stroke-width={0.9 * u} />
					<circle class="plan-hub" r={m * 0.32} />
				</g>
			))
		}
		<!-- centre lines through the motors -->
		<path class="plan-centre" d={`M${-d - r * 0.3} ${-d - r * 0.3}L${d + r * 0.3} ${d + r * 0.3}M${d + r * 0.3} ${-d - r * 0.3}L${-d - r * 0.3} ${d + r * 0.3}`} stroke-width={0.35 * u} stroke-dasharray={`${6 * u} ${1.5 * u} ${1 * u} ${1.5 * u}`} />
	</g>
	<g class="plan-dim" aria-hidden="true">
		<!-- extension lines from the two motor centres -->
		<path d={ext(-d, -d, a) + ext(d, d, b)} stroke-width={0.4 * u} />
		<g transform={`translate(${mid.x} ${mid.y}) rotate(45)`}>
			<g class="plan-dim-line">
				<line x1={-half} x2={half} y1="0" y2="0" stroke-width={0.6 * u} />
				<path d={`M${-half} 0l${4 * u} ${-1.3 * u}v${2.6 * u}zM${half} 0l${-4 * u} ${-1.3 * u}v${2.6 * u}z`} class="plan-arrow" />
			</g>
			<text y={7.6 * u} text-anchor="middle" font-size={5.4 * u}>
				{num ? <tspan data-count={num}>{num}</tspan> : null}<tspan>{rest}</tspan>
			</text>
		</g>
	</g>
</svg>

<style>
	.plan {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
		color: var(--ink);
	}
	.plan-body {
		stroke: currentColor;
	}
	.plan-disc {
		stroke: var(--ink-soft);
		opacity: 0.7;
	}
	.plan-arm.front {
		stroke: var(--accent-brand);
	}
	.plan-blade {
		stroke: var(--ink-soft);
	}
	.plan-motor {
		fill: var(--field);
	}
	.plan-hub {
		fill: currentColor;
		stroke: none;
	}
	.plan-centre {
		stroke: var(--ink-soft);
		opacity: 0.6;
	}
	.plan-dim {
		stroke: var(--ink-soft);
		fill: none;
	}
	.plan-arrow {
		fill: var(--ink);
		stroke: none;
	}
	.plan-dim line {
		stroke: var(--ink);
	}
	.plan-dim text {
		fill: var(--ink);
		stroke: none;
		font-weight: 700;
		font-stretch: 112%;
		font-variant-numeric: tabular-nums;
	}
	/* The dimension draws out from its middle when the drawing comes into view (transform only). */
	.plan-dim-line {
		transform-box: fill-box;
		transform-origin: center;
	}
	:global(.motion) .plan-dim-line {
		scale: 0 1;
		transition: scale 1.3s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s;
	}
	:global(.motion) .plan[data-lit] .plan-dim-line {
		scale: 1 1;
	}
</style>
