---
/**
 * The whole team, under the page's heading (src/pages/work/frc.astro): the photo starts small and centred, grows as
 * the page scrolls until it fills the screen, holds there with its words over it, then lets the page move on.
 *
 * Scroll position alone decides how far it has grown (--p, 0 to 1), so scrolling back up runs it backwards. With
 * reduced motion nothing sticks or grows: the photo simply shows at full width with its words beneath.
 */
import type { FrcPhoto } from "@/text/projects/frc";

interface Props {
	photo: FrcPhoto;
	/** The line over the photo once it fills the screen. */
	words: string;
	meta?: string;
}

const { photo, words, meta } = Astro.props;
---

<section class="treveal" aria-label={photo.alt}>
	<div class="treveal-track">
		<div class="treveal-stick">
			<figure class="treveal-frame" style={`--ratio: ${photo.w} / ${photo.h}`}>
				<img
					src={`/assets/frc/${photo.id}-640.webp`}
					srcset={`/assets/frc/${photo.id}-640.webp 640w, /assets/frc/${photo.id}.webp ${photo.w}w`}
					sizes="100vw"
					alt={photo.alt}
					width={photo.w}
					height={photo.h}
					fetchpriority="high"
				/>
				<figcaption class="treveal-words">
					<p class="font-wide">{words}</p>
					{meta && <p class="treveal-meta">{meta}</p>}
				</figcaption>
			</figure>
		</div>
	</div>
</section>

<style>
	/* The track is taller than the screen: how far through it you are is how far the photo has grown. */
	.treveal-track {
		height: 230svh;
	}
	.treveal-stick {
		position: sticky;
		top: 0;
		display: grid;
		place-items: center;
		height: 100svh;
		overflow: hidden;
	}
	/* Full screen at --p 1, a little under half that at 0; the corners square off as it fills the screen. */
	.treveal-frame {
		--p: 0;
		position: relative;
		margin: 0;
		/* Its own shape, never taller than the screen: the photo is 1800 px wide, so filling the whole screen
		   height would blow it up past its own detail and soften it. */
		width: 100vw;
		aspect-ratio: var(--ratio);
		max-height: 100svh;
		overflow: hidden;
		border-radius: calc((1 - var(--p)) * 2.5rem);
		transform: scale(calc(0.62 + 0.38 * var(--p)));
		will-change: transform;
	}
	.treveal-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}
	/* The words arrive once the photo has nearly filled the screen. */
	.treveal-words {
		position: absolute;
		inset: auto 0 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 6rem clamp(1.25rem, 5vw, 4.5rem) clamp(1.5rem, 5vh, 3.5rem);
		background: linear-gradient(to top, rgb(3 7 14 / 0.92), rgb(3 7 14 / 0.6) 45%, transparent 88%);
		color: #fff;
		opacity: clamp(0, (var(--p) - 0.62) / 0.22, 1);
		transform: translateY(calc((1 - clamp(0, (var(--p) - 0.62) / 0.22, 1)) * 1.5rem));
		/* It is scaled with the frame: cancel that out so the words read at their own size. */
		scale: calc(1 / (0.62 + 0.38 * var(--p)));
		transform-origin: bottom center;
	}
	.treveal-words p:first-child {
		max-width: 22ch;
		font-size: clamp(1.75rem, 4.6vw, 3.75rem);
		font-weight: 880;
		line-height: 1.02;
		text-shadow: 0 2px 24px rgb(3 7 14 / 0.6);
	}
	.treveal-meta {
		font-size: 0.95rem;
		color: rgb(255 255 255 / 0.75);
	}
	@media (prefers-reduced-motion: reduce) {
		.treveal-track {
			height: auto;
		}
		.treveal-stick {
			position: static;
			height: auto;
		}
		.treveal-frame {
			width: 100%;
			max-height: none;
			border-radius: 0;
			transform: none;
		}
		.treveal-words {
			opacity: 1;
			transform: none;
			scale: 1;
		}
	}
</style>

<script>
	// How far the photo has grown is how far the track has scrolled: one listener, one custom property.
	function initTeamReveal() {
		const track = document.querySelector<HTMLElement>(".treveal-track");
		const frame = track?.querySelector<HTMLElement>(".treveal-frame");
		const stick = track?.querySelector<HTMLElement>(".treveal-stick");
		if (!track || !frame || !stick || track.dataset.ready) return;
		track.dataset.ready = "1";
		if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		let pending = 0;
		const place = () => {
			pending = 0;
			const span = track.offsetHeight - stick.offsetHeight;
			const grown = span > 0 ? -track.getBoundingClientRect().top / (span * 0.6) : 1;
			frame.style.setProperty("--p", String(Math.min(1, Math.max(0, grown))));
		};
		const onScroll = () => {
			if (!pending) pending = requestAnimationFrame(place);
		};
		place();
		addEventListener("scroll", onScroll, { passive: true });
		addEventListener("resize", onScroll);
	}
	initTeamReveal();
	document.addEventListener("astro:page-load", initTeamReveal);
</script>
