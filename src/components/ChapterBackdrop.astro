---
/**
 * The opening of a project chapter: slow footage of the project's own station in the studio (the same renders as the
 * home page's read mode, public/studio/scenes/), behind the page's first screen. It lights up from darkness once, as
 * if the studio's lights came on, then drifts. The picture itself fades out towards the words and the page (a mask,
 * not a scrim), so the text keeps its contrast without a gradient laid over anything. Decorative: no alt text.
 * Put it first inside <BaseLayout>; the layout's <main> is its frame.
 */
interface Props {
	/** The project's id (the file name in src/text/projects/): drone, frc, cybersecurity, mini-drone, lifetime. */
	project: string;
}
const scenes: Record<string, string> = { drone: "drones", frc: "robotics", cybersecurity: "networks", "mini-drone": "sketch", lifetime: "web" };
const scene = scenes[Astro.props.project] ?? "sketch";
---

<div class="chapter-backdrop" data-scene={scene} aria-hidden="true">
	<img
		src={`/studio/scenes/${scene}-800.webp`}
		srcset={`/studio/scenes/${scene}-800.webp 800w, /studio/scenes/${scene}.webp 1600w`}
		sizes="100vw"
		width="1600"
		height="900"
		alt=""
		fetchpriority="low"
	/>
</div>

<style is:global>
	.chapter-backdrop {
		position: absolute;
		inset: 0 0 auto 0;
		z-index: -1;
		height: min(92svh, 860px);
		overflow: hidden;
		pointer-events: none;
		/* fades towards the words (left) and into the page (bottom): two masks, kept where both keep it */
		-webkit-mask-image:
			linear-gradient(to right, transparent 8%, #000 62%),
			linear-gradient(to bottom, #000 35%, transparent 100%);
		-webkit-mask-composite: source-in;
		mask-image:
			linear-gradient(to right, transparent 8%, #000 62%),
			linear-gradient(to bottom, #000 35%, transparent 100%);
		mask-composite: intersect;
	}
	.chapter-backdrop img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: var(--backdrop-lit);
		transform-origin: 70% 40%;
		animation:
			chapter-lights 2.2s cubic-bezier(0.3, 0, 0.2, 1) 0.3s backwards,
			chapter-drift 36s ease-in-out infinite alternate;
	}
	:root {
		--backdrop-lit: 0.22;
	}
	.dark {
		--backdrop-lit: 0.5;
	}
	/* The drone page (two columns, 1024 px and up): the drone is small and low in its shot, and the page's text and 3D
	   card cover the rest, so the shot is zoomed in on the landing pad and moved up behind the top of the page, like the
	   KitBot on FRC. Phones and tablets keep the whole shot. */
	@media (min-width: 1024px) {
		.chapter-backdrop[data-scene="drones"] img {
			position: absolute;
			max-width: none;
			width: 200%;
			height: 200%;
			left: -16%;
			top: -61%;
		}
	}
	/* Phones: the words run over the whole picture, so it only fades into the page, and stays dimmer. */
	@media (max-width: 767px) {
		.chapter-backdrop {
			-webkit-mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
			mask-image: linear-gradient(to bottom, #000 30%, transparent 100%);
		}
		:root {
			--backdrop-lit: 0.12;
		}
		.dark {
			--backdrop-lit: 0.3;
		}
	}
	@keyframes chapter-lights {
		from {
			opacity: 0;
		}
	}
	@keyframes chapter-drift {
		from {
			transform: scale(1.1) translate3d(1.5%, 0, 0);
		}
		to {
			transform: scale(1.02) translate3d(-1.5%, -1%, 0);
		}
	}
	html.reduce-motion .chapter-backdrop img {
		animation: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.chapter-backdrop img {
			animation: none;
		}
	}
</style>
