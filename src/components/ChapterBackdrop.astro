---
/**
 * The opening of a project chapter: slow footage of the project's own station in the studio (the same renders as the
 * home page's read mode, public/studio/scenes/), behind the page's first screen, fading into the page. A scrim from the
 * text's side keeps the words' contrast (measured, not guessed: see SHOWCASE.md). Decorative: no alt text.
 * Put it first inside <BaseLayout>; the layout's <main> is its frame.
 */
interface Props {
	/** The project's id (the file name in src/text/projects/): drone, frc, cybersecurity, mini-drone. */
	project: string;
}
const scenes: Record<string, string> = { drone: "drones", frc: "robotics", cybersecurity: "networks", "mini-drone": "sketch" };
const scene = scenes[Astro.props.project] ?? "sketch";
---

<div class="chapter-backdrop" aria-hidden="true">
	<img
		src={`/studio/scenes/${scene}-800.webp`}
		srcset={`/studio/scenes/${scene}-800.webp 800w, /studio/scenes/${scene}.webp 1600w`}
		sizes="100vw"
		width="1600"
		height="900"
		alt=""
		fetchpriority="low"
	/>
	<div class="chapter-scrim"></div>
</div>

<style is:global>
	.chapter-backdrop {
		position: absolute;
		inset: 0 0 auto 0;
		z-index: -1;
		height: min(90svh, 820px);
		overflow: hidden;
		pointer-events: none;
		-webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent 100%);
		mask-image: linear-gradient(to bottom, #000 40%, transparent 100%);
	}
	.chapter-backdrop img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.2;
		transform-origin: 70% 40%;
		animation: chapter-drift 36s ease-in-out infinite alternate;
	}
	.dark .chapter-backdrop img {
		opacity: 0.4;
	}
	html:not(.dark) .chapter-backdrop img {
		opacity: 0.16;
	}
	/* From the side the words are on, so they keep their contrast over the brightest part of the picture. */
	.chapter-scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, var(--background) 0%, color-mix(in oklab, var(--background) 80%, transparent) 50%, transparent 100%);
	}
	html:not(.dark) .chapter-scrim {
		background: linear-gradient(90deg, var(--background) 0%, color-mix(in oklab, var(--background) 92%, transparent) 55%, transparent 100%);
	}
	@media (max-width: 767px) {
		.chapter-scrim,
		html:not(.dark) .chapter-scrim {
			background: color-mix(in oklab, var(--background) 78%, transparent);
		}
	}
	@keyframes chapter-drift {
		from {
			transform: scale(1.1) translate3d(1.5%, 0, 0);
		}
		to {
			transform: scale(1.02) translate3d(-1.5%, -1%, 0);
		}
	}
	html.reduce-motion .chapter-backdrop img {
		animation: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.chapter-backdrop img {
			animation: none;
		}
	}
</style>
