---
/**
 * The 3D studio's loading screen (Studio.astro): the studio's plan, seen from above, drawing itself on the blueprint as
 * the room really loads (engine.ts, ready). Stage 0 the room and its furniture; 1 the KitBot and the F450 on their
 * benches; 2 the tour the camera will take through the room (the scenes' own camera stops, scenes.ts); 3 the pools of
 * light over each station. A title block in the corner says what is loading. When it is all in, the plan lifts away
 * into the room.
 *
 * It must keep moving while the page is busy building the room, so everything that moves here is a transform or an
 * opacity on an HTML element (those run on the compositor, off the page's own thread): each stage is its own layer,
 * wiped on from the left by a clip that slides one way while its drawing slides back the other (so the drawing stands
 * still and the edge sweeps across it, a yellow line on the edge like a plotter's head). Never animate stroke-dashoffset,
 * clip-path or anything inside the SVG here: those stop whenever the page's thread is busy. Nothing moves until the
 * stage has made its renderer (Studio.astro sets data-loader-go right after): that one block stalls the compositor
 * too, and it passes unseen on a still screen.
 *
 * Measurements: the room's own (room.ts ROOM and DESK, stations.ts), in metres, x across, z into the room.
 * Words: src/text/studio.ts (`loading`).
 */
import { HOME, SHOTS } from "@/lib/studio/scenes";
import { studio } from "@/text/studio";

const t = studio.loading;
const R = { x0: -8.5, x1: 8.5, z0: -3.4, z1: 6.4 };
/** A box on the floor plan: centre, size, its label (optional) and the stage it is drawn in. */
const boxes: { x: number; z: number; w: number; d: number; label?: string; above?: boolean; stage: number }[] = [
	{ x: -6, z: -2.45, w: 2.3, d: 0.9, label: t.plan.desk, stage: 0 },
	{ x: -4.15, z: -2.4, w: 1.0, d: 0.62, stage: 0 },
	{ x: -2.6, z: -2.6, w: 1.6, d: 0.8, label: t.plan.test, stage: 0 },
	{ x: -0.6, z: -2.55, w: 1.1, d: 0.86, stage: 0 },
	{ x: 1.4, z: -2.6, w: 1.6, d: 0.8, stage: 0 },
	{ x: 2.58, z: -2.7, w: 0.6, d: 0.6, label: t.plan.software, stage: 0 },
	{ x: 3.3, z: -2.95, w: 0.74, d: 0.64, label: t.plan.rack, above: true, stage: 0 },
	{ x: -2.4, z: 5.1, w: 2.2, d: 0.95, label: t.plan.table, stage: 0 },
	...[-4.05, -2.95, -1.85, -0.75].map((x) => ({ x, z: 5.85, w: 0.5, d: 0.5, stage: 0 })),
	// the robot on its cart (its frame and bumpers), stage 1
	{ x: -0.56, z: -2.55, w: 0.72, d: 0.62, label: t.plan.robot, stage: 1 },
];
const rect = (b: (typeof boxes)[number]) => `M${b.x - b.w / 2} ${b.z - b.d / 2}h${b.w}v${b.d}h${-b.w}Z`;
// The F450 from above on its bench: an X of arms, a prop disc at each end.
const drone = { x: 1.4, z: -2.55, arm: 0.32 };
// The curved wall of projects (stations.ts: the arc's centre, radius, its cylinder from pi/2 - 0.6 over 1.2 rad).
const arc = { x: 3.6, z: 1.0, r: 4.1, a0: Math.PI / 2 - 0.6, a1: Math.PI / 2 + 0.6 };
const at = (a: number) => [arc.x + arc.r * Math.sin(a), arc.z + arc.r * Math.cos(a)] as const;
const [ax0, az0] = at(arc.a0);
const [ax1, az1] = at(arc.a1);
const wallArc = `M${ax0.toFixed(2)} ${az0.toFixed(2)}A${arc.r} ${arc.r} 0 0 0 ${ax1.toFixed(2)} ${az1.toFixed(2)}`;
// The tour: the camera's stops in order (the simulated flight's three happen inside the screen: left out).
const stops = HOME.filter((id) => !id.startsWith("sim")).map((id) => SHOTS[id].camera);
const tour = stops.map(([x, , z], i) => `${i ? "L" : "M"}${x.toFixed(2)} ${z.toFixed(2)}`).join("") + "Z";
// The pools of light (the bench lamps, room.ts SCENE_LAMPS), stage 3.
const pools = [
	[-6, -2.2, 1.3], [-4.15, -2.2, 0.9], [-2.6, -2.3, 1.0], [-0.6, -2.3, 1.0], [1.4, -2.3, 1.0], [3.3, -2.5, 0.8], [5.0, 5.6, 1.4], [-2.4, 5.0, 1.5],
] as const;
const labels: { x: number; z: number; text: string; stage: number }[] = [
	{ x: 7.2, z: 1.0, text: t.plan.projects, stage: 0 },
	{ x: 5.0, z: 6.0, text: t.plan.whiteboard, stage: 0 },
	{ x: -0.3, z: 6.75, text: t.plan.window, stage: 0 },
	{ x: -5.6, z: 6.75, text: t.plan.door, stage: 0 },
	{ x: 1.4, z: -1.85, text: t.plan.drone, stage: 1 },
];
---

<div class="sl" role="status" aria-live="polite" data-studio-loader>
	<div class="sl-sheet">
		<p class="sl-title">{t.heading}</p>
		<div class="sl-plan" aria-hidden="true">
			{
				[0, 1, 2, 3].map((stage) => (
					<div class="sl-wipe" data-loader-stage={stage}>
						<svg class="sl-layer" viewBox="-9.2 -4.4 18.4 11.8">
							{stage === 0 && (
								<>
									<path class="sl-wall" d={`M${R.x0} ${R.z0}H${R.x1}V${R.z1}H${R.x0}Z`} />
									<path class="sl-glass" d={`M-4.6 ${R.z1}H3.9`} />
									<path class="sl-thin" d={`M-6.2 ${R.z1}A0.9 0.9 0 0 1 -5.3 5.5`} />
									<path class="sl-wall" d={wallArc} />
									<path class="sl-thin" d={`M3.85 ${R.z1 - 0.05}H6.15`} />
								</>
							)}
							{stage === 1 && (
								<>
									<path class="sl-hot" d={`M${drone.x - drone.arm} ${drone.z - drone.arm}L${drone.x + drone.arm} ${drone.z + drone.arm}M${drone.x + drone.arm} ${drone.z - drone.arm}L${drone.x - drone.arm} ${drone.z + drone.arm}`} />
									{[[-1, -1], [1, -1], [1, 1], [-1, 1]].map(([sx, sz]) => <circle class="sl-hot" cx={drone.x + sx * drone.arm} cy={drone.z + sz * drone.arm} r="0.13" />)}
								</>
							)}
							{boxes.filter((b) => b.stage === stage).map((b) => <path class={stage === 0 ? "sl-thin" : "sl-hot"} d={rect(b)} />)}
							{stage === 2 && (
								<>
									<path class="sl-tour" d={tour} />
									{stops.map(([x, , z]) => <circle class="sl-stop" cx={x} cy={z} r="0.09" />)}
								</>
							)}
							{stage === 3 && pools.map(([x, z, r]) => <circle class="sl-pool" cx={x} cy={z} r={r} />)}
							{
								[...boxes.filter((b) => b.label).map((b) => ({ x: b.x, z: b.above ? b.z - b.d / 2 - 0.16 : b.z + b.d / 2 + 0.38, text: b.label!, stage: b.stage })), ...labels]
									.filter((l) => l.stage === stage)
									.map((l) => (
										<text class="sl-label" x={l.x} y={l.z} text-anchor="middle">
											{l.text}
										</text>
									))
							}
						</svg>
					</div>
				))
			}
		</div>
		<dl class="sl-block">
			<div><dt>{t.block.drawing}</dt><dd>{t.block.drawingValue}</dd></div>
			<div><dt>{t.block.view}</dt><dd>{t.block.viewValue}</dd></div>
			<div class="sl-status"><dt>{t.block.status}</dt><dd data-loading-step data-steps={t.steps.join("|")}>{t.steps[0]}</dd></div>
			<span class="sl-bar" aria-hidden="true"><i data-loading-bar></i><b></b></span>
		</dl>
	</div>
</div>

<style is:global>
	/* Shown only while the 3D is coming (Studio.astro sets data-live when it is in). */
	.sl {
		display: none;
	}
	html.studio-on .studio:not([data-read]):not([data-live]) .sl,
	html.studio-on .studio[data-leaving-loader] .sl {
		position: fixed;
		inset: 0;
		z-index: 201; /* above the logo intro while it waits (SplashShell.astro) */
		display: grid;
		place-items: center;
		padding: clamp(1rem, 3vw, 2.5rem);
		color: #f2eedf;
		background:
			linear-gradient(rgb(143 184 245 / 0.06) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem,
			linear-gradient(90deg, rgb(143 184 245 / 0.06) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem,
			#071038;
	}
	/* The logo intro plays first; the plan takes over once it waits for the room. */
	html.splash:not(.splash-hold) .studio:not([data-live]) .sl {
		display: none;
	}
	/* Done: the plan lifts away into the room (opacity and transform: compositor). */
	.studio[data-leaving-loader] .sl {
		pointer-events: none;
		animation: sl-leave 0.9s cubic-bezier(0.65, 0, 0.35, 1) forwards;
	}
	.studio[data-leaving-loader] .sl-plan {
		animation: sl-lift 0.9s cubic-bezier(0.65, 0, 0.35, 1) forwards;
	}
	@keyframes sl-leave {
		to {
			opacity: 0;
		}
	}
	@keyframes sl-lift {
		to {
			transform: scale(1.18);
		}
	}
	.sl-sheet {
		position: relative;
		display: grid;
		gap: 1.25rem;
		width: min(72rem, 100%);
	}
	.sl-title {
		font-size: clamp(1.75rem, 1.1rem + 2.4vw, 3.25rem);
		font-weight: 850;
		font-stretch: 125%;
		letter-spacing: -0.02em;
		line-height: 1;
	}
	.sl-plan {
		position: relative;
		width: min(100%, calc(68svh * 18.4 / 11.8));
		aspect-ratio: 18.4 / 11.8;
		margin-inline: auto;
		transform-origin: 50% 55%;
	}
	/* One layer per stage. The clip slides in from the left while the drawing inside slides back by the same amount,
	   both linear and started together, so the drawing stands still and its edge sweeps across. */
	.sl-wipe {
		position: absolute;
		inset: 0;
		overflow: hidden;
		transform: translateX(-101%);
		will-change: transform;
	}
	.sl-layer {
		display: block;
		width: 100%;
		height: 100%;
		transform: translateX(101%);
		will-change: transform;
	}
	/* the plotter's head: a yellow line on the sweeping edge, gone once the stage is drawn */
	.sl-wipe::after {
		content: "";
		position: absolute;
		inset: 0 0 0 auto;
		width: 2px;
		background: #f5d042;
		opacity: 0;
	}
	.studio[data-loader-go] .sl-wipe[data-loader-stage="0"],
	.sl-wipe[data-on] {
		animation: sl-clip 1.3s linear var(--sl-wait, 0s) forwards;
	}
	.studio[data-loader-go] .sl-wipe[data-loader-stage="0"] > .sl-layer,
	.sl-wipe[data-on] > .sl-layer {
		animation: sl-back 1.3s linear var(--sl-wait, 0s) forwards;
	}
	.studio[data-loader-go] .sl-wipe[data-loader-stage="0"]::after,
	.sl-wipe[data-on]::after {
		animation: sl-head 1.3s linear var(--sl-wait, 0s) both;
	}
	/* the first stage waits a third of a second more: the room's first slice of building is the last bump */
	.sl-wipe[data-loader-stage="0"] {
		--sl-wait: 0.35s;
	}
	@keyframes sl-clip {
		to {
			transform: none;
		}
	}
	@keyframes sl-back {
		to {
			transform: none;
		}
	}
	@keyframes sl-head {
		0% {
			opacity: 0;
		}
		2%,
		88% {
			opacity: 1;
		}
		100% {
			opacity: 0;
		}
	}
	/* the lights come up rather than being drawn */
	.sl-wipe[data-loader-stage="3"] {
		transform: none;
		opacity: 0;
	}
	.sl-wipe[data-loader-stage="3"] > .sl-layer {
		transform: scale(0.94);
	}
	.sl-wipe[data-loader-stage="3"][data-on] {
		animation: sl-up 1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}
	.sl-wipe[data-loader-stage="3"][data-on] > .sl-layer {
		animation: sl-back 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
	}
	.sl-wipe[data-loader-stage="3"]::after {
		display: none;
	}
	@keyframes sl-up {
		to {
			opacity: 1;
		}
	}
	.sl-layer :is(path, circle) {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.sl-wall {
		stroke: #f2eedf;
		stroke-width: 0.05; /* metres: the plan is drawn in the room's own units */
	}
	.sl-glass {
		stroke: #8fb8f5;
		stroke-width: 0.08;
	}
	.sl-thin {
		stroke: rgb(242 238 223 / 0.7);
		stroke-width: 0.026;
	}
	.sl-hot {
		stroke: #8fb8f5;
		stroke-width: 0.036;
	}
	.sl-tour {
		stroke: #f5d042;
		stroke-width: 0.045;
	}
	.sl-layer .sl-stop {
		fill: #f5d042;
		stroke: none;
	}
	.sl-layer .sl-pool {
		fill: rgb(245 208 66 / 0.13);
		stroke: none;
	}
	.sl-label {
		font-size: 0.3px;
		font-weight: 600;
		fill: rgb(242 238 223 / 0.72);
	}
	/* the title block, in the corner as on the site's drawing sheets */
	.sl-block {
		justify-self: end;
		display: grid;
		grid-template-columns: auto auto minmax(14rem, auto);
		border: 1px solid rgb(242 238 223 / 0.22);
		border-radius: 0.6rem;
		overflow: hidden;
		font-size: 0.8125rem;
	}
	.sl-block > div {
		padding: 0.55rem 0.9rem;
		border-left: 1px solid rgb(242 238 223 / 0.18);
	}
	.sl-block > div:first-child {
		border-left: 0;
	}
	.sl-block dt {
		color: rgb(242 238 223 / 0.6);
	}
	.sl-block dd {
		font-weight: 650;
		font-size: 0.9375rem;
	}
	.sl-bar {
		grid-column: 1 / -1;
		position: relative;
		height: 3px;
		background: rgb(242 238 223 / 0.12);
		overflow: hidden;
	}
	.sl-bar i {
		position: absolute;
		inset: 0;
		background: #f5d042;
		transform-origin: left center;
		transform: scaleX(var(--done, 0.06));
		transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
		will-change: transform;
	}
	/* a light running along the bar, always: the sign that nothing has stopped */
	.sl-bar b {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, transparent, rgb(242 238 223 / 0.75), transparent);
		transform: translateX(-100%);
		will-change: transform;
	}
	.studio[data-loader-go] .sl-bar b {
		animation: sl-run 1.4s linear 0.35s infinite;
	}
	@keyframes sl-run {
		to {
			transform: translateX(100%);
		}
	}
	@media (max-width: 760px) {
		.sl-block {
			justify-self: stretch;
			grid-template-columns: 1fr;
		}
		.sl-block > div {
			border-left: 0;
			border-top: 1px solid rgb(242 238 223 / 0.18);
		}
	}
	html.studio-loading {
		overflow: hidden;
	}
</style>
