---
/**
 * Leadership block: each leader's photo, name and titles at JPL Innovation and on FRC Team 10951.
 * Titles come from the `leadership` field in src/text/members/*.md.
 *   lead="jpl" lists the JPL Innovation title first (members page); lead="frc" lists the FRC title first (FRC page).
 * The photographs rest in the brand's two inks and come up in colour on hover or focus, as on the crew sheet.
 */
import Portrait from "@/components/members/Portrait.astro";
import { getLeaders, leadershipRoles } from "@/lib/content";

interface Props {
	lead?: "jpl" | "frc";
	heading?: string;
	intro?: string;
	headingLevel?: "h2" | "h3";
	id?: string;
}

const { lead = "jpl", heading = "Leadership", intro, headingLevel: Heading = "h2", id = "leadership" } = Astro.props;
const leaders = await getLeaders();
---

<div class="lead">
	<div class="lead__head">
		<Heading id={`${id}-heading`} class="lead__title">{heading}</Heading>
		{intro && <p class="lead__intro">{intro}</p>}
	</div>
	<ul class="lead__list" role="list" aria-labelledby={`${id}-heading`}>
		{
			leaders.map((m) => {
				const roles = leadershipRoles(m, lead);
				return (
					<li class="press lead__item">
						<div class="lead__photo">
							<Portrait src={m.data.img} alt="" sizes="80px" />
						</div>
						<div class="lead__text">
							<a href={`/members/${m.id}/`} class="lead__name">
								{m.data.title}
							</a>
							<ul class="lead__roles" role="list">
								{roles.map((r, i) => (
									<li class={i === 0 ? "lead__first" : "lead__then"}>
										{r.title}
										<span class="lead__org"> · {r.org}</span>
									</li>
								))}
							</ul>
						</div>
					</li>
				);
			})
		}
	</ul>
</div>

<style>
	.lead {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}
	.lead__head {
		display: flex;
		max-width: 42rem;
		flex-direction: column;
		gap: 0.5rem;
	}
	.lead__title {
		font-size: clamp(1.875rem, 1.5rem + 1.5vw, 2.25rem);
		font-weight: 850;
		font-stretch: 125%;
		text-wrap: balance;
	}
	.lead__intro {
		font-size: 1.125rem;
		color: var(--ink-soft);
		text-wrap: pretty;
	}
	.lead__list {
		display: grid;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	@media (min-width: 768px) {
		.lead__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.lead__item {
		position: relative;
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 1.25rem;
		border-radius: 1.5rem;
		background: color-mix(in oklab, var(--sheet) 72%, transparent);
		box-shadow: inset 0 0 0 1px var(--sheet-edge);
	}
	.lead__item:is(:hover, :focus-within) {
		--portrait-lit: 1;
	}
	.lead__photo {
		flex-shrink: 0;
		width: 4.5rem;
		height: 4.5rem;
		overflow: hidden;
		border-radius: 50%;
		box-shadow: inset 0 0 0 1px var(--sheet-edge);
	}
	.lead__text {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.35rem;
	}
	.lead__name {
		font-size: 1.25rem;
		font-weight: 760;
		font-stretch: 112%;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 3px;
		text-underline-offset: 5px;
		transition: text-decoration-color 0.3s;
	}
	.lead__item:hover .lead__name {
		text-decoration-color: var(--accent-brand);
	}
	.lead__name::after {
		content: "";
		position: absolute;
		inset: 0;
	}
	.lead__roles {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.9375rem;
	}
	.lead__first {
		font-weight: 650;
	}
	.lead__first .lead__org {
		font-weight: 400;
		color: var(--ink-soft);
	}
	.lead__then {
		color: var(--ink-soft);
	}
</style>
