			backdrop-filter: blur(8px);
		}		.kch:not([data-read]) #stakes .kch-stat {
			font-size: clamp(4rem, 10vw, 6.5rem);
		}
		.kch:not([data-read]) .kch-panel {
			max-height: 46svh;
			gap: 0.6rem;
		}
	}

	/* The chapter map: a dot per beat at the right edge, a tick per part-by-part stop under beat 4; each is a link. */
	.kch-map {
		position: absolute;
		right: max(0.75rem, env(safe-area-inset-right));
		top: 50%;
		z-index: 3;
		translate: 0 -50%;
		padding: 0.5rem 0.3rem;
		border: 1px solid color-mix(in oklab, var(--foreground) 14%, transparent);
		border-radius: 999px;
		background: color-mix(in oklab, var(--background) 60%, transparent);
		-webkit-backdrop-filter: blur(10px);
		backdrop-filter: blur(10px);
	}
	.kch-map ol {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.1rem;
	}
	.kch-map a {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.2rem;
		padding: 0.4rem 0.35rem;
		border-radius: 999px;
		color: var(--muted-foreground);
		font: 600 0.68rem/1 ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
	}
	.kch-map a:focus-visible {
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}
	.kch-map-dot {
		width: 0.55rem;
