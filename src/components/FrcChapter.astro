	/* Narrower windows (the drone in the middle): the words at the bottom, over a scrim. */
	@media (max-aspect-ratio: 6/5) {
		.kch:not([data-read]) .kch-panel {
			top: auto;
			bottom: 2rem;
			width: auto;
			right: var(--left);
