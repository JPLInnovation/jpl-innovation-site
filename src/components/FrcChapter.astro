	/* While the chapter is in 3D, the page's own backdrop footage is covered anyway: don't show it. */
	html:has(.kch:not([data-read])) .chapter-backdrop {
		display: none;
	}
	/* ?showcase=capture: the robot alone, on a transparent background (scripts/showcase-stills.py). */
	.kch[data-capture] :is(.kch-bg, .kch-veil, .kch-frame, .kch-hud, .kch-map, .kch-gate, .kch-panels, .kch-skip) {
		display: none;
