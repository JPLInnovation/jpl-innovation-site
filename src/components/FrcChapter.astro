		transition: opacity 1.2s cubic-bezier(0.33, 1, 0.68, 1);
	}
	.kch[data-live] .kch-stage canvas {
		opacity: 1;
	}
	/* Over the canvas: the vignette, a scrim behind the words on the left (wide windows), and a light film grain (it
	   keeps the dark gradient from banding). */
	.kch-veil {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			linear-gradient(to right, rgb(3 10 16 / var(--bd-scrim, 0.7)), rgb(3 10 16 / calc(var(--bd-scrim, 0.7) * 0.75)) 36%, transparent 60%),
			radial-gradient(115% 95% at 50% 50%, transparent 52%, rgb(0 0 0 / var(--look-vignette, 0.62)));
	}
	@media (max-aspect-ratio: 6/5) {
		.kch-veil {
