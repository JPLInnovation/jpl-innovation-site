	.kch-gate-bar {
		width: min(16rem, 60vw);
		height: 2px;
		background: color-mix(in oklab, var(--foreground) 15%, transparent);
	}
	.kch-gate-bar {
		overflow: hidden;
	}
	.kch-gate-bar > span {
		display: block;
		height: 100%;
		width: 35%;
