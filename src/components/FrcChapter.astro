			linear-gradient(to bottom in oklch, rgb(7 11 18 / 0.7) 4.5rem, rgb(7 11 18 / 0) 10rem),
			linear-gradient(to right in oklch, rgb(7 11 18 / var(--look-scrim, 0.72)), rgb(7 11 18 / calc(var(--look-scrim, 0.72) * 0.7)) 34%, rgb(7 11 18 / 0) 58%);
	}
	@media (max-aspect-ratio: 6/5) {
