	/* The loading gate: only if the model takes a moment (more than about 300 ms). */
	.kch-gate {
		position: absolute;
		inset: 0;
		z-index: 4;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 0.9rem;
		background: linear-gradient(to bottom, #071822, #030a10);
		font: 500 0.8rem/1.4 ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--muted-foreground);
