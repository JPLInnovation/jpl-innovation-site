	}
	.kch-ticks {
		padding-block: 0.15rem;
	}
	.kch-ticks a {
		padding: 0.22rem 0.5rem;
	}
	.kch-ticks a::before {
		content: "";
		display: block;
		width: 0.6rem;
		height: 2px;
		border-radius: 1px;
