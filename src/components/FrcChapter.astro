</style>

<script>
	import { afterIntro } from "@/lib/splash";

	const LIVE_GATE = 300; // ms: the loading gate shows only if the 3D isn't up by then
	let cleanup: (() => void) | undefined;

	function initKitbot() {
		cleanup?.();
		cleanup = undefined;
		const root = document.querySelector<HTMLElement>("[data-kch]");
		if (!root) return;
		const cleanups: Array<() => void> = [];
		cleanup = () => cleanups.forEach((c) => c());

		// The live local time in Ho Chi Minh City, in both modes.
		const clocks = [...root.querySelectorAll<HTMLTimeElement>("[data-kch-clock]")];
		const formats = clocks.map(
			(c) => new Intl.DateTimeFormat("en-GB", { timeZone: c.dataset.kchClock, hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false }),
		);
		const tick = () => {
			const now = new Date();
			clocks.forEach((c, i) => {
				c.textContent = formats[i].format(now);
				c.dateTime = now.toISOString();
			});
		};
		tick();
		const clock = window.setInterval(tick, 1000);
		cleanups.push(() => clearInterval(clock));
		if (root.hasAttribute("data-read")) return;

		const stops = JSON.parse(root.dataset.stops!) as string[];
		const titles = JSON.parse(root.dataset.titles!) as string[];
		const last = stops.length - 1;
		const track = root.querySelector<HTMLElement>(".kch-track")!;
		const pin = root.querySelector<HTMLElement>(".kch-pin")!;
		const stage = root.querySelector<HTMLElement>("[data-kch-stage]")!;
		const canvas = stage.querySelector("canvas")!;
		const panels = [...root.querySelectorAll<HTMLElement>(".kch-panel")];
		const beatLinks = [...root.querySelectorAll<HTMLAnchorElement>("[data-beat]")];
		const tickLinks = [...root.querySelectorAll<HTMLAnchorElement>(".kch-ticks a")];
		const count = root.querySelector<HTMLElement>("[data-kch-count]")!;
		const live = root.querySelector<HTMLElement>("[data-kch-live]")!;
		const gate = root.querySelector<HTMLElement>("[data-kch-gate]")!;
		const capture = root.hasAttribute("data-capture");

		// Offsets, measured on resize only: each stop is one screen of scroll from the top of the track.
		let screenH = 1;
		let top = 0;
		const measure = () => {
			screenH = pin.offsetHeight || innerHeight;
			top = track.getBoundingClientRect().top + scrollY;
		};
		measure();
		const resize = new ResizeObserver(measure);
		resize.observe(document.documentElement);
		cleanups.push(() => resize.disconnect());
		const position = () => (scrollY - top) / screenH;
		const goTo = (stop: number, smooth = true) =>
			scrollTo({ top: top + Math.max(0, Math.min(last, stop)) * screenH, behavior: smooth ? "smooth" : "instant" });

		// Keyboard: arrows and Page Up/Down move one stop while the chapter is on screen; past either end the page scrolls on.
		const onKey = (event: KeyboardEvent) => {
			if (root.hasAttribute("data-read") || event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) return;
			const target = event.target as HTMLElement;
			if (target.closest?.("input, textarea, select, [contenteditable], dialog, [role=tab], [data-board]")) return;
			const forward = ["ArrowDown", "ArrowRight", "PageDown"].includes(event.key);
			const back = ["ArrowUp", "ArrowLeft", "PageUp"].includes(event.key);
			if (!forward && !back) return;
			const p = position();
			if (p < -0.5 || p > last + 0.25) return;
			const next = Math.round(p) + (forward ? 1 : -1);
			if (next < 0 || next > last) return;
			event.preventDefault();
			goTo(next);
		};
		addEventListener("keydown", onKey);
		cleanups.push(() => removeEventListener("keydown", onKey));
		const onClick = (event: MouseEvent) => {
			const el = (event.target as Element).closest<HTMLElement>("[data-goto]");
			if (!el || root.hasAttribute("data-read")) return;
			event.preventDefault();
			goTo(Number(el.dataset.goto));
		};
		root.addEventListener("click", onClick);
		cleanups.push(() => root.removeEventListener("click", onClick));
		const onFocus = (event: FocusEvent) => {
			const panel = (event.target as Element).closest<HTMLElement>(".kch-panel");
			if (!panel || root.hasAttribute("data-read")) return;
			const stop = Number(panel.dataset.stop);
			if (Math.abs(position() - stop) > 0.3) goTo(stop, false);
		};
		root.addEventListener("focusin", onFocus);
		cleanups.push(() => root.removeEventListener("focusin", onFocus));

		// The backdrop follows the camera: the arena on beat 1, the field on 2, the pits on 3, then the grid alone.
		const clamp01 = (x: number) => Math.max(0, Math.min(1, x));
		const round = (x: number) => Math.round(x * 100) / 100;
		const layers = {
			arena: root.querySelector<HTMLElement>(".kch-bd-arena")!,
			field: root.querySelector<HTMLElement>(".kch-bd-field")!,
			pits: root.querySelector<HTMLElement>(".kch-bd-pits")!,
		};
		const shown: Record<string, number> = {};
		const set = (name: string, value: number) => {
			const v = round(value);
			if (shown[name] === v) return;
			shown[name] = v;
			pin.style.setProperty(`--bd-${name}`, String(v));
		};
		const backdrop = (at: number) => {
			const arena = clamp01(1 - at * 0.9);
			const field = clamp01(1 - Math.abs(at - 1) * 1.2);
			const pits = clamp01(1 - Math.abs(at - 2) * 1.05);
			set("arena", arena);
			set("field", field);
			set("push", clamp01(at));
			set("pits", pits);
			set("swing", Math.max(-1, Math.min(1, at - 2)));
			set("scrim", 0.7);
			for (const [name, value] of [["arena", arena], ["field", field], ["pits", pits]] as const) layers[name].toggleAttribute("data-off", value <= 0.005);
		};
		backdrop(0);

		// The words, the HUD's counter, the map and the announcement follow the camera.
		const levels = new Float32Array(panels.length).fill(-1);
		let shownStop = -1;
		let announceTimer: number | undefined;
		const beatNames = beatLinks.map((a) => `${a.querySelector(".kch-map-n")!.textContent} / ${String(beatLinks.length).padStart(2, "0")}: ${a.querySelector(".kch-map-title")!.textContent}`);
		const onFrame = (at: number) => {
			panels.forEach((panel, i) => {
				const d = Math.abs(at - i);
				const on = Math.round(Math.max(0, Math.min(1, (0.42 - d) / 0.22)) * 100) / 100;
				if (on === levels[i]) return;
				levels[i] = on;
				panel.style.setProperty("--on", String(on));
				panel.toggleAttribute("data-shown", on > 0.5);
			});
			root.style.setProperty("--w-stakes", String(Math.round(Math.max(0, 1 - Math.abs(at - 1) * 2.2) * 100) / 100));
			backdrop(at);
			const current = Math.max(0, Math.min(last, Math.round(at)));
			if (current === shownStop) return;
			shownStop = current;
			const beat = Math.min(current, 3);
			count.textContent = String(beat + 1).padStart(2, "0");
			beatLinks.forEach((a, b) => (b === beat ? a.setAttribute("aria-current", "step") : a.removeAttribute("aria-current")));
			tickLinks.forEach((a, k) => (k === current - 3 ? a.setAttribute("aria-current", "step") : a.removeAttribute("aria-current")));
			window.clearTimeout(announceTimer);
			announceTimer = window.setTimeout(() => {
				live.textContent = current >= 3 && titles[current] ? `${beatNames[beat]}, ${titles[current]}` : beatNames[beat];
			}, 600);
		};
		cleanups.push(() => window.clearTimeout(announceTimer));

		// The loading gate, only if the model takes a moment.
		const gateTimer = window.setTimeout(() => {
			if (root.hasAttribute("data-live") || root.hasAttribute("data-read") || capture) return;
			gate.hidden = false;
		}, LIVE_GATE);
		const closeGate = () => {
			window.clearTimeout(gateTimer);
			if (gate.hidden) return;
			gate.setAttribute("data-leaving", "");
			window.setTimeout(() => {
				gate.hidden = true;
				gate.removeAttribute("data-leaving");
			}, 600);
		};
		cleanups.push(closeGate);

		let cancelled = false;
		let dispose: (() => void) | undefined;
		/** The plain page, for any reason the 3D cannot carry on (no WebGL, too slow, the GPU lost, an error). */
		const toRead = (why: string) => {
			if (cancelled || root.hasAttribute("data-read")) return;
			console.warn(`KitBot chapter: switching to the plain page (${why}).`);
			closeGate();
			root.setAttribute("data-read", "");
			root.removeAttribute("data-live");
			root.classList.remove("dark");
			dispose?.();
			dispose = undefined;
		};
		cleanups.push(() => {
			cancelled = true;
			dispose?.();
			dispose = undefined;
		});

		type Hook = { go(n: number | null): void; capture(): string };
		const w = window as unknown as { __showcase?: Hook };
		let hook: Hook | undefined;
		Promise.all([import("@/lib/three/stage"), import("@/lib/three/models/frc-chapter"), afterIntro()])
			.then(async ([stageModule, chapterModule]) => {
				if (cancelled || root.hasAttribute("data-read")) return;
				if (chapterModule.STOPS.join() !== stops.join()) console.warn("KitBot chapter: the page's stops and the camera's differ.", stops, chapterModule.STOPS);
				const look = chapterModule.LOOK;
				pin.style.setProperty("--look-glow", String(look.glow));
				pin.style.setProperty("--look-vignette", String(look.vignette));
				pin.style.setProperty("--look-grain", String(look.grain));
				for (const [name, value] of Object.entries(look.backdrop)) pin.style.setProperty(`--look-${name}`, String(value));
				backdrop(position());
				dispose = await stageModule.mountStage(
					stage,
					canvas,
					async (ctx) => {
						const model = await chapterModule.default(ctx, { position, onStop: () => undefined, onFrame, titles, capture });
						if (capture) {
							hook = w.__showcase;
							delete w.__showcase;
						}
						return model;
					},
					{ camera: [0.6, 0.3, 1.6], target: [0, 0.2, 0], fov: 34, near: 0.02, orbit: false, effects: capture, pixelRatio: 1.5, onFallback: (reason) => toRead(reason) },
				);
				if (cancelled || root.hasAttribute("data-read")) {
					dispose();
					dispose = undefined;
					return;
				}
				root.setAttribute("data-live", "");
				closeGate();
				pin.setAttribute("data-images", "first");
				const more = window.setTimeout(() => pin.setAttribute("data-images", "all"), 1200);
				cleanups.push(() => clearTimeout(more));
				// A link to a stop (/work/frc/#intake) lands on it, on arrival and when the address changes to one.
				const toHash = () => {
					const hashed = stops.indexOf(decodeURIComponent(location.hash.slice(1)));
					if (hashed >= 0) goTo(hashed, false);
				};
				toHash();
				addEventListener("hashchange", toHash);
				cleanups.push(() => removeEventListener("hashchange", toHash));
				const held = hook;
				if (capture && held) w.__showcase = { ...held, go: (n) => held.go(n === null ? null : n + 3) };
			})
			.catch((error) => {
				console.warn("KitBot chapter: the 3D could not start.", error);
				toRead("error");
			});
	}

	document.addEventListener("astro:page-load", initKitbot);
	document.addEventListener("astro:before-swap", () => {
		cleanup?.();
		cleanup = undefined;
	});
</script>
