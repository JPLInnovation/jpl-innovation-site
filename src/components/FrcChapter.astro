	.kch-pin[data-images] .kch-bd-arena { background-image: url("/chapter/frc/arena.webp"); }
	.kch-pin[data-images="all"] .kch-bd-field { background-image: url("/chapter/frc/field.webp"); }
	.kch-pin[data-images="all"] .kch-bd-pits { background-image: url("/chapter/frc/pits.webp"); }
	.kch-stage {
