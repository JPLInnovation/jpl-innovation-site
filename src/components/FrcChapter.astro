---
/**
 * The KitBot chapter on the FRC page, built like the drone chapter (src/components/DroneChapter.astro): one pinned,
 * full-window 3D stage that the page's own scroll moves the camera through (src/lib/three/models/frc-chapter.ts), with
 * each beat's words as real HTML over it. The stage stays put for about nine and a half screens of scroll, then lets go
 * into the rest of the page.
 *
 *   01 Prologue   the KitBot low in the dark, lit from behind; what it stands for
 *   02 Stakes     the camera closes in on the launcher: the autonomous routine, 95% repeatable
 *   03 Reveal     the lights come up: the name, what it is, its numbers, where it raced
 *   04 Anatomy    the part-by-part stops, the rest of the robot fading back
 *
 * Every stop is one screen of native scroll (nothing is hijacked). Keyboard: arrows and Page Up/Down move one stop while
 * the chapter is on screen; "Skip the robot" goes past it. The chapter map at the side has a dot per beat and a tick per
 * part-by-part stop.
 *
 * Classic (data-read, decided before the first paint): the same words as one ordinary page in the same order, the
 * first three beats on a still dark picture, the parts as cards with renders of the real model (public/showcase/robot/,
 * scripts/showcase-stills.py). Used on phones (under 768 px), with reduced motion, without WebGL, when Classic is
 * chosen, and when the 3D gives up (too slow, a lost GPU, an error, or not up within 30 s).
 *
 * All the words: src/text/projects/frc.ts (robotChapter) and src/text/showcase/robot.ts.
 */
// @ts-ignore: the project has no Node type definitions; this only runs at build time, in Node.
import { existsSync } from "node:fs";
import BeatLabel from "@/components/BeatLabel.astro";
import StatusTag from "@/components/StatusTag.astro";
import { buttonVariants } from "@/components/ui/button";
import { DataIcon } from "@/lib/icons";
import { robotChapter as chapter } from "@/text/projects/frc";
import { robotShowcase as parts } from "@/text/showcase/robot";

const beats = chapter.beats;
const [first, ...rest] = parts.features;
/** The stops in order (the camera's, src/lib/three/models/frc-chapter.ts STOPS): beats 1 to 3, then the parts. */
const stops = ["prologue", "stakes", "reveal", ...parts.features.map((f) => f.id)];
/** The small label in the 3D view on each stop: none on beats 1 to 3. */
const titles = ["", "", "", ...parts.features.map((f) => f.title)];
const beatList = [beats.prologue, beats.stakes, beats.reveal, beats.anatomy];
/** Classic's picture of a stop, from the real model (scripts/showcase-stills.py), when there is one. */
const still = (id: string) =>
	existsSync(`public/showcase/robot/${id}-800.webp`)
		? { src: `/showcase/robot/${id}-800.webp`, srcset: `/showcase/robot/${id}-800.webp 800w, /showcase/robot/${id}.webp 1600w` }
		: undefined;
const overviewStill = still("overview");
---

<div id="kitbot" class="kch showcase" data-kch data-read data-stops={JSON.stringify(stops)} data-titles={JSON.stringify(titles)} style={`--stops: ${stops.length}`}>
	<script is:inline data-astro-rerun>
		// Before the first paint: the 3D chapter unless Classic was chosen, the window is under 768 px, motion is reduced
		// or there is no WebGL. In 3D the whole chapter has the dark theme's colours, in both themes.
		(() => {
			const el = document.currentScript.parentElement;
			const root = document.documentElement;
			const capture = new URLSearchParams(location.search).get("showcase") === "capture";
			const read =
				!capture &&
				(root.classList.contains("read-mode") ||
					root.classList.contains("reduce-motion") ||
					matchMedia("(max-width: 767px), (prefers-reduced-motion: reduce)").matches);
			if (read) return;
			const gl = document.createElement("canvas").getContext("webgl2") || document.createElement("canvas").getContext("webgl");
			if (!gl) return;
			gl.getExtension("WEBGL_lose_context")?.loseContext();
			el.removeAttribute("data-read");
			el.classList.add("dark");
			if (capture) el.setAttribute("data-capture", "");
			setTimeout(() => {
				if (el.isConnected && !el.hasAttribute("data-live") && !el.hasAttribute("data-read")) {
					el.setAttribute("data-read", "");
					el.classList.remove("dark");
					console.warn("KitBot chapter: the 3D did not start in time, showing the plain page.");
				}
			}, 30000);
		})();
	</script>
	<a class="kch-skip" href="#after-kitbot">{chapter.skip}</a>

	<div class="kch-track">
		<div class="kch-pin">
			<div class="kch-bg" aria-hidden="true">
				<div class="kch-bd kch-bd-arena"></div>
				<div class="kch-bd kch-bd-field"></div>
				<div class="kch-bd kch-bd-pits"></div>
			</div>
			<div class="kch-stage" data-kch-stage>
				<canvas role="img" aria-label={parts.modelLabel}></canvas>
			</div>
			<div class="kch-veil" aria-hidden="true"></div>
			<div class="kch-frame" aria-hidden="true">
				<span class="kch-corner kch-tl"></span><span class="kch-corner kch-tr"></span><span class="kch-corner kch-bl"></span><span class="kch-corner kch-br"></span>
			</div>
			<div class="kch-frame kch-aim" aria-hidden="true">
				<svg class="kch-cross" viewBox="-20 -20 40 40"><path d="M0-20v12M0 8v12M-20 0h12M8 0h12" fill="none" stroke="currentColor" stroke-width="1.6"></path><circle r="11" fill="none" stroke="currentColor" stroke-width="1" opacity="0.6"></circle></svg>
			</div>

			<div class="kch-hud" aria-hidden="true">
				<p class="kch-hud-left">
					<span class="kch-hud-state"><span class="kch-hud-dot"></span>{chapter.hud.state}</span>
					<span class="kch-hud-step">{chapter.hud.detail}</span>
				</p>
				<p class="kch-hud-right">
					<span>{chapter.hud.city} <time class="kch-hud-time" data-kch-clock={chapter.hud.timeZone}>--:--:--</time></span>
					<span class="kch-hud-count"><span data-kch-count>01</span> / {beatList.length.toString().padStart(2, "0")}</span>
				</p>
			</div>

			<nav class="kch-map" aria-label={chapter.mapLabel}>
				<ol>
					{
						beatList.map((beat, b) => (
							<li>
								<a href={`#${stops[b]}`} data-goto={b} data-beat={b}>
									<span class="kch-map-dot" aria-hidden="true" />
									<span class="kch-map-n">{beat.number}</span>
									<span class="kch-map-title">{beat.title}</span>
								</a>
								{b === 3 && (
									<ol class="kch-ticks">
										{parts.features.map((f, i) => (
											<li>
												<a href={`#${f.id}`} data-goto={3 + i} aria-label={`${beat.number} ${beat.title}: ${f.title}`}>
													<span class="kch-map-title" aria-hidden="true">{f.title}</span>
												</a>
											</li>
										))}
									</ol>
								)}
							</li>
						))
					}
				</ol>
			</nav>

			<div class="kch-gate" data-kch-gate hidden>
				<p class="kch-gate-label">{chapter.loading}</p>
				<div class="kch-gate-bar" aria-hidden="true"><span></span></div>
			</div>

			<div class="kch-panels">
				<div class="kch-band dark">
					<!-- 01 Prologue -->
					<section id="prologue" class="kch-panel" data-stop="0" aria-labelledby="kitbot-prologue-label">
						<BeatLabel id="kitbot-prologue-label" beat={beats.prologue} />
						<p class="kch-classic-hud">
							<span class="kch-hud-state"><span class="kch-hud-dot" aria-hidden="true"></span>{chapter.hud.state}</span>
							<span>{chapter.hud.detail}</span>
							<span>
								<span aria-hidden="true">{chapter.hud.city}</span>
								<span class="sr-only">{chapter.hud.timeLabel} {chapter.hud.city}:</span>
								<time class="kch-hud-time" data-kch-clock={chapter.hud.timeZone}>--:--:--</time>
							</span>
						</p>
						<p class="kch-statement font-wide">{chapter.prologue.statement}</p>
					</section>

					<!-- 02 The stakes -->
					<section id="stakes" class="kch-panel" data-stop="1" aria-labelledby="kitbot-stakes-label">
						<BeatLabel id="kitbot-stakes-label" beat={beats.stakes} />
						<p class="kch-stat-label">{chapter.stakes.label}</p>
						<p class="kch-stat font-wide"><span>{chapter.stakes.value}</span> <span class="kch-stat-unit">{chapter.stakes.unit}</span></p>
						<p class="kch-stat-secondary font-wide">{chapter.stakes.secondary}</p>
						<p class="kch-stat-source">{chapter.stakes.source}</p>
						<p class="kch-aside">{chapter.stakes.aside}</p>
					</section>

					<!-- 03 The reveal -->
					<header id="reveal" class="kch-panel kch-reveal" data-stop="2" aria-labelledby="kitbot-reveal-label">
						<BeatLabel id="kitbot-reveal-label" beat={beats.reveal} />
						<div><StatusTag>{chapter.reveal.status}</StatusTag></div>
						<h2 class="font-wide"><span class="kch-kicker">{chapter.reveal.kicker}</span> {chapter.reveal.name}</h2>
						<p class="kch-intro">{chapter.reveal.intro}</p>
						<dl class="kch-facts">
							{
								chapter.reveal.facts.map((f) => (
									<div>
										<dt>
											<DataIcon name={f.icon} className="size-4" />
											{f.label}
										</dt>
										<dd>{f.value}</dd>
									</div>
								))
							}
						</dl>
						<div class="kch-actions">
							<a href={chapter.reveal.specsHref} class={buttonVariants({ variant: "signal", size: "lg" })}>{chapter.reveal.specsLink}</a>
							<a href={chapter.reveal.resultsHref} class={buttonVariants({ variant: "outline", size: "lg" })}>{chapter.reveal.resultsLink}</a>
						</div>
						<p class="kch-note">{parts.note}</p>
						{overviewStill && <img class="kch-still" src={overviewStill.src} srcset={overviewStill.srcset} sizes="(min-width: 48rem) 40rem, 100vw" alt={parts.modelLabel} width="1600" height="1200" loading="lazy" />}
					</header>
				</div>

				<!-- 04 Anatomy: the parts (Classic: cards with renders of the real model) -->
				<div class="kch-parts">
					<section id={first.id} class="kch-panel showcase-feature" data-stop="3" aria-labelledby="kitbot-anatomy-label">
						<BeatLabel id="kitbot-anatomy-label" beat={beats.anatomy} />
						<p class="kch-stat kch-stat-small font-wide"><span>{chapter.anatomy.value}</span> <span class="kch-stat-unit">{chapter.anatomy.label}</span></p>
						<h3 class="kch-parts-heading font-wide">{parts.heading}</h3>
						<h4 class="kch-part-title font-semiwide">{first.title}</h4>
						<p>{first.text}</p>
						<dl class="kch-part-facts">
							{first.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
						</dl>
					</section>
					{
						rest.map((f, i) => {
							const s = still(f.id);
							return (
								<section id={f.id} class="kch-panel showcase-feature" data-stop={4 + i} aria-labelledby={`kitbot-part-${f.id}`}>
									<h4 id={`kitbot-part-${f.id}`} class="kch-part-title font-semiwide">{f.title}</h4>
									<p>{f.text}</p>
									<dl class="kch-part-facts">
										{f.facts.map((x) => <div><dt>{x.label}</dt><dd>{x.value}</dd></div>)}
									</dl>
									{s && <img class="kch-still" src={s.src} srcset={s.srcset} sizes="(min-width: 48rem) 36rem, 100vw" alt={`${f.title}: ${parts.modelLabel}`} width="1600" height="1200" loading="lazy" />}
								</section>
							);
						})
					}
				</div>
			</div>
		</div>
	</div>
	<p class="sr-only" aria-live="polite" data-kch-live></p>
</div>
<div id="after-kitbot" class="kch-after" tabindex="-1"></div>

<style is:global>
	/* ---------- Both modes ---------- */
	.kch .chapter-label {
		font: 600 0.8rem/1.3 ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.kch .chapter-label-n {
		color: var(--foreground);
		margin-right: 0.6em;
	}
	.kch-panel {
		color: var(--foreground);
		scroll-margin-top: 5rem;
	}
	.kch-hud-state {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
	}
	.kch-hud-dot {
		width: 0.55em;
		height: 0.55em;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 8px color-mix(in oklab, var(--accent) 80%, transparent);
	}
	.kch-hud-time {
		display: inline-block;
		min-width: 8ch;
		color: var(--foreground);
		font-variant-numeric: tabular-nums;
	}
	.kch-statement {
		max-width: 16ch;
		font-weight: 860;
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 1.02;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}
	.kch-stat-label {
		font: 600 0.85rem/1.3 ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.kch-stat {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 0.3em;
		font-weight: 900;
		font-size: clamp(4rem, 15vw, 9rem);
		line-height: 0.86;
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
	}
	.kch-stat > span:first-child {
		white-space: nowrap;
	}
	.kch-stat-small {
		font-size: clamp(2.75rem, 8vw, 5rem);
	}
	.kch-stat-unit {
		font-size: 0.32em;
		font-weight: 760;
		letter-spacing: 0;
		color: var(--muted-foreground);
	}
	.kch-stat-secondary {
		font-size: clamp(1.4rem, 3vw, 2.25rem);
		font-weight: 780;
		color: var(--muted-foreground);
	}
	.kch-stat-source,
	.kch-aside {
		max-width: 46ch;
		font-size: 1.125rem;
	}
	.kch-stat-source {
		color: var(--muted-foreground);
	}
	.kch-reveal h2 {
		font-size: clamp(2.8rem, 8vw, 6.25rem);
		font-weight: 900;
		line-height: 0.94;
	}
	.kch-kicker {
		display: block;
		margin-bottom: 0.15em;
		font-size: 0.36em;
		font-weight: 720;
		color: var(--muted-foreground);
	}
	.kch-intro {
		max-width: 56ch;
		font-size: 1.125rem;
	}
	.kch-facts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem 1.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}
	@media (min-width: 40rem) {
		.kch-facts {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.kch-facts dt {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		font-size: 0.875rem;
		color: var(--muted-foreground);
	}
	.kch-facts dd {
		font-weight: 600;
	}
	.kch-team {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		font-size: 0.875rem;
		color: var(--muted-foreground);
	}
	.kch-team a {
		font-weight: 500;
		color: var(--foreground);
	}
	.kch-team a:hover {
		text-decoration: underline;
	}
	.kch-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
	}
	.kch-note,
	.kch-legend {
		max-width: 48ch;
		font-size: 0.875rem;
		color: var(--muted-foreground);
	}
	.kch-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
	}
	.kch-legend > span {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.kch-swatch {
		width: 1.25rem;
		height: 0.375rem;
		border-radius: 999px;
	}
	.kch-parts-heading {
		font-size: clamp(2rem, 4.5vw, 3.25rem);
		font-weight: 850;
	}
	.kch-parts-intro {
		max-width: 56ch;
		font-size: 1.125rem;
		color: var(--muted-foreground);
	}
	.kch-part-title {
		font-size: 1.5rem;
		font-weight: 780;
	}
	.kch-part-facts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem 1.5rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--border);
	}
	.kch-part-facts dt {
		font-size: 0.8rem;
		color: var(--muted-foreground);
	}
	.kch-part-facts dd {
		font-weight: 600;
	}
	.kch-skip {
		position: absolute;
		left: 1rem;
		z-index: 60;
		translate: 0 -200%;
		padding: 0.6rem 1rem;
		border-radius: 999px;
		background: var(--primary);
		color: var(--primary-foreground);
		font-weight: 600;
	}
	.kch-skip:focus-visible {
		translate: 0 0.5rem;
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}

	/* ---------- Classic: an ordinary page, in the same order ---------- */
	.kch[data-read] :is(.kch-bg, .kch-stage, .kch-veil, .kch-frame, .kch-hud, .kch-map, .kch-gate) {
		display: none;
	}
	.kch[data-read] .kch-band {
		padding-bottom: 10rem;
		/* The still gradient: the 3D's colours, fading into the page. */
		background:
			linear-gradient(to bottom, rgb(3 10 16 / 0.35), rgb(3 10 16 / 0.6) 60%, #030a10 calc(100% - 10rem), transparent),
			url("/chapter/frc/classic.webp") center 35% / cover no-repeat,
			#071822;
	}
	.kch[data-read] .kch-back {
		padding-top: 1.5rem;
	}
	.kch[data-read] .kch-panel {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		width: 100%;
		max-width: 76rem;
		margin-inline: auto;
		padding: 2.5rem clamp(1rem, 4vw, 2.5rem);
	}
	.kch-classic-hud {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		padding-block: 0.75rem;
		border-block: 1px solid var(--border);
		font: 500 0.85rem/1.4 ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.kch-classic-hud > span:last-child {
		display: inline-flex;
		gap: 1em;
		color: var(--muted-foreground);
	}
	.kch-still {
		width: 100%;
		max-width: 40rem;
		height: auto;
		border-radius: 0.75rem;
	}
	.kch[data-read] .kch-parts {
		display: grid;
		max-width: 76rem;
		margin-inline: auto;
	}
	@media (min-width: 48rem) {
		.kch[data-read] .kch-parts {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.kch[data-read] .kch-parts > :first-child {
			grid-column: 1 / -1;
		}
		.kch[data-read] .kch-parts > :first-child .kch-still {
			max-width: 36rem;
		}
	}
	.kch[data-read] .kch-parts .kch-still {
		order: -1;
		background: var(--card);
		border: 1px solid var(--border);
	}
	.kch[data-read] .kch-parts > :first-child .kch-still {
		order: 0;
	}

	/* ---------- 3D: the pinned stage ---------- */
	.kch:not([data-read]) {
		margin-top: 0;
	}
	.kch:not([data-read]) .kch-track {
		position: relative;
		/* A screen per stop after the first, and a half screen to let go. */
		height: calc((var(--stops) + 0.5) * 100svh);
	}
	.kch:not([data-read]) .kch-pin {
		position: sticky;
		top: 0;
		height: 100svh;
		overflow: hidden;
		isolation: isolate;
		--edge: clamp(1rem, 4vw, 2.5rem);
		--left: max(var(--edge), calc((100vw - 76rem) / 2 + var(--edge)));
		--focus-x: 70%;
	}
	@media (max-aspect-ratio: 6/5) {
		.kch:not([data-read]) .kch-pin {
			--focus-x: 50%;
		}
	}
	/* The backdrop: a very dark teal-blue gradient and a glow behind the drone (no pure black). */
	.kch-bg {
		position: absolute;
		inset: 0;
		z-index: -2;
		background:
			radial-gradient(42% 52% at var(--focus-x) 50%, rgb(34 211 238 / calc(var(--look-glow, 0.24) * var(--glow-level, 1))), transparent 72%),
			radial-gradient(120% 90% at 50% 10%, #0b2130, transparent 70%),
			linear-gradient(to bottom, #071822, #030a10);
	}
	/* The backdrop layers: their images only once the 3D is up (data-images: beat 1's first, then the rest), each shown
	   by the camera (--bd-*, 0 to 1) times its strength in LOOK (--look-*). Moved with transform and opacity only. */
	.kch-bd {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.kch-bd[data-off] {
		visibility: hidden;
	}
	/* The team's own event photos, blurred (public/chapter/frc/): the arena (beat 1), the field being set up (2), the
	   pits under our flag (3). Each shown by the camera (--bd-*, 0 to 1) times its strength in LOOK (--look-*). */
	.kch-bd {
		background: center / cover no-repeat;
		transition: none;
	}
	.kch-bd-arena {
		opacity: calc(var(--bd-arena, 0) * var(--look-arena, 0.75));
