	.kch-map-title {
		position: absolute;
		right: calc(100% + 0.6rem);
		top: 50%;
		translate: 6px -50%;
		padding: 0.4rem 0.65rem;
		border-radius: 999px;
		white-space: nowrap;
		background: color-mix(in oklab, var(--background) 86%, transparent);
		border: 1px solid color-mix(in oklab, var(--foreground) 14%, transparent);
		color: var(--foreground);
