	.kch-gate-n {
		color: var(--foreground);
		font-variant-numeric: tabular-nums;
	}
	/* After the chapter (the skip link's target): the edition's near-black carries straight on, nothing to fade. */
	.kch-after:focus {
		outline: none;
	}
	/* While the chapter is in 3D, the page's own backdrop footage is covered anyway: don't show it. */
	html:has(.kch:not([data-read])) .chapter-backdrop {
		display: none;
	}
	/* ?showcase=capture: the robot alone, on a transparent background (scripts/showcase-stills.py). */
	.kch[data-capture] :is(.kch-bg, .kch-poster, .kch-veil, .kch-frame, .kch-hud, .kch-map, .kch-gate, .kch-panels, .kch-skip, .kch-caption) {
		display: none;
	}
	.kch[data-capture] .kch-pin {
		position: fixed;
		inset: 0;
		z-index: 100;
		height: auto;
	}

 .kch-panel h2, .kch-panel h3 { font-family: "Archivo Variable", "Arial", sans-serif; letter-spacing: -.035em; line-height: 1.08; }
 /* Reading text only: the big statement, numbers and labels keep their own tight type. */
 .kch-panel > p:not([class]), .kch-panel > :is(.kch-intro, .kch-aside, .kch-stat-source, .kch-note) { font-family: "Segoe UI", Arial, sans-serif; line-height: 1.55; }
 .kch-panel .kch-facts { margin-top: 0.5rem; gap: 1.25rem 1.5rem; padding-top: 1.25rem; }
 .kch-panel .kch-facts dt { font-family: ui-monospace, "Cascadia Code", monospace; font-size: .68rem; letter-spacing: .06em; line-height: 1.5; }
 .kch-panel .kch-facts dd { margin-top: .4rem; line-height: 1.45; }
 /* The extension's bright panels come close to the words on this stop: a narrower column stays clear of them. */
 @media (min-aspect-ratio: 6/5) {
