---
/**
 * The KitBot chapter on the FRC page, built like the drone chapter (src/components/DroneChapter.astro): one pinned,
 * full-window 3D stage that the page's own scroll moves the camera through (src/lib/three/models/frc-chapter.ts), with
 * each beat's words as real HTML over it. The robot stands on the 2026 field (its carpet, lines, HUBs, BUMPs and FUEL,
 * the arena's lights and the team's own photograph of the stands behind), drives a short curve and shoots into its HUB
 * as the beats go by, then turns for its close-ups. The stage stays put for about fourteen screens of scroll, then
 * lets go into the rest of the page. It sits in the FRC page's special edition (src/pages/work/frc.astro): near-black,
 * Anton for the big words, the edition's yellow; no glows.
 *
 *   Prologue   the KitBot in the dark arena, lit from behind; what it stands for
 *   Stakes     over the launcher as it shoots into its HUB: the autonomous routine, 95% repeatable
 *   Reveal     the field's lights come up: the name, what it is, its numbers, where it raced
 *   Anatomy    the part-by-part stops, the rest of the robot fading back
 *
 * Every stop is one screen of native scroll (nothing is hijacked). Keyboard: arrows and Page Up/Down move one stop while
 * the chapter is on screen; "Skip the robot" goes past it. The chapter map at the side has a dot per beat and a tick per
 * part-by-part stop.
 *
 * The 3D (the robot and the field's files) only loads once the chapter is within two screens.
 *
 * Classic (data-read, decided before the first paint): the same words as one ordinary page in the same order, under a
 * still of the KitBot on the field (scripts/bake-field-still.py), the parts as cards with renders of the real model
 * (public/showcase/robot/, scripts/showcase-stills.py). Used on phones (under 768 px), with reduced motion, without
 * WebGL, when Classic is chosen, and when the 3D gives up (too slow, a lost GPU, an error, or not up within 120 s of
 * starting to load).
 *
 * All the words: src/text/projects/frc.ts (robotChapter) and src/text/showcase/robot.ts.
 */
// @ts-ignore: the project has no Node type definitions; this only runs at build time, in Node.
import { existsSync } from "node:fs";
import BeatLabel from "@/components/BeatLabel.astro";
import { DataIcon } from "@/lib/icons";
import { robotChapter as chapter } from "@/text/projects/frc";
import { robotShowcase as parts } from "@/text/showcase/robot";

const beats = chapter.beats;
const [first, ...rest] = parts.features;
/** The stops in order (the camera's, src/lib/three/models/frc-chapter.ts STOPS): beats 1 to 3, then the parts. */
const stops = ["prologue", "stakes", "reveal", ...parts.features.map((f) => f.id)];
/** The small label in the 3D view on each stop: none on beats 1 to 3. */
const titles = ["", "", "", ...parts.features.map((f) => f.title)];
const beatList = [beats.prologue, beats.stakes, beats.reveal, beats.anatomy];
/** Classic's picture of a stop, from the real model (scripts/showcase-stills.py), when there is one. */
const still = (id: string) =>
	existsSync(`public/showcase/robot/${id}-800.webp`)
		? { src: `/showcase/robot/${id}-800.webp`, srcset: `/showcase/robot/${id}-800.webp 800w, /showcase/robot/${id}.webp 1600w`, full: `/showcase/robot/${id}.webp` }
		: undefined;
const overviewStill = still("overview");
/** What shows until the 3D's first full frame is ready (scripts/showcase-stills.py). */
const poster = existsSync("public/chapter/frc/poster.webp") ? "/chapter/frc/poster.webp" : undefined;
/** The plain page's picture: the KitBot on the field, a still of the 3D (scripts/bake-field-still.py). */
const fieldStill = existsSync("public/chapter/frc/field-still.webp")
	? { src: "/chapter/frc/field-still.webp", srcset: "/chapter/frc/field-still-800.webp 800w, /chapter/frc/field-still.webp 1600w" }
	: undefined;
const hardwareSources: Record<string, { label: string; href: string }> = {
	krakens: { label: 'WCP motor documentation', href: 'https://wcproducts.com/products/kraken' },
	vision: { label: 'Limelight MegaTag2 documentation', href: 'https://docs.limelightvision.io/docs/docs-limelight/pipeline-apriltag/apriltag-robot-localization-megatag2' },
	odometry: { label: 'WPILib odometry documentation', href: 'https://docs.wpilib.org/en/stable/docs/software/kinematics-and-odometry/differential-drive-odometry.html' },
};
---

<div id="kitbot" class="kch showcase" data-kch data-read data-stops={JSON.stringify(stops)} data-titles={JSON.stringify(titles)} style={`--stops: ${stops.length}`}>
	<script is:inline data-astro-rerun>
		// Before the first paint: the 3D chapter unless Classic was chosen, the window is under 768 px, motion is reduced
		// or there is no WebGL. In 3D the whole chapter has the dark theme's colours, in both themes.
		(() => {
			const el = document.currentScript.parentElement;
			const root = document.documentElement;
			const capture = new URLSearchParams(location.search).get("showcase") === "capture";
			const read =
				!capture &&
				(root.classList.contains("read-mode") ||
					root.classList.contains("reduce-motion") ||
					matchMedia("(max-width: 767px), (prefers-reduced-motion: reduce)").matches);
			if (read) return;
			const gl = document.createElement("canvas").getContext("webgl2") || document.createElement("canvas").getContext("webgl");
			if (!gl) return;
			gl.getExtension("WEBGL_lose_context")?.loseContext();
			el.removeAttribute("data-read");
			el.classList.add("dark");
			if (capture) el.setAttribute("data-capture", "");
		})();
	</script>
	<a class="kch-skip" href="#after-kitbot">{chapter.skip}</a>

	<div class="kch-track">
		<div class="kch-pin">
			<div class="kch-bg" aria-hidden="true"></div>
			<div class="kch-stage" data-kch-stage>
				<canvas role="img" aria-label={`${parts.modelLabel} ${chapter.field.alt}`}></canvas>
			</div>
			{poster && <img class="kch-poster" src={poster} alt="" width="1600" height="1200" />}
			<div class="kch-veil" aria-hidden="true"></div>
			<div class="kch-frame" aria-hidden="true">
				<span class="kch-corner kch-tl"></span><span class="kch-corner kch-tr"></span><span class="kch-corner kch-bl"></span><span class="kch-corner kch-br"></span>
			</div>

			<div class="kch-hud" aria-hidden="true">
				<p class="kch-hud-left">
					<span class="kch-hud-state"><span class="kch-hud-dot"></span>{chapter.hud.state}</span>
					<span class="kch-hud-step">{chapter.hud.detail}</span>
				</p>
				<p class="kch-hud-right">
					<span>{chapter.hud.city} <time class="kch-hud-time" data-kch-clock={chapter.hud.timeZone}>--:--:--</time></span>
					<span class="kch-hud-count" data-kch-count>{beats.prologue.title}</span>
				</p>
			</div>
			<p class="kch-caption" aria-hidden="true">{chapter.field.note}</p>

			<nav class="kch-map" aria-label={chapter.mapLabel}>
				<ol>
					{
						beatList.map((beat, b) => (
							<li>
								<a href={`#${stops[b]}`} data-goto={b} data-beat={b}>
									<span class="kch-map-dot" aria-hidden="true" />
									<span class="kch-map-n">{beat.number}</span>
									<span class="kch-map-title">{beat.title}</span>
								</a>
								{b === 3 && (
									<ol class="kch-ticks">
										{parts.features.map((f, i) => (
											<li>
												<a href={`#${f.id}`} data-goto={3 + i} aria-label={`${beat.number} ${beat.title}: ${f.title}`}>
													<span class="kch-map-title" aria-hidden="true">{f.title}</span>
												</a>
											</li>
										))}
									</ol>
								)}
							</li>
						))
					}
				</ol>
			</nav>

			<div class="kch-gate" data-kch-gate hidden>
				<p class="kch-gate-label">{chapter.loading}</p>
				<div class="kch-gate-bar" aria-hidden="true"><span></span></div>
			</div>

			<div class="kch-panels">
				<div class="kch-band dark">
					<!-- The plain page's picture: a still of the 3D, the KitBot on the field (scripts/bake-field-still.py). -->
					{fieldStill && <img class="kch-field-still" src={fieldStill.src} srcset={fieldStill.srcset} sizes="(min-width: 76rem) 76rem, 100vw" alt={chapter.field.alt} width="1600" height="900" loading="lazy" />}
					<!-- 01 Prologue -->
					<section id="prologue" class="kch-panel" data-stop="0" aria-labelledby="kitbot-prologue-label">
						<BeatLabel id="kitbot-prologue-label" beat={beats.prologue} />
						<p class="kch-classic-hud">
							<span class="kch-hud-state"><span class="kch-hud-dot" aria-hidden="true"></span>{chapter.hud.state}</span>
							<span>{chapter.hud.detail}</span>
							<span>
								<span aria-hidden="true">{chapter.hud.city}</span>
								<span class="sr-only">{chapter.hud.timeLabel} {chapter.hud.city}:</span>
								<time class="kch-hud-time" data-kch-clock={chapter.hud.timeZone}>--:--:--</time>
							</span>
						</p>
						<p class="kch-statement font-wide">{chapter.prologue.statement}</p>
					</section>

					<!-- 02 The stakes -->
					<section id="stakes" class="kch-panel" data-stop="1" aria-labelledby="kitbot-stakes-label">
						<BeatLabel id="kitbot-stakes-label" beat={beats.stakes} />
						<p class="kch-stat-label">{chapter.stakes.label}</p>
						<p class="kch-stat font-wide"><span>{chapter.stakes.value}</span> <span class="kch-stat-unit">{chapter.stakes.unit}</span></p>
						<p class="kch-stat-secondary font-wide">{chapter.stakes.secondary}</p>
						<p class="kch-stat-source">{chapter.stakes.source}</p>
						<p class="kch-aside">{chapter.stakes.aside}</p>
					</section>

					<!-- 03 The reveal -->
					<header id="reveal" class="kch-panel kch-reveal" data-stop="2" aria-labelledby="kitbot-reveal-label">
						<BeatLabel id="kitbot-reveal-label" beat={beats.reveal} />
						<p class="kch-status">{chapter.reveal.status}</p>
						<h2 class="font-wide"><span class="kch-kicker">{chapter.reveal.kicker}</span> {chapter.reveal.name}</h2>
						<p class="kch-intro">{chapter.reveal.intro}</p>
						<dl class="kch-facts">
							{
								chapter.reveal.facts.map((f) => (
									<div>
										<dt>
											<DataIcon name={f.icon} className="size-4" />
											{f.label}
										</dt>
										<dd>{f.value}</dd>
									</div>
								))
							}
						</dl>
						<div class="kch-actions">
							<a href={chapter.reveal.specsHref} class="frc-btn press"><span data-roll>{chapter.reveal.specsLink}</span><span class="frc-btn-chev" aria-hidden="true">»</span></a>
							<a href={chapter.reveal.resultsHref} class="kch-link">{chapter.reveal.resultsLink}</a>
						</div>
						<p class="kch-note">{parts.note}</p>
						{overviewStill && <img class="kch-still" src={overviewStill.src} srcset={overviewStill.srcset} sizes="(min-width: 48rem) 40rem, 100vw" alt={parts.modelLabel} width="1600" height="1200" loading="lazy" data-zoom={overviewStill.full} data-zoom-caption={parts.modelLabel} role="button" tabindex="0" />}
					</header>
				</div>

				<!-- 04 Anatomy: the parts (Classic: cards with renders of the real model) -->
				<div class="kch-parts">
					<section id={first.id} class="kch-panel showcase-feature" data-stop="3" aria-labelledby="kitbot-anatomy-label">
						<BeatLabel id="kitbot-anatomy-label" beat={beats.anatomy} />
						<p class="kch-stat kch-stat-small font-wide"><span>{chapter.anatomy.value}</span> <span class="kch-stat-unit">{chapter.anatomy.label}</span></p>
						<h3 class="kch-parts-heading font-wide">{parts.heading}</h3>
						<h4 class="kch-part-title font-semiwide">{first.title}</h4>
						<p>{first.text}</p>
						<dl class="kch-part-facts">
							{first.facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
						</dl>
					</section>
					{
						rest.map((f, i) => {
							const s = still(f.id);
							return (
								<section id={f.id} class="kch-panel showcase-feature" data-stop={4 + i} aria-labelledby={`kitbot-part-${f.id}`}>
									<h4 id={`kitbot-part-${f.id}`} class="kch-part-title font-semiwide">{f.title}</h4>
									<p>{f.text}</p>
									<dl class="kch-part-facts">
										{f.facts.map((x) => <div><dt>{x.label}</dt><dd>{x.value}</dd></div>)}
									</dl>
									{hardwareSources[f.id] && <p class="kch-note"><a href={hardwareSources[f.id].href}>{hardwareSources[f.id].label}</a></p>}
									{parts.states[f.id] ? (
										<fieldset class="kch-states">
											<legend class="sr-only">{parts.states[f.id].legend}</legend>
											<div class="kch-state-pick">
												{parts.states[f.id].options.map((o, n) => (
													<label><input type="radio" name={`kch-state-${f.id}`} checked={n === 1} /> {o.label}</label>
												))}
											</div>
											{parts.states[f.id].options.map((o) => {
												const pic = still(o.still);
												return pic && <img class="kch-still" src={pic.src} srcset={pic.srcset} sizes="(min-width: 48rem) 36rem, 100vw" alt={`${f.title}, ${o.label}: ${parts.modelLabel}`} width="1600" height="1200" loading="lazy" data-zoom={pic.full} data-zoom-caption={`${f.title} · ${o.label}`} role="button" tabindex="0" />;
											})}
										</fieldset>
									) : s && <img class="kch-still" src={s.src} srcset={s.srcset} sizes="(min-width: 48rem) 36rem, 100vw" alt={`${f.title}: ${parts.modelLabel}`} width="1600" height="1200" loading="lazy" data-zoom={s.full} data-zoom-caption={f.title} role="button" tabindex="0" />}
								</section>
							);
						})
					}
				</div>
			</div>
		</div>
	</div>
	<p class="sr-only" aria-live="polite" data-kch-live></p>
</div>
<div id="after-kitbot" class="kch-after" tabindex="-1"></div>

<style is:global>
	/* ---------- Both modes ---------- */
	.kch .chapter-label {
		font: 600 0.8rem/1.3 ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.kch .chapter-label-n {
		color: var(--foreground);
		margin-right: 0.6em;
	}
	.kch-panel {
		color: var(--foreground);
		scroll-margin-top: 5rem;
	}
	.kch-hud-state {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
	}
	.kch-hud-dot {
		width: 0.5em;
		height: 0.5em;
		background: var(--accent);
	}
	.kch-hud-time {
		display: inline-block;
		min-width: 8ch;
		color: var(--foreground);
		font-variant-numeric: tabular-nums;
	}
	.kch-statement {
		max-width: 16ch;
		font-weight: 860;
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 1.02;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}
	.kch-stat-label {
		font: 600 0.85rem/1.3 ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted-foreground);
	}
	.kch-stat {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 0.3em;
		font-weight: 900;
		font-size: clamp(4rem, 15vw, 9rem);
		line-height: 0.86;
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
	}
	.kch-stat > span:first-child {
		white-space: nowrap;
	}
	.kch-stat-small {
		font-size: clamp(2.75rem, 8vw, 5rem);
	}
	.kch-stat-unit {
		font-size: 0.32em;
		font-weight: 760;
		letter-spacing: 0;
		color: var(--muted-foreground);
	}
	.kch-stat-secondary {
		font-size: clamp(1.4rem, 3vw, 2.25rem);
		font-weight: 780;
		color: var(--muted-foreground);
	}
	.kch-stat-source,
	.kch-aside {
		max-width: 46ch;
		font-size: 1.125rem;
	}
	.kch-stat-source {
		color: var(--muted-foreground);
	}
	.kch-reveal h2 {
		font-size: clamp(2.8rem, 8vw, 6.25rem);
		font-weight: 900;
		line-height: 0.94;
	}
	.kch-kicker {
		display: block;
		margin-bottom: 0.15em;
		font-size: 0.36em;
		font-weight: 720;
		color: var(--muted-foreground);
	}
	.kch-intro {
		max-width: 56ch;
		font-size: 1.125rem;
	}
	.kch-facts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem 1.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}
	@media (min-width: 40rem) {
		.kch-facts {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	.kch-facts dt {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		font-size: 0.875rem;
		color: var(--muted-foreground);
	}
	.kch-facts dd {
		font-weight: 600;
	}
	.kch-team {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		font-size: 0.875rem;
		color: var(--muted-foreground);
	}
	.kch-team a {
		font-weight: 500;
		color: var(--foreground);
	}
	.kch-team a:hover {
		text-decoration: underline;
	}
	.kch-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
	}
	.kch-note,
	.kch-legend {
		max-width: 48ch;
		font-size: 0.875rem;
		color: var(--muted-foreground);
	}
	.kch-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
	}
	.kch-legend > span {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.kch-swatch {
		width: 1.25rem;
		height: 0.375rem;
		border-radius: 999px;
	}
	.kch-parts-heading {
		font-size: clamp(2rem, 4.5vw, 3.25rem);
		font-weight: 850;
	}
	.kch-parts-intro {
		max-width: 56ch;
		font-size: 1.125rem;
		color: var(--muted-foreground);
	}
	.kch-part-title {
		font-size: 1.5rem;
		font-weight: 780;
	}
	.kch-part-facts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem 1.5rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--border);
	}
	.kch-part-facts dt {
		font-size: 0.8rem;
		color: var(--muted-foreground);
	}
	.kch-part-facts dd {
		font-weight: 600;
	}
	.kch-skip {
		position: absolute;
		left: 1rem;
		z-index: 60;
		translate: 0 -200%;
		padding: 0.6rem 1rem;
		border-radius: 999px;
		background: var(--primary);
		color: var(--primary-foreground);
		font-weight: 600;
	}
	.kch-skip:focus-visible {
		translate: 0 0.5rem;
		outline: 2px solid var(--ring);
		outline-offset: 2px;
	}

	/* ---------- Classic: an ordinary page, in the same order ---------- */
	.kch[data-read] :is(.kch-bg, .kch-stage, .kch-poster, .kch-veil, .kch-frame, .kch-hud, .kch-map, .kch-gate, .kch-caption) {
		display: none;
	}
	.kch[data-read] .kch-band {
		padding-bottom: 6rem;
		background: var(--frc-k, #070b12);
	}
	/* The still of the KitBot on the field, at the top of the plain page; the 3D draws it itself. */
	.kch-field-still {
		display: block;
		width: 100%;
		max-width: 76rem;
		height: auto;
		aspect-ratio: 16 / 9;
		margin-inline: auto;
		object-fit: cover;
		object-position: 68% 50%;
	}
	@media (max-width: 47.99rem) {
		.kch-field-still {
			aspect-ratio: 4 / 3;
		}
	}
	.kch:not([data-read]) .kch-field-still {
		display: none;
	}
	.kch[data-read] .kch-back {
		padding-top: 1.5rem;
	}
	.kch[data-read] .kch-panel {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		width: 100%;
		max-width: 76rem;
		margin-inline: auto;
		padding: 2.5rem clamp(1rem, 4vw, 2.5rem);
	}
	.kch-classic-hud {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		padding-block: 0.75rem;
		border-block: 1px solid var(--border);
		font: 500 0.85rem/1.4 ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.kch-classic-hud > span:last-child {
		display: inline-flex;
		gap: 1em;
		color: var(--muted-foreground);
	}
	/* A picture that opens full size (the page's viewer, src/pages/work/frc.astro) says so when pointed at. */
	.kch-still[data-zoom] {
		cursor: zoom-in;
		transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.35s;
	}
	.kch-still[data-zoom]:hover,
	.kch-still[data-zoom]:focus-visible {
		transform: scale(1.02);
		box-shadow: 0 18px 40px -22px rgb(0 0 0 / 0.55);
	}
	@media (prefers-reduced-motion: reduce) {
