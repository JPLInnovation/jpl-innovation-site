---
/**
 * The first-visit question: the 3D studio or the classic page. BaseLayout's head script puts html.choose-experience on
 * (before the first paint) for a visitor who has never answered, on a computer that would run the 3D; until they answer,
 * the page behaves as the classic one (reduce-motion and read-mode, so no 3D starts and no intro plays). This dialog
 * (the browser's own <dialog>) then asks:
 *
 *   Explore in 3D   the answer is saved and the page reloads into the studio (with a straight warning about lag)
 *   Classic         the answer is saved as Motion: Read mode (Settings) and the page stays as it is
 *
 * Escape means Classic (the safe one). It is never asked again; Settings → Motion changes it. Words: src/text/site.ts
 * (`experience`).
 */
import { BookOpen, Box, TriangleAlert } from "lucide-react";
import { experience as text } from "@/text/site";
---

<dialog id="experience-dialog" class="experience-dialog" aria-labelledby="experience-title" aria-describedby="experience-desc">
	<div class="flex flex-col gap-2">
		<h2 id="experience-title" class="font-wide text-2xl font-[850] sm:text-3xl">{text.title}</h2>
		<p id="experience-desc" class="text-[15px] text-muted-foreground">{text.description}</p>
	</div>
	<div class="grid gap-3 sm:grid-cols-2">
		<button type="button" data-experience="3d" class="experience-card press">
			<span class="experience-icon" aria-hidden="true"><Box className="size-6" strokeWidth={1.75} /></span>
			<span class="experience-name">{text.threeD.title}</span>
			<span class="experience-text">{text.threeD.text}</span>
			<span class="experience-tag experience-tag-warn"><TriangleAlert className="size-3.5" aria-hidden="true" /> {text.threeD.warning}</span>
			<span class="experience-go">{text.threeD.button}</span>
		</button>
		<button type="button" data-experience="classic" class="experience-card press" autofocus>
			<span class="experience-icon" aria-hidden="true"><BookOpen className="size-6" strokeWidth={1.75} /></span>
			<span class="experience-name">{text.classic.title}</span>
			<span class="experience-text">{text.classic.text}</span>
			<span class="experience-tag experience-tag-good">{text.classic.note}</span>
			<span class="experience-go">{text.classic.button}</span>
		</button>
	</div>
</dialog>

<style is:global>
	.experience-dialog {
		position: fixed;
		inset: 0;
		margin: auto;
		width: min(44rem, calc(100vw - 2rem));
		max-height: calc(100svh - 2rem);
		overflow: auto;
		padding: 1.5rem;
		border: 1px solid var(--border);
		border-radius: 1.25rem;
		background: var(--card);
		color: var(--foreground);
		box-shadow: 0 30px 90px -30px rgb(0 0 0 / 0.7);
		overscroll-behavior: contain;
	}
	@media (min-width: 40rem) {
		.experience-dialog {
			padding: 2rem;
		}
	}
	.experience-dialog[open] {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		animation: experience-in 0.35s cubic-bezier(0.65, 0, 0.35, 1);
	}
	.experience-dialog::backdrop {
		background: rgb(2 6 23 / 0.72);
		-webkit-backdrop-filter: blur(6px);
		backdrop-filter: blur(6px);
	}
	@keyframes experience-in {
		from {
			opacity: 0;
			transform: translateY(10px) scale(0.97);
		}
	}
	html.reduce-motion .experience-dialog[open] {
		animation: none;
	}
	.experience-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.6rem;
		padding: 1.25rem;
		border: 1px solid var(--border);
		border-radius: 1rem;
		background: color-mix(in oklab, var(--foreground) 4%, transparent);
		text-align: left;
		cursor: pointer;
		transition:
			border-color 0.2s,
			background-color 0.2s,
			transform 0.2s;
	}
	.experience-card:hover,
	.experience-card:focus-visible {
		border-color: var(--accent);
		background: color-mix(in oklab, var(--accent) 10%, transparent);
		transform: translateY(-2px);
	}
	.experience-card:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.experience-icon {
		display: inline-flex;
		width: 2.75rem;
		height: 2.75rem;
		align-items: center;
		justify-content: center;
		border-radius: 0.75rem;
		background: color-mix(in oklab, var(--accent) 18%, transparent);
		color: var(--foreground);
	}
	.experience-name {
		font-stretch: 112%;
		font-weight: 800;
		font-size: 1.35rem;
		line-height: 1.1;
	}
	.experience-text {
		font-size: 0.95rem;
		color: var(--muted-foreground);
	}
	.experience-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		border-radius: 999px;
		padding: 0.2rem 0.65rem;
		font: 600 12px/1.4 ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
	}
	.experience-tag-warn {
		background: #fde68a;
		color: #5c3d00;
	}
	.experience-tag-good {
		background: #bbf7d0;
		color: #14532d;
	}
	.dark .experience-tag-warn {
		background: rgb(251 191 36 / 0.18);
		color: #fcd34d;
	}
	.dark .experience-tag-good {
		background: rgb(74 222 128 / 0.16);
		color: #86efac;
	}
	.experience-go {
		margin-top: auto;
		padding-top: 0.4rem;
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 4px;
	}
</style>

<script>
	import { EXPERIENCE_KEY, MOTION_KEY } from "@/lib/prefs";

	const store = (key: string, value: string | null) => {
		try {
			if (value === null) localStorage.removeItem(key);
			else localStorage.setItem(key, value);
		} catch {}
	};
	const dialog = () => document.getElementById("experience-dialog") as HTMLDialogElement | null;

	function answer(choice: "3d" | "classic") {
		const d = dialog();
		store(EXPERIENCE_KEY, choice);
		if (choice === "3d") {
			// Full motion; the page loads again with the studio in it (everything that animates reads this on load).
			store(MOTION_KEY, null);
			location.reload();
			return;
		}
		// Classic is the read mode of Settings: the page is already showing it, so it just stays.
		store(MOTION_KEY, "read");
		document.documentElement.classList.remove("choose-experience");
		d?.close();
	}

	function ask() {
		const d = dialog();
		if (d && document.documentElement.classList.contains("choose-experience") && !d.open) d.showModal();
	}

	// Delegated once, so it keeps working after client-side page swaps (the dialog is part of each page).
	document.addEventListener("click", (event) => {
		const button = (event.target as Element).closest<HTMLElement>("[data-experience]");
		if (button) answer(button.dataset.experience === "3d" ? "3d" : "classic");
	});
	// Escape is the safe answer.
	document.addEventListener(
		"cancel",
		(event) => {
			if ((event.target as HTMLElement).id !== "experience-dialog") return;
			event.preventDefault();
			answer("classic");
		},
		true,
	);
	document.addEventListener("astro:page-load", ask);
</script>
