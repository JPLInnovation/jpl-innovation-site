---
import { ClientRouter } from "astro:transitions";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import FrcSplash from "@/components/FrcSplash.astro";
import IntroSplash from "@/components/IntroSplash.astro";
import { splashFor } from "@/lib/splash";
import "@/styles/global.css";
// The subset almost every page's text uses. Preloading it lets the display headings render in Archivo
// straight away instead of reflowing when the font arrives (layout shift).
import archivoLatin from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import { site } from "@/text/site";

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	/**
	 * false: no canonical URL or og:url (the 404 page, which has no address of its own). It isn't marked noindex:
	 * GitHub Pages already serves it with a 404 status, which keeps it out of search results.
	 */
	canonical?: boolean;
}

const {
	title = "JPL Innovation",
	description = site.description,
	canonical: hasCanonical = true,
} = Astro.props;
// The page's one official address, for search engines and link previews.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
// Which logo intro this page plays on a full load or refresh (FRC pages: FrcSplash; everything else: IntroSplash).
const splash = splashFor(Astro.url.pathname);
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#eef3fd" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#050a1f" media="(prefers-color-scheme: dark)" />
		{hasCanonical && <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{hasCanonical && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={new URL("/assets/logo.jpg", Astro.site ?? Astro.url)} />
		<meta name="twitter:card" content="summary" />
		<title>{title}</title>
		<slot name="head" />
		<link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<script is:inline>
			// Inlined and blocking so the page never flashes the wrong theme.
			// `motion` hides scroll-revealed content until src/scripts/motion.ts animates it in.
			// Skipped for reduced motion; removed again if the script hasn't started within 2.5 s.
			const applyMotion = () => {
				const root = document.documentElement;
				if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
				root.classList.add("motion");
				setTimeout(() => {
					if (!root.classList.contains("motion-live")) root.classList.remove("motion");
				}, 2500);
			};
			applyMotion();
			// The only thing this site keeps in localStorage is this theme choice (no tokens, no accounts).
			// Anything other than "dark"/"light" is ignored and the system setting is used instead.
			const applyTheme = () => {
				let stored = null;
				try {
					stored = localStorage.getItem("theme");
				} catch {}
				const valid = stored === "dark" || stored === "light";
				const dark = valid ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle("dark", dark);
			};
			applyTheme();
			// Client-side navigation swaps <html> attributes, so re-apply after each swap.
			if (!window.__jplThemeHook) {
				document.addEventListener("astro:after-swap", () => {
					applyTheme();
					applyMotion();
				});
				window.__jplThemeHook = true;
			}
		</script>
		<!-- Logo intros, on every full page load or refresh; the FRC one also when you click through to it (src/lib/splash.ts). Remove a line to turn that intro off. -->
		{splash === "jpl" && <IntroSplash />}
		{splash === "frc" && <FrcSplash />}
		<ClientRouter />
	</head>
	<body>
		<!-- Animated background (global.css + src/scripts/background.ts). Persisted so it doesn't restart on navigation. -->
		<div class="site-bg" aria-hidden="true" transition:persist="site-bg">
			<div class="site-bg__mesh"></div>
			<canvas class="site-bg__net" data-site-bg></canvas>
			<div class="site-bg__glow" data-site-glow></div>
		</div>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-foreground"
		>
			Skip to content
		</a>
		<SiteHeader />
		<main id="main" class="flex-1">
			<slot />
		</main>
		<SiteFooter />
		<script>
			import "@/scripts/background";
			import "@/scripts/motion";
		</script>
	</body>
</html>
