---
import { getEntry, render } from "astro:content";
import BackLink from "@/components/BackLink.astro";
import { backToWork } from "@/text/work";
import IosTerminal from "@/components/IosTerminal.astro";
import ContactSection from "@/components/ContactSection.astro";
import NextChapter from "@/components/NextChapter.astro";
import ModelViewer from "@/components/model-viewer";
import PageIntro from "@/components/PageIntro.astro";
import StatusTag from "@/components/StatusTag.astro";
import SubnetSplit from "@/components/SubnetSplit.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

// Words: src/text/projects/cybersecurity.ts (title, intro and write-up: src/text/projects/cybersecurity.md)
import { cyberPage } from "@/text/projects/cybersecurity";
const entry = (await getEntry("work", "cybersecurity"))!;
const { Content } = await render(entry);
const { data } = entry;

const { model3d, ccna } = cyberPage;
const legend = [
	{ color: "bg-chart-1", label: model3d.legend.vlan10 },
	{ color: "bg-chart-2", label: model3d.legend.vlan20 },
	{ color: "bg-chart-3", label: model3d.legend.allowed },
	{ color: "bg-chart-4", label: model3d.legend.dropped },
];
---

<BaseLayout title={`${data.title} | JPL Innovation`} description={data.description}>
	<PageIntro title={data.title} lede={data.description}>
		<div slot="before" class="flex flex-col gap-4">
			<BackLink href="/work/">{backToWork}</BackLink>
			{data.badge && <StatusTag>{data.badge}</StatusTag>}
		</div>
	</PageIntro>

	<section class="wrapper" aria-labelledby="lab-heading">
		<h2 id="lab-heading" class="sr-only">{model3d.heading}</h2>
		<figure class="flex flex-col gap-4" data-reveal data-reveal-delay="200">
			<div class="overflow-hidden rounded-xl border surface">
				<ModelViewer
					client:visible
					model="network"
					label={model3d.description}
					className="aspect-[4/3] w-full md:aspect-[21/10]"
				>
					<img src={data.img} alt={data.img_alt ?? ""} transition:name={`project-${entry.id}`} class="size-full object-cover" />
				</ModelViewer>
			</div>
			<figcaption class="flex flex-col gap-3">
				<ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
					{
						legend.map((item) => (
							<li class="flex items-center gap-2">
								<span class={`size-2.5 rounded-full ${item.color}`} aria-hidden="true" />
								{item.label}
							</li>
						))
					}
				</ul>
				<p class="text-sm text-muted-foreground">{model3d.caption}</p>
			</figcaption>
		</figure>
	</section>

	<article class="wrapper py-16 md:py-24">
		<div class="prose prose-lg prose-site max-w-[68ch]" data-reveal>
			<Content />
		</div>
	</article>

	<section class="border-y bg-card/70" aria-labelledby="ccna-heading">
		<div class="wrapper flex flex-col gap-10 py-20 md:py-28">
			<div class="flex max-w-2xl flex-col gap-3" data-reveal>
				<h2 id="ccna-heading" class="font-wide text-3xl font-[850] md:text-5xl">{ccna.heading}</h2>
				<p class="text-lg text-muted-foreground">{ccna.intro}</p>
			</div>
			<div class="grid items-start gap-8 lg:grid-cols-[1.15fr_1fr] lg:gap-10">
				<div data-reveal><IosTerminal /></div>
				<div data-reveal data-reveal-delay="150"><SubnetSplit /></div>
			</div>
		</div>
	</section>

	<NextChapter current={"cybersecurity"} />
	<ContactSection />
</BaseLayout>
