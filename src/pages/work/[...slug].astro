---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BackLink from "@/components/BackLink.astro";
import { backToWork } from "@/text/work";
import ContactSection from "@/components/ContactSection.astro";
import PageIntro from "@/components/PageIntro.astro";
import StatusTag from "@/components/StatusTag.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
	entry: CollectionEntry<"work">;
}

export async function getStaticPaths() {
	// FRC, the drone and cybersecurity have their own pages in src/pages/work/.
	const custom = ["frc", "drone", "cybersecurity", "mini-drone"];
	const work = await getCollection("work", (entry) => !custom.includes(entry.id));
	return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
---

<BaseLayout title={`${data.title} | JPL Innovation`} description={data.description}>
	<PageIntro title={data.title} lede={data.description}>
		<div slot="before" class="flex flex-col gap-4">
			<BackLink href="/work/">{backToWork}</BackLink>
			{data.badge && <StatusTag>{data.badge}</StatusTag>}
		</div>
	</PageIntro>

	<div class="wrapper" data-reveal data-reveal-delay="200">
		<img transition:name={`project-${entry.id}`} src={data.img} alt={data.img_alt ?? ""} class="aspect-[21/9] w-full rounded-xl bg-muted object-cover" />
	</div>

	<article class="wrapper py-16 md:py-24">
		<div class="prose prose-lg prose-site max-w-[68ch]" data-reveal>
			<Content />
		</div>
	</article>

	<ContactSection />
</BaseLayout>
