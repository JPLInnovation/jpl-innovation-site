---
import { getEntry } from "astro:content";
import BackLink from "@/components/BackLink.astro";
import { backToWork } from "@/text/work";
import FrcRobotReveal from "@/components/frc-robot-reveal";
import FrcLockup from "@/components/FrcLockup.astro";
import FrcSeasons from "@/components/frc-seasons";
import HardwareStack from "@/components/HardwareStack.astro";
import Leadership from "@/components/Leadership.astro";
import ContactSection from "@/components/ContactSection.astro";
import ModelViewer from "@/components/model-viewer";
import Odometer from "@/components/Odometer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
// All the words on this page: src/text/projects/frc.ts (intro sentence and photo: src/text/projects/frc.md)
import { frcPage, team } from "@/text/projects/frc";
import { DataIcon } from "@/lib/icons";

const entry = (await getEntry("work", "frc"))!;

const { facts: f } = frcPage;
const facts = [
	{ label: f.rookieYear, value: String(team.rookieYear) },
	{ label: f.region, value: team.region },
	{ label: f.homeLabel, value: f.home },
	{ label: f.nextSeasonLabel, value: f.nextSeason },
];
---

<BaseLayout title={frcPage.seoTitle} description={entry.data.description}>
	<div class="wrapper pt-6 md:pt-8">
		<BackLink href="/work/">{backToWork}</BackLink>
	</div>

	<header class="wrapper flex flex-col items-center gap-6 pb-14 pt-6 text-center md:pb-20 md:pt-10">
		<!-- Logo lockup; the FRC intro (FrcSplash) lands exactly on this. -->
		<FrcLockup />
		<h1 class="font-wide text-[clamp(3.25rem,12vw,10.5rem)] font-[900] leading-[0.9] tracking-[-0.03em]">
			{frcPage.headingPrefix} <Odometer value={String(team.number)} />
		</h1>
		<p class="max-w-[56ch] text-lg text-muted-foreground md:text-xl" data-reveal data-reveal-delay="250">
			{entry.data.description}
		</p>
		<dl class="mt-4 grid w-full max-w-3xl grid-cols-2 gap-x-6 gap-y-5 border-t pt-6 sm:grid-cols-4" data-reveal-group>
			{
				facts.map((f) => (
					<div class="flex flex-col gap-0.5">
						<dt class="text-sm text-muted-foreground">{f.label}</dt>
						<dd class="font-semibold">{f.value}</dd>
					</div>
				))
			}
		</dl>
	</header>

	<FrcRobotReveal client:load src={entry.data.img} alt={entry.data.img_alt ?? ""} />

	<section class="wrapper pt-20 md:pt-28" aria-labelledby="robot-3d-heading">
		<div class="grid items-center gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
			<div class="flex flex-col gap-4" data-reveal>
				<h2 id="robot-3d-heading" class="font-wide text-3xl font-[850] md:text-5xl">{frcPage.model3d.heading}</h2>
				<p class="text-lg text-muted-foreground">{frcPage.model3d.text}</p>
				<p class="text-sm text-muted-foreground">{frcPage.model3d.note}</p>
			</div>
			<div class="overflow-hidden rounded-xl border surface" data-reveal data-reveal-delay="150">
				<ModelViewer
					client:visible
					model="frc-robot"
					label={frcPage.model3d.description}
					className="aspect-[4/3] w-full"
				>
					<img src="/assets/FRCnew.jpg" alt={frcPage.model3d.fallbackAlt} class="size-full object-cover object-[32%_68%]" loading="lazy" />
				</ModelViewer>
			</div>
		</div>
	</section>

	<div class="wrapper py-24 md:py-32">
		<!-- Hydrates once the page is idle: it's below the fold, and #2026 deep links still work. -->
		<FrcSeasons client:idle />
	</div>

	<HardwareStack />

	<section class="border-t bg-card/70" aria-labelledby="team-heading">
		<div class="wrapper flex flex-col gap-8 py-20 md:py-24">
			<div class="flex max-w-2xl items-center gap-5" data-reveal>
				<img
					src={team.logo}
					alt=""
					width="764"
					height="764"
					loading="lazy"
					class="size-16 shrink-0 rounded-full object-cover ring-1 ring-border md:size-20"
				/>
				<div class="flex flex-col gap-2">
					<h2 id="team-heading" class="font-wide text-3xl font-[850] md:text-4xl">{frcPage.about.headingPrefix} {team.number}</h2>
					<p class="text-lg text-muted-foreground">{team.name}, {team.school}. {team.mission}.</p>
				</div>
			</div>
			<ul class="grid gap-x-8 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
				{
					team.focus.map((f) => (
						<li class="flex flex-col gap-2 border-t py-6">
							<DataIcon name={f.icon} className="size-6" strokeWidth={1.75} />
							<h3 class="font-semiwide text-lg font-[760]">{f.title}</h3>
							<p class="text-muted-foreground">{f.desc}</p>
						</li>
					))
				}
			</ul>
			<div class="mt-6 border-t pt-12">
				<Leadership
					lead="frc"
					heading={frcPage.about.leadershipHeading}
					headingLevel="h3"
					id="frc-leadership"
					intro={frcPage.about.leadershipIntro}
				/>
			</div>
		</div>
	</section>

	<ContactSection />
</BaseLayout>
