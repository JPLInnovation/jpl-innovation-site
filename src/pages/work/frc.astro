		width: 1.3rem;
		height: 0.75rem;
		border: 1px solid rgb(120 165 230 / 0.42);
		border-bottom: 0;
	}
	.frc-grid-key [data-kind="above"]::before {
		background: rgb(120 165 230 / 0.16);
		border-color: transparent;
	}
	.frc-grid-key [data-kind="us"]::before {
		background: var(--frc-y);
		border-color: var(--frc-y);
	}
	.frc-ev-low {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem 2.5rem;
	}
	.frc-ev-playoffs {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}
	.frc-ev-playoffs h4 {
		font-size: var(--step-small);
		font-weight: 650;
	}
	.frc-ev-playoffs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.frc-ev-playoffs li {
		padding: 0.3rem 0.65rem;
		box-shadow: inset 0 0 0 1px var(--border);
		font-size: 0.9rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}
	.frc-ev-playoffs li[data-won] {
		background: var(--frc-b);
		color: var(--frc-k);
		box-shadow: none;
	}
	.frc-ev-goals summary {
		display: flex;
		align-items: center;
		min-height: 44px;
		cursor: pointer;
		font-weight: 650;
	}
	.frc-ev-goals ul {
		padding-left: 1.25rem;
		list-style: disc;
		color: var(--muted-foreground);
	}
	.frc-ev-source {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		min-height: 44px;
		font-weight: 650;
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	/* The season's goals as rows, not three cards (frc-views.tsx Goals2027). */
	.frc-goals {
		display: grid;
		border-top: 1px solid var(--border);
	}
	.frc-goals > li {
		display: grid;
		gap: 0.75rem 2rem;
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--border);
	}
	@media (min-width: 768px) {
		.frc-goals > li {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
		}
	}

	/* ---------- Partnering ---------- */
	.frc-partner {
		display: grid;
		gap: 3rem;
	}
	@media (min-width: 1024px) {
		.frc-partner {
			grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
			align-items: start;
		}
	}
	.frc-partner-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
	}
	.frc-partner-back {
		margin-top: 0.75rem;
		font-size: 1.05rem;
		font-weight: 650;
	}
	.frc-partner-list {
		width: 100%;
	}
	.frc-partner-list li {
		padding-block: 0.6rem;
		border-top: 1px solid var(--border);
		font-size: var(--step-small);
	}

	/* ---------- The photo viewer (frc-photos.tsx, frc-views.tsx and [data-zoom] on this page): the browser's own <dialog> ---------- */
	.frc-lightbox {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 4.5rem 4.5rem 2rem;
		border: 0;
		background: transparent;
		display: none;
		align-items: center;
		justify-content: center;
	}
	.frc-lightbox[open] {
		display: flex;
	}
	.frc-lightbox::backdrop {
		background: rgb(7 11 18 / 0.94);
	}
	@media (max-width: 640px) {
		.frc-lightbox {
			padding: 4.5rem 0.75rem 1.5rem;
		}
	}
	.frc-zoom {
		cursor: zoom-in;
	}
	.frc-zoom img,
	.frc-zoom-img {
		transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.frc-zoom-img {
		cursor: zoom-in;
	}
	.frc-zoom:hover img,
	.frc-zoom:focus-visible img,
	.frc-zoom-img:hover,
	.frc-zoom-img:focus-visible {
		transform: scale(1.04);
	}
	@media (prefers-reduced-motion: reduce) {
		.frc-zoom img,
		.frc-zoom-img {
			transition: none;
		}
		.frc-zoom:hover img,
		.frc-zoom:focus-visible img,
		.frc-zoom-img:hover,
		.frc-zoom-img:focus-visible {
			transform: none;
		}
	}
	.frc-lightbox-btn {
		position: absolute;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		background: var(--frc-y);
		color: var(--frc-k);
	}
	.frc-round-btn {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--card);
		transition: border-color 0.2s;
	}
	.frc-round-btn:hover {
		border-color: var(--foreground);
	}
	/* A print: white border, like a photo on a desk (no shadow on dark). */
	.frc-print {
		border-radius: 0.6rem;
		background: #fff;
		padding: 6px;
	}
	.frc-print img {
		border-radius: 0.35rem;
	}
	.frc-print-caption {
		position: absolute;
		inset-inline: 6px;
		bottom: 6px;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		border-radius: 0 0 0.35rem 0.35rem;
		padding: 2.5rem 1rem 0.8rem;
		background: linear-gradient(in oklch to top, rgb(7 11 18 / 0.8), rgb(7 11 18 / 0));
		color: #fff;
		pointer-events: none;
	}
	/* The build season strips: side by side, the open one wide; stacked on phones. */
	.frc-strips {
		display: flex;
		gap: 0.5rem;
		height: clamp(22rem, 42vw, 30rem);
	}
	.frc-strips > li {
		flex: 1 1 0;
		min-width: 0;
		transition: flex-grow 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.frc-strips > li[data-open] {
		flex-grow: 6;
	}
	.frc-strip-label {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 3rem 1rem 0.9rem;
		background: linear-gradient(in oklch to top, rgb(7 11 18 / 0.82), rgb(7 11 18 / 0));
		color: #fff;
		white-space: nowrap;
	}
	.frc-strips > li:not([data-open]) .frc-strip-caption {
		opacity: 0;
	}
	.frc-strips > li:not([data-open]) .frc-strip-label {
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		inset: auto 0 0 auto;
		margin: 0.4rem;
		border-radius: 999px;
		padding: 0.7rem 0.3rem;
		background: rgb(7 11 18 / 0.78);
	}
	@media (max-width: 767px) {
		.frc-strips {
			flex-direction: column;
			height: 44rem;
		}
	}
	/* The preseason posts: a row that scrolls sideways and snaps, its far edge fading out. */
	.frc-posts {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: min(15.5rem, 78%);
		gap: 1.25rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding-bottom: 0.75rem;
		scrollbar-width: thin;
		-webkit-mask-image: linear-gradient(in oklch to right, #000 88%, transparent);
		mask-image: linear-gradient(in oklch to right, #000 88%, transparent);
	}
	.frc-post {
		scroll-snap-align: start;
		overflow: hidden;
		border-radius: 0.9rem;
		border: 1px solid var(--border);
		background: var(--card);
	}
	/* ---------- The pit board ---------- */
	.frc-board > .wrapper {
		padding-block: clamp(4rem, 11svh, 7rem);
	}
	.frc-board-h {
		font-family: var(--frc-disp);
		font-weight: 400;
		font-size: clamp(2.4rem, 3.6vw, 3.6rem);
		line-height: 0.92;
		letter-spacing: 0;
		text-transform: uppercase;
		text-wrap: balance;
	}
	.frc-board-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
	}
	.frc-board-intro {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	@media (min-width: 1024px) {
		.frc-board-grid {
			grid-template-columns: 16.5rem minmax(0, 1fr);
			grid-template-rows: auto 1fr;
			column-gap: 2.25rem;
			row-gap: 1.75rem;
			align-items: start;
		}
		.frc-board-intro {
			grid-column: 1;
			grid-row: 1;
		}
		.frc-rail {
			grid-column: 1;
			grid-row: 2;
		}
		.frc-panels {
			grid-column: 2;
			grid-row: 1 / span 2;
		}
	}
	/* The rail: a column of chapters on wide screens; a row that swipes, stuck under the header, on phones. */
	.frc-rail {
		position: sticky;
		top: 4.5rem;
		z-index: 20;
		margin-inline: -1rem;
		padding: 0.5rem 1rem;
		background: var(--frc-k);
	}
	.frc-rail [role="tablist"] {
		display: flex;
		gap: 0.25rem;
		overflow-x: auto;
		scrollbar-width: none;
		-webkit-mask-image: linear-gradient(in oklch to right, #000 86%, transparent);
		mask-image: linear-gradient(in oklch to right, #000 86%, transparent);
	}
	@media (min-width: 1024px) {
		.frc-rail {
			top: 6rem;
			margin: 0;
			padding: 0;
			background: none;
		}
		.frc-rail [role="tablist"] {
			flex-direction: column;
			gap: 0;
			overflow: visible;
			-webkit-mask-image: none;
			mask-image: none;
		}
	}
	.frc-rail button {
		flex: none;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.15rem;
		min-height: 44px;
		padding: 0.7rem 0.75rem;
		text-align: left;
		transition:
			transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
			background-color 0.2s,
			color 0.2s;
	}
	@media (min-width: 1024px) {
		.frc-rail button {
			border-top: 1px solid var(--border);
		}
		.frc-rail button:hover:not([aria-selected="true"]) {
			transform: translateX(5px);
		}
	}
	.frc-rail-name {
		font-family: var(--frc-disp);
		font-weight: 400;
		font-size: 1.45rem;
		line-height: 1;
		text-transform: uppercase;
	}
	.frc-rail-figure {
		font-size: 0.8rem;
		color: var(--muted-foreground);
	}
	.frc-rail button[aria-selected="true"] {
		background: var(--frc-y);
		color: var(--frc-k);
	}
	.frc-rail button[aria-selected="true"] .frc-rail-figure {
		color: rgb(7 11 18 / 0.78);
	}
	/* A chapter: its name and its views on top, the view, and the way on to the next chapter. A lighter surface on the
	   night ground, and the cards inside it one step lighter again. */
	.frc-chapter {
		--card: #19233a;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		border-radius: 1rem;
		background: var(--frc-s);
		padding: 1.25rem;
	}
	@media (min-width: 1024px) {
		.frc-chapter {
			min-height: min(46rem, calc(100svh - 8.5rem));
			padding: 2rem 2.25rem;
		}
	}
	.frc-chapter[hidden],
	.frc-view[hidden] {
		display: none !important;
	}
	.frc-chapter-head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
	}
	.frc-views {
		display: flex;
		gap: 1.25rem;
		max-width: 100%;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.frc-views button {
		flex: none;
		min-height: 44px;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--muted-foreground);
		box-shadow: inset 0 -2px 0 transparent;
		transition:
			color 0.2s,
			box-shadow 0.2s;
	}
	.frc-views button:hover {
		color: var(--foreground);
	}
	.frc-views button[aria-selected="true"] {
		color: var(--foreground);
		box-shadow: inset 0 -2px 0 var(--frc-y);
	}
	.frc-chapter-foot {
		margin-top: auto;
		display: flex;
		justify-content: flex-end;
		border-top: 1px solid var(--border);
		padding-top: 0.75rem;
	}
	.frc-next {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 44px;
		color: var(--muted-foreground);
	}
	.frc-next span:not([aria-hidden]) {
		font-weight: 700;
		color: var(--foreground);
	}
	.frc-next span[aria-hidden] {
		transition: transform 0.25s;
	}
	.frc-next:hover span[aria-hidden] {
		transform: translateX(4px);
	}
	/* Before the script runs (or without it) every chapter and view is shown in turn; the tabs would do nothing. */
	.frc-board:not(.is-live) :is(.frc-rail, .frc-views) {
		display: none;
	}
	.frc-board:not(.is-live) .frc-panels {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.frc-board .frc-strips {
		height: clamp(11rem, 18vw, 15rem);
	}
	/* A row of prints that scrolls sideways (src/components/frc-views.tsx Filmstrip), its far edge fading out. */
	.frc-film {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: min(16rem, 72%);
		gap: 1rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding-bottom: 0.5rem;
		scrollbar-width: thin;
		-webkit-mask-image: linear-gradient(in oklch to right, #000 86%, transparent);
		mask-image: linear-gradient(in oklch to right, #000 86%, transparent);
	}
	.frc-film > li {
		height: clamp(16rem, 30vw, 25rem);
		scroll-snap-align: start;
	}
	/* The drawer: a sheet from the right (the browser's own <dialog>). */
	.frc-drawer {
		position: fixed;
		inset: 0 0 0 auto;
		width: min(34rem, 100vw);
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 1.5rem;
		overflow-y: auto;
		border: 0;
		border-left: 1px solid var(--border);
		background: var(--frc-s);
		color: var(--foreground);
	}
	.frc-drawer[open] {
		animation: frc-drawer-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.frc-drawer::backdrop {
		background: rgb(7 11 18 / 0.6);
	}
	@keyframes frc-drawer-in {
		from {
			transform: translateX(40px);
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.frc-drawer[open] {
			animation: none;
		}
	}
	html.reduce-motion .frc-drawer[open] {
		animation: none;
	}

	/* Small round or pill buttons (src/components/frc-story.tsx). */
	.frc-chip-btn {
		display: inline-grid;
		place-items: center;
		min-width: 44px;
		height: 44px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--card);
		font-size: 0.875rem;
		font-weight: 600;
		transition:
			border-color 0.2s,
			background 0.2s;
	}
	.frc-chip-btn:hover:not(:disabled),
	.frc-chip-btn.is-on {
		border-color: var(--foreground);
	}
	.frc-chip-btn.is-on {
		background: var(--frc-y);
		border-color: var(--frc-y);
		color: var(--frc-k);
	}
	.frc-chip-btn:disabled {
		opacity: 0.4;
	}
	/* A pick list (sub-teams, kinds of support, the season's steps): the one picked in yellow, the one pointed at nudges right. */
	.frc-pick {
		min-height: 48px;
		background: transparent;
		transition:
			transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
			border-color 0.2s,
			background 0.2s,
			color 0.2s;
	}
	.frc-pick:hover {
		transform: translateX(4px);
		border-color: var(--foreground);
	}
	.frc-pick.is-on {
		background: var(--frc-y);
		color: var(--frc-k);
		border-color: var(--frc-y);
	}
	.frc-pick.is-on span {
		color: inherit;
	}
	/* Markers on the chassis photo: flat discs that grow when pointed at or picked. */
	.frc-hotspot {
		position: absolute;
		width: 44px;
		height: 44px;
		transform: translate(-50%, -50%);
		display: grid;
		place-items: center;
	}
	.frc-hotspot i {
		width: 18px;
		height: 18px;
		border-radius: 999px;
		background: var(--frc-y);
		box-shadow: 0 0 0 3px var(--frc-k);
		transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.frc-hotspot-alt i {
		background: var(--frc-b);
	}
	.frc-hotspot:hover i,
	.frc-hotspot:focus-visible i,
	.frc-hotspot.is-on i {
		transform: scale(1.4);
	}
	/* The values: a colour bar sweeps in and the meaning rises into view when pointed at (always shown on touch). */
	.frc-value {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 1.25rem;
		min-height: 8rem;
		padding: 1.25rem;
		background: var(--card);
		outline-offset: -3px;
		transition: background 0.3s;
	}
	.frc-value::before {
		content: "";
		position: absolute;
		inset: 0 0 auto;
		height: 4px;
		background: var(--value);
		transform: scaleX(0.12);
		transform-origin: left;
		transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.frc-value p {
		color: var(--muted-foreground);
		transition:
			opacity 0.35s,
			transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.frc-value:hover,
	.frc-value:focus-visible {
		background: color-mix(in oklch, var(--value) 10%, var(--card));
	}
	.frc-value:hover::before,
	.frc-value:focus-visible::before {
		transform: scaleX(1);
	}
	@media (hover: hover) {
		.frc-value p {
			opacity: 0;
			transform: translateY(10px);
		}
		.frc-value:hover p,
		.frc-value:focus-visible p {
			opacity: 1;
			transform: none;
		}
	}
	/* The conduct rows: the ideal, an arrow that draws across, and what it means in practice. */
	.frc-conduct {
		display: grid;
		gap: 0.25rem 1.5rem;
		align-items: center;
		border-top: 1px solid var(--border);
		padding: 1rem 0.5rem;
		outline-offset: -3px;
		transition: background 0.25s;
	}
	@media (min-width: 768px) {
		.frc-conduct {
			grid-template-columns: minmax(0, 1fr) 6rem minmax(0, 1fr);
		}
	}
	.frc-conduct-arrow {
		position: relative;
		height: 2px;
		background: rgb(238 241 246 / 0.15);
	}
	.frc-conduct-arrow::before {
		content: "";
		position: absolute;
		inset: 0;
		background: var(--frc-y);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.frc-conduct-means {
		color: var(--muted-foreground);
		transition: color 0.25s;
	}
	.frc-conduct:hover,
	.frc-conduct:focus-visible {
		background: rgb(238 241 246 / 0.04);
	}
	.frc-conduct:hover .frc-conduct-arrow::before,
	.frc-conduct:focus-visible .frc-conduct-arrow::before {
		transform: scaleX(1);
	}
	.frc-conduct:hover .frc-conduct-means,
	.frc-conduct:focus-visible .frc-conduct-means {
		color: var(--foreground);
	}
	@media (max-width: 767px) {
		.frc-conduct-arrow {
			display: none;
		}
	}
	.frc-check {
		position: relative;
		padding-left: 1.6rem;
	}
	.frc-check::before {
		content: "✓";
		position: absolute;
		left: 0.15rem;
		font-weight: 800;
		color: var(--frc-y);
	}
	@media (prefers-reduced-motion: reduce) {
		.frc-strips > li,
		.frc-pick,
		.frc-value::before,
		.frc-value p,
		.frc-conduct-arrow::before {
			transition: none;
		}
