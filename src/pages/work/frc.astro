	<script>
		// The pit board: shows one chapter and one view at a time, follows the address (#2026, #2026-results, #robot,
		// a part of the robot like #intake), and is driven by mouse, touch and keyboard (arrow keys, Home, End).
		const PARTS = ["overview", "intake", "hopper", "shooter", "drivetrain", "electronics"];
		function initBoard() {
			const root = document.querySelector<HTMLElement>("[data-board]");
			if (!root || root.dataset.ready) return;
			root.dataset.ready = "1";
			const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-chapter-tab]")];
			const chapters = [...root.querySelectorAll<HTMLElement>("[data-chapter]")];
			const viewOf: Record<string, string> = {};
			for (const ch of chapters) viewOf[ch.dataset.chapter!] = ch.querySelector<HTMLElement>("[data-view]")!.dataset.view!;
			let current = chapters[0].dataset.chapter!;

			const show = (id: string, view?: string, opts: { focus?: HTMLElement | null; scroll?: boolean; write?: boolean } = {}) => {
				const ch = chapters.find((c) => c.dataset.chapter === id);
				if (!ch) return;
				if (view && ch.querySelector(`[data-view="${view}"]`)) viewOf[id] = view;
				const changed = id !== current;
				current = id;
				for (const t of tabs) {
					const on = t.dataset.chapterTab === id;
					t.setAttribute("aria-selected", String(on));
					t.tabIndex = on ? 0 : -1;
				}
				for (const c of chapters) c.hidden = c !== ch;
				for (const v of ch.querySelectorAll<HTMLElement>("[data-view]")) v.hidden = v.dataset.view !== viewOf[id];
				for (const vt of ch.querySelectorAll<HTMLButtonElement>("[data-view-tab]")) {
					const on = vt.dataset.viewTab === viewOf[id];
					vt.setAttribute("aria-selected", String(on));
					vt.tabIndex = on ? 0 : -1;
				}
				if (changed) ch.dataset.enter = String(Date.now());
				opts.focus?.focus();
				if (opts.write !== false) {
					const first = ch.querySelector<HTMLElement>("[data-view]")!.dataset.view;
					history.replaceState(null, "", `#${viewOf[id] === first ? id : `${id}-${viewOf[id]}`}`);
				}
				// On a phone the board is taller than the screen: bring the chapter's top into view.
				if (opts.scroll) {
					const top = ch.getBoundingClientRect().top;
					if (top < 0 || top > innerHeight * 0.6) ch.scrollIntoView({ block: "start", behavior: document.documentElement.classList.contains("motion") ? "smooth" : "auto" });
				}
			};

			const fromHash = (scroll: boolean) => {
				const h = decodeURIComponent(location.hash.slice(1));
				if (!h) return false;
				if (PARTS.includes(h)) return show("robot", "parts", { scroll, write: false }), true;
				for (const ch of chapters) {
					const id = ch.dataset.chapter!;
					if (h === id) return show(id, undefined, { scroll }), true;
					if (h.startsWith(id + "-")) return show(id, h.slice(id.length + 1), { scroll }), true;
				}
				return false;
			};

			root.classList.add("is-live");
			const deep = fromHash(false);
			if (!deep) show(current, undefined, { write: false });
			else requestAnimationFrame(() => root.scrollIntoView({ block: "start" }));
			addEventListener("hashchange", () => fromHash(true));

			const move = (list: HTMLButtonElement[], i: number, key: string, vertical: boolean) => {
				const back = vertical ? ["ArrowUp", "ArrowLeft"] : ["ArrowLeft"];
				const fwd = vertical ? ["ArrowDown", "ArrowRight"] : ["ArrowRight"];
				if (back.includes(key)) return (i - 1 + list.length) % list.length;
				if (fwd.includes(key)) return (i + 1) % list.length;
				if (key === "Home") return 0;
				if (key === "End") return list.length - 1;
				return -1;
			};
			tabs.forEach((t, i) => {
				t.addEventListener("click", () => show(t.dataset.chapterTab!, undefined, { scroll: innerWidth < 1024 }));
				t.addEventListener("keydown", (e) => {
					const j = move(tabs, i, e.key, true);
					if (j < 0) return;
					e.preventDefault();
					show(tabs[j].dataset.chapterTab!, undefined, { focus: tabs[j] });
				});
			});
			for (const ch of chapters) {
				const vts = [...ch.querySelectorAll<HTMLButtonElement>("[data-view-tab]")];
				vts.forEach((vt, i) => {
					vt.addEventListener("click", () => show(ch.dataset.chapter!, vt.dataset.viewTab));
					vt.addEventListener("keydown", (e) => {
						const j = move(vts, i, e.key, false);
						if (j < 0) return;
						e.preventDefault();
						show(ch.dataset.chapter!, vts[j].dataset.viewTab, { focus: vts[j] });
					});
				});
			}
		}
		initBoard();
		document.addEventListener("astro:page-load", initBoard);
	</script>

	<NextChapter current={"frc"} />
	<ContactSection />
</BaseLayout>

