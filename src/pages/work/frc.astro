---
/**
 * The FIRST Robotics page, a special edition of the site (docs/superpowers/specs/2026-11-15-classic-redesign-design.md
 * §12): its look and devices come from the team's own robotics site, a race weekend. Anton display type in yellow and
 * blue on near-black, with hard switches to paper; seven column lines that draw themselves down the page; buttons whose
 * letters roll; "Team 10951" on an odometer; the statement whose photos come into colour; the rookie season as pinned
 * chapters with a photo reel; the regionals' starting grid with our slot and the first-round pick lit; the team photo
 * that opens to the whole screen; the KitBot itself driving down the calendar; the pits on a slider; then the 3D
 * KitBot, the swerve, the pit board, outreach and partnering, all as before.
 *
 * Ruling: the edition is night (near-black) in both themes, with its own paper sections; the site's header, footer
 * and contact band keep the theme. Anton is loaded by this page only (below), for display sizes only.
 *
 * All the words: src/text/projects/frc.ts (intro sentence and photo: src/text/projects/frc.md), the robot's part by
 * part text: src/text/showcase/robot.ts. The devices: src/components/frc/ (edition.ts drives them).
 */
import ProjectCase from "@/components/ProjectCase.astro";
import { getEntry } from "astro:content";
import Leadership from "@/components/Leadership.astro";
import NextChapter from "@/components/NextChapter.astro";
import TeamReveal from "@/components/TeamReveal.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/frc/Hero.astro";
import Statement from "@/components/frc/Statement.astro";
import History from "@/components/frc/History.astro";
import Agenda from "@/components/frc/Agenda.astro";
import Gallery from "@/components/frc/Gallery.astro";
import { board, frcPhotos, frcPage, lightboxText, partner, rookieText, season2027More, swerveSim, team, teamMore, workshop, type FrcPhoto } from "@/text/projects/frc";
import { EventSheets, PhotoDeck, WeekPosts } from "@/components/frc-photos";
import { CertPipeline, SubTeamPicker, SupportPicker, SwerveLab } from "@/components/frc-story";
import { Filmstrip, Goals2027, HardwareView, KitBotView, Overview2027, Road2027, SeasonGame, SeasonTimeline } from "@/components/frc-views";
import FrcChapter from "@/components/FrcChapter.astro";
import FrcOutreach from "@/components/FrcOutreach.astro";
import { DataIcon } from "@/lib/icons";
import { srcset } from "@/lib/images";

const entry = (await getEntry("work", "frc"))!;
const teamPhoto = frcPhotos[teamMore.photo] as FrcPhoto;
const workshopPhoto = frcPhotos[workshop.photo] as FrcPhoto;
/** A team photo's sizes for srcset (public/assets/frc/: the file and its 640-wide copy). */
const frcSrcset = (photo: FrcPhoto) => `/assets/frc/${photo.id}-640.webp 640w, /assets/frc/${photo.id}.webp ${photo.w}w`;

const chapter = (id: string) => board.chapters.find((c) => c.id === id)!;
const nextOf = (id: string) => board.chapters[(board.chapters.findIndex((c) => c.id === id) + 1) % board.chapters.length];
---

<BaseLayout title={frcPage.seoTitle} description={entry.data.description}>
	<link slot="head" rel="preload" href="/fonts/anton-400.woff2" as="font" type="font/woff2" crossorigin />
	<div class="frc-ed" data-frc-edition>
		<!-- The page's seven column lines (four on phones), drawn down as the page starts to scroll. -->
		<div class="frc-cols" data-frc-cols aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>

		<Hero line={entry.data.description} />

		<!-- The statement on paper: its words light up, its photos come into colour as they pass. -->
		<Statement />

		<!-- The case: the problem, why not the alternatives, our answer (src/text/projects/hooks.ts). -->
		<div class="frc-night dark frc-case">
			<ProjectCase project="frc" />
		</div>

		<!-- The rookie season in eight scenes, pinned, with the photo reel. -->
		<History />

		<!-- The two regionals, in the open: rank on the starting grid, record, the alliance that picked us, the playoffs. -->
		<section id="results" class="frc-sec frc-night frc-night-2 dark scroll-mt-24" aria-labelledby="results-heading">
			<div class="wrapper frc-sec-in">
				<div class="frc-sec-head">
					<h2 id="results-heading" class="frc-h2">{rookieText.eventsHeading}</h2>
					<p class="frc-lead">{rookieText.eventsIntro}</p>
				</div>
				<EventSheets client:visible />
			</div>
		</section>

		<!-- The whole team: the photo opens to the full screen as the page scrolls (src/components/TeamReveal.astro). -->
		<div class="frc-night dark">
			<TeamReveal photo={teamPhoto} words={teamPhoto.caption} meta={teamPhoto.meta} />
		</div>

		<!-- The calendar, with the KitBot driving down it. -->
		<Agenda />

		<!-- The KitBot in 3D, scrolled through like the drone's chapter (src/components/FrcChapter.astro). -->
		<FrcChapter />

		<!-- The swerve: drive the simulator, or point at the real chassis to light up its parts. -->
		<section class="frc-sec frc-night frc-night-2 dark" aria-labelledby="swerve-heading">
			<div class="wrapper frc-sec-in">
				<div class="frc-sec-head">
					<h2 id="swerve-heading" class="frc-h2">{swerveSim.heading}</h2>
					<p class="frc-lead">{swerveSim.text}</p>
				</div>
				<SwerveLab client:visible />
			</div>
		</section>

		<!-- From the pits: the gallery slider. -->
		<Gallery />

		<!-- The pit board: everything about the team in one screen. A chapter on the side (on phones, along the top), a view
		     inside it, and the detail a click away. Without JavaScript every chapter and view shows, one after another. -->
		<section id="board" class="frc-board frc-night dark" aria-labelledby="board-heading" data-board>
			<div class="wrapper py-8 md:py-10">
				<div class="frc-board-grid">
					<div class="frc-board-intro">
						<h2 id="board-heading" class="frc-board-h">{board.heading}</h2>
						<p class="text-sm text-muted-foreground">{board.intro}</p>
					</div>
					<nav class="frc-rail" aria-label={board.label}>
						<div role="tablist" aria-orientation="vertical" aria-label={board.label}>
							{board.chapters.map((c) => (
								<button type="button" role="tab" id={`ct-${c.id}`} aria-controls={`ch-${c.id}`} data-chapter-tab={c.id}>
									<span class="frc-rail-name">{c.name}</span>
									<span class="frc-rail-figure">{c.figure}</span>
								</button>
							))}
						</div>
					</nav>
					<div class="frc-panels">
					<section class="frc-chapter" id="ch-2026" data-chapter="2026" role="tabpanel" aria-labelledby="ct-2026">
						<header class="frc-chapter-head">
							<h3 class="font-wide text-[clamp(1.5rem,2.4vw,2rem)] font-[880] leading-tight">{chapter("2026").name}</h3>
							{chapter("2026").views.length > 1 && (
								<div class="frc-views" role="tablist" aria-label={board.viewsLabel}>
									{chapter("2026").views.map((v) => (
										<button type="button" role="tab" id={`vt-2026-${v.id}`} aria-controls={`v-2026-${v.id}`} data-view-tab={v.id}>{v.name}</button>
									))}
								</div>
							)}
						</header>
						<div class="frc-view" id="v-2026-game" data-view="game" role="tabpanel" aria-labelledby="vt-2026-game">
							<SeasonGame client:visible />
						</div>
						<div class="frc-view" id="v-2026-timeline" data-view="timeline" role="tabpanel" aria-labelledby="vt-2026-timeline">
							<SeasonTimeline client:visible />
						</div>
						<div class="frc-view" id="v-2026-photos" data-view="photos" role="tabpanel" aria-labelledby="vt-2026-photos">
							<!-- The pits photos have their own slider above the board (src/components/frc/Gallery.astro). -->
							<PhotoDeck client:visible />
						</div>
						<footer class="frc-chapter-foot">
							<a href={`#${nextOf("2026").id}`} class="frc-next">{board.nextLabel} <span>{nextOf("2026").name}</span> <span aria-hidden="true">→</span></a>
						</footer>
					</section>
					<section class="frc-chapter" id="ch-2027" data-chapter="2027" role="tabpanel" aria-labelledby="ct-2027">
						<header class="frc-chapter-head">
							<h3 class="font-wide text-[clamp(1.5rem,2.4vw,2rem)] font-[880] leading-tight">{chapter("2027").name}</h3>
							{chapter("2027").views.length > 1 && (
								<div class="frc-views" role="tablist" aria-label={board.viewsLabel}>
									{chapter("2027").views.map((v) => (
										<button type="button" role="tab" id={`vt-2027-${v.id}`} aria-controls={`v-2027-${v.id}`} data-view-tab={v.id}>{v.name}</button>
									))}
								</div>
							)}
						</header>
						<div class="frc-view" id="v-2027-overview" data-view="overview" role="tabpanel" aria-labelledby="vt-2027-overview">
							<Overview2027 client:visible />
						</div>
						<div class="frc-view" id="v-2027-road" data-view="road" role="tabpanel" aria-labelledby="vt-2027-road">
							<Road2027 client:visible />
						</div>
						<div class="frc-view" id="v-2027-goals" data-view="goals" role="tabpanel" aria-labelledby="vt-2027-goals">
							<Goals2027 client:visible />
						</div>
						<div class="frc-view" id="v-2027-weekly" data-view="weekly" role="tabpanel" aria-labelledby="vt-2027-weekly">
							<div class="flex flex-col gap-3">
								<p class="text-muted-foreground">{season2027More.weeksIntro}</p>
								<WeekPosts client:visible />
							</div>
						</div>
						<footer class="frc-chapter-foot">
							<a href={`#${nextOf("2027").id}`} class="frc-next">{board.nextLabel} <span>{nextOf("2027").name}</span> <span aria-hidden="true">→</span></a>
						</footer>
					</section>
					<section class="frc-chapter" id="ch-robot" data-chapter="robot" role="tabpanel" aria-labelledby="ct-robot">
						<header class="frc-chapter-head">
							<h3 class="font-wide text-[clamp(1.5rem,2.4vw,2rem)] font-[880] leading-tight">{chapter("robot").name}</h3>
							{chapter("robot").views.length > 1 && (
								<div class="frc-views" role="tablist" aria-label={board.viewsLabel}>
									{chapter("robot").views.map((v) => (
										<button type="button" role="tab" id={`vt-robot-${v.id}`} aria-controls={`v-robot-${v.id}`} data-view-tab={v.id}>{v.name}</button>
									))}
								</div>
							)}
						</header>
						<div class="frc-view" id="v-robot-kitbot" data-view="kitbot" role="tabpanel" aria-labelledby="vt-robot-kitbot">
							<KitBotView client:visible />
						</div>
						<div class="frc-view" id="v-robot-hardware" data-view="hardware" role="tabpanel" aria-labelledby="vt-robot-hardware">
							<HardwareView client:visible />
						</div>
						<footer class="frc-chapter-foot">
							<a href={`#${nextOf("robot").id}`} class="frc-next">{board.nextLabel} <span>{nextOf("robot").name}</span> <span aria-hidden="true">→</span></a>
						</footer>
					</section>
					<section class="frc-chapter" id="ch-team" data-chapter="team" role="tabpanel" aria-labelledby="ct-team">
						<header class="frc-chapter-head">
							<h3 class="font-wide text-[clamp(1.5rem,2.4vw,2rem)] font-[880] leading-tight">{chapter("team").name}</h3>
							{chapter("team").views.length > 1 && (
								<div class="frc-views" role="tablist" aria-label={board.viewsLabel}>
									{chapter("team").views.map((v) => (
										<button type="button" role="tab" id={`vt-team-${v.id}`} aria-controls={`v-team-${v.id}`} data-view-tab={v.id}>{v.name}</button>
									))}
								</div>
							)}
						</header>
						<div class="frc-view" id="v-team-about" data-view="about" role="tabpanel" aria-labelledby="vt-team-about">
							<div class="grid items-center gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
								<div class="flex flex-col gap-4">
									<div class="flex items-center gap-4">
										<img src={team.logo} srcset={srcset(team.logo)} sizes="64px" alt="" width="764" height="764" loading="lazy" class="size-14 shrink-0 rounded-full object-cover ring-1 ring-border" />
										<h4 class="font-wide text-[clamp(1.6rem,2.6vw,2.25rem)] font-[880] leading-tight">{frcPage.about.headingPrefix} {team.number}</h4>
									</div>
									<p>{team.name}, {team.school}. {team.mission}.</p>
									<ul class="grid gap-x-5 sm:grid-cols-2">
										{team.focus.map((x) => (
											<li class="flex gap-3 border-t py-3">
												<DataIcon name={x.icon} className="mt-0.5 size-5 shrink-0" strokeWidth={1.75} />
												<span class="text-sm"><span class="font-semibold">{x.title}.</span> <span class="text-muted-foreground">{x.desc}</span></span>
											</li>
										))}
									</ul>
								</div>
								<figure class="m-0 flex flex-col gap-2">
									<button type="button" class="frc-zoom block w-full overflow-hidden rounded-xl" data-zoom={`/assets/frc/${teamPhoto.id}.webp`} data-zoom-alt={teamPhoto.alt} data-zoom-caption={`${teamPhoto.caption} · ${teamPhoto.meta}`} aria-label={`${lightboxText.open} ${teamPhoto.caption}`}>
										<img src={`/assets/frc/${teamPhoto.id}-640.webp`} srcset={frcSrcset(teamPhoto)} sizes="(min-width: 1024px) 50vw, 100vw" alt={teamPhoto.alt} width={teamPhoto.w} height={teamPhoto.h} loading="lazy" decoding="async" class="h-auto w-full" />
									</button>
									<figcaption class="text-sm text-muted-foreground">{teamPhoto.caption} · {teamPhoto.meta}</figcaption>
								</figure>
							</div>
						</div>
						<div class="frc-view" id="v-team-subteams" data-view="subteams" role="tabpanel" aria-labelledby="vt-team-subteams">
							<div class="flex flex-col gap-5">
								<p class="max-w-3xl text-muted-foreground">{teamMore.subTeamsIntro}</p>
								<SubTeamPicker client:visible />
								<div class="grid gap-x-6 md:grid-cols-[auto_1fr_1fr]">
									<p class="border-t py-3 font-semibold">{teamMore.joinHeading}<span class="block text-sm font-normal text-muted-foreground">{teamMore.meets}</span></p>
									{teamMore.join.map((j) => (
										<p class="border-t py-3 text-sm"><span class="font-semibold">{j.title}.</span> <span class="text-muted-foreground">{j.text}</span></p>
									))}
								</div>
								<p class="text-sm text-muted-foreground">{teamMore.joinNote}</p>
							</div>
						</div>
						<div class="frc-view" id="v-team-values" data-view="values" role="tabpanel" aria-labelledby="vt-team-values">
							<div class="flex flex-col gap-5">
								<ul class="grid gap-px overflow-hidden rounded-2xl border bg-border sm:grid-cols-2 lg:grid-cols-3">
									{teamMore.values.map((v) => (
										<li class="frc-value" tabindex="0" style={`--value:${v.colour}`}>
											<h5 class="font-wide text-2xl font-[850]">{v.name}</h5>
											<p>{v.text}</p>
										</li>
									))}
								</ul>
								<ul class="grid gap-4 md:grid-cols-2">
									{teamMore.firstValues.map((v) => (
										<li class="flex flex-col gap-1.5 rounded-xl border surface p-5">
											<p class="text-sm text-muted-foreground">{teamMore.firstValueTag}</p>
											<h5 class="font-wide text-xl font-[850]">{v.name}</h5>
											<p class="text-sm text-muted-foreground">{v.text}</p>
										</li>
									))}
								</ul>
							</div>
						</div>
						<div class="frc-view" id="v-team-leadership" data-view="leadership" role="tabpanel" aria-labelledby="vt-team-leadership">
							<Leadership lead="frc" heading={frcPage.about.leadershipHeading} headingLevel="h3" id="frc-leadership" intro={frcPage.about.leadershipIntro} />
						</div>
						<footer class="frc-chapter-foot">
							<a href={`#${nextOf("team").id}`} class="frc-next">{board.nextLabel} <span>{nextOf("team").name}</span> <span aria-hidden="true">→</span></a>
						</footer>
					</section>
					<section class="frc-chapter" id="ch-workshop" data-chapter="workshop" role="tabpanel" aria-labelledby="ct-workshop">
						<header class="frc-chapter-head">
							<h3 class="font-wide text-[clamp(1.5rem,2.4vw,2rem)] font-[880] leading-tight">{chapter("workshop").name}</h3>
							{chapter("workshop").views.length > 1 && (
								<div class="frc-views" role="tablist" aria-label={board.viewsLabel}>
									{chapter("workshop").views.map((v) => (
										<button type="button" role="tab" id={`vt-workshop-${v.id}`} aria-controls={`v-workshop-${v.id}`} data-view-tab={v.id}>{v.name}</button>
									))}
								</div>
							)}
						</header>
						<div class="frc-view" id="v-workshop-path" data-view="path" role="tabpanel" aria-labelledby="vt-workshop-path">
							<div class="flex flex-col gap-4">
								<p class="max-w-3xl text-muted-foreground">{workshop.intro}</p>
								<CertPipeline client:visible />
							</div>
						</div>
						<div class="frc-view" id="v-workshop-rules" data-view="rules" role="tabpanel" aria-labelledby="vt-workshop-rules">
							<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
								<figure class="m-0 flex flex-col gap-2">
									<button type="button" class="frc-zoom block w-full overflow-hidden rounded-xl" data-zoom={`/assets/frc/${workshopPhoto.id}.webp`} data-zoom-alt={workshopPhoto.alt} data-zoom-caption={`${workshopPhoto.caption} · ${workshopPhoto.meta}`} aria-label={`${lightboxText.open} ${workshopPhoto.caption}`}>
										<img src={`/assets/frc/${workshopPhoto.id}-640.webp`} srcset={frcSrcset(workshopPhoto)} sizes="(min-width: 1024px) 40vw, 100vw" alt={workshopPhoto.alt} width={workshopPhoto.w} height={workshopPhoto.h} loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" />
									</button>
									<figcaption class="text-sm text-muted-foreground">{workshopPhoto.caption} · {workshopPhoto.meta}</figcaption>
								</figure>
								<div class="flex flex-col gap-5">
									<div class="flex flex-col gap-2">
										<h4 class="font-semiwide text-xl font-[780]">{workshop.rulesHeading}</h4>
										<dl class="grid gap-x-6 sm:grid-cols-2">
											{workshop.rules.map((r) => (
												<div class="flex flex-col gap-0.5 border-t py-3">
													<dt class="font-semibold">{r.title}</dt>
													<dd class="text-sm text-muted-foreground">{r.text}</dd>
												</div>
											))}
										</dl>
									</div>
								</div>
							</div>
						</div>
						<div class="frc-view" id="v-workshop-conduct" data-view="conduct" role="tabpanel" aria-labelledby="vt-workshop-conduct">
							<ul class="flex flex-col">
								{teamMore.conduct.map((c) => (
									<li class="frc-conduct" tabindex="0">
										<span class="font-wide text-lg font-[820]">{c.ideal}</span>
										<span class="frc-conduct-arrow" aria-hidden="true"></span>
										<span class="frc-conduct-means text-lg">{c.means}</span>
									</li>
								))}
							</ul>
						</div>
						<div class="frc-view" id="v-workshop-photos" data-view="photos" role="tabpanel" aria-labelledby="vt-workshop-photos">
							<Filmstrip client:visible ids={workshop.photos} label={workshop.photosLabel} />
						</div>
						<footer class="frc-chapter-foot">
							<a href={`#${nextOf("workshop").id}`} class="frc-next">{board.nextLabel} <span>{nextOf("workshop").name}</span> <span aria-hidden="true">→</span></a>
						</footer>
					</section>
					</div>
				</div>
			</div>
		</section>

		<!-- Outreach, a section of its own (it used to be the last chapter of the pit board). -->
		<FrcOutreach />

		<!-- Partnering with the team: gifts in kind only. -->
		<section id="partner" class="frc-sec frc-night dark" aria-labelledby="partner-heading">
			<div class="wrapper frc-sec-in frc-partner">
				<div class="frc-partner-copy">
					<h2 id="partner-heading" class="frc-h2">{partner.heading}</h2>
					<p class="frc-lead"><strong>{partner.tag}.</strong> {partner.text}</p>
					<h3 class="frc-partner-back">{partner.backHeading}</h3>
					<ul class="frc-partner-list">
						{partner.back.map((b) => <li class="frc-check">{b}</li>)}
					</ul>
					<button type="button" data-email-open data-subject={partner.emailSubject} class="frc-btn press"><span data-roll>{partner.button}</span><span class="frc-btn-chev" aria-hidden="true">»</span></button>
				</div>
				<SupportPicker client:visible />
			</div>
		</section>

		<script>
			// The pit board: shows one chapter and one view at a time, follows the address (#2026, #2026-timeline, #robot),
			// and is driven by mouse, touch and keyboard (arrow keys, Home, End).
			function initBoard() {
				const root = document.querySelector<HTMLElement>("[data-board]");
				if (!root || root.dataset.ready) return;
				root.dataset.ready = "1";
				const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-chapter-tab]")];
				const chapters = [...root.querySelectorAll<HTMLElement>("[data-chapter]")];
				const viewOf: Record<string, string> = {};
				for (const ch of chapters) viewOf[ch.dataset.chapter!] = ch.querySelector<HTMLElement>("[data-view]")!.dataset.view!;
				let current = chapters[0].dataset.chapter!;

				const show = (id: string, view?: string, opts: { focus?: HTMLElement | null; scroll?: boolean; write?: boolean } = {}) => {
					const ch = chapters.find((c) => c.dataset.chapter === id);
					if (!ch) return;
					if (view && ch.querySelector(`[data-view="${view}"]`)) viewOf[id] = view;
					const changed = id !== current;
					current = id;
					for (const t of tabs) {
						const on = t.dataset.chapterTab === id;
						t.setAttribute("aria-selected", String(on));
						t.tabIndex = on ? 0 : -1;
					}
					for (const c of chapters) c.hidden = c !== ch;
					for (const v of ch.querySelectorAll<HTMLElement>("[data-view]")) v.hidden = v.dataset.view !== viewOf[id];
					for (const vt of ch.querySelectorAll<HTMLButtonElement>("[data-view-tab]")) {
						const on = vt.dataset.viewTab === viewOf[id];
						vt.setAttribute("aria-selected", String(on));
						vt.tabIndex = on ? 0 : -1;
					}
					if (changed) ch.dataset.enter = String(Date.now());
					opts.focus?.focus();
					if (opts.write !== false) {
						const first = ch.querySelector<HTMLElement>("[data-view]")!.dataset.view;
						history.replaceState(null, "", `#${viewOf[id] === first ? id : `${id}-${viewOf[id]}`}`);
					}
					// On a phone the board is taller than the screen: bring the chapter's top into view.
					if (opts.scroll) {
						const top = ch.getBoundingClientRect().top;
						if (top < 0 || top > innerHeight * 0.6) ch.scrollIntoView({ block: "start", behavior: document.documentElement.classList.contains("motion") ? "smooth" : "auto" });
					}
				};

				const fromHash = (scroll: boolean) => {
					const h = location.hash.slice(1);
					if (!h) return false;
					for (const ch of chapters) {
						const id = ch.dataset.chapter!;
						if (h === id) return show(id, undefined, { scroll }), true;
						if (h.startsWith(id + "-")) return show(id, h.slice(id.length + 1), { scroll }), true;
					}
					return false;
				};

				root.classList.add("is-live");
				const deep = fromHash(false);
				if (!deep) show(current, undefined, { write: false });
				else requestAnimationFrame(() => root.scrollIntoView({ block: "start" }));
				// One listener per visit, removed when the page is swapped out (it used to pile up on every return).
				const onHash = () => fromHash(true);
				addEventListener("hashchange", onHash);
				document.addEventListener("astro:before-swap", () => removeEventListener("hashchange", onHash), { once: true });

				const move = (list: HTMLButtonElement[], i: number, key: string, vertical: boolean) => {
					const back = vertical ? ["ArrowUp", "ArrowLeft"] : ["ArrowLeft"];
					const fwd = vertical ? ["ArrowDown", "ArrowRight"] : ["ArrowRight"];
					if (back.includes(key)) return (i - 1 + list.length) % list.length;
					if (fwd.includes(key)) return (i + 1) % list.length;
					if (key === "Home") return 0;
					if (key === "End") return list.length - 1;
					return -1;
				};
				tabs.forEach((t, i) => {
					t.addEventListener("click", () => show(t.dataset.chapterTab!, undefined, { scroll: innerWidth < 1024 }));
					t.addEventListener("keydown", (e) => {
						const j = move(tabs, i, e.key, true);
						if (j < 0) return;
						e.preventDefault();
						show(tabs[j].dataset.chapterTab!, undefined, { focus: tabs[j] });
					});
				});
				for (const ch of chapters) {
					const vts = [...ch.querySelectorAll<HTMLButtonElement>("[data-view-tab]")];
					vts.forEach((vt, i) => {
						vt.addEventListener("click", () => show(ch.dataset.chapter!, vt.dataset.viewTab));
						vt.addEventListener("keydown", (e) => {
							const j = move(vts, i, e.key, false);
							if (j < 0) return;
							e.preventDefault();
							show(ch.dataset.chapter!, vts[j].dataset.viewTab, { focus: vts[j] });
						});
					});
				}
			}
			// A photo outside the galleries opens full size in the viewer above: one listener for the whole page.
			if (!document.documentElement.dataset.zoomReady) {
				document.documentElement.dataset.zoomReady = "1";
				// A picture that is not a button of its own (Classic's stills) still answers Enter and Space.
				document.addEventListener("keydown", (e) => {
					const photo = (e.target as HTMLElement).closest<HTMLElement>("[data-zoom][tabindex]");
					if (!photo || (e.key !== "Enter" && e.key !== " ")) return;
					e.preventDefault();
					photo.click();
				});
				document.addEventListener("click", (e) => {
					const view = document.querySelector<HTMLDialogElement>("[data-zoom-view]");
					if (!view) return;
					const open = (e.target as HTMLElement).closest<HTMLElement>("[data-zoom]");
					if (open) {
						const img = view.querySelector("img")!;
						img.src = open.dataset.zoom!;
						img.alt = open.dataset.zoomAlt ?? "";
						view.querySelector("figcaption")!.textContent = open.dataset.zoomCaption ?? "";
						view.showModal();
					} else if (view.open && ((e.target as HTMLElement).closest("[data-zoom-close]") || e.target === view)) {
						view.close();
					}
				});
			}
			initBoard();
			document.addEventListener("astro:page-load", initBoard);
		</script>

		<!-- One viewer for the photos that stand on their own (the robot's, the team's, the workshop's): every
		     [data-zoom] button shows its full-size photo here. The galleries bring their own (frc-photos.tsx). -->
		<dialog class="frc-lightbox" data-zoom-view>
			<figure class="m-0 flex max-h-full flex-col items-center gap-3">
				<img alt="" class="max-h-[78vh] w-auto max-w-full rounded-lg object-contain" />
				<figcaption class="text-center text-white"></figcaption>
			</figure>
			<button type="button" class="frc-lightbox-btn right-4 top-4" data-zoom-close aria-label={lightboxText.close}>
				<span aria-hidden="true" class="text-xl leading-none">&#215;</span>
			</button>
		</dialog>

		<div class="frc-night dark">
			<NextChapter current={"frc"} />
		</div>
	</div>
</BaseLayout>

