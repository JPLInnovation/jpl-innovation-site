---
// @ts-ignore: the project has no Node type definitions; this only runs at build
import { existsSync } from "node:fs";
import { getEntry } from "astro:content";
import BackLink from "@/components/BackLink.astro";
import { backToWork } from "@/text/work";
import FrcRobotReveal from "@/components/frc-robot-reveal";
import FrcLockup from "@/components/FrcLockup.astro";
import FrcSeasons from "@/components/frc-seasons";
import HardwareStack from "@/components/HardwareStack.astro";
import Leadership from "@/components/Leadership.astro";
import ChapterBackdrop from "@/components/ChapterBackdrop.astro";
import ContactSection from "@/components/ContactSection.astro";
import NextChapter from "@/components/NextChapter.astro";
import Showcase from "@/components/showcase";
import Odometer from "@/components/Odometer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
// All the words on this page: src/text/projects/frc.ts (intro sentence and photo: src/text/projects/frc.md),
// and the 3D robot's part by part text: src/text/showcase/robot.ts
import { frcDeck, frcPhotos, frcPage, outreach, partner, seasonStory, swerveSim, team, teamMore, workshop, type FrcPhoto } from "@/text/projects/frc";
import { PhotoDeck, PhotoMosaic } from "@/components/frc-photos";
import { CertPipeline, SeasonStory, SubTeamPicker, SupportPicker, SwerveLab } from "@/components/frc-story";
import { robotShowcase } from "@/text/showcase/robot";
import { DataIcon } from "@/lib/icons";
import { srcset } from "@/lib/images";
import { buttonVariants } from "@/components/ui/button";

const entry = (await getEntry("work", "frc"))!;
const teamPhoto = frcPhotos[teamMore.photo] as FrcPhoto;
const workshopPhoto = frcPhotos[workshop.photo] as FrcPhoto;
/** A team photo's sizes for srcset (public/assets/frc/: the file and its 640-wide copy). */
const frcSrcset = (photo: FrcPhoto) => `/assets/frc/${photo.id}-640.webp 640w, /assets/frc/${photo.id}.webp ${photo.w}w`;

const { facts: f } = frcPage;
const facts = [
	{ label: f.rookieYear, value: String(team.rookieYear) },
	{ label: f.region, value: team.region },
	{ label: f.homeLabel, value: f.home },
	{ label: f.nextSeasonLabel, value: f.nextSeason },
];

// The showcase's pictures for phones (scripts/showcase-stills.py --page robot). A feature without one shows its text only.
const stills = Object.fromEntries(
	robotShowcase.features
		.filter((f) => existsSync(`public/showcase/robot/${f.id}-800.webp`))
		.map((f) => [f.id, `/showcase/robot/${f.id}`]),
);
---

<BaseLayout title={frcPage.seoTitle} description={entry.data.description}>
	<ChapterBackdrop project="frc" />
	<div class="wrapper pt-6 md:pt-8">
		<BackLink href="/work/">{backToWork}</BackLink>
	</div>

	<header class="wrapper flex flex-col items-center gap-6 pb-14 pt-6 text-center md:pb-20 md:pt-10">
		<!-- Logo lockup; the FRC intro (FrcSplash) lands exactly on this. -->
		<FrcLockup />
		<h1 class="font-wide text-[clamp(3.25rem,12vw,10.5rem)] font-[900] leading-[0.9] tracking-[-0.03em]">
			{frcPage.headingPrefix} <Odometer value={String(team.number)} />
		</h1>
		<p class="max-w-[56ch] text-lg text-muted-foreground md:text-xl" data-reveal data-reveal-delay="250">
			{entry.data.description}
		</p>
		<dl class="mt-4 grid w-full max-w-3xl grid-cols-2 gap-x-6 gap-y-5 border-t pt-6 sm:grid-cols-4" data-reveal-group>
			{
				facts.map((f) => (
					<div class="flex flex-col gap-0.5">
						<dt class="text-sm text-muted-foreground">{f.label}</dt>
						<dd class="font-semibold">{f.value}</dd>
					</div>
				))
			}
		</dl>
	</header>

	<!-- The season in six prints: drag or flick the top one away, tap one to see it large (src/components/frc-photos.tsx). -->
	<section class="wrapper grid items-center gap-12 pb-24 md:pb-32 lg:grid-cols-[1fr_1.1fr]" aria-labelledby="deck-heading">
		<div class="flex flex-col gap-5" data-reveal>
			<h2 id="deck-heading" class="font-wide text-[clamp(2.2rem,5vw,3.75rem)] font-[880] leading-[1]">{frcDeck.heading}</h2>
			<p class="max-w-[52ch] text-lg text-muted-foreground">{frcDeck.text}</p>
		</div>
		<PhotoDeck client:visible />
	</section>

	<!-- The rookie season told by scrolling: the stage holds still while the scenes pass (src/components/frc-story.tsx). -->
	<section class="wrapper pb-16 md:pb-24" aria-labelledby="story-heading">
		<h2 id="story-heading" class="max-w-3xl font-wide text-[clamp(2rem,4.5vw,3.25rem)] font-[850] leading-[1.02]" data-reveal>{seasonStory.heading}</h2>
		<p class="mt-3 font-mono text-xs uppercase tracking-wider text-muted-foreground">{seasonStory.hint} ↓</p>
		<SeasonStory client:visible={{ rootMargin: "600px" }} />
	</section>

	<FrcRobotReveal client:load src={entry.data.img} alt={entry.data.img_alt ?? ""} />

	<!-- The 2026 robot in 3D, part by part: the robot turns to each part as its text scrolls past (src/components/showcase.tsx).
	     The photo is the stage's picture until the 3D loads, without JavaScript, and when WebGL is unavailable. -->
	<Showcase client:visible={{ rootMargin: "200px" }} model="robot" text={robotShowcase} stills={stills} className="pt-20 md:pt-28">
		<img
			src="/assets/FRCnew.jpg"
			srcset={srcset("/assets/FRCnew.jpg")}
			sizes="(min-width: 1024px) 55vw, 100vw"
			alt={frcPage.model3d.fallbackAlt}
			class="size-full rounded-xl object-cover object-[32%_68%]"
			loading="lazy"
		/>
	</Showcase>

	<div class="wrapper py-24 md:py-32">
		<!-- Hydrates once the page is idle: it's below the fold, and #2026 deep links still work. -->
		<FrcSeasons client:idle />
	</div>

	<!-- The swerve: drive the simulator, or point at the real chassis to light up its parts. -->
	<section class="border-y bg-card/70" aria-labelledby="swerve-heading">
		<div class="wrapper flex flex-col gap-10 py-20 md:py-28">
			<div class="flex max-w-3xl flex-col gap-3" data-reveal>
				<h2 id="swerve-heading" class="font-wide text-[clamp(2.2rem,5vw,3.75rem)] font-[880] leading-[1]">{swerveSim.heading}</h2>
				<p class="text-lg text-muted-foreground" data-words>{swerveSim.text}</p>
			</div>
			<SwerveLab client:visible />
		</div>
	</section>

	<HardwareStack />

	<section class="border-t bg-card/70" aria-labelledby="team-heading">
		<div class="wrapper flex flex-col gap-8 py-20 md:py-24">
			<div class="flex max-w-2xl items-center gap-5" data-reveal>
				<img
					src={team.logo}
					srcset={srcset(team.logo)}
					sizes="80px"
					alt=""
					width="764"
					height="764"
					loading="lazy"
					class="size-16 shrink-0 rounded-full object-cover ring-1 ring-border md:size-20"
				/>
				<div class="flex flex-col gap-2">
					<h2 id="team-heading" class="font-wide text-3xl font-[850] md:text-4xl">{frcPage.about.headingPrefix} {team.number}</h2>
					<p class="text-lg text-muted-foreground">{team.name}, {team.school}. {team.mission}.</p>
				</div>
			</div>
			<ul class="grid gap-x-8 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
				{
					team.focus.map((f) => (
						<li class="flex flex-col gap-2 border-t py-6">
							<DataIcon name={f.icon} className="size-6" strokeWidth={1.75} />
							<h3 class="font-semiwide text-lg font-[760]">{f.title}</h3>
							<p class="text-muted-foreground">{f.desc}</p>
						</li>
					))
				}
			</ul>
			<figure class="m-0 flex flex-col gap-2 overflow-hidden" data-parallax>
				<img
					src={`/assets/frc/${teamPhoto.id}-640.webp`}
					srcset={frcSrcset(teamPhoto)}
					sizes="(min-width: 1280px) 1200px, 100vw"
					alt={teamPhoto.alt}
					width={teamPhoto.w}
					height={teamPhoto.h}
					loading="lazy"
					decoding="async"
					class="h-auto w-full rounded-2xl border"
				/>
				<figcaption class="flex justify-between font-mono text-xs uppercase tracking-wider text-muted-foreground">
					<span>{teamPhoto.caption}</span><span>{teamPhoto.meta}</span>
				</figcaption>
			</figure>
			<div class="mt-6 flex flex-col gap-8 border-t pt-12">
				<div class="flex max-w-3xl flex-col gap-2" data-reveal>
					<h3 class="font-wide text-2xl font-[850] md:text-3xl">{teamMore.subTeamsHeading}</h3>
					<p class="text-lg text-muted-foreground" data-words>{teamMore.subTeamsIntro}</p>
				</div>
				<SubTeamPicker client:visible />
				<div class="flex flex-col gap-4">
					<div class="flex flex-wrap items-baseline justify-between gap-2">
						<h4 class="font-semiwide text-xl font-[780]">{teamMore.joinHeading}</h4>
						<p class="text-sm text-muted-foreground">{teamMore.meets}</p>
					</div>
					<ul class="grid gap-6 md:grid-cols-2" data-reveal-group>
						{
							teamMore.join.map((j) => (
								<li class="flex flex-col gap-2 border-t py-6">
									<h5 class="font-semiwide text-lg font-[760]">{j.title}</h5>
									<p class="text-muted-foreground">{j.text}</p>
								</li>
							))
						}
					</ul>
					<p class="text-sm text-muted-foreground">{teamMore.joinNote}</p>
				</div>
			</div>
			<!-- The values: each card reveals what it means when you point at it (always shown on touch screens). -->
			<div class="mt-6 flex flex-col gap-8 border-t pt-12">
				<h3 class="font-wide text-2xl font-[850] md:text-3xl" data-reveal>{teamMore.valuesHeading}</h3>
				<ul class="grid gap-px overflow-hidden rounded-2xl border bg-border sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
					{
						teamMore.values.map((v) => (
							<li class="frc-value" tabindex="0" style={`--value:${v.colour}`}>
								<h4 class="font-wide text-2xl font-[850]">{v.name}</h4>
								<p>{v.text}</p>
							</li>
						))
					}
				</ul>
				<ul class="grid gap-6 md:grid-cols-2" data-reveal-group>
					{
						teamMore.firstValues.map((v) => (
							<li class="flex flex-col gap-3 rounded-2xl border surface p-6 md:p-8">
								<p class="font-mono text-xs uppercase tracking-wider text-muted-foreground">{teamMore.firstValueTag}</p>
								<h4 class="font-wide text-[clamp(1.5rem,2.6vw,2rem)] font-[880] leading-tight">{v.name}</h4>
								<p class="text-muted-foreground">{v.text}</p>
							</li>
						))
					}
				</ul>
				<div class="flex flex-col gap-3">
					<h4 class="font-semiwide text-xl font-[780]">{teamMore.conductHeading}</h4>
					<ul class="flex flex-col">
						{
							teamMore.conduct.map((c) => (
								<li class="frc-conduct" tabindex="0">
									<span class="font-semibold">{c.ideal}</span>
									<span class="frc-conduct-arrow" aria-hidden="true"></span>
									<span class="frc-conduct-means">{c.means}</span>
								</li>
							))
						}
					</ul>
				</div>
			</div>
			<div class="mt-6 border-t pt-12">
				<Leadership
					lead="frc"
					heading={frcPage.about.leadershipHeading}
					headingLevel="h3"
					id="frc-leadership"
					intro={frcPage.about.leadershipIntro}
				/>
			</div>
		</div>
	</section>

	<!-- The workshop: how a student is certified on a machine, and the rules before anyone starts. -->
	<section class="wrapper flex flex-col gap-12 py-20 md:py-28" aria-labelledby="workshop-heading">
		<div class="grid items-end gap-8 lg:grid-cols-[1.2fr_1fr]">
			<div class="flex flex-col gap-3" data-reveal>
				<h2 id="workshop-heading" class="font-wide text-[clamp(2rem,4.5vw,3.25rem)] font-[850] leading-[1.02]">{workshop.heading}</h2>
				<p class="text-lg text-muted-foreground">{workshop.intro}</p>
			</div>
			<figure class="m-0 flex flex-col gap-2 overflow-hidden" data-parallax>
				<img
					src={`/assets/frc/${workshopPhoto.id}-640.webp`}
					srcset={frcSrcset(workshopPhoto)}
					sizes="(min-width: 1024px) 40vw, 100vw"
					alt={workshopPhoto.alt}
					width={workshopPhoto.w}
					height={workshopPhoto.h}
					loading="lazy"
					decoding="async"
					class="aspect-[4/3] w-full rounded-2xl border object-cover"
				/>
				<figcaption class="font-mono text-xs uppercase tracking-wider text-muted-foreground">{workshopPhoto.caption} · {workshopPhoto.meta}</figcaption>
			</figure>
		</div>
		<CertPipeline client:visible />
		<div class="flex flex-col gap-4">
			<h3 class="font-semiwide text-xl font-[780]">{workshop.rulesHeading}</h3>
			<dl class="grid gap-x-8 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
				{
					workshop.rules.map((r) => (
						<div class="flex flex-col gap-1 border-t py-4">
							<dt class="font-semibold">{r.title}</dt>
							<dd class="text-sm text-muted-foreground">{r.text}</dd>
						</div>
					))
				}
			</dl>
		</div>
		<PhotoMosaic client:visible ids={workshop.photos} label={workshop.photosLabel} columns={4} />
	</section>

	<!-- Outreach: the team's programs beyond the field. -->
	<section class="border-t bg-card/70" aria-labelledby="outreach-heading">
		<div class="wrapper flex flex-col gap-12 py-20 md:py-28">
			<div class="flex max-w-3xl flex-col gap-3" data-reveal>
				<h2 id="outreach-heading" class="font-wide text-[clamp(2rem,4.5vw,3.25rem)] font-[850] leading-[1.02]">{outreach.heading}</h2>
				<p class="text-lg text-muted-foreground">{outreach.intro}</p>
			</div>
			<ul class="grid gap-6 md:grid-cols-2" data-reveal-group>
				{
					outreach.programs.map((o) => (
						<li class="frc-prog flex flex-col gap-2 rounded-xl border surface p-6 md:p-8" tabindex={o.more ? "0" : undefined}>
							<p class="font-mono text-xs uppercase tracking-wider text-muted-foreground">{o.tag}</p>
							<h3 class="font-semiwide text-2xl font-[780]">{o.name}</h3>
							<p class="text-muted-foreground">{o.text}</p>
							{o.detail && <p class="text-sm">{o.detail}</p>}
							{o.more && (
								<>
									<p class="frc-prog-hint font-mono text-xs uppercase tracking-wider text-muted-foreground" aria-hidden="true">{outreach.moreHint} +</p>
									<dl class="frc-prog-more">
										<div class="flex flex-col gap-2 pt-2">
											{o.more.map((m) => (
												<div class="grid gap-1 border-t pt-2 sm:grid-cols-[9rem_1fr]">
													<dt class="text-sm font-semibold">{m.k}</dt>
													<dd class="text-sm text-muted-foreground">{m.v}</dd>
												</div>
											))}
										</div>
									</dl>
								</>
							)}
						</li>
					))
				}
			</ul>
			<div class="flex flex-col gap-4">
				<h3 class="font-semiwide text-xl font-[780]">{outreach.photosLabel}</h3>
				<PhotoMosaic client:visible ids={outreach.photos} label={outreach.photosLabel} />
				<p class="text-sm text-muted-foreground">{outreach.privacy}</p>
			</div>
		</div>
	</section>

	<!-- Partnering with the team: gifts in kind only. -->
	<section class="wrapper flex flex-col gap-10 py-20 md:py-28" aria-labelledby="partner-heading">
		<div class="flex max-w-3xl flex-col items-start gap-4" data-reveal>
			<span class="inline-flex items-center gap-2 rounded-full border border-foreground/15 bg-card px-2.5 py-0.5 text-[13px] font-medium">
				<span class="size-2 rounded-full bg-accent ring-1 ring-foreground/25" aria-hidden="true"></span>{partner.tag}
			</span>
			<h2 id="partner-heading" class="font-wide text-[clamp(2rem,4.5vw,3.25rem)] font-[850] leading-[1.02]">{partner.heading}</h2>
			<p class="text-lg text-muted-foreground">{partner.text}</p>
		</div>
		<SupportPicker client:visible />
		<div class="grid items-start gap-8 md:grid-cols-[1fr_auto]">
			<div class="flex flex-col gap-3">
				<h3 class="font-semiwide text-xl font-[780]">{partner.backHeading}</h3>
				<ul class="grid gap-x-8 sm:grid-cols-2">
					{partner.back.map((b) => <li class="frc-check border-t py-3">{b}</li>)}
				</ul>
			</div>
			<button type="button" data-email-open data-subject={partner.emailSubject} class={buttonVariants({ variant: "signal", size: "lg" })}>
				{partner.button}
			</button>
		</div>
	</section>

	<NextChapter current={"frc"} />
	<ContactSection />
</BaseLayout>

<style is:global>
	/* The photo viewer (src/components/frc-photos.tsx), the browser's own <dialog>. */
	.frc-lightbox {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 4.5rem 4.5rem 2rem;
		border: 0;
		background: transparent;
		display: none;
		align-items: center;
		justify-content: center;
	}
	.frc-lightbox[open] {
		display: flex;
	}
	.frc-lightbox::backdrop {
		background: rgb(4 7 14 / 0.9);
		backdrop-filter: blur(6px);
	}
	@media (max-width: 640px) {
		.frc-lightbox {
			padding: 4.5rem 0.75rem 1.5rem;
		}
	}
	.frc-lightbox-btn {
		position: absolute;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.92);
		color: #0b111c;
	}
	.frc-round-btn {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--card);
		transition: border-color 0.2s;
	}
	.frc-round-btn:hover {
		border-color: color-mix(in oklab, var(--foreground) 40%, transparent);
	}
	/* A print: white border and a soft shadow, like a photo on a desk. */
	.frc-print {
		border-radius: 0.6rem;
		background: #fff;
		padding: 6px;
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.12), 0 12px 32px -12px rgb(0 0 0 / 0.35);
	}
	.frc-print img {
		border-radius: 0.35rem;
	}
	.frc-print-caption {
		position: absolute;
		inset-inline: 6px;
		bottom: 6px;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		border-radius: 0 0 0.35rem 0.35rem;
		padding: 2.5rem 1rem 0.8rem;
		background: linear-gradient(to top, rgb(0 0 0 / 0.78), transparent);
		color: #fff;
		pointer-events: none;
	}
	/* The mosaic: each print a little crooked (--tilt), straight and lifted on hover or focus. */
	.frc-mosaic .frc-pin {
		transform: rotate(var(--tilt, 0deg));
		transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.frc-mosaic .frc-pin:hover,
	.frc-mosaic .frc-pin:focus-within {
		transform: rotate(0deg) translateY(-4px) scale(1.02);
	}
	/* The build season strips: side by side, the open one wide; stacked on phones. */
	.frc-strips {
		display: flex;
		gap: 0.5rem;
		height: clamp(22rem, 42vw, 30rem);
	}
	.frc-strips > li {
		flex: 1 1 0;
		min-width: 0;
		transition: flex-grow 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.frc-strips > li[data-open] {
		flex-grow: 6;
	}
	.frc-strip-label {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 3rem 1rem 0.9rem;
		background: linear-gradient(to top, rgb(0 0 0 / 0.8), transparent);
		color: #fff;
		white-space: nowrap;
	}
	.frc-strips > li:not([data-open]) .frc-strip-caption {
		opacity: 0;
	}
	.frc-strips > li:not([data-open]) .frc-strip-label {
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		inset: auto 0 0 auto;
		margin: 0.4rem;
		border-radius: 999px;
		padding: 0.7rem 0.3rem;
		background: rgb(0 0 0 / 0.72);
	}
	@media (max-width: 767px) {
		.frc-strips {
			flex-direction: column;
			height: 44rem;
		}
	}
	/* The preseason posts: a row that scrolls sideways and snaps. */
	.frc-posts {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: min(20rem, 82%);
		gap: 1.25rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		padding-bottom: 0.75rem;
		scrollbar-width: thin;
	}
	.frc-post {
		scroll-snap-align: start;
		overflow: hidden;
		border-radius: 0.9rem;
		border: 1px solid var(--border);
		background: var(--card);
	}
	/* Small round or pill buttons (src/components/frc-story.tsx). */
	.frc-chip-btn {
		display: inline-grid;
		place-items: center;
		min-width: 44px;
		height: 44px;
		border-radius: 999px;
		border: 1px solid var(--border);
		background: var(--card);
		font-size: 0.875rem;
		font-weight: 600;
		transition: border-color 0.2s, background 0.2s;
	}
	.frc-chip-btn:hover:not(:disabled),
	.frc-chip-btn.is-on {
