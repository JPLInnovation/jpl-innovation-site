---
// @ts-ignore: the project has no Node type definitions; this only runs at build
import { existsSync } from "node:fs";
import { getEntry } from "astro:content";
import BackLink from "@/components/BackLink.astro";
import { backToWork } from "@/text/work";
import FrcLockup from "@/components/FrcLockup.astro";
import Leadership from "@/components/Leadership.astro";
import ChapterBackdrop from "@/components/ChapterBackdrop.astro";
import ContactSection from "@/components/ContactSection.astro";
import NextChapter from "@/components/NextChapter.astro";
import Odometer from "@/components/Odometer.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
// All the words on this page: src/text/projects/frc.ts (intro sentence and photo: src/text/projects/frc.md),
// and the robot's part by part text: src/text/showcase/robot.ts
import { board, frcDeck, frcPhotos, frcPage, outreach, partner, rookieText, season2027More, swerveSim, team, teamMore, workshop, type FrcPhoto } from "@/text/projects/frc";
import { EventSheets, PhotoDeck, WeekPosts } from "@/components/frc-photos";
import { CertPipeline, SeasonSlides, SubTeamPicker, SupportPicker, SwerveLab } from "@/components/frc-story";
import { Filmstrip, Goals2027, HardwareView, KitBotView, Overview2027, PartsView, Road2027, SeasonGame, SeasonTimeline } from "@/components/frc-views";
import { robotShowcase } from "@/text/showcase/robot";
import { DataIcon } from "@/lib/icons";
import { srcset } from "@/lib/images";
import { buttonVariants } from "@/components/ui/button";

const entry = (await getEntry("work", "frc"))!;
const teamPhoto = frcPhotos[teamMore.photo] as FrcPhoto;
const workshopPhoto = frcPhotos[workshop.photo] as FrcPhoto;
/** A team photo's sizes for srcset (public/assets/frc/: the file and its 640-wide copy). */
const frcSrcset = (photo: FrcPhoto) => `/assets/frc/${photo.id}-640.webp 640w, /assets/frc/${photo.id}.webp ${photo.w}w`;

const { facts: f } = frcPage;
const facts = [
	{ label: f.rookieYear, value: String(team.rookieYear) },
	{ label: f.region, value: team.region },
	{ label: f.homeLabel, value: f.home },
	{ label: f.nextSeasonLabel, value: f.nextSeason },
];

// The CAD render of each part of the robot (scripts/showcase-stills.py --page robot). A part without one shows its name.
const stills = Object.fromEntries(
	robotShowcase.features
		.filter((f) => existsSync(`public/showcase/robot/${f.id}-800.webp`))
		.map((f) => [f.id, `/showcase/robot/${f.id}`]),
);
const chapter = (id: string) => board.chapters.find((c) => c.id === id)!;
const nextOf = (id: string) => board.chapters[(board.chapters.findIndex((c) => c.id === id) + 1) % board.chapters.length];
---

<BaseLayout title={frcPage.seoTitle} description={entry.data.description}>
	<ChapterBackdrop project="frc" />
	<div class="wrapper pt-6 md:pt-8">
		<BackLink href="/work/">{backToWork}</BackLink>
	</div>

	<header class="wrapper flex flex-col items-center gap-6 pb-14 pt-6 text-center md:pb-20 md:pt-10">
		<!-- Logo lockup; the FRC intro (FrcSplash) lands exactly on this. -->
		<FrcLockup />
		<h1 class="font-wide text-[clamp(3.25rem,12vw,10.5rem)] font-[900] leading-[0.9] tracking-[-0.03em]">
			{frcPage.headingPrefix} <Odometer value={String(team.number)} />
		</h1>
		<p class="max-w-[56ch] text-lg text-muted-foreground md:text-xl" data-reveal data-reveal-delay="250">
			{entry.data.description}
		</p>
		<dl class="mt-4 grid w-full max-w-3xl grid-cols-2 gap-x-6 gap-y-5 border-t pt-6 sm:grid-cols-4" data-reveal-group>
			{
				facts.map((f) => (
					<div class="flex flex-col gap-0.5">
						<dt class="text-sm text-muted-foreground">{f.label}</dt>
						<dd class="font-semibold">{f.value}</dd>
					</div>
				))
			}
		</dl>
	</header>

	<!-- The pit board: everything about the team in one screen. A chapter on the side (on phones, along the top), a view
	     inside it, and the detail a click away. Without JavaScript every chapter and view shows, one after another. -->
	<section id="board" class="frc-board" aria-labelledby="board-heading" data-board>
		<div class="wrapper py-8 md:py-10">
			<div class="frc-board-grid">
				<div class="frc-board-intro">
					<h2 id="board-heading" class="font-wide text-[clamp(1.5rem,1.9vw,1.6rem)] font-[880] leading-[1.02]">{frcDeck.heading}</h2>
					<p class="text-sm text-muted-foreground">{frcDeck.text}</p>
				</div>
				<nav class="frc-rail" aria-label={board.label}>
					<div role="tablist" aria-orientation="vertical" aria-label={board.label}>
						{board.chapters.map((c) => (
							<button type="button" role="tab" id={`ct-${c.id}`} aria-controls={`ch-${c.id}`} data-chapter-tab={c.id}>
								<span class="frc-rail-name">{c.name}</span>
								<span class="frc-rail-figure">{c.figure}</span>
							</button>
						))}
					</div>
				</nav>
				<div class="frc-panels">
				<section class="frc-chapter" id="ch-2026" data-chapter="2026" role="tabpanel" aria-labelledby="ct-2026">
					<header class="frc-chapter-head">
						<h3 class="font-wide text-[clamp(1.5rem,2.4vw,2rem)] font-[880] leading-tight">{chapter("2026").name}</h3>
						{chapter("2026").views.length > 1 && (
							<div class="frc-views" role="tablist" aria-label={board.viewsLabel}>
								{chapter("2026").views.map((v) => (
									<button type="button" role="tab" id={`vt-2026-${v.id}`} aria-controls={`v-2026-${v.id}`} data-view-tab={v.id}>{v.name}</button>
								))}
							</div>
						)}
					</header>
					<div class="frc-view" id="v-2026-story" data-view="story" role="tabpanel" aria-labelledby="vt-2026-story">
						<SeasonSlides client:visible />
					</div>
					<div class="frc-view" id="v-2026-results" data-view="results" role="tabpanel" aria-labelledby="vt-2026-results">
						<EventSheets client:visible />
					</div>
					<div class="frc-view" id="v-2026-game" data-view="game" role="tabpanel" aria-labelledby="vt-2026-game">
						<SeasonGame client:visible />
					</div>
					<div class="frc-view" id="v-2026-timeline" data-view="timeline" role="tabpanel" aria-labelledby="vt-2026-timeline">
						<SeasonTimeline client:visible />
					</div>
					<div class="frc-view" id="v-2026-photos" data-view="photos" role="tabpanel" aria-labelledby="vt-2026-photos">
						<div class="grid items-start gap-8 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
							<PhotoDeck client:visible />
							<div class="flex min-w-0 flex-col gap-3">
								<h4 class="font-semiwide text-xl font-[780]">{rookieText.pitsHeading}</h4>
								<Filmstrip client:visible ids={rookieText.pits} label={rookieText.pitsHeading} />
							</div>
						</div>
					</div>
					<footer class="frc-chapter-foot">
						<a href={`#${nextOf("2026").id}`} class="frc-next">{board.nextLabel} <span>{nextOf("2026").name}</span> <span aria-hidden="true">→</span></a>
					</footer>
				</section>
				<section class="frc-chapter" id="ch-2027" data-chapter="2027" role="tabpanel" aria-labelledby="ct-2027">
					<header class="frc-chapter-head">
						<h3 class="font-wide text-[clamp(1.5rem,2.4vw,2rem)] font-[880] leading-tight">{chapter("2027").name}</h3>
						{chapter("2027").views.length > 1 && (
							<div class="frc-views" role="tablist" aria-label={board.viewsLabel}>
								{chapter("2027").views.map((v) => (
									<button type="button" role="tab" id={`vt-2027-${v.id}`} aria-controls={`v-2027-${v.id}`} data-view-tab={v.id}>{v.name}</button>
								))}
							</div>
						)}
					</header>
					<div class="frc-view" id="v-2027-overview" data-view="overview" role="tabpanel" aria-labelledby="vt-2027-overview">
						<Overview2027 client:visible />
					</div>
					<div class="frc-view" id="v-2027-road" data-view="road" role="tabpanel" aria-labelledby="vt-2027-road">
						<Road2027 client:visible />
					</div>
					<div class="frc-view" id="v-2027-goals" data-view="goals" role="tabpanel" aria-labelledby="vt-2027-goals">
						<Goals2027 client:visible />
					</div>
					<div class="frc-view" id="v-2027-weekly" data-view="weekly" role="tabpanel" aria-labelledby="vt-2027-weekly">
						<div class="flex flex-col gap-3">
							<p class="text-muted-foreground">{season2027More.weeksIntro}</p>
							<WeekPosts client:visible />
						</div>
					</div>
					<footer class="frc-chapter-foot">
						<a href={`#${nextOf("2027").id}`} class="frc-next">{board.nextLabel} <span>{nextOf("2027").name}</span> <span aria-hidden="true">→</span></a>
					</footer>
				</section>
				<section class="frc-chapter" id="ch-robot" data-chapter="robot" role="tabpanel" aria-labelledby="ct-robot">
					<header class="frc-chapter-head">
						<h3 class="font-wide text-[clamp(1.5rem,2.4vw,2rem)] font-[880] leading-tight">{chapter("robot").name}</h3>
						{chapter("robot").views.length > 1 && (
							<div class="frc-views" role="tablist" aria-label={board.viewsLabel}>
								{chapter("robot").views.map((v) => (
									<button type="button" role="tab" id={`vt-robot-${v.id}`} aria-controls={`v-robot-${v.id}`} data-view-tab={v.id}>{v.name}</button>
								))}
							</div>
						)}
					</header>
					<div class="frc-view" id="v-robot-kitbot" data-view="kitbot" role="tabpanel" aria-labelledby="vt-robot-kitbot">
						<KitBotView client:visible />
					</div>
					<div class="frc-view" id="v-robot-parts" data-view="parts" role="tabpanel" aria-labelledby="vt-robot-parts">
						<PartsView client:visible stills={stills} />
					</div>
					<div class="frc-view" id="v-robot-swerve" data-view="swerve" role="tabpanel" aria-labelledby="vt-robot-swerve">
						<div class="flex flex-col gap-4">
							<p class="max-w-3xl text-muted-foreground">{swerveSim.text}</p>
							<SwerveLab client:visible />
						</div>
					</div>
					<div class="frc-view" id="v-robot-hardware" data-view="hardware" role="tabpanel" aria-labelledby="vt-robot-hardware">
						<HardwareView client:visible />
					</div>
					<footer class="frc-chapter-foot">
						<a href={`#${nextOf("robot").id}`} class="frc-next">{board.nextLabel} <span>{nextOf("robot").name}</span> <span aria-hidden="true">→</span></a>
					</footer>
				</section>
				<section class="frc-chapter" id="ch-team" data-chapter="team" role="tabpanel" aria-labelledby="ct-team">
					<header class="frc-chapter-head">
						<h3 class="font-wide text-[clamp(1.5rem,2.4vw,2rem)] font-[880] leading-tight">{chapter("team").name}</h3>
						{chapter("team").views.length > 1 && (
							<div class="frc-views" role="tablist" aria-label={board.viewsLabel}>
								{chapter("team").views.map((v) => (
									<button type="button" role="tab" id={`vt-team-${v.id}`} aria-controls={`v-team-${v.id}`} data-view-tab={v.id}>{v.name}</button>
								))}
							</div>
						)}
					</header>
					<div class="frc-view" id="v-team-about" data-view="about" role="tabpanel" aria-labelledby="vt-team-about">
						<div class="grid items-center gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
							<div class="flex flex-col gap-4">
								<div class="flex items-center gap-4">
									<img src={team.logo} srcset={srcset(team.logo)} sizes="64px" alt="" width="764" height="764" loading="lazy" class="size-14 shrink-0 rounded-full object-cover ring-1 ring-border" />
									<h4 class="font-wide text-[clamp(1.6rem,2.6vw,2.25rem)] font-[880] leading-tight">{frcPage.about.headingPrefix} {team.number}</h4>
								</div>
								<p>{team.name}, {team.school}. {team.mission}.</p>
								<ul class="grid gap-x-5 sm:grid-cols-2">
									{team.focus.map((x) => (
										<li class="flex gap-3 border-t py-3">
											<DataIcon name={x.icon} className="mt-0.5 size-5 shrink-0" strokeWidth={1.75} />
											<span class="text-sm"><span class="font-semibold">{x.title}.</span> <span class="text-muted-foreground">{x.desc}</span></span>
										</li>
									))}
								</ul>
							</div>
							<figure class="m-0 flex flex-col gap-2">
								<img src={`/assets/frc/${teamPhoto.id}-640.webp`} srcset={frcSrcset(teamPhoto)} sizes="(min-width: 1024px) 50vw, 100vw" alt={teamPhoto.alt} width={teamPhoto.w} height={teamPhoto.h} loading="lazy" decoding="async" class="h-auto w-full rounded-xl" />
								<figcaption class="text-sm text-muted-foreground">{teamPhoto.caption} · {teamPhoto.meta}</figcaption>
							</figure>
						</div>
					</div>
					<div class="frc-view" id="v-team-subteams" data-view="subteams" role="tabpanel" aria-labelledby="vt-team-subteams">
						<div class="flex flex-col gap-5">
							<p class="max-w-3xl text-muted-foreground">{teamMore.subTeamsIntro}</p>
							<SubTeamPicker client:visible />
							<div class="grid gap-x-6 md:grid-cols-[auto_1fr_1fr]">
								<p class="border-t py-3 font-semibold">{teamMore.joinHeading}<span class="block text-sm font-normal text-muted-foreground">{teamMore.meets}</span></p>
								{teamMore.join.map((j) => (
									<p class="border-t py-3 text-sm"><span class="font-semibold">{j.title}.</span> <span class="text-muted-foreground">{j.text}</span></p>
								))}
							</div>
							<p class="text-sm text-muted-foreground">{teamMore.joinNote}</p>
						</div>
					</div>
					<div class="frc-view" id="v-team-values" data-view="values" role="tabpanel" aria-labelledby="vt-team-values">
						<div class="flex flex-col gap-5">
							<ul class="grid gap-px overflow-hidden rounded-2xl border bg-border sm:grid-cols-2 lg:grid-cols-3">
								{teamMore.values.map((v) => (
									<li class="frc-value" tabindex="0" style={`--value:${v.colour}`}>
										<h5 class="font-wide text-2xl font-[850]">{v.name}</h5>
										<p>{v.text}</p>
									</li>
								))}
							</ul>
							<ul class="grid gap-4 md:grid-cols-2">
								{teamMore.firstValues.map((v) => (
									<li class="flex flex-col gap-1.5 rounded-xl border surface p-5">
										<p class="text-sm text-muted-foreground">{teamMore.firstValueTag}</p>
										<h5 class="font-wide text-xl font-[850]">{v.name}</h5>
										<p class="text-sm text-muted-foreground">{v.text}</p>
									</li>
								))}
							</ul>
						</div>
					</div>
					<div class="frc-view" id="v-team-leadership" data-view="leadership" role="tabpanel" aria-labelledby="vt-team-leadership">
						<Leadership lead="frc" heading={frcPage.about.leadershipHeading} headingLevel="h4" id="frc-leadership" intro={frcPage.about.leadershipIntro} />
					</div>
					<footer class="frc-chapter-foot">
						<a href={`#${nextOf("team").id}`} class="frc-next">{board.nextLabel} <span>{nextOf("team").name}</span> <span aria-hidden="true">→</span></a>
					</footer>
				</section>
				<section class="frc-chapter" id="ch-workshop" data-chapter="workshop" role="tabpanel" aria-labelledby="ct-workshop">
					<header class="frc-chapter-head">
						<h3 class="font-wide text-[clamp(1.5rem,2.4vw,2rem)] font-[880] leading-tight">{chapter("workshop").name}</h3>
						{chapter("workshop").views.length > 1 && (
							<div class="frc-views" role="tablist" aria-label={board.viewsLabel}>
								{chapter("workshop").views.map((v) => (
									<button type="button" role="tab" id={`vt-workshop-${v.id}`} aria-controls={`v-workshop-${v.id}`} data-view-tab={v.id}>{v.name}</button>
								))}
							</div>
						)}
					</header>
					<div class="frc-view" id="v-workshop-path" data-view="path" role="tabpanel" aria-labelledby="vt-workshop-path">
						<div class="flex flex-col gap-4">
							<p class="max-w-3xl text-muted-foreground">{workshop.intro}</p>
							<CertPipeline client:visible />
						</div>
					</div>
					<div class="frc-view" id="v-workshop-rules" data-view="rules" role="tabpanel" aria-labelledby="vt-workshop-rules">
						<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
							<figure class="m-0 flex flex-col gap-2">
								<img src={`/assets/frc/${workshopPhoto.id}-640.webp`} srcset={frcSrcset(workshopPhoto)} sizes="(min-width: 1024px) 40vw, 100vw" alt={workshopPhoto.alt} width={workshopPhoto.w} height={workshopPhoto.h} loading="lazy" decoding="async" class="aspect-[4/3] w-full rounded-xl object-cover" />
								<figcaption class="text-sm text-muted-foreground">{workshopPhoto.caption} · {workshopPhoto.meta}</figcaption>
							</figure>
							<div class="flex flex-col gap-5">
								<div class="flex flex-col gap-2">
									<h4 class="font-semiwide text-xl font-[780]">{workshop.rulesHeading}</h4>
									<dl class="grid gap-x-6 sm:grid-cols-2">
										{workshop.rules.map((r) => (
											<div class="flex flex-col gap-0.5 border-t py-3">
												<dt class="font-semibold">{r.title}</dt>
												<dd class="text-sm text-muted-foreground">{r.text}</dd>
											</div>
										))}
									</dl>
								</div>
							</div>
						</div>
					</div>
					<div class="frc-view" id="v-workshop-conduct" data-view="conduct" role="tabpanel" aria-labelledby="vt-workshop-conduct">
						<ul class="flex flex-col">
							{teamMore.conduct.map((c) => (
								<li class="frc-conduct" tabindex="0">
									<span class="font-wide text-lg font-[820]">{c.ideal}</span>
									<span class="frc-conduct-arrow" aria-hidden="true"></span>
									<span class="frc-conduct-means text-lg">{c.means}</span>
								</li>
							))}
						</ul>
					</div>
					<div class="frc-view" id="v-workshop-photos" data-view="photos" role="tabpanel" aria-labelledby="vt-workshop-photos">
						<Filmstrip client:visible ids={workshop.photos} label={workshop.photosLabel} />
					</div>
					<footer class="frc-chapter-foot">
						<a href={`#${nextOf("workshop").id}`} class="frc-next">{board.nextLabel} <span>{nextOf("workshop").name}</span> <span aria-hidden="true">→</span></a>
					</footer>
				</section>
				<section class="frc-chapter" id="ch-outreach" data-chapter="outreach" role="tabpanel" aria-labelledby="ct-outreach">
					<header class="frc-chapter-head">
						<h3 class="font-wide text-[clamp(1.5rem,2.4vw,2rem)] font-[880] leading-tight">{chapter("outreach").name}</h3>
						{chapter("outreach").views.length > 1 && (
							<div class="frc-views" role="tablist" aria-label={board.viewsLabel}>
								{chapter("outreach").views.map((v) => (
									<button type="button" role="tab" id={`vt-outreach-${v.id}`} aria-controls={`v-outreach-${v.id}`} data-view-tab={v.id}>{v.name}</button>
								))}
							</div>
						)}
					</header>
					<div class="frc-view" id="v-outreach-programs" data-view="programs" role="tabpanel" aria-labelledby="vt-outreach-programs">
						<div class="flex flex-col gap-4">
							<p class="max-w-3xl text-muted-foreground">{outreach.intro}</p>
							<ul class="grid gap-4 md:grid-cols-2">
								{outreach.programs.map((o) => (
									<li class="frc-prog flex flex-col gap-1.5 rounded-xl border surface p-5" tabindex={o.more ? "0" : undefined}>
										<p class="text-sm text-muted-foreground">{o.tag}</p>
										<h5 class="font-semiwide text-xl font-[780]">{o.name}</h5>
										<p class="text-sm text-muted-foreground">{o.text}</p>
										{o.detail && <p class="text-sm">{o.detail}</p>}
										{o.more && (
											<>
												<p class="frc-prog-hint text-sm font-semibold" aria-hidden="true">{outreach.moreHint} +</p>
												<dl class="frc-prog-more">
													<div class="flex flex-col gap-1.5 pt-1">
														{o.more.map((m) => (
															<div class="grid gap-1 border-t pt-1.5 sm:grid-cols-[8.5rem_1fr]">
																<dt class="text-sm font-semibold">{m.k}</dt>
																<dd class="text-sm text-muted-foreground">{m.v}</dd>
															</div>
														))}
													</div>
												</dl>
											</>
										)}
									</li>
								))}
							</ul>
						</div>
					</div>
					<div class="frc-view" id="v-outreach-robokids" data-view="robokids" role="tabpanel" aria-labelledby="vt-outreach-robokids">
						<div class="flex flex-col gap-3">
							<Filmstrip client:visible ids={outreach.photos} label={outreach.photosLabel} />
							<p class="text-sm text-muted-foreground">{outreach.privacy}</p>
						</div>
					</div>
					<footer class="frc-chapter-foot">
						<a href={`#${nextOf("outreach").id}`} class="frc-next">{board.nextLabel} <span>{nextOf("outreach").name}</span> <span aria-hidden="true">→</span></a>
					</footer>
				</section>
				<section class="frc-chapter" id="ch-partner" data-chapter="partner" role="tabpanel" aria-labelledby="ct-partner">
					<header class="frc-chapter-head">
						<h3 class="font-wide text-[clamp(1.5rem,2.4vw,2rem)] font-[880] leading-tight">{chapter("partner").name}</h3>
						{chapter("partner").views.length > 1 && (
