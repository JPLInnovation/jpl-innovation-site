---
import ProjectCase from "@/components/ProjectCase.astro";
import { getEntry } from "astro:content";
import { ArrowUpRight } from "lucide-react";
import BackLink from "@/components/BackLink.astro";
import { backToWork } from "@/text/work";
import ChapterBackdrop from "@/components/ChapterBackdrop.astro";
import DroneIllustration from "@/components/DroneIllustration.astro";
import NextChapter from "@/components/NextChapter.astro";
import TitleBlock from "@/components/TitleBlock.astro";
import Bom from "@/components/drone/Bom.astro";
import Motion from "@/components/drone/Motion.astro";
import Plate from "@/components/drone/Plate.astro";
import Revisions from "@/components/drone/Revisions.astro";
import Schematic from "@/components/drone/Schematic.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
// All the words on this page: src/text/projects/mini-drone.ts (card on the Work page: src/text/projects/mini-drone.md);
// the parts list's column headings are the F450 page's (src/text/projects/drone.ts).
import { dronePage } from "@/text/projects/drone";
import { miniDrone, miniDronePage as text, partGroups, projectFiles, roadmap, systems } from "@/text/projects/mini-drone";

const entry = (await getEntry("work", "mini-drone"))!;

const team = await Promise.all(
	miniDrone.team.map(async (t) => {
		const member = t.member ? await getEntry("members", t.member) : null;
		return { label: t.role, value: member ? member.data.title : "", href: member ? `/members/${member.id}/` : undefined };
	}),
);
/** The drawing's title block: the project, where it stands, its figures, who builds it. */
const titleRows = [
	{ label: text.titleBlock.project, value: miniDrone.name },
	{ label: text.titleBlock.status, value: miniDrone.status },
	...miniDrone.facts.map((f) => ({ label: f.label, value: f.value })),
	...team.filter((t) => t.value),
];
---

<BaseLayout title={`${miniDrone.name} | JPL Innovation`} description={entry.data.description}>
	<ChapterBackdrop project="mini-drone" />

	<!-- The sheet's opening: the name, what it is, its files -->
	<header class="mini-head wrapper">
		<BackLink href="/work/">{backToWork}</BackLink>
		<h1 class="mini-title living" data-decode>{miniDrone.name}</h1>
		<p class="mini-intro">{miniDrone.intro}</p>
		<p class="mini-files">
			<a href={projectFiles.href} target="_blank" rel="noopener" class="press">
				{projectFiles.label}<ArrowUpRight className="size-[1.1em]" strokeWidth={2} aria-hidden="true" />
			</a>
			<span>{projectFiles.note}</span>
		</p>
	</header>

	<!-- The plate: the quad drawn from above, to scale, with the title block in its corner -->
	<Plate class="mini-plate" cols={4}>
		<div class="mini-plan" transition:name="project-mini-drone">
			<DroneIllustration label={text.heroImgAlt} wheelbase={69} prop={35} motor={0.055} plate={0.36} dimension={text.plan.dimension} />
		</div>
		<TitleBlock slot="block" rows={titleRows} label={text.titleBlock.label} wide />
	</Plate>

	<!-- The case: the problem, why not the alternatives, our answer (src/text/projects/hooks.ts). -->
	<ProjectCase project="mini-drone" />

	<!-- The roadmap, as the drawing's revision table -->
	<Revisions
		steps={roadmap}
		heading={text.progressHeading}
		labels={{ step: text.stepLabel, stage: text.stageLabel, state: text.stateLabel, done: text.doneTag, now: text.nowTag }}
	/>

	<!-- How it works: the two systems as schematics -->
	<Schematic systems={systems} heading={text.systemsHeading} intro={text.systemsIntro} branchPrefix={text.branchPrefix} />

	<!-- Parts: the count by group, then the parts list -->
	<Bom
		groups={partGroups}
		suffix={text.partsHeadingSuffix}
		labels={dronePage.table}
		captionSuffix={text.tableCaptionSuffix}
		count={{ unit: text.countUnit, label: text.countTotal }}
	/>

	<NextChapter current={"mini-drone"} />
	<Motion />
</BaseLayout>

<style>
	.mini-head {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		padding-top: 1.5rem;
		padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
	}
	.mini-title {
		max-width: 11ch;
		font-size: var(--step-display);
		font-stretch: 125%;
		font-weight: 850;
		line-height: 0.88;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}
	.mini-intro {
		max-width: 52ch;
		font-size: var(--step-lead);
		line-height: 1.45;
		text-wrap: pretty;
	}
	.mini-files {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 1.25rem;
		color: var(--ink-soft);
	}
	.mini-files a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 2.75rem;
		font-weight: 650;
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--accent-brand);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}
	.mini-files a:hover {
		text-decoration-thickness: 3px;
	}
	.mini-plan :global(svg) {
		width: 100%;
		height: 100%;
	}
</style>
