---
import ProjectCase from "@/components/ProjectCase.astro";
import { getEntry } from "astro:content";
import { CircleCheck } from "lucide-react";
import ChapterBackdrop from "@/components/ChapterBackdrop.astro";
import DroneChapter from "@/components/DroneChapter.astro";
import NextChapter from "@/components/NextChapter.astro";
import Bom from "@/components/drone/Bom.astro";
import Revisions from "@/components/drone/Revisions.astro";
import Schematic from "@/components/drone/Schematic.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
// All the words on this page: src/text/projects/drone.ts (card on the Work page: src/text/projects/drone.md); the
// chapter at the top (src/components/DroneChapter.astro) also uses "Part by part": src/text/showcase/drone.ts
import { drone, dronePage as text, earlierWork, partGroups, roadmap, systems } from "@/text/projects/drone";

const entry = (await getEntry("work", "drone"))!;
---

<BaseLayout title={`${drone.name} | JPL Innovation`} description={entry.data.description}>
	<ChapterBackdrop project="drone" />
	<!-- The opening: in 3D one pinned stage the scroll moves the camera through; in Classic the sheet's opening, the
	     plate with its title block, and the parts drawn one by one. -->
	<DroneChapter />

	<!-- The case: the problem, why not the alternatives, our answer (src/text/projects/hooks.ts). -->
	<ProjectCase project="drone" />

	<!-- The roadmap, as the drawing's revision table -->
	<Revisions
		steps={roadmap}
		heading={text.progressHeading}
		labels={{ step: text.stepLabel, stage: text.stageLabel, state: text.stateLabel, done: text.doneTag, now: text.nowTag }}
	/>

	<!-- How it works: the three systems as schematics -->
	<Schematic systems={systems} heading={text.systemsHeading} intro={text.systemsIntro} branchPrefix={text.branchPrefix} />

	<!-- Parts & budget: the receipt, then the parts list -->
	<Bom
		groups={partGroups}
		suffix={text.partsHeadingSuffix}
		labels={text.table}
		captionSuffix={text.table.captionSuffix}
		total={{ label: text.totalLabel, note: text.totalNote }}
	/>

	<!-- Earlier work: the sheet before this one -->
	<section class="earlier wrapper" aria-labelledby="earlier-heading">
		<div class="earlier-lead">
			<p class="earlier-date">{text.earlierLabel} {earlierWork.date}</p>
			<h2 id="earlier-heading" class="earlier-heading">{earlierWork.title}</h2>
			<p class="earlier-summary">{earlierWork.summary}</p>
		</div>
		<ul class="earlier-points">
			{
				earlierWork.points.map((p) => (
					<li>
						<CircleCheck className="size-[1.15em] shrink-0" strokeWidth={1.5} aria-hidden="true" />
						{p}
					</li>
				))
			}
		</ul>
	</section>

	<NextChapter current={"drone"} />
</BaseLayout>

<style>
	.earlier {
		display: grid;
		gap: 2.5rem;
		padding-block: clamp(4rem, 9vw, 7rem);
		border-top: 1px solid var(--sheet-edge);
	}
	@media (min-width: 52rem) {
		.earlier {
			grid-template-columns: 1fr 1.2fr;
			gap: 4rem;
		}
	}
	.earlier-lead {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}
	.earlier-date {
		color: var(--ink-soft);
	}
	.earlier-heading {
		font-size: var(--step-lead);
		font-stretch: 125%;
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}
	.earlier-summary {
		max-width: 46ch;
		text-wrap: pretty;
	}
	.earlier-points li {
		display: flex;
		gap: 0.75rem;
		padding-block: 0.9rem;
		border-bottom: 1px solid var(--sheet-edge);
		text-wrap: pretty;
	}
	.earlier-points li :global(svg) {
		margin-top: 0.2em;
		color: var(--ink-soft);
	}
	.earlier-points li:first-child {
		border-top: 1.5px solid var(--ink);
	}
</style>
