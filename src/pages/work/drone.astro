---
// @ts-ignore: the project has no Node type definitions; this only runs at build time, in Node.
import { existsSync } from "node:fs";
import { getEntry } from "astro:content";
import { ArrowDown, ArrowRight, CircleCheck, CornerDownRight } from "lucide-react";
import BackLink from "@/components/BackLink.astro";
import BeatLabel from "@/components/BeatLabel.astro";
import { buttonVariants } from "@/components/ui/button";
import { backToWork } from "@/text/work";
import DroneIllustration from "@/components/DroneIllustration.astro";
import ChapterBackdrop from "@/components/ChapterBackdrop.astro";
import ContactSection from "@/components/ContactSection.astro";
import NextChapter from "@/components/NextChapter.astro";
import ModelViewer from "@/components/model-viewer";
import PartsTable from "@/components/parts-table";
import Showcase from "@/components/showcase";
import StatusTag from "@/components/StatusTag.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
// All the words on this page: src/text/projects/drone.ts (card on the Work page: src/text/projects/drone.md),
// and the "Part by part" showcase: src/text/showcase/drone.ts
import { drone, droneChapter as chapter, dronePage as text, earlierWork, partGroups, roadmap, systems } from "@/text/projects/drone";
import { droneShowcase } from "@/text/showcase/drone";
import { formatVnd } from "@/lib/format";
import { DataIcon } from "@/lib/icons";
import { cn } from "@/lib/utils";

const entry = (await getEntry("work", "drone"))!;

/** The chapter's beats so far, in page order (each one's id is its section's). */
const beatIds = ["prologue", "stakes", "reveal", "anatomy"] as const;

const team = await Promise.all(
	drone.team.map(async (t) => ({ role: t.role, member: "member" in t ? await getEntry("members", t.member) : null })),
);

const groups = partGroups.map((g) => ({
	...g,
	subtotal: g.parts.reduce((sum, p) => sum + (p.price ?? 0), 0),
}));
const total = groups.reduce((sum, g) => sum + g.subtotal, 0);
const partCount = groups.reduce((sum, g) => sum + g.parts.length, 0);

// The showcase's pictures for phones (scripts/showcase-stills.py). A feature without one shows its text only.
const stills = Object.fromEntries(
	droneShowcase.features
		.filter((f) => existsSync(`public/showcase/drone/${f.id}-800.webp`))
		.map((f) => [f.id, `/showcase/drone/${f.id}`]),
);
---

<BaseLayout title={`${drone.name} | JPL Innovation`} description={entry.data.description}>
	<ChapterBackdrop project="drone" />
	<!-- The chapter: beats 1 to 4 (words: src/text/projects/drone.ts, droneChapter). In 3D, beats 1 to 3 are a screen each
	     over the dark and the chapter map sits at the side; in Classic (data-read: phones, reduced motion, no WebGL, Classic
	     chosen) the same words are an ordinary page in the same order. src/scripts/drone-chapter.ts runs the clock, the
	     map and the beats coming in. -->
	<div class="drone-chapter" data-drone-chapter data-read>
		<script is:inline data-astro-rerun>
			// Before the first paint: the 3D chapter unless Classic was chosen, the window is under 768 px, motion is reduced
			// or there is no WebGL.
			(() => {
				const el = document.currentScript.parentElement;
				const root = document.documentElement;
				const read =
					root.classList.contains("read-mode") ||
					root.classList.contains("reduce-motion") ||
					matchMedia("(max-width: 767px), (prefers-reduced-motion: reduce)").matches;
				if (read) return;
				const gl = document.createElement("canvas").getContext("webgl2") || document.createElement("canvas").getContext("webgl");
				if (!gl) return;
				gl.getExtension("WEBGL_lose_context")?.loseContext();
				el.removeAttribute("data-read");
			})();
		</script>
		<nav class="chapter-map" aria-label={chapter.mapLabel} data-chapter-map>
			<ol>
				{
					beatIds.map((id) => (
						<li>
							<a href={`#${id}`} data-map-link={id}>
								<span class="chapter-map-dot" aria-hidden="true" />
								<span class="chapter-map-n">{chapter.beats[id].number}</span>
								<span class="chapter-map-title">{chapter.beats[id].title}</span>
							</a>
						</li>
					))
				}
			</ol>
		</nav>

		<div class="chapter-band" data-chapter-band>
			<script is:inline data-astro-rerun>
				// In 3D the first three beats are dark in both themes: the band takes the dark theme's colours.
				(() => {
					const band = document.currentScript.parentElement;
					if (!band.closest("[data-drone-chapter]").hasAttribute("data-read")) band.classList.add("dark");
				})();
			</script>
			<div class="chapter-back wrapper pt-6 md:pt-10"><BackLink href="/work/">{backToWork}</BackLink></div>

			<!-- 01 Prologue: the drone's real state, where it is and the local time, and the problem it solves -->
			<section id="prologue" data-beat="prologue" class="chapter-beat chapter-screen wrapper" aria-labelledby="prologue-label">
				<BeatLabel id="prologue-label" beat={chapter.beats.prologue} />
				<p class="chapter-hud">
					<span class="chapter-hud-state"><span class="chapter-hud-dot" aria-hidden="true"></span>{chapter.hud.state}</span>
					<span class="chapter-hud-place">
						<span aria-hidden="true">{chapter.hud.city}</span>
						<span class="sr-only">{chapter.hud.timeLabel} {chapter.hud.city}:</span>
						<time class="chapter-hud-time" data-chapter-clock={chapter.hud.timeZone}>--:--:--</time>
					</span>
				</p>
				<p class="chapter-statement font-wide">{chapter.prologue.problem}</p>
			</section>

			<!-- 02 The stakes: the camera's 720p at 60 fps, and the 4G link said on its own (no frame rate for the stream) -->
			<section id="stakes" data-beat="stakes" class="chapter-beat chapter-screen wrapper" aria-labelledby="stakes-label">
				<BeatLabel id="stakes-label" beat={chapter.beats.stakes} />
				<div class="chapter-stat">
					<p class="chapter-stat-label">{chapter.stakes.label}</p>
					<p class="chapter-stat-value font-wide"><span>{chapter.stakes.value}</span> <span class="chapter-stat-unit">{chapter.stakes.unit}</span></p>
					<p class="chapter-stat-secondary font-wide">{chapter.stakes.secondary}</p>
					<p class="chapter-stat-source">{chapter.stakes.source}</p>
				</div>
				<p class="chapter-aside">{chapter.stakes.link}</p>
			</section>

		<!-- 03 The reveal: the drone's name, status and credits, and the 3D model rising out of the dark -->
		<header id="reveal" data-beat="reveal" aria-labelledby="reveal-label" class="chapter-beat wrapper grid gap-10 pb-16 pt-6 md:pt-10 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-14 lg:pb-24">
				<BeatLabel id="reveal-label" beat={chapter.beats.reveal} class="lg:col-span-2" />
			<div class="flex flex-col gap-6">
				<div data-reveal><StatusTag>{drone.status}</StatusTag></div>
				<h1 data-reveal class="font-wide text-[clamp(2.8rem,8vw,6.25rem)] font-[900] leading-[0.94]"><span class="chapter-kicker">{chapter.reveal.kicker}</span> {drone.name}</h1>
				<p class="max-w-[56ch] text-lg" data-reveal data-reveal-delay="150">{drone.intro}</p>
				<dl class="grid grid-cols-2 gap-x-6 gap-y-5 border-t pt-6 sm:grid-cols-4" data-reveal-group>
					{
						drone.facts.map((f) => (
							<div class="flex flex-col gap-1">
								<dt class="flex items-center gap-1.5 text-sm text-muted-foreground">
									<DataIcon name={f.icon} className="size-4" />
									{f.label}
								</dt>
								<dd class="font-semibold">{f.value}</dd>
							</div>
						))
					}
				</dl>
				<ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted-foreground" data-reveal>
					{
						team.map((t) => (
							<li>
								{t.role}
								{t.member && (
									<>
										{" — "}
										<a href={`/members/${t.member.id}/`} class="font-medium text-foreground hover:underline">
											{t.member.data.title}
										</a>
									</>
								)}
							</li>
						))
					}
				</ul>
				<!-- data-astro-reload: the guide, the 3D layout and the camera mount are standalone pages, so load them fully instead of a client-side swap. -->
				<div class="flex flex-wrap items-center gap-x-4 gap-y-2" data-reveal>
					<a href={text.buildGuide.href} data-astro-reload class={buttonVariants({ variant: "signal", size: "lg" })}>{text.buildGuide.label}</a>
					<a href={text.layout3d.href} data-astro-reload class={buttonVariants({ variant: "outline", size: "lg" })}>{text.layout3d.label}</a>
					<a href={text.cameraPov.href} data-astro-reload class={buttonVariants({ variant: "outline", size: "lg" })}>{text.cameraPov.label}</a>
					<p class="max-w-[40ch] text-sm text-muted-foreground">{text.buildGuide.note}</p>
				</div>
			</div>
			<figure transition:name="project-drone" class="chapter-rise flex flex-col gap-4 rounded-xl border surface p-4 md:p-6" data-reveal>
				<ModelViewer
					client:visible
					model="drone"
					label={text.model3d.description}
					className="aspect-square w-full"
				>
					<div class="mx-auto w-full max-w-[22rem]"><DroneIllustration /></div>
				</ModelViewer>
				<figcaption class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm text-muted-foreground">
					<span class="flex items-center gap-2"><span class="h-1.5 w-5 rounded-full bg-alliance-red" aria-hidden="true"></span>{text.model3d.frontArms}</span>
					<span class="flex items-center gap-2"><span class="h-1.5 w-5 rounded-full bg-muted-foreground" aria-hidden="true"></span>{text.model3d.rearArms}</span>
					<span>{text.model3d.layoutNote}</span>
				</figcaption>
			</figure>
		</header>
		</div>

		<!-- 04 Anatomy: the frame's 450 mm, then the part-by-part showcase -->
		<section id="anatomy" data-beat="anatomy" class="chapter-beat" aria-labelledby="anatomy-label">
			<div class="wrapper flex flex-col gap-3 pb-4 md:pb-8">
				<BeatLabel id="anatomy-label" beat={chapter.beats.anatomy} />
				<p class="chapter-stat-value chapter-stat-small font-wide" data-reveal><span>{chapter.anatomy.value}</span> <span class="chapter-stat-unit">{chapter.anatomy.label}</span></p>
			</div>
		<!-- Part by part: the 3D drone turns to each part as its text scrolls past (src/components/showcase.tsx) -->
		<Showcase client:visible={{ rootMargin: "200px" }} model="drone" text={droneShowcase} stills={stills}>
			<div class="mx-auto w-full max-w-[22rem]"><DroneIllustration /></div>
		</Showcase>
		</section>
	</div>

	<!-- Progress -->
	<section class="wrapper flex flex-col gap-8 pb-24" aria-labelledby="progress-heading">
		<h2 data-reveal id="progress-heading" class="font-wide text-[clamp(2rem,4.5vw,3.25rem)] font-[850]">{text.progressHeading}</h2>
		<ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-6 lg:gap-5" data-reveal-group>
			{
				roadmap.map((step, i) => (
					<li class="flex flex-col gap-2">
						<span aria-hidden="true" class="mb-2 flex h-1.5 overflow-hidden rounded-full bg-foreground/15">
							{step.state !== "upcoming" && (
								<span
									data-draw
									data-draw-watch="parent"
									data-reveal-delay={i * 150}
									class={cn("block w-full rounded-full", step.state === "done" ? "bg-foreground" : "bg-accent")}
								/>
							)}
						</span>
						<p class="flex items-center gap-2 text-sm font-medium text-muted-foreground">
							{text.stepLabel} {i + 1}
							{step.state === "done" && (
								<span class="inline-flex items-center gap-1 text-foreground">
									<CircleCheck className="size-4" aria-hidden="true" /> {text.doneTag}
								</span>
							)}
							{step.state === "current" && (
								<span class="rounded-sm bg-accent px-1.5 py-0.5 text-xs font-bold text-accent-foreground">{text.nowTag}</span>
							)}
						</p>
						<h3 class="font-semiwide text-lg font-[760]">{step.title}</h3>
						<p class="text-muted-foreground">{step.desc}</p>
					</li>
				))
			}
		</ol>
	</section>

	<!-- How it works -->
	<section class="border-y bg-card/70" aria-labelledby="systems-heading">
		<div class="wrapper flex flex-col gap-10 py-20 md:py-24">
			<div class="flex max-w-2xl flex-col gap-3" data-reveal>
				<h2 id="systems-heading" class="font-wide text-[clamp(2rem,4.5vw,3.25rem)] font-[850]">{text.systemsHeading}</h2>
				<p class="text-lg text-muted-foreground">{text.systemsIntro}</p>
			</div>
			<div class="flex flex-col gap-10">
				{
					systems.map((sys) => (
						<div class="flex flex-col gap-4 border-t pt-6">
							<h3 class="flex items-center gap-2.5 font-semiwide text-xl font-[780]">
								<DataIcon name={sys.icon} className="size-5" strokeWidth={1.75} />
								{sys.title}
							</h3>
							<ol class="flex flex-col gap-1 lg:flex-row lg:items-stretch lg:gap-0" data-reveal-group>
								{sys.steps.map((s, j) => (
									<li class="flex flex-col lg:flex-1 lg:flex-row lg:items-center">
										{j > 0 && (
											<span class="flex items-center gap-2 py-1.5 pl-4 text-xs text-muted-foreground lg:flex-col lg:justify-center lg:gap-0.5 lg:px-2 lg:py-0">
												<ArrowDown className="size-4 lg:hidden" aria-hidden="true" />
												<ArrowRight className="hidden size-4 lg:block" aria-hidden="true" />
												{"link" in s && s.link && <span class="lg:whitespace-nowrap">{s.link}</span>}
											</span>
										)}
										<span class="flex flex-1 flex-col rounded-lg border bg-background px-4 py-3">
											<strong class="font-semibold">{s.name}</strong>
											<small class="text-sm text-muted-foreground">{s.detail}</small>
										</span>
									</li>
								))}
							</ol>
							{"branch" in sys && sys.branch && (
								<div class="flex flex-col gap-2 pl-4 lg:pl-8">
									<p class="flex items-center gap-2 text-sm text-muted-foreground">
										<CornerDownRight className="size-4" aria-hidden="true" /> {text.branchPrefix} {sys.branch.from}
									</p>
									<ol class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-0" data-reveal-group>
										{sys.branch.steps.map((s, j) => (
											<li class="flex flex-col sm:flex-row sm:items-center">
												{j > 0 && (
													<span class="py-1.5 pl-4 text-muted-foreground sm:px-2 sm:py-0" aria-hidden="true">
														<ArrowDown className="size-4 sm:hidden" />
														<ArrowRight className="hidden size-4 sm:block" />
													</span>
												)}
												<span class="flex flex-col rounded-lg border bg-background px-4 py-3">
													<strong class="font-semibold">{s.name}</strong>
													<small class="text-sm text-muted-foreground">{s.detail}</small>
												</span>
											</li>
										))}
									</ol>
								</div>
							)}
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Parts & budget -->
	<section id="parts" class="wrapper flex flex-col gap-10 py-20 md:py-24" aria-labelledby="parts-heading">
		<h2 data-reveal id="parts-heading" class="font-wide text-[clamp(2rem,4.5vw,3.25rem)] font-[850]">{partCount} {text.partsHeadingSuffix}</h2>

		<figure class="grid gap-8 rounded-xl border surface p-6 md:grid-cols-[1fr_1.4fr] md:p-8" data-reveal>
			<div class="flex flex-col gap-2">
				<p class="text-sm text-muted-foreground">{text.totalLabel}</p>
				<p class="font-wide text-[clamp(2.2rem,5vw,3.25rem)] font-[880] leading-none tabular-nums" data-count={total} data-count-format="vnd">{formatVnd(total)}</p>
				<figcaption class="text-sm text-muted-foreground">
					{text.totalNote}
				</figcaption>
			</div>
			<div class="flex flex-col gap-5">
				<!-- Share of the budget per group; exact values are in the legend and the tables below. -->
				<div class="flex h-4 gap-[2px]" aria-hidden="true" data-draw data-draw-duration="1.4">
					{
						groups.map((g) => (
							<span
								class="rounded-[4px]"
								title={`${g.title}: ${formatVnd(g.subtotal)}`}
								style={`flex-grow: ${g.subtotal}; background: ${g.color}`}
							/>
						))
					}
				</div>
				<ul class="grid gap-3 sm:grid-cols-2">
					{
						groups.map((g) => (
							<li class="flex items-start gap-3">
								<span class="mt-1.5 size-3 shrink-0 rounded-[3px]" style={`background: ${g.color}`} aria-hidden="true" />
								<span class="flex flex-col">
									<span class="font-medium">{g.title}</span>
									<span class="text-sm tabular-nums text-muted-foreground">
										{formatVnd(g.subtotal)}, {Math.round((g.subtotal / total) * 100)}%
									</span>
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</figure>

		<div class="flex flex-col gap-12">
			{
				groups.map((g) => (
					<section aria-labelledby={`group-${g.id}`} class="flex flex-col gap-3" data-reveal>
						<h3 id={`group-${g.id}`} class="flex items-center gap-2.5 font-semiwide text-xl font-[780]">
							<span class="size-3 rounded-[3px]" style={`background: ${g.color}`} aria-hidden="true" />
							{g.title}
						</h3>
						<PartsTable caption={`${g.title} ${text.table.captionSuffix}`} parts={g.parts} subtotal={g.subtotal} />
					</section>
				))
			}
		</div>
	</section>

	<!-- Earlier work -->
	<section class="border-t bg-card/70" aria-labelledby="earlier-heading">
		<div class="wrapper grid gap-8 py-20 md:grid-cols-[1fr_1.2fr] md:gap-14 md:py-24">
			<div class="flex flex-col gap-3" data-reveal>
				<p class="text-sm text-muted-foreground">{text.earlierLabel} {earlierWork.date}</p>
				<h2 id="earlier-heading" class="font-wide text-3xl font-[850] md:text-4xl">{earlierWork.title}</h2>
				<p class="text-lg">{earlierWork.summary}</p>
			</div>
			<ul class="flex flex-col" data-reveal-group>
				{
					earlierWork.points.map((p) => (
						<li class="flex gap-3 border-t py-4">
							<CircleCheck className="mt-0.5 size-5 shrink-0" aria-hidden="true" />
							{p}
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<NextChapter current={"drone"} />
	<ContactSection />
	<script>
		import "@/scripts/drone-chapter";
	</script>
	<style is:global>
		/* ---------- The drone chapter, both modes (Classic: an ordinary page, in the same order) ---------- */
		.chapter-label {
			font: 600 0.8rem/1.3 ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--muted-foreground);
		}
		.chapter-label-n {
			color: var(--foreground);
			margin-right: 0.6em;
		}
		.chapter-beat {
			scroll-margin-top: 4.5rem;
		}
		.chapter-screen {
			display: flex;
			flex-direction: column;
			gap: 1.5rem;
			padding-block: 2.5rem;
		}
		.chapter-hud {
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			gap: 0.5rem 2rem;
			padding-block: 0.75rem;
			border-block: 1px solid var(--border);
			font: 500 0.85rem/1.4 ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}
		.chapter-hud-state {
			display: inline-flex;
			align-items: center;
			gap: 0.6em;
		}
		.chapter-hud-dot {
			width: 0.55em;
			height: 0.55em;
			border-radius: 50%;
			background: #1fb0d6;
			box-shadow: 0 0 8px rgb(31 176 214 / 0.8);
		}
		.chapter-hud-place {
			display: inline-flex;
			gap: 1em;
			color: var(--muted-foreground);
		}
		.chapter-hud-time {
			min-width: 8ch;
			color: var(--foreground);
			font-variant-numeric: tabular-nums;
		}
		.chapter-statement {
			max-width: 18ch;
			font-stretch: 125%;
			font-weight: 860;
			font-size: clamp(2rem, 5vw, 3.5rem);
			line-height: 1.02;
			letter-spacing: -0.02em;
			text-wrap: balance;
		}
		.chapter-stat {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
		}
		.chapter-stat-label {
			font: 600 0.85rem/1.3 ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: var(--muted-foreground);
		}
		.chapter-stat-value {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0 0.3em;
			font-stretch: 125%;
			font-weight: 900;
			font-size: clamp(4rem, 15vw, 9rem);
			line-height: 0.86;
			letter-spacing: -0.03em;
			font-variant-numeric: tabular-nums;
		}
		.chapter-stat-small {
			font-size: clamp(2.75rem, 8vw, 5rem);
		}
		.chapter-stat-value > span:first-child {
			white-space: nowrap;
		}
		.chapter-stat-unit {
			font-size: 0.32em;
			font-weight: 760;
			letter-spacing: 0;
			color: var(--muted-foreground);
		}
		.chapter-stat-secondary {
			font-size: clamp(1.4rem, 3vw, 2.25rem);
			font-weight: 780;
			color: var(--muted-foreground);
		}
		.chapter-stat-source {
			font-size: 1.125rem;
			color: var(--muted-foreground);
		}
		.chapter-aside {
			max-width: 46ch;
			font-size: 1.125rem;
		}
		.chapter-kicker {
			display: block;
			margin-bottom: 0.15em;
			font-size: 0.36em;
			font-weight: 720;
			letter-spacing: 0;
			color: var(--muted-foreground);
		}
		#anatomy {
			padding-top: 2rem;
		}
		/* The map is the 3D chapter's only. */
		.chapter-map {
			display: none;
		}

		/* ---------- 3D: beats 1 to 3 a screen each, over the dark (the band has the dark theme's colours) ---------- */
		.drone-chapter:not([data-read]) .chapter-band {
			position: relative;
			padding-bottom: 12rem;
			color: var(--foreground);
			background: linear-gradient(to bottom, #04070a, #04070a calc(100% - 12rem), transparent);
		}
		html:has(.drone-chapter:not([data-read])) .chapter-backdrop {
			display: none;
		}
		.drone-chapter:not([data-read]) .chapter-screen {
			min-height: calc(100svh - 9rem);
			justify-content: center;
			gap: 2.5rem;
			padding-block: 3rem;
		}
		.drone-chapter:not([data-read]) #prologue {
			justify-content: space-between;
		}
		.drone-chapter:not([data-read]) .chapter-statement {
			font-size: clamp(2.6rem, 5.8vw, 5.75rem);
			max-width: 15ch;
			margin-block: auto;
		}
		.drone-chapter:not([data-read]) #stakes .chapter-stat-value {
			font-size: clamp(6rem, 18vw, 16rem);
		}
		.drone-chapter:not([data-read]) #reveal {
			min-height: 100svh;
			align-content: center;
		}
		/* The model floats in the dark: no card around it. */
		.drone-chapter:not([data-read]) .chapter-rise {
			border-color: transparent;
			background: none;
			box-shadow: none;
		}

		/* Each beat comes in as it reaches the screen (src/scripts/drone-chapter.ts), and the model rises out of the dark.
		   Individual translate/scale/filter, so they never fight the site's own reveal (which animates transform). */
		.drone-chapter[data-live] :is(#prologue, #stakes) > * {
			opacity: 0;
			translate: 0 28px;
			transition:
				opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
				translate 0.9s cubic-bezier(0.22, 1, 0.36, 1);
		}
		.drone-chapter[data-live] :is(#prologue, #stakes)[data-in] > * {
			opacity: 1;
			translate: 0 0;
		}
		.drone-chapter[data-live] :is(#prologue, #stakes)[data-in] > :nth-child(2) { transition-delay: 0.2s; }
		.drone-chapter[data-live] :is(#prologue, #stakes)[data-in] > :nth-child(3) { transition-delay: 0.45s; }
		.drone-chapter[data-live] :is(#prologue, #stakes)[data-in] > :nth-child(4) { transition-delay: 0.7s; }
		.drone-chapter[data-live] .chapter-rise {
			translate: 0 16vh;
			scale: 0.92;
			filter: brightness(0);
			transition:
				translate 1.8s cubic-bezier(0.16, 1, 0.3, 1),
				scale 1.8s cubic-bezier(0.16, 1, 0.3, 1),
				filter 2.2s cubic-bezier(0.33, 1, 0.68, 1);
		}
		.drone-chapter[data-live] #reveal[data-in] .chapter-rise {
			translate: 0 0;
			scale: 1;
			filter: none;
		}

		/* The chapter map: a dot per beat at the window's right edge, the current one lit; each is a link. */
		.drone-chapter:not([data-read]) .chapter-map {
			display: block;
			position: fixed;
			right: max(0.75rem, env(safe-area-inset-right));
			top: 50%;
			z-index: 30;
			translate: 0 -50%;
			padding: 0.5rem 0.3rem;
			border: 1px solid color-mix(in oklab, var(--foreground) 14%, transparent);
			border-radius: 999px;
			background: color-mix(in oklab, var(--background) 72%, transparent);
			-webkit-backdrop-filter: blur(10px);
			backdrop-filter: blur(10px);
		}
		.chapter-map ol {
			display: flex;
			flex-direction: column;
			gap: 0.15rem;
		}
		.chapter-map a {
			position: relative;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.2rem;
			padding: 0.4rem 0.35rem;
			border-radius: 999px;
			color: var(--muted-foreground);
			font: 600 0.68rem/1 ui-monospace, "Cascadia Mono", "SF Mono", Menlo, Consolas, monospace;
			text-decoration: none;
		}
		.chapter-map a:focus-visible {
			outline: 2px solid var(--ring);
			outline-offset: 2px;
		}
		.chapter-map-dot {
			width: 0.55rem;
			height: 0.55rem;
			border-radius: 50%;
			border: 1.5px solid currentColor;
			transition: background 0.3s, scale 0.3s;
		}
		.chapter-map a[aria-current] {
			color: var(--foreground);
		}
		.chapter-map a[aria-current] .chapter-map-dot {
			border-color: #1fb0d6;
			background: #1fb0d6;
			scale: 1.25;
		}
		/* The beat's name, beside its dot: the current one, and any you point at or move to. */
		.chapter-map-title {
			position: absolute;
			right: calc(100% + 0.6rem);
			top: 50%;
			translate: 6px -50%;
			padding: 0.4rem 0.65rem;
			border-radius: 999px;
			white-space: nowrap;
			background: color-mix(in oklab, var(--background) 86%, transparent);
			border: 1px solid color-mix(in oklab, var(--foreground) 14%, transparent);
			color: var(--foreground);
			font: 600 0.75rem/1 var(--font-sans, inherit);
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.25s, translate 0.25s;
		}
		.chapter-map a:is(:hover, :focus-visible) .chapter-map-title {
			opacity: 1;
			translate: 0 -50%;
		}
	</style>
</BaseLayout>
