---
import { getEntry } from "astro:content";
import { ArrowDown, ArrowRight, CircleCheck, CornerDownRight } from "lucide-react";
import BackLink from "@/components/BackLink.astro";
import { buttonVariants } from "@/components/ui/button";
import { backToWork } from "@/text/work";
import DroneIllustration from "@/components/DroneIllustration.astro";
import ContactSection from "@/components/ContactSection.astro";
import ModelViewer from "@/components/model-viewer";
import PartsTable from "@/components/parts-table";
import StatusTag from "@/components/StatusTag.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
// All the words on this page: src/text/projects/drone.ts (card on the Work page: src/text/projects/drone.md)
import { drone, dronePage as text, earlierWork, partGroups, roadmap, systems } from "@/text/projects/drone";
import { formatVnd } from "@/lib/format";
import { DataIcon } from "@/lib/icons";
import { cn } from "@/lib/utils";

const entry = (await getEntry("work", "drone"))!;

const groups = partGroups.map((g) => ({
	...g,
	subtotal: g.parts.reduce((sum, p) => sum + (p.price ?? 0), 0),
}));
const total = groups.reduce((sum, g) => sum + g.subtotal, 0);
const partCount = groups.reduce((sum, g) => sum + g.parts.length, 0);
---

<BaseLayout title={`${drone.name} | JPL Innovation`} description={entry.data.description}>
	<!-- Hero -->
	<header class="wrapper grid gap-10 pb-16 pt-6 md:pt-10 lg:grid-cols-[1.1fr_1fr] lg:items-center lg:gap-14 lg:pb-24">
		<div class="flex flex-col gap-6">
			<BackLink href="/work/">{backToWork}</BackLink>
			<div data-reveal><StatusTag>{drone.status}</StatusTag></div>
			<h1 data-reveal class="font-wide text-[clamp(2.8rem,8vw,6.25rem)] font-[900] leading-[0.94]">{drone.name}</h1>
			<p class="max-w-[56ch] text-lg" data-reveal data-reveal-delay="150">{drone.intro}</p>
			<dl class="grid grid-cols-2 gap-x-6 gap-y-5 border-t pt-6 sm:grid-cols-4" data-reveal-group>
				{
					drone.facts.map((f) => (
						<div class="flex flex-col gap-1">
							<dt class="flex items-center gap-1.5 text-sm text-muted-foreground">
								<DataIcon name={f.icon} className="size-4" />
								{f.label}
							</dt>
							<dd class="font-semibold">{f.value}</dd>
						</div>
					))
				}
			</dl>
			<!-- data-astro-reload: the guide is a standalone page, so load it fully instead of a client-side swap. -->
			<div class="flex flex-wrap items-center gap-x-4 gap-y-2" data-reveal>
				<a href={text.buildGuide.href} data-astro-reload class={buttonVariants({ variant: "signal", size: "lg" })}>{text.buildGuide.label}</a>
				<p class="max-w-[40ch] text-sm text-muted-foreground">{text.buildGuide.note}</p>
			</div>
		</div>
		<figure transition:name="project-drone" class="flex flex-col gap-4 rounded-xl border surface p-4 md:p-6" data-reveal>
			<ModelViewer
				client:visible
				model="drone"
				label={text.model3d.description}
				className="aspect-square w-full"
			>
				<div class="mx-auto w-full max-w-[22rem]"><DroneIllustration /></div>
			</ModelViewer>
			<figcaption class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm text-muted-foreground">
				<span class="flex items-center gap-2"><span class="h-1.5 w-5 rounded-full bg-alliance-red" aria-hidden="true"></span>{text.model3d.frontArms}</span>
				<span class="flex items-center gap-2"><span class="h-1.5 w-5 rounded-full bg-muted-foreground" aria-hidden="true"></span>{text.model3d.rearArms}</span>
				<span>{text.model3d.layoutNote}</span>
			</figcaption>
		</figure>
	</header>

	<!-- Progress -->
	<section class="wrapper flex flex-col gap-8 pb-24" aria-labelledby="progress-heading">
		<h2 data-reveal id="progress-heading" class="font-wide text-[clamp(2rem,4.5vw,3.25rem)] font-[850]">{text.progressHeading}</h2>
		<ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-6 lg:gap-5" data-reveal-group>
			{
				roadmap.map((step, i) => (
					<li class="flex flex-col gap-2">
						<span aria-hidden="true" class="mb-2 flex h-1.5 overflow-hidden rounded-full bg-foreground/15">
							{step.state !== "upcoming" && (
								<span
									data-draw
									data-reveal-delay={i * 150}
									class={cn("block w-full rounded-full", step.state === "done" ? "bg-foreground" : "bg-accent")}
								/>
							)}
						</span>
						<p class="flex items-center gap-2 text-sm font-medium text-muted-foreground">
							{text.stepLabel} {i + 1}
							{step.state === "done" && (
								<span class="inline-flex items-center gap-1 text-foreground">
									<CircleCheck className="size-4" aria-hidden="true" /> {text.doneTag}
								</span>
							)}
							{step.state === "current" && (
								<span class="rounded-sm bg-accent px-1.5 py-0.5 text-xs font-bold text-accent-foreground">{text.nowTag}</span>
							)}
						</p>
						<h3 class="font-semiwide text-lg font-[760]">{step.title}</h3>
						<p class="text-muted-foreground">{step.desc}</p>
					</li>
				))
			}
		</ol>
	</section>

	<!-- How it works -->
	<section class="border-y bg-card/70" aria-labelledby="systems-heading">
		<div class="wrapper flex flex-col gap-10 py-20 md:py-24">
			<div class="flex max-w-2xl flex-col gap-3" data-reveal>
				<h2 id="systems-heading" class="font-wide text-[clamp(2rem,4.5vw,3.25rem)] font-[850]">{text.systemsHeading}</h2>
				<p class="text-lg text-muted-foreground">{text.systemsIntro}</p>
			</div>
			<div class="flex flex-col gap-10">
				{
					systems.map((sys) => (
						<div class="flex flex-col gap-4 border-t pt-6">
							<h3 class="flex items-center gap-2.5 font-semiwide text-xl font-[780]">
								<DataIcon name={sys.icon} className="size-5" strokeWidth={1.75} />
								{sys.title}
							</h3>
							<ol class="flex flex-col gap-1 lg:flex-row lg:items-stretch lg:gap-0" data-reveal-group>
								{sys.steps.map((s, j) => (
									<li class="flex flex-col lg:flex-1 lg:flex-row lg:items-center">
										{j > 0 && (
											<span class="flex items-center gap-2 py-1.5 pl-4 text-xs text-muted-foreground lg:flex-col lg:justify-center lg:gap-0.5 lg:px-2 lg:py-0">
												<ArrowDown className="size-4 lg:hidden" aria-hidden="true" />
												<ArrowRight className="hidden size-4 lg:block" aria-hidden="true" />
												{"link" in s && s.link && <span class="lg:whitespace-nowrap">{s.link}</span>}
											</span>
										)}
										<span class="flex flex-1 flex-col rounded-lg border bg-background px-4 py-3">
											<strong class="font-semibold">{s.name}</strong>
											<small class="text-sm text-muted-foreground">{s.detail}</small>
										</span>
									</li>
								))}
							</ol>
							{"branch" in sys && sys.branch && (
								<div class="flex flex-col gap-2 pl-4 lg:pl-8">
									<p class="flex items-center gap-2 text-sm text-muted-foreground">
										<CornerDownRight className="size-4" aria-hidden="true" /> {text.branchPrefix} {sys.branch.from}
									</p>
									<ol class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-0" data-reveal-group>
										{sys.branch.steps.map((s, j) => (
											<li class="flex flex-col sm:flex-row sm:items-center">
												{j > 0 && (
													<span class="py-1.5 pl-4 text-muted-foreground sm:px-2 sm:py-0" aria-hidden="true">
														<ArrowDown className="size-4 sm:hidden" />
														<ArrowRight className="hidden size-4 sm:block" />
													</span>
												)}
												<span class="flex flex-col rounded-lg border bg-background px-4 py-3">
													<strong class="font-semibold">{s.name}</strong>
													<small class="text-sm text-muted-foreground">{s.detail}</small>
												</span>
											</li>
										))}
									</ol>
								</div>
							)}
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Parts & budget -->
	<section id="parts" class="wrapper flex flex-col gap-10 py-20 md:py-24" aria-labelledby="parts-heading">
		<h2 data-reveal id="parts-heading" class="font-wide text-[clamp(2rem,4.5vw,3.25rem)] font-[850]">{partCount} {text.partsHeadingSuffix}</h2>

		<figure class="grid gap-8 rounded-xl border surface p-6 md:grid-cols-[1fr_1.4fr] md:p-8" data-reveal>
			<div class="flex flex-col gap-2">
				<p class="text-sm text-muted-foreground">{text.totalLabel}</p>
				<p class="font-wide text-[clamp(2.2rem,5vw,3.25rem)] font-[880] leading-none tabular-nums" data-count={total} data-count-format="vnd">{formatVnd(total)}</p>
				<figcaption class="text-sm text-muted-foreground">
					{text.totalNote}
				</figcaption>
			</div>
			<div class="flex flex-col gap-5">
				<!-- Share of the budget per group; exact values are in the legend and the tables below. -->
				<div class="flex h-4 gap-[2px]" aria-hidden="true" data-draw data-draw-duration="1.4">
					{
						groups.map((g) => (
							<span
								class="rounded-[4px]"
								title={`${g.title}: ${formatVnd(g.subtotal)}`}
								style={`flex-grow: ${g.subtotal}; background: ${g.color}`}
							/>
						))
					}
				</div>
				<ul class="grid gap-3 sm:grid-cols-2">
					{
						groups.map((g) => (
							<li class="flex items-start gap-3">
								<span class="mt-1.5 size-3 shrink-0 rounded-[3px]" style={`background: ${g.color}`} aria-hidden="true" />
								<span class="flex flex-col">
									<span class="font-medium">{g.title}</span>
									<span class="text-sm tabular-nums text-muted-foreground">
										{formatVnd(g.subtotal)}, {Math.round((g.subtotal / total) * 100)}%
									</span>
								</span>
							</li>
						))
					}
				</ul>
			</div>
		</figure>

		<div class="flex flex-col gap-12">
			{
				groups.map((g) => (
					<section aria-labelledby={`group-${g.id}`} class="flex flex-col gap-3" data-reveal>
						<h3 id={`group-${g.id}`} class="flex items-center gap-2.5 font-semiwide text-xl font-[780]">
							<span class="size-3 rounded-[3px]" style={`background: ${g.color}`} aria-hidden="true" />
							{g.title}
						</h3>
						<PartsTable caption={`${g.title} ${text.table.captionSuffix}`} parts={g.parts} subtotal={g.subtotal} />
					</section>
				))
			}
		</div>
	</section>

	<!-- Earlier work -->
	<section class="border-t bg-card/70" aria-labelledby="earlier-heading">
		<div class="wrapper grid gap-8 py-20 md:grid-cols-[1fr_1.2fr] md:gap-14 md:py-24">
			<div class="flex flex-col gap-3" data-reveal>
				<p class="text-sm text-muted-foreground">{text.earlierLabel} {earlierWork.date}</p>
				<h2 id="earlier-heading" class="font-wide text-3xl font-[850] md:text-4xl">{earlierWork.title}</h2>
				<p class="text-lg">{earlierWork.summary}</p>
			</div>
			<ul class="flex flex-col" data-reveal-group>
				{
					earlierWork.points.map((p) => (
						<li class="flex gap-3 border-t py-4">
							<CircleCheck className="mt-0.5 size-5 shrink-0" aria-hidden="true" />
							{p}
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<ContactSection />
</BaseLayout>
