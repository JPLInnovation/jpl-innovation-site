---
import ContactSection from "@/components/ContactSection.astro";
import Leadership from "@/components/Leadership.astro";
import MemberList from "@/components/MemberList.astro";
import ModelViewer from "@/components/model-viewer";
import PageIntro from "@/components/PageIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMembers, toBadge } from "@/lib/content";
import { srcset } from "@/lib/images";
// Words: src/text/members.ts (people: src/text/members/*.md)
import { membersPage } from "@/text/members";

const members = await getMembers();
const badges = members.map(toBadge);
---

<BaseLayout title={membersPage.seoTitle} description={membersPage.seoDescription}>
	<PageIntro title={membersPage.title} lede={membersPage.lede} />

	<section class="wrapper pb-14 md:pb-20">
		<Leadership lead="jpl" heading={membersPage.leadershipHeading} intro={membersPage.leadershipIntro} />
	</section>

	<section class="wrapper pb-14 md:pb-20" aria-labelledby="badges-heading">
		<h2 id="badges-heading" class="sr-only">Member badges in 3D</h2>
		<div class="overflow-hidden rounded-xl border surface" data-reveal>
			<ModelViewer
				client:visible
				model="badges"
				options={{ members: badges, mode: "row" }}
				label={`3D ID badges for ${members.map((m) => m.data.title).join(" and ")}, hanging on JPL Innovation lanyards.`}
				className="aspect-[4/3] w-full sm:aspect-[16/8]"
			>
				<div class="flex h-full items-center justify-center gap-6 p-8">
					{members.map((m) => <img src={m.data.img} srcset={srcset(m.data.img)} sizes="(min-width: 640px) 360px, 45vw" alt="" class="h-3/4 w-auto rounded-xl object-cover shadow-sm" loading="lazy" />)}
				</div>
			</ModelViewer>
		</div>
		<p class="mt-3 text-sm text-muted-foreground">{membersPage.badgesHint}</p>
	</section>

	<section class="wrapper pb-20 md:pb-28">
		<MemberList members={members} headingLevel="h2" />
	</section>
	<ContactSection />
</BaseLayout>
