---
import CrewSheet from "@/components/members/CrewSheet.astro";
import ModelViewer from "@/components/model-viewer";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMembers, toBadge } from "@/lib/content";
import { srcset } from "@/lib/images";
// Words: src/text/members.ts (people: src/text/members/*.md)
import { membersPage } from "@/text/members";

const members = await getMembers();
const badges = members.map(toBadge);
---

<BaseLayout title={membersPage.seoTitle} description={membersPage.seoDescription}>
	<div class="crew-wrap" data-reveal>
		<CrewSheet />
	</div>

	<section class="wrapper badges" aria-labelledby="badges-heading">
		<h2 id="badges-heading" class="badges__title">{membersPage.badgesHeading}</h2>
		<div class="badges__plate">
			<ModelViewer
				client:visible
				model="badges"
				options={{ members: badges, mode: "row" }}
				label={`3D ID badges for ${members.map((m) => m.data.title).join(" and ")}, hanging on JPL Innovation lanyards.`}
				className="aspect-[4/3] w-full sm:aspect-[16/8]"
			>
				<div class="flex h-full items-center justify-center gap-6 p-8">
					{members.map((m) => <img src={m.data.img} srcset={srcset(m.data.img)} sizes="(min-width: 640px) 360px, 45vw" alt="" class="h-3/4 w-auto rounded-xl object-cover" loading="lazy" />)}
				</div>
			</ModelViewer>
		</div>
		<p class="badges__hint">{membersPage.badgesHint}</p>
	</section>

</BaseLayout>

<style>
	.crew-wrap {
		width: 100%;
		max-width: 92rem;
		margin-inline: auto;
		padding: clamp(1rem, 2.5vw, 2rem) clamp(1rem, 2.5vw, 2.5rem) 0;
	}
	.badges {
		padding-top: clamp(4rem, 9vw, 8rem);
		padding-bottom: clamp(4rem, 9vw, 8rem);
	}
	.badges__title {
		font-size: var(--step-lead);
		font-weight: 760;
		font-stretch: 112%;
		margin-bottom: 1.25rem;
	}
	.badges__plate {
		overflow: hidden;
		border-radius: 1.5rem;
		border: 1px solid var(--sheet-edge);
	}
	.badges__hint {
		margin-top: 0.75rem;
		font-size: var(--step-small);
		color: var(--ink-soft);
	}
</style>
