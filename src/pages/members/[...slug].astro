---
import { type CollectionEntry, getCollection } from "astro:content";
import BackLink from "@/components/BackLink.astro";
import Toolkit from "@/components/members/Toolkit.astro";
import VietnamMap from "@/components/members/VietnamMap.astro";
import ModelViewer from "@/components/model-viewer";
import TitleBlock from "@/components/TitleBlock.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { leadershipRoles, roleLine, toBadge } from "@/lib/content";
import { srcset } from "@/lib/images";
// Headings: src/text/members.ts. This person's details: src/text/members/<name>.md
import { memberPage } from "@/text/members";

interface Props {
	entry: CollectionEntry<"members">;
}

export async function getStaticPaths() {
	const members = await getCollection("members");
	return members.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;

// Search snippet: name and roles first, so each member's description is distinct (the bios start alike).
const roles = roleLine(entry);
const seoDescription = `${data.title}${roles ? ` (${roles})` : ""}: ${data.description.trim()}`;

// The name at full width: sized from its letters (the longest word on a phone, where it wraps).
const words = data.title.split(/\s+/);
const nameFit = `--chars:${data.title.length};--word:${Math.max(...words.map((w) => w.length))}`;
const firstName = words[0];

// The title block: the roles at each organisation and the one fun true figure if there is one.
const block = [
	...leadershipRoles(entry).map((r) => ({ label: r.org, value: r.title })),
	...(data.fun_fact ? [{ label: data.fun_fact.label, value: data.fun_fact.value }] : []),
];
const places = data.places ?? [];
const path = data.path ?? [];
const achievements = (data.achievements ?? []).map((a) => (typeof a === "string" ? { title: a, result: "" } : a));
// The story as plain paragraphs, so each can light up word by word (src/scripts/motion.ts, data-words).
const story = (entry.body ?? "")
	.split(/\n\s*\n/)
	.map((p) => p.replace(/\s+/g, " ").trim())
	.filter(Boolean);
---

<BaseLayout title={`${data.title} | JPL Innovation`} description={seoDescription}>
	<div class="wrapper pt-6 md:pt-10">
		<BackLink href="/members/">{memberPage.backLink}</BackLink>
	</div>

	<header class="hero" data-reveal>
		{data.greeting && <p class="hero__hello">{data.greeting}</p>}
		<h1 class="hero__name living" style={nameFit} data-name-fit>
			{
				words.map((w, i) => (
					<>
						{i > 0 && " "}
						<span>{w}</span>
					</>
				))
			}
		</h1>
	</header>

	<section class="wrapper intro" aria-label={data.title}>
		<div class="intro__portrait">
			<ModelViewer
				client:visible
				model="badges"
				options={{ members: [toBadge(entry)], mode: "single" }}
				label={`${data.title}'s 3D member badge: photo, name and roles on the front, technical skills on the back.`}
				className="aspect-[4/5] w-full"
			>
				<img
					src={data.img}
					srcset={srcset(data.img)}
					sizes="(min-width: 768px) 22rem, 90vw"
					transition:name={`member-${entry.id}`}
					alt={data.img_alt ?? ""}
					class="size-full object-cover object-top"
				/>
			</ModelViewer>
		</div>
		<div class="intro__text">
			<p class="intro__desc">{data.description}</p>
			<p class="intro__tags">
				<span class="sr-only">{memberPage.rolesLabel}: </span>
				{data.tags.join(" · ")}
			</p>
			{block.length > 0 && <TitleBlock rows={block} label={memberPage.titleBlockLabel} wide={block.length === 3} />}
		</div>
	</section>

	{
		places.length > 0 && (
			<div class="wrapper block">
			<section class="map sheet lens" aria-labelledby="map-heading">
				<div class="map__drawing">
					<VietnamMap places={places} path={path} />
				</div>
				<div class="map__key">
					<h2 id="map-heading" class="title">
						{memberPage.mapHeading}
					</h2>
					<ul class="map__places" role="list">
						{places.map((p) => (
							<li>
								<span class="map__place">{p.name}</span>
								{p.note && <span class="map__note">{p.note}</span>}
							</li>
						))}
					</ul>
					{path.length > 0 && (
						<>
							<h3 class="map__pathhead">{memberPage.pathHeading}</h3>
							<ol class="map__path">
								{path.map((stop) => (
									<li>{stop}</li>
								))}
							</ol>
						</>
					)}
				</div>
			</section>
			</div>
		)
	}

	<section class="wrapper block" aria-labelledby="skills-heading">
		<h2 id="skills-heading" class="title">{memberPage.skillsHeading}</h2>
		<Toolkit skills={data.technical_skills} labelledby="skills-heading" />
	</section>

	{
		(achievements.length > 0 || (data.sports?.length ?? 0) > 0) && (
			<div class="wrapper block record">
				{achievements.length > 0 && (
					<section aria-labelledby="achievements-heading">
						<h2 id="achievements-heading" class="title">
							{memberPage.achievementsHeading}
						</h2>
						<table class="parts">
							<thead>
								<tr>
									<th scope="col">{memberPage.achievementsColumns[0]}</th>
									<th scope="col">{memberPage.achievementsColumns[1]}</th>
								</tr>
							</thead>
							<tbody>
								{achievements.map((a) => (
									<tr>
										<td>{a.title}</td>
										<td>{a.result}</td>
									</tr>
								))}
							</tbody>
						</table>
					</section>
				)}
				{data.sports?.length && (
					<section class="sports" aria-labelledby="sports-heading">
						<h2 id="sports-heading" class="sports__title">
							{memberPage.sportsHeading}
						</h2>
						<ul role="list">
							{data.sports.map((s) => (
								<li>
									<span class="sports__sport">{s.sport}</span>
									<span class="sports__team">{s.team}</span>
								</li>
							))}
						</ul>
					</section>
				)}
			</div>
		)
	}

	<article class="wrapper block story" aria-labelledby="story-heading">
		<h2 id="story-heading" class="title">{memberPage.storyHeading}</h2>
		<div class="story__text">
			{story.map((p) => <p data-words>{p}</p>)}
		</div>
		<p class="story__sign" aria-hidden="true">{firstName}</p>
	</article>

</BaseLayout>

<script>
	// The name at full width, exactly: one line on a wide screen, its longest word across a phone. Measured once on
	// load and again only when the width changes.
	const MAX = 240; // 15rem, the type scale's ceiling
	let watch: ResizeObserver | undefined;
	function fit(h: HTMLElement) {
		const wide = getComputedStyle(h).whiteSpace === "nowrap";
		const spans = [...h.querySelectorAll("span")];
		const range = document.createRange();
		range.selectNodeContents(h);
		const measured = wide ? range.getBoundingClientRect().width : Math.max(...spans.map((s) => s.getBoundingClientRect().width));
		if (!measured) return;
		const size = parseFloat(getComputedStyle(h).fontSize);
		h.style.fontSize = `${Math.min(MAX, (size * h.clientWidth) / measured).toFixed(2)}px`;
	}
	document.addEventListener("astro:page-load", () => {
		watch?.disconnect();
		const h = document.querySelector<HTMLElement>("[data-name-fit]");
		if (!h) return;
		let width = 0;
		watch = new ResizeObserver(([entry]) => {
			if (Math.abs(entry.contentRect.width - width) < 1) return;
			width = entry.contentRect.width;
			h.style.fontSize = "";
			fit(h);
		});
		document.fonts.ready.then(() => watch?.observe(h.parentElement!));
	});
</script>

<style>
	/* the greeting, then the name across the whole sheet */
	.hero {
		container-type: inline-size;
		padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 2.5vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem);
		max-width: 92rem;
		margin-inline: auto;
	}
	.hero__hello {
		font-size: var(--step-lead);
		color: var(--ink-soft);
		margin-bottom: 0.4rem;
	}
	.hero__name {
		/* a first guess from the letters (Archivo here runs 0.67 to 0.8 em a letter); the script below makes it exact */
		font-size: min(15rem, calc(100cqi / (var(--chars) * 0.75)));
		font-weight: 860;
		font-stretch: 125%;
		line-height: 0.88;
		letter-spacing: -0.04em;
		white-space: nowrap;
	}
	@container (width < 40rem) {
		.hero__name {
			white-space: normal;
			font-size: calc(100cqi / (var(--word) * 0.82));
		}
	}

	.intro {
		display: grid;
		gap: clamp(1.5rem, 4vw, 3.5rem);
		align-items: start;
	}
	@media (min-width: 768px) {
		.intro {
			grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
		}
	}
	.intro__portrait {
		width: 100%;
		max-width: 20rem;
		overflow: hidden;
		border-radius: 1.5rem;
		background: var(--field-2);
	}
	.intro__text {
		display: grid;
		gap: 1.25rem;
	}
	.intro__tags {
		color: var(--ink-soft);
		margin-bottom: 0.75rem;
	}
	.intro__desc {
		font-size: var(--step-lead);
		line-height: 1.4;
		max-width: 40ch;
		text-wrap: pretty;
	}

	.title {
		font-size: var(--step-head);
		font-weight: 800;
		font-stretch: 125%;
		line-height: 0.95;
		letter-spacing: -0.03em;
		margin-bottom: clamp(1.25rem, 3vw, 2rem);
		text-wrap: balance;
	}
	.block {
		padding-top: clamp(4rem, 9vw, 7.5rem);
	}

	/* the map sheet */
	.map {
		display: grid;
		gap: 2rem;
		border-radius: 2rem;
		padding: clamp(1.25rem, 3vw, 2.5rem);
	}
	@media (min-width: 900px) {
		.map {
			grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
			align-items: center;
		}
	}
	.map__drawing {
		max-width: 36rem;
		width: 100%;
		margin-inline: auto;
		padding-inline: clamp(2.25rem, 6vw, 3rem) clamp(0.5rem, 4vw, 3rem);
	}
	.map__places,
	.map__path {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.map__places li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 0.75rem;
		padding: 0.6rem 0;
		border-top: 1px solid var(--sheet-edge);
	}
	.map__place {
		font-size: var(--step-lead);
		font-weight: 700;
		font-stretch: 112%;
	}
	.map__note {
		color: var(--ink-soft);
	}
	.map__pathhead {
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		font-size: var(--step-body);
		font-weight: 700;
	}
	.map__path {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 0;
		font-size: var(--step-lead);
		font-weight: 650;
		line-height: 1.3;
	}
	.map__path li:not(:last-child)::after {
		content: "→";
		margin-inline: 0.55rem;
		color: var(--accent-brand);
	}

	/* achievements: a parts list */
	.record {
		display: grid;
		gap: clamp(3rem, 6vw, 4rem);
	}
	@media (min-width: 900px) {
		.record {
			grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
			align-items: start;
		}
	}
	.parts {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--step-body);
	}
	.parts th {
		text-align: left;
		font-size: var(--step-small);
		font-weight: 600;
		color: var(--ink-soft);
		padding: 0 1rem 0.6rem 0;
		border-bottom: 1px solid color-mix(in oklab, var(--ink) 55%, transparent);
	}
	.parts td {
		padding: 0.9rem 1rem 0.9rem 0;
		border-bottom: 1px solid var(--sheet-edge);
		vertical-align: top;
		text-wrap: pretty;
	}
	.parts td:last-child,
	.parts th:last-child {
		padding-right: 0;
		white-space: nowrap;
	}
	.parts td:last-child {
		font-weight: 650;
	}

	/* sports: their own panel, the sheet turned over (paper on dark, navy on light) */
	.sports {
		border-radius: 1.75rem;
		padding: clamp(1.5rem, 3vw, 2.25rem);
		background: var(--ink);
		color: var(--field);
		container-type: inline-size;
	}
	.sports__title {
		font-size: var(--step-body);
		font-weight: 700;
		margin-bottom: 1rem;
	}
	.sports ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.sports li {
		display: grid;
		padding: 0.9rem 0;
		border-top: 1px solid color-mix(in oklab, var(--field) 22%, transparent);
	}
	.sports__sport {
		/* the head step, held to the panel's width so a long sport ("Badminton") stays inside */
		font-size: min(var(--step-head), 12.5cqi);
		overflow-wrap: anywhere;
		font-weight: 820;
		font-stretch: 125%;
		line-height: 1;
		letter-spacing: -0.03em;
	}
	.sports__team {
		margin-top: 0.35rem;
	}

	/* the story, lit word by word, signed at the end */
	.story {
		padding-bottom: clamp(4rem, 9vw, 7.5rem);
	}
	@media (min-width: 900px) {
		.story {
			display: grid;
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.9fr);
			column-gap: clamp(2rem, 5vw, 5rem);
		}
		.story .title {
			position: sticky;
			top: 7rem;
			align-self: start;
			grid-row: span 2;
		}
	}
	.story__text {
		display: grid;
		gap: 1.25em;
		max-width: 44ch;
		font-size: var(--step-lead);
		line-height: 1.45;
	}
	.story__sign {
		margin-top: 2rem;
		font-family: "Caveat", cursive;
		font-weight: 600;
		font-size: var(--step-head);
		line-height: 1;
		color: var(--accent-brand);
		rotate: -5deg;
		width: fit-content;
	}
</style>
