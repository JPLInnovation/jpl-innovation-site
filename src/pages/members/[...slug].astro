---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BackLink from "@/components/BackLink.astro";
import ContactSection from "@/components/ContactSection.astro";
import ModelViewer from "@/components/model-viewer";
import { badgeVariants } from "@/components/ui/badge";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { leadershipRoles, roleLine, toBadge } from "@/lib/content";
import { srcset } from "@/lib/images";
import { cn } from "@/lib/utils";
import { Trophy } from "lucide-react";
// Headings: src/text/members.ts. This person's details: src/text/members/<name>.md
import { memberPage } from "@/text/members";

interface Props {
	entry: CollectionEntry<"members">;
}

export async function getStaticPaths() {
	const members = await getCollection("members");
	return members.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

/** Skill levels as a 3-step scale; unknown levels show just the label. */
const levels: Record<string, number> = { Developing: 1, Proficient: 2, Advanced: 3 };

// Search snippet: name and roles first, so each member's description is distinct (the bios start alike).
const roles = roleLine(entry);
const seoDescription = `${data.title}${roles ? ` (${roles})` : ""}: ${data.description.trim()}`;
---

<BaseLayout title={`${data.title} | JPL Innovation`} description={seoDescription}>
	<div class="wrapper pt-6 md:pt-10">
		<BackLink href="/members/">{memberPage.backLink}</BackLink>
	</div>

	<header class="wrapper grid gap-8 pb-14 pt-4 md:grid-cols-[minmax(0,17rem)_1fr] md:gap-14 md:pb-20">
		<div class="w-full max-w-[17rem]" data-reveal>
			<ModelViewer
				client:visible
				model="badges"
				options={{ members: [toBadge(entry)], mode: "single" }}
				label={`${data.title}'s 3D member badge: photo, name and roles on the front, technical skills on the back.`}
				className="aspect-[4/5] w-full"
			>
				<img
					src={data.img}
					srcset={srcset(data.img)}
					sizes="272px"
					transition:name={`member-${entry.id}`}
					alt={data.img_alt ?? ""}
					class="size-full rounded-xl bg-muted object-cover object-top"
				/>
			</ModelViewer>
		</div>
		<div class="flex flex-col gap-5 md:pt-6" data-reveal-group>
			<h1 class="font-wide text-[clamp(2.4rem,6vw,4.75rem)] font-[880] leading-[0.98]">{data.title}</h1>
			{
				data.leadership && (
					<ul class="flex flex-col gap-1 text-lg" aria-label="Leadership roles">
						{leadershipRoles(entry).map((r) => (
							<li>
								<span class="font-semibold">{r.title}</span>
								<span class="text-muted-foreground"> · {r.org}</span>
							</li>
						))}
					</ul>
				)
			}
			<p class="max-w-[54ch] text-lg md:text-xl">{data.description}</p>
			<ul class="flex flex-wrap gap-2" aria-label="Roles">
				{data.tags.map((t) => <li class={cn(badgeVariants({ variant: "secondary" }), "px-2.5 py-1 text-[13px]")}>{t}</li>)}
			</ul>
		</div>
	</header>

	<section class="border-y bg-card/70" aria-labelledby="skills-heading">
		<div class="wrapper py-14 md:py-20">
			<h2 data-reveal id="skills-heading" class="mb-8 font-wide text-3xl font-[850] md:text-4xl">{memberPage.skillsHeading}</h2>
			<ul class="grid gap-x-10 md:grid-cols-2" data-reveal-group>
				{
					data.technical_skills.map((s) => {
						const level = levels[s.level];
						return (
							<li class="flex flex-col gap-2 border-t py-5">
								<div class="flex items-center justify-between gap-4">
									<h3 class="font-semiwide text-xl font-[760]">{s.title}</h3>
									<span class="flex items-center gap-2.5 text-sm text-muted-foreground">
										{s.level}
										{level && (
											<span class="flex gap-1" aria-hidden="true">
												{[1, 2, 3].map((n) => (
													<span class={cn("h-2 w-5 rounded-full", n <= level ? "bg-foreground" : "bg-foreground/15")} />
												))}
											</span>
										)}
									</span>
								</div>
								<p class="text-muted-foreground">{s.description}</p>
							</li>
						);
					})
				}
			</ul>
		</div>
	</section>

	{
		(data.achievements?.length || data.sports?.length) && (
			<section class="wrapper grid gap-12 pt-14 md:grid-cols-2 md:gap-16 md:pt-20">
				{data.achievements?.length && (
					<div class="flex flex-col gap-6" aria-labelledby="achievements-heading">
						<h2 data-reveal id="achievements-heading" class="font-wide text-3xl font-[850] md:text-4xl">{memberPage.achievementsHeading}</h2>
						<ul class="flex flex-col" data-reveal-group>
							{data.achievements.map((a) => (
								<li class="flex gap-3 border-t py-4 text-lg">
									<Trophy className="mt-1 size-5 shrink-0 text-primary dark:text-accent" strokeWidth={1.75} aria-hidden="true" />
									{a}
								</li>
							))}
						</ul>
					</div>
				)}
				{data.sports?.length && (
					<div class="flex flex-col gap-6" aria-labelledby="sports-heading">
						<h2 data-reveal id="sports-heading" class="font-wide text-3xl font-[850] md:text-4xl">{memberPage.sportsHeading}</h2>
						<ul class="flex flex-col" data-reveal-group>
							{data.sports.map((s) => (
								<li class="flex items-baseline justify-between gap-4 border-t py-4 text-lg">
									<span class="font-semibold">{s.sport}</span>
									<span class="text-muted-foreground">{s.team}</span>
								</li>
							))}
						</ul>
					</div>
				)}
			</section>
		)
	}

	<article class="wrapper py-16 md:py-24" aria-labelledby="story-heading">
		<h2 data-reveal id="story-heading" class="mb-6 font-wide text-3xl font-[850] md:text-4xl">{memberPage.storyHeading}</h2>
		<div class="prose prose-lg prose-site max-w-[65ch]" data-reveal>
			<Content />
		</div>
	</article>

	<ContactSection />
</BaseLayout>
