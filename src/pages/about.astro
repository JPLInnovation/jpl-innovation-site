---
import { ArrowRight } from "lucide-react";
import ContactSection from "@/components/ContactSection.astro";
import Leadership from "@/components/Leadership.astro";
import PageIntro from "@/components/PageIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects } from "@/lib/content";
import { srcset } from "@/lib/images";
import { cn } from "@/lib/utils";
// Words: src/text/about.ts (the team: src/text/members/*.md; the contact box: src/text/site.ts)
import { aboutPage, focus, story, team, values } from "@/text/about";

// Cards show and link to project pages that exist (src/text/projects/*.md).
const projects = new Map((await getProjects()).map((p) => [p.id, p]));

const sectionHeading = "font-wide text-3xl font-[850] md:text-4xl";
---

<BaseLayout title={aboutPage.seoTitle} description={aboutPage.seoDescription}>
	<PageIntro title={aboutPage.title} lede={aboutPage.lede} />

	<!-- Our story. Reading text, so no entrance motion; the heading stays beside it on wide screens. -->
	<section class="border-t" aria-labelledby="story-heading">
		<div class="wrapper grid gap-8 py-16 md:grid-cols-[1fr_1.6fr] md:gap-16 md:py-24">
			<h2 id="story-heading" class={cn(sectionHeading, "md:sticky md:top-28 md:self-start")}>{story.heading}</h2>
			<div class="flex max-w-[65ch] flex-col gap-5 text-lg">
				{
					story.paragraphs.map((p, i) => (
						<p class={cn(i === story.paragraphs.length - 1 ? "font-semiwide text-xl font-[760]" : "text-muted-foreground")}>
							{p}
						</p>
					))
				}
			</div>
		</div>
	</section>

	<!-- What we work on: each project's own picture, linking to its page -->
	<section class="border-t bg-card/70" aria-labelledby="focus-heading">
		<div class="wrapper py-16 md:py-24">
			<div class="mb-10 flex max-w-2xl flex-col gap-2">
				<h2 id="focus-heading" class={sectionHeading}>{focus.heading}</h2>
				<p class="text-lg text-muted-foreground">{focus.intro}</p>
			</div>
			<ul class="grid gap-5 lg:grid-cols-3" data-reveal>
				{
					focus.areas.map((a) => {
						const project = projects.get(a.project);
						return (
							<li
								class={cn(
									"relative flex flex-col overflow-hidden rounded-xl border surface md:flex-row lg:flex-col",
									project && "press group transition-[transform,box-shadow] duration-300 hover:-translate-y-0.5 hover:shadow-[var(--shadow-lift)]",
								)}
							>
								{project && (
									<img
										src={project.data.img}
										srcset={srcset(project.data.img)}
										sizes="(min-width: 1024px) 380px, (min-width: 768px) 280px, 100vw"
										alt=""
										loading="lazy"
										class="aspect-[16/10] w-full shrink-0 bg-muted object-cover md:w-2/5 lg:w-full"
									/>
								)}
								<div class="flex flex-1 flex-col gap-3 p-6 md:p-7">
									<h3 class="font-semiwide text-xl font-[760]">{a.title}</h3>
									<p class="text-muted-foreground">{a.desc}</p>
									{project && (
										// The whole card is clickable through this link's ::after.
										<a
											href={`/work/${project.id}/`}
											class="mt-auto inline-flex min-h-11 w-fit items-center gap-2 font-semibold underline-offset-4 transition-[gap] after:absolute after:inset-0 after:rounded-xl group-hover:gap-3 group-hover:underline"
										>
											{focus.linkPrefix} {project.data.title}
											<ArrowRight className="size-4" aria-hidden="true" />
										</a>
									)}
								</div>
							</li>
						);
					})
				}
			</ul>
		</div>
	</section>

	<!-- The team: names, titles and profile links from src/text/members/*.md -->
	<section class="wrapper py-16 md:py-24" aria-labelledby="team-heading">
		<Leadership lead="jpl" heading={team.heading} intro={team.intro} id="team" />
	</section>

	<!-- What we believe. Same 2 px rule as the home page timeline. -->
	<section class="border-t bg-card/70" aria-labelledby="values-heading">
		<div class="wrapper py-16 md:py-24">
			<h2 id="values-heading" class={cn(sectionHeading, "mb-10")}>{values.heading}</h2>
			<ul class="grid gap-10 md:grid-cols-3 md:gap-8">
				{
					values.items.map((v) => (
						<li class="flex flex-col gap-3 border-t-2 border-foreground pt-6">
							<h3 class="font-semiwide text-xl font-[760]">{v.title}</h3>
							<p class="text-muted-foreground">{v.desc}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<ContactSection />
</BaseLayout>
