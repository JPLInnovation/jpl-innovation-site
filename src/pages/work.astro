---
import ContactSection from "@/components/ContactSection.astro";
import ProjectList from "@/components/ProjectList.astro";
import WorkWall from "@/components/WorkWall.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects } from "@/lib/content";
// Words: src/text/work.ts
import { workPage, workWall } from "@/text/work";

const projects = await getProjects();
---

<BaseLayout title={workPage.seoTitle} description={workPage.seoDescription}>
	<!-- The wall (3D, pinned while you scroll along it) or, in read mode, the heading; then the plain list of the same projects. -->
	<WorkWall projects={projects} />
	<section class="wrapper pb-20 pt-16 md:pb-28 md:pt-24" aria-labelledby="all-projects-heading">
		<h2 id="all-projects-heading" class="all-projects-heading mb-6 font-wide text-[clamp(1.6rem,3vw,2.4rem)] font-[850]">{workWall.listHeading}</h2>
		<ProjectList projects={projects} headingLevel="h3" />
	</section>
	<ContactSection />
</BaseLayout>

<style is:global>
	/* In read mode the page starts with the plain heading and the list, so this heading would repeat it: kept for screen readers only. */
	[data-wall][data-read] ~ section .all-projects-heading {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	[data-wall][data-read] ~ section {
		padding-top: 0;
	}
</style>
