---
import WorkWall from "@/components/WorkWall.astro";
import Register from "@/components/work/Register.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects } from "@/lib/content";
// Words: src/text/work.ts
import { workPage } from "@/text/work";

const projects = await getProjects();
---

<BaseLayout title={workPage.seoTitle} description={workPage.seoDescription}>
	<!-- The wall (3D, pinned while you scroll along it) or, in classic mode, the sheet's name and its title block; then the register of the same projects, every link real HTML. -->
	<WorkWall projects={projects} />
	<Register projects={projects} />
</BaseLayout>
