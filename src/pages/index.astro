---
import { ArrowRight, ArrowUpRight, CircleCheck, Cog, CodeXml, Drone, NotebookPen, ShieldCheck } from "lucide-react";
import HomePortal from "@/components/home-portal";
import ContactSection from "@/components/ContactSection.astro";
import MemberList from "@/components/MemberList.astro";
import ProjectList from "@/components/ProjectList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
// All the words on this page: src/text/home.ts (the organization details for search engines: src/text/site.ts)
import { journey, mission, pageHeading, services, servicesSection, teamSection, workSection } from "@/text/home";
import { getMembers, getProjects } from "@/lib/content";
import { cn } from "@/lib/utils";
import { site } from "@/text/site";

const projects = await getProjects();
const members = await getMembers();

const serviceIcons = { cog: Cog, drone: Drone, shield: ShieldCheck, code: CodeXml };
const processIcons = { plan: NotebookPen, build: Cog, check: CircleCheck };

// Tells search engines who runs the site (schema.org Organization), from the same text as the footer.
const organization = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: site.name,
	url: new URL("/", Astro.site).href,
	logo: new URL("/assets/logo.jpg", Astro.site).href,
	email: site.email,
	description: site.description,
};
---

<BaseLayout>
	<script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(organization)} />
	<h1 class="sr-only">{pageHeading}</h1>

	<!-- Pulled up under the sticky header so the opening frame fills the screen. -->
	<div class="-mt-18">
		<HomePortal client:load />
	</div>

	<!-- Services: a numbered sheet, one row each. -->
	<!-- TODO: confirm services — placeholder copy, edit in src/text/home.ts -->
	<section id="services" class="wrapper py-24 md:py-32" aria-labelledby="services-heading">
		<div class="mb-12 grid gap-6 md:mb-16 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-end" data-reveal>
			<h2 id="services-heading" class="font-wide text-[clamp(2.25rem,5vw,4rem)] font-[850] leading-[0.98]">{servicesSection.heading}</h2>
			<p class="max-w-[46ch] text-lg text-muted-foreground md:justify-self-end">{servicesSection.intro}</p>
		</div>
		<ol class="border-t border-rule" data-reveal-group>
			{
				services.map((s, i) => {
					const Icon = serviceIcons[s.icon];
					const external = s.proof?.href.startsWith("http");
					return (
						<li class="service-row group relative grid gap-x-8 gap-y-3 border-b py-7 md:grid-cols-[3.5rem_minmax(0,1fr)_minmax(0,1.25fr)_minmax(0,0.8fr)] md:items-baseline md:py-9">
							<span class="spec text-sm text-muted-foreground" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
							<h3 class="flex items-center gap-3 font-semiwide text-xl font-[780] md:text-2xl">
								<Icon className="size-6 shrink-0 text-accent-ink" strokeWidth={1.75} aria-hidden="true" />
								{s.title}
							</h3>
							<p class="max-w-[52ch] text-muted-foreground">{s.desc}</p>
							{s.proof ? (
								<a
									href={s.proof.href}
									class="press inline-flex min-h-11 w-fit items-center gap-1.5 text-sm font-semibold underline decoration-accent decoration-2 underline-offset-4 md:justify-self-end"
									{...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
								>
									{servicesSection.linkPrefix} {s.proof.label}
									<ArrowUpRight className="size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true" />
								</a>
							) : (
								<span aria-hidden="true" />
							)}
						</li>
					);
				})
			}
		</ol>
	</section>

	<!-- Projects -->
	<section class="border-t bg-card" aria-labelledby="work-heading">
		<div class="wrapper py-24 md:py-32">
			<div class="mb-10 grid gap-6 md:mb-14 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:items-end" data-reveal>
				<h2 id="work-heading" class="font-wide text-[clamp(2.25rem,5vw,4rem)] font-[850] leading-[0.98]">{workSection.heading}</h2>
				<p class="max-w-[46ch] text-lg text-muted-foreground md:justify-self-end">{workSection.intro}</p>
			</div>
			<ProjectList projects={projects} />
		</div>
	</section>

	<!-- Mission -->
	<section class="border-y" aria-labelledby="mission-heading">
		<div class="wrapper flex flex-col gap-6 pb-16 pt-24 md:pb-24 md:pt-36">
			<h2 id="mission-heading" class="spec text-sm text-muted-foreground" data-reveal>{mission.label}</h2>
			<p data-words class="max-w-5xl font-wide text-[clamp(2rem,5vw,4.75rem)] font-[850] leading-[1.02] tracking-[-0.025em]">
				{mission.statement}
			</p>
		</div>
		<div class="wrapper grid gap-10 pb-16 md:grid-cols-[1fr_1.4fr] md:gap-16 md:pb-20">
			<h3 class="text-lg font-semibold" data-reveal>{mission.standardsHeading}</h3>
			<ul class="flex flex-col" data-reveal-group>
				{
					mission.standards.map((s) => (
						<li class="flex gap-3 border-t py-4">
							<CircleCheck className="mt-0.5 size-5 shrink-0 text-accent-ink" aria-hidden="true" />
							<span>{s}</span>
						</li>
					))
				}
			</ul>
		</div>
		<div class="wrapper pb-20 md:pb-28">
			<h3 class="mb-2 text-lg font-semibold" data-reveal>{mission.processHeading}</h3>
			<ol class="grid gap-10 border-t border-rule pt-10 md:grid-cols-3" data-reveal-group>
				{
					mission.process.map(({ icon, title, desc }, i) => {
						const StepIcon = processIcons[icon];
						return (
						<li class="flex flex-col gap-3">
							<span class="flex items-center gap-3">
								<StepIcon className="size-7" strokeWidth={1.75} aria-hidden="true" />
								<span class="spec text-sm text-muted-foreground">{mission.stepLabel} {String(i + 1).padStart(2, "0")}</span>
							</span>
							<h4 class="font-semiwide text-xl font-[760]">{title}</h4>
							<p class="text-muted-foreground">{desc}</p>
						</li>
						);
					})
				}
			</ol>
		</div>
	</section>

	<!-- Journey -->
	<section class="wrapper py-20 md:py-28" aria-labelledby="journey-heading">
		<h2 data-reveal id="journey-heading" class="mb-14 max-w-3xl font-wide text-[clamp(2.25rem,5vw,4rem)] font-[850] leading-[0.98]">
			{journey.heading}
		</h2>
		<div class="relative">
			<!-- Progress so far: draws from 2023 to the "Now" dot (4th of 6 columns). -->
			<span
				aria-hidden="true"
				data-draw
				data-draw-duration="1.6"
				class="absolute left-0 top-0 z-[1] hidden h-[3px] w-1/2 bg-accent lg:block"
			></span>
			<ol class="grid lg:grid-cols-6" data-reveal-group>
				{
					journey.milestones.map((m) => (
						<li
							class={cn(
								"relative border-l-2 pb-10 pl-7 lg:border-l-0 lg:border-t-2 lg:pb-0 lg:pl-0 lg:pr-6 lg:pt-8",
								m.state === "future" ? "border-dashed border-foreground/25" : "border-foreground",
							)}
						>
							<span
								aria-hidden="true"
								class={cn(
									"absolute -left-[9px] top-1 z-[2] size-4 rounded-full border-2 lg:-top-[9px] lg:left-0",
									m.state === "past" && "border-foreground bg-foreground",
									m.state === "now" && "border-foreground bg-marker ring-4 ring-marker/30",
									m.state === "future" && "border-foreground/40 bg-background",
								)}
							/>
							<p class="spec flex items-center gap-2 text-2xl font-medium">
								{m.year}
								{m.state === "now" && (
									<span class="rounded-sm bg-marker px-1.5 py-0.5 text-xs font-semibold text-marker-foreground">
										{journey.nowTag}
									</span>
								)}
							</p>
							<h3 class="mt-2 text-base font-semibold">{m.title}</h3>
							<p class="mt-1 text-sm text-muted-foreground">{m.desc}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<!-- Team -->
	<section class="border-t bg-card" aria-labelledby="team-heading">
		<div class="wrapper py-24 md:py-32">
			<div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between" data-reveal>
				<div class="flex max-w-2xl flex-col gap-3">
					<h2 id="team-heading" class="font-wide text-[clamp(2.25rem,5vw,4rem)] font-[850] leading-[0.98]">{teamSection.heading}</h2>
					<p class="text-lg text-muted-foreground">{teamSection.intro}</p>
				</div>
				<a href="/members/" class="press inline-flex min-h-11 items-center gap-2 font-semibold">
					{teamSection.allMembersLink} <ArrowRight className="size-4" aria-hidden="true" />
				</a>
			</div>
			<MemberList members={members} />
		</div>
	</section>

	<ContactSection />
</BaseLayout>
