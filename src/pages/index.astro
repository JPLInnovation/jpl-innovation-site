---
/**
 * The home page: the studio (src/components/Studio.astro). One room, twelve camera stops, and the loop back to the
 * desk. Phones, reduced motion and read mode get the same text as one ordinary page, with a picture of each scene.
 *
 * All the words: src/text/home.ts and src/text/site.ts (the studio's own: src/text/studio.ts). The projects on the
 * wall come from src/text/projects/*.md, the people at the table from src/text/members/*.md.
 */
import { ArrowRight, ArrowUpRight } from "lucide-react";
import EmailButton from "@/components/EmailButton.astro";
import StatusTag from "@/components/StatusTag.astro";
import ClassicHome from "@/components/ClassicHome.astro";
import Studio from "@/components/Studio.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMembers, getProjects, toBadge } from "@/lib/content";
import { copyUpTo, srcset } from "@/lib/images";
import type { RoomContent } from "@/lib/studio/room";
import { HOME } from "@/lib/studio/scenes";
import { hero, hook, journey, mission, pageHeading, services, servicesSection, teamSection, workSection } from "@/text/home";
import { roadmap } from "@/text/projects/drone";
import { contact, displayDomain, footer, site, talk } from "@/text/site";
import { sketchText, studio } from "@/text/studio";

const projects = await getProjects();
const members = await getMembers();
const [plan, build, handOver] = mission.process;

// What the room itself shows.
const content: RoomContent = {
	projects: projects.map((p) => ({ title: p.data.title, img: copyUpTo(p.data.img, 1920), badge: p.data.badge, href: `/work/${p.id}/` })),
	portraits: members.map((m) => ({ name: m.data.title, role: toBadge(m).title ?? "", img: copyUpTo(m.data.img, 1280) })),
	standards: { heading: mission.standardsHeading, items: mission.standards, steps: mission.process.map((s) => s.title) },
	milestones: journey.milestones.map(({ year, state }) => ({ year, state })),
	sign: talk.label,
	slogan: site.slogan,
	domain: displayDomain,
	sketch: { text: sketchText, states: roadmap.map((step) => step.state) },
};

// The work stations, one per service, text on alternate sides.
const stations = ["robotics", "drones", "networks", "web"] as const;

/** Read mode's picture of a scene (scripts/studio-stills.py), 800 and 1600 wide. */
const still = (id: string) => ({
	src: `/studio/scenes/${id}-800.webp`,
	srcset: `/studio/scenes/${id}-800.webp 800w, /studio/scenes/${id}.webp 1600w`,
	sizes: "(min-width: 64rem) 36rem, 100vw",
});

// Tells search engines who runs the site (schema.org Organization), from the same text as the footer.
const organization = {
	"@context": "https://schema.org",
	"@type": "Organization",
	name: site.name,
	url: new URL("/", Astro.site).href,
	logo: new URL("/assets/logo.jpg", Astro.site).href,
	email: site.email,
	description: site.description,
};
---

<BaseLayout>
	<script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(organization)} />
	<!-- The studio (3D) and the classic home page. Only one shows: html.studio-on is set by Studio before the first paint
	     when the 3D will run; otherwise (Classic, Read mode, phones, reduced motion, no JavaScript) the classic page shows. -->
	<div class="studio-home">
	<Studio scenes={HOME} content={content} anchors={{ services: "robotics", work: "wall", team: "crew", contact: "contact" }}>
		<!-- 0 Title -->
		<section data-scene="title" data-place="center" class="studio-scene studio-title">
			<img class="studio-still" {...still("title")} alt="" loading="lazy" width="1600" height="900" />
			<p class="studio-kicker">{hero.kicker}</p>
			<h1 class="sr-only">{pageHeading}</h1>
			<p class="studio-lede">{hero.support}</p>
			<p class="studio-hint">{studio.scrollHint} <span aria-hidden="true">↓</span></p>
		</section>

		<!-- Why we exist: on the first visit to the studio, over the dark room before the lamp comes on (a short cut,
		     src/text/home.ts `hook.playLines`); otherwise, and for screen readers always, the full paragraph as text. -->
		<div class="studio-hook" data-studio-hook>
			<div class="studio-hook-inner">
				<h2>{hook.heading}</h2>
				<p class="sr-only">{hook.lines.join(" ")}</p>
				<div class="studio-hook-window" aria-hidden="true">
					<div class="studio-hook-roll" data-hook-roll>
						{hook.playLines.map((i) => <p data-play data-lamp={i === hook.lampLine ? "" : undefined}>{hook.lines[i]}</p>)}
					</div>
				</div>
				<button type="button" class="studio-hook-skip" data-hook-skip data-continue={hook.continue} hidden>{hook.skip}</button>
			</div>
		</div>

		<!-- 1 Sketch: where every project starts -->
		<section data-scene="sketch" data-place="top" class="studio-scene studio-card" aria-labelledby="scene-sketch">
			<img class="studio-still" {...still("sketch")} alt="" loading="lazy" width="1600" height="900" />
			<p class="studio-tag">{mission.stepLabel} 01 · {plan.title}</p>
			<h2 id="scene-sketch">{servicesSection.heading}</h2>
			<p class="studio-big">{servicesSection.intro}</p>
			<p>{plan.desc}</p>
		</section>

		<!-- 2 Research: the build guide on the monitor -->
		<section data-scene="research" data-side="right" class="studio-scene studio-card" aria-labelledby="scene-research">
			<img class="studio-still" {...still("research")} alt="" loading="lazy" width="1600" height="900" />
			<p class="studio-tag">{mission.stepLabel} 02 · {build.title}</p>
			<h2 id="scene-research">{mission.processHeading}</h2>
			<p>{build.desc}</p>
		</section>

		<!-- 3 The four stations: one service each -->
		{
			services.map((s, i) => {
				const id = stations[i];
				const external = s.proof?.href.startsWith("http");
				return (
					<section data-scene={id} data-side={i % 2 ? "right" : undefined} class="studio-scene studio-card" aria-labelledby={`scene-${id}`}>
						<img class="studio-still" {...still(id)} alt="" loading="lazy" width="1600" height="900" />
						<p class="studio-tag">
							{servicesSection.heading} · {i + 1} {studio.stationOf} {services.length}
						</p>
						<h2 id={`scene-${id}`}>{s.title}</h2>
						<p>{s.desc}</p>
						{s.proof && (
							<a
								href={s.proof.href}
								class="studio-link"
								{...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
							>
								{servicesSection.linkPrefix} {s.proof.label}
								<ArrowUpRight className="size-4" aria-hidden="true" />
							</a>
						)}
					</section>
				);
			})
		}

		<!-- 4 The wall of projects -->
		<section data-scene="wall" class="studio-scene studio-card" aria-labelledby="scene-wall">
			<img class="studio-still" {...still("wall")} alt="" loading="lazy" width="1600" height="900" />
			<h2 id="scene-wall">{workSection.heading}</h2>
			<p>{workSection.intro}</p>
			<ul class="studio-list">
				{
					projects.map((p) => (
						<li>
							<a href={`/work/${p.id}/`}>{p.data.title}</a>
							{p.data.badge && <StatusTag>{p.data.badge}</StatusTag>}
						</li>
					))
				}
			</ul>
			<a href="/work/" class="studio-link">{workSection.allWorkLink} <ArrowRight className="size-4" aria-hidden="true" /></a>
		</section>

		<!-- 5 Standards: the whiteboard -->
		<section data-scene="standards" class="studio-scene studio-card" aria-labelledby="scene-standards">
			<img class="studio-still" {...still("standards")} alt="" loading="lazy" width="1600" height="900" />
			<p class="studio-tag">{mission.stepLabel} 03 · {handOver.title}</p>
			<h2 id="scene-standards">{mission.standardsHeading}</h2>
			<ul class="studio-checks">
				{mission.standards.map((s) => <li>{s}</li>)}
			</ul>
			<p>{handOver.desc}</p>
			<p class="studio-tag">{mission.label}</p>
			<p class="studio-big">{mission.statement}</p>
		</section>

		<!-- 6 Timeline: the window -->
		<section data-scene="timeline" data-side="right" data-wide class="studio-scene studio-card" aria-labelledby="scene-timeline">
			<img class="studio-still" {...still("timeline")} alt="" loading="lazy" width="1600" height="900" />
			<h2 id="scene-timeline">{journey.heading}</h2>
			<ol class="studio-years">
				{
					journey.milestones.map((m) => (
						<li data-state={m.state}>
							<p class="studio-year">
								{m.year}
								{m.state === "now" && <span class="studio-chip studio-chip-now">{journey.nowTag}</span>}
								{m.before && <span class="studio-chip">{journey.beforeTag}</span>}
							</p>
							<h3>{m.title}</h3>
							<p>{m.desc}</p>
						</li>
					))
				}
			</ol>
		</section>

		<!-- 7 The crew: the table -->
		<section data-scene="crew" class="studio-scene studio-card" aria-labelledby="scene-crew">
			<img class="studio-still" {...still("crew")} alt="" loading="lazy" width="1600" height="900" />
			<h2 id="scene-crew">{teamSection.heading}</h2>
			<p>{teamSection.intro}</p>
			<ul class="studio-people">
				{
					members.map((m) => (
						<li>
							<img src={copyUpTo(m.data.img, 160)} srcset={srcset(m.data.img)} sizes="48px" alt="" width="48" height="48" loading="lazy" />
							<span>
								<a href={`/members/${m.id}/`}>{m.data.title}</a>
								<span class="studio-role">{toBadge(m).title}</span>
							</span>
						</li>
					))
				}
			</ul>
			<a href="/members/" class="studio-link">{teamSection.allMembersLink} <ArrowRight className="size-4" aria-hidden="true" /></a>
		</section>

		<!-- 8 Contact: the door -->
		<section data-scene="contact" data-side="right" class="studio-scene studio-card" aria-labelledby="scene-contact">
			<img class="studio-still" {...still("contact")} alt="" loading="lazy" width="1600" height="900" />
			<h2 id="scene-contact">{contact.heading}</h2>
			<p>
				{contact.before}
				<a href={`mailto:${site.email}`} class="studio-inline-link">{site.email}</a>{contact.after}
			</p>
			<div class="flex flex-wrap items-center gap-3">
				<EmailButton label={contact.button} subject={contact.subject} />
				<button type="button" class="studio-restart" data-studio-restart>{studio.backToStart} <span aria-hidden="true">↺</span></button>
			</div>
			<nav aria-label={footer.pagesHeading} class="studio-footer-links">
				<ul>
					{footer.pages.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
				</ul>
			</nav>
		</section>
	</Studio>
	</div>
	<div class="classic-home">
		<ClassicHome />
	</div>
	<script is:inline data-astro-rerun>
		// Both versions use the same anchors (#services, #work, #team, #contact); keep them only on the one showing,
		// so links like /#services land in the right place. The hidden one keeps them aside (data-anchor-id), for when the
		// opening page switches this page to the studio (studio:on, src/components/Studio.astro).
		(() => {
			const place = () => {
				const on = document.documentElement.classList.contains("studio-on");
				document.querySelector(on ? ".classic-home" : ".studio-home")?.querySelectorAll("[id]").forEach((el) => {
					el.dataset.anchorId = el.id;
					el.removeAttribute("id");
				});
				document.querySelector(on ? ".studio-home" : ".classic-home")?.querySelectorAll("[data-anchor-id]").forEach((el) => {
					el.id = el.dataset.anchorId;
					delete el.dataset.anchorId;
				});
			};
			place();
			document.addEventListener("studio:on", place, { once: true });
		})();
	</script>
	<script>
		import "@/scripts/studio-hook";
	</script>
	<style is:global>
		/* ---------- The studio's first words (src/scripts/studio-hook.ts) ---------- */
		.studio-hook:not([data-playing]) .studio-hook-inner > h2 {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
		.studio-hook:not([data-playing]) .studio-hook-window {
			display: none;
		}
		.studio-hook[data-playing] {
			position: fixed;
			inset: 0;
			z-index: 4;
			display: grid;
			place-items: center;
			padding: 6rem 1.5rem;
			text-align: center;
			background: radial-gradient(ellipse 55% 45% at 50% 50%, color-mix(in oklab, var(--background) 72%, transparent), transparent 80%);
			transition: opacity 0.8s cubic-bezier(0.65, 0, 0.35, 1);
		}
		.studio-hook[data-leaving] {
			opacity: 0;
		}
		.studio-hook-inner {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 1.75rem;
			max-width: 48rem;
		}
		.studio-hook[data-playing] h2 {
			font-stretch: 125%;
			font-weight: 850;
			font-size: clamp(2rem, 4.5vw, 3.75rem);
			line-height: 1.02;
			letter-spacing: -0.02em;
			color: var(--foreground);
			text-wrap: balance;
			animation: hook-in 1s cubic-bezier(0.22, 1, 0.36, 1) both;
		}
		/* A window a few lines tall: the lines roll up through it, the current one bright, the one before dimmed. */
		.studio-hook-window {
			position: relative;
			width: min(34ch, 100%);
			height: 7.5em;
			overflow: hidden;
			font-size: clamp(1.25rem, 2.2vw, 1.75rem);
			line-height: 1.35;
			-webkit-mask-image: linear-gradient(to bottom, transparent, #000 40%);
			mask-image: linear-gradient(to bottom, transparent, #000 40%);
		}
		.studio-hook-roll {
			display: flex;
			flex-direction: column;
			gap: 0.9em;
			transform: translateY(7.5em);
			transition: transform 0.9s cubic-bezier(0.65, 0, 0.35, 1);
		}
		.studio-hook-roll > p {
			color: var(--foreground);
			opacity: 0;
			transition: opacity 0.7s;
			text-wrap: balance;
		}
		.studio-hook-roll > p[data-state="current"] {
			opacity: 1;
		}
		.studio-hook-roll > p[data-state="previous"] {
			opacity: 0.4;
		}
		.studio-hook-roll > p[data-lamp] {
			font-weight: 700;
		}
		.studio-hook-skip {
			position: fixed;
			left: 50%;
			bottom: 1.25rem;
			transform: translateX(-50%);
			min-height: 44px;
			padding: 0 1.4rem;
			border-radius: 999px;
			border: 1px solid color-mix(in oklab, var(--foreground) 22%, transparent);
			background: color-mix(in oklab, var(--background) 70%, transparent);
			-webkit-backdrop-filter: blur(10px);
			backdrop-filter: blur(10px);
			color: var(--foreground);
			font-weight: 600;
			cursor: pointer;
		}
		.studio-hook-skip:focus-visible {
			outline: 2px solid var(--ring);
			outline-offset: 3px;
		}
		/* Wide screens: on the empty wall to the left, where the title's words will be, so the logo stays clear to light up. */
		@media (min-width: 1101px) {
			.studio-hook[data-playing] {
				place-items: center start;
				padding-left: clamp(1rem, 5vw, 4.5rem);
				text-align: left;
				background: radial-gradient(ellipse 38% 55% at 16% 50%, color-mix(in oklab, var(--background) 72%, transparent), transparent 80%);
			}
			.studio-hook-inner {
				align-items: flex-start;
				max-width: min(30rem, 34vw);
			}
			.studio-hook-window {
				width: 100%;
			}
			.studio-hook[data-playing] h2 {
				font-size: clamp(2rem, 3.3vw, 3.25rem);
			}
		}
		/* Reduced motion: the heading and the lamp line together, still, and Continue under them. */
		.studio-hook[data-still] .studio-hook-window {
			height: auto;
			-webkit-mask-image: none;
			mask-image: none;
		}
		.studio-hook[data-still] .studio-hook-roll {
			transform: none;
			transition: none;
		}
		.studio-hook[data-still] .studio-hook-roll > p:not([data-state="current"]) {
			display: none;
		}
		.studio-hook[data-still] h2,
		.studio-hook[data-still] .studio-hook-roll > p {
			animation: none;
			transition: none;
		}
		.studio-hook[data-still] .studio-hook-skip {
			position: static;
			transform: none;
			background: var(--primary);
			color: var(--primary-foreground);
		}
		/* While the words play, the scene's own words and the ruler wait. */
		html.hook-on .studio-panels > [data-scene],
		html.hook-on .studio-ruler {
			opacity: 0 !important;
			pointer-events: none !important;
		}
		@keyframes hook-in {
			from {
				opacity: 0;
				transform: translateY(14px);
			}
		}
		html.studio-on .classic-home,
		html:not(.studio-on) .studio-home {
			display: none;
		}
	</style>
</BaseLayout>
