---
/**
 * 404: a sheet missing from JPL's drawing set (the spec's section 7). Where its drawing should be, the drone camera's
 * lost feed (static on a small canvas, still under reduced motion); its title block names the address that was asked
 * for; below, the register: every sheet of the set, to find your way. Words: src/text/site.ts (`notFound`); the
 * projects' and members' names and lines come from their own files.
 */
import TitleBlock from "@/components/TitleBlock.astro";
import { buttonVariants } from "@/components/ui/button";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getMembers, getProjects, roleLine } from "@/lib/content";
import { notFound } from "@/text/site";

const { signal, register, titleBlock } = notFound;
/** A project's line in the register: the first sentence (or clause) of its description. */
const firstLine = (text: string) => text.trim().split(/(?<=\.)\s|\s—\s/)[0].replace(/[.:]$/, "") + ".";
const rows = [
	{ href: "/", label: register.home.label, shows: register.home.shows },
	{ href: "/work/", label: register.work.label, shows: register.work.shows },
	...(await getProjects()).map((p) => ({ href: `/work/${p.id}/`, label: p.data.title, shows: firstLine(p.data.description), sub: true })),
	{ href: "/members/", label: register.members.label, shows: register.members.shows },
	...(await getMembers()).map((m) => ({ href: `/members/${m.id}/`, label: m.data.title, shows: roleLine(m), sub: true })),
	{ href: "/about/", label: register.about.label, shows: register.about.shows },
];
---

<BaseLayout title={`${notFound.title} | JPL Innovation`} description={notFound.description} canonical={false}>
	<section class="wrapper missing" aria-labelledby="lost-heading">
		<h1 id="lost-heading" class="missing__title living" data-reveal>
			{notFound.headline}<span class="sr-only">. {notFound.title}.</span>
		</h1>
		<div class="missing__grid">
			<div class="missing__text">
				<p class="missing__lede">{notFound.lede}</p>
				<div class="missing__actions">
					<a href="/" class={buttonVariants({ variant: "default", size: "lg" }) + " missing__home"}>{notFound.homeButton}</a>
					<a href="/work/" class="missing__work">{notFound.workButton}</a>
				</div>
			</div>
			<!-- The missing sheet: its outline in the set, and where its drawing should be, the drone camera's lost feed. -->
			<figure class="missing__sheet">
				<div class="missing__feed">
					<canvas class="lost-static" width="200" height="112" aria-hidden="true"></canvas>
					<span class="missing__cam" aria-hidden="true">{signal.cam}</span>
					<span class="missing__status" aria-hidden="true">{signal.status}</span>
					<p class="missing__signal" aria-hidden="true">{signal.headline}</p>
				</div>
				<figcaption class="missing__caption">{signal.kicker}</figcaption>
				<TitleBlock
					label={titleBlock.label}
					rows={[
						{ label: titleBlock.status, value: titleBlock.statusValue },
						{ label: titleBlock.error, value: titleBlock.errorValue },
						{ label: titleBlock.address, value: "" },
					]}
					wide
				/>
			</figure>
		</div>
	</section>

	<!-- The register: every sheet of the set. -->
	<section class="wrapper register" aria-labelledby="register-heading">
		<h2 id="register-heading" class="register__heading">{register.heading}</h2>
		<table class="register__table">
			<thead>
				<tr>
					<th scope="col">{register.sheet}</th>
					<th scope="col">{register.shows}</th>
				</tr>
			</thead>
			<tbody>
				{
					rows.map((r) => (
						<tr class:list={{ "register__sub": r.sub }}>
							<th scope="row">
								<a href={r.href}>{r.label}</a>
							</th>
							<td>{r.shows}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</section>

</BaseLayout>

<style>
	.missing {
		padding-top: clamp(2rem, 4vw, 3.5rem);
		padding-bottom: clamp(4.5rem, 9vw, 8rem);
	}
	.missing__title {
		/* two lines at every width: "This sheet isn't / in the set" */
		font-size: clamp(2.3rem, 7.6vw - 0.2rem, 11rem);
		font-weight: 850;
		font-stretch: 112%;
		line-height: 0.9;
		letter-spacing: -0.04em;
		text-wrap: balance;
		padding-bottom: 0.06em;
	}
	@media (min-width: 640px) {
		.missing__title {
			font-stretch: 125%;
			font-size: min(var(--step-display), 7.3vw);
		}
	}
	.missing__grid {
		display: grid;
		gap: 2.5rem;
		margin-top: clamp(1.75rem, 3.5vw, 3rem);
	}
	@media (min-width: 1024px) {
		.missing__grid {
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			gap: clamp(2rem, 4vw, 4rem);
			align-items: start;
		}
	}
	.missing__text {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}
	.missing__lede {
		max-width: 36ch;
		font-size: var(--step-lead);
		line-height: 1.4;
		text-wrap: pretty;
	}
	.missing__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.75rem;
	}
	.missing__home {
		border-radius: 999px;
		padding-inline: 1.5rem;
	}
	.missing__work {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		font-weight: 650;
		text-decoration: underline;
		text-decoration-color: var(--accent-brand);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}

	/* The missing sheet: a dashed outline where it should stand in the set. */
	.missing__sheet {
		--pad: clamp(0.75rem, 1.6vw, 1.1rem);
		--inner: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin: 0;
		padding: var(--pad);
		border: 2px dashed color-mix(in oklab, var(--ink-soft) 55%, transparent);
		border-radius: calc(var(--inner) + var(--pad));
	}
	.missing__feed {
		position: relative;
		isolation: isolate;
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: var(--inner);
		background: #050b2c;
		color: #f2eedf;
	}
	.lost-static {
		position: absolute;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		image-rendering: pixelated;
		opacity: 0.4;
	}
	.missing__signal {
		font-size: clamp(2rem, 5.5vw, 5.5rem);
		font-weight: 850;
		font-stretch: 125%;
		letter-spacing: -0.04em;
		line-height: 1;
		text-align: center;
	}
	.missing__cam,
	.missing__status {
		position: absolute;
		top: 0.9rem;
		font-size: var(--step-small);
		font-weight: 650;
		color: #f5d042;
	}
	.missing__cam {
		left: 1rem;
	}
	.missing__status {
		right: 1rem;
	}
	@media (prefers-reduced-motion: no-preference) {
		:global(html:not(.reduce-motion)) .missing__status {
			animation: lost-blink 1.1s steps(2, jump-none) infinite;
		}
	}
	@keyframes lost-blink {
		50% {
			opacity: 0.2;
		}
	}
	.missing__caption {
		font-size: var(--step-small);
		color: var(--ink-soft);
		padding-inline: 0.25rem;
	}
	.missing__sheet :global(.title-block) {
		border-radius: var(--inner);
	}

	/* The register: a real table. */
	.register {
		padding-bottom: clamp(5rem, 11vw, 10rem);
	}
	.register__heading {
		font-size: var(--step-head);
		font-weight: 800;
		font-stretch: 125%;
		line-height: 0.95;
		letter-spacing: -0.03em;
		text-wrap: balance;
		padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
	}
	.register__table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--step-body);
	}
	.register__table th,
	.register__table td {
		padding: 0.85rem 1rem 0.85rem 0;
		border-bottom: 1px solid var(--sheet-edge);
		text-align: left;
		vertical-align: baseline;
	}
	.register__table thead th {
		font-size: var(--step-small);
		font-weight: 600;
		color: var(--ink-soft);
		border-bottom-color: color-mix(in oklab, var(--ink) 35%, transparent);
	}
	.register__table tbody th {
		width: 38%;
		font-weight: 750;
		font-stretch: 112%;
	}
	.register__sub th {
		padding-left: 1.25rem;
		font-weight: 600;
		font-stretch: 100%;
	}
	.register__table a {
		display: inline-block;
		padding-block: 0.35rem;
		text-decoration: underline;
		text-decoration-color: transparent;
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
		transition: text-decoration-color 0.25s;
	}
	.register__table a:hover,
	.register__table a:focus-visible {
		text-decoration-color: var(--accent-brand);
	}
	.register__table td {
		color: var(--ink-soft);
	}
	@media (max-width: 639px) {
		.register__table thead {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
		}
		.register__table tr {
			display: grid;
			border-bottom: 1px solid var(--sheet-edge);
			padding-block: 0.7rem;
		}
		.register__table th,
		.register__table td {
			width: auto !important;
			padding: 0;
			border: 0;
		}
		.register__table td {
			font-size: var(--step-small);
		}
	}
</style>

<script>
	import { reducedMotion } from "@/lib/prefs";

	let stop: (() => void) | undefined;

	function init() {
		stop?.();
		stop = undefined;
		// The title block names the address that was asked for.
		const address = document.querySelector<HTMLElement>(".missing__sheet .title-block__cell:last-child dd");
		if (address) {
			try {
				address.textContent = decodeURI(location.pathname);
			} catch {
				address.textContent = location.pathname;
			}
		}
		const canvas = document.querySelector<HTMLCanvasElement>(".lost-static");
		const g = canvas?.getContext("2d");
		if (!canvas || !g) return;
		const { width, height } = canvas;
		const image = g.createImageData(width, height);
		let band = 0;

		/** One frame of static: grey noise, with a few horizontal tearing bands that drift down the picture. */
		const draw = () => {
			const data = image.data;
			band = (band + 1.7) % height;
			for (let y = 0; y < height; y++) {
				const torn = Math.abs(y - band) < 4 || Math.abs(y - ((band * 2.3) % height)) < 2;
				const bright = torn ? 1.9 : 1;
				for (let x = 0; x < width; x++) {
					const v = Math.min(255, Math.random() * 190 * bright);
					const i = (y * width + x) * 4;
					data[i] = v * 0.86;
					data[i + 1] = v;
					data[i + 2] = Math.min(255, v * 1.1);
					data[i + 3] = 255;
				}
			}
			g.putImageData(image, 0, 0);
		};
		draw();
		if (reducedMotion()) return;

		let raf = 0;
		let last = 0;
		let visible = true;
		const tick = (now: number) => {
			raf = requestAnimationFrame(tick);
			if (!visible || now - last < 66) return; // about 15 frames a second, like analogue
			last = now;
			draw();
		};
		raf = requestAnimationFrame(tick);
		const watch = new IntersectionObserver(([entry]) => (visible = entry.isIntersecting));
		watch.observe(canvas);
		stop = () => {
			cancelAnimationFrame(raf);
			watch.disconnect();
		};
	}

	document.addEventListener("astro:page-load", init);
	document.addEventListener("astro:before-swap", () => stop?.());
</script>
