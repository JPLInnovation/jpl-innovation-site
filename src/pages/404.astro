---
import ContactSection from "@/components/ContactSection.astro";
import { buttonVariants } from "@/components/ui/button";
import PageIntro from "@/components/PageIntro.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
// Words: src/text/site.ts (`notFound`).
import { notFound } from "@/text/site";
---

<BaseLayout title={`${notFound.title} | JPL Innovation`} description="This page doesn't exist." noindex>
	<PageIntro title={notFound.title} lede={notFound.lede}>
		<div class="flex flex-wrap gap-3 pt-2 pb-20">
			<a href="/" class={buttonVariants({ variant: "signal", size: "lg" })}>{notFound.homeButton}</a>
			<a href="/work/" class={buttonVariants({ variant: "outline", size: "lg" })}>{notFound.workButton}</a>
		</div>
	</PageIntro>
	<ContactSection />
</BaseLayout>
