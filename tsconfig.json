{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "jpl-innovation-site", "website-old-main", "screenshots", "**/*.test.ts", "scripts"],
  "compilerOptions": {
    "jsx": "react-jsx",
